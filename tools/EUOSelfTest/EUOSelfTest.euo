; ============================================================================
;  EUO SelfTest - guided test of every variable and command of EasyUO Reforged
; ============================================================================
;  WHAT IT DOES
;    Walks through the variables, events and commands of the port against a
;    running UO client. Each item is sent/read by the script, checked by the
;    script wherever the engine can observe the result (AUTO), and confirmed
;    by YOU only where nothing but eyes can tell (HUMAN: journal text, an
;    animation, an item in a hand). A small always-on-top panel shows what
;    was just done and what to look at, with Pass / Fail / Skip / Repeat /
;    Stop buttons - the UO window stays fully usable.
;
;    At the end a Markdown report is written (see REPORT) so two runs, e.g.
;    client.exe and client_beta.exe, can be diffed.
;
;  HOW TO RUN
;    1. Start the UO client and log a character in (a staff/GM character
;       makes the item and combat stages much easier; no client is also
;       fine: the client stages are skipped and the language stage runs).
;    2. Open this file in a tab of EasyUO Reforged and press Play.
;    3. Answer the panel. "Stop" (or closing the panel) ends the run and
;       still writes the report.
;
;  STAGES (switch them with the %ST_DO_* flags below)
;    1 variables, read only         5 client commands
;    2 variables, write + restore   6 vendor window (needs a buy gump open)
;    3 Event Macro                  7 combat macros (acts on a monster!)
;    4 Event / ExEvent              8 language, menu, namespace (all-commands-test.euo)
;                                   9 buff bar (needs buffs on the character)
;
;  REPORT
;    selftest-<ReforgedVer>-<client>-<date>-<time>.md in the folder EasyUO was
;    started from (the full path is shown at the end), and a copyable memo at
;    the end. One line per item:  - [PASS|FAIL|NOTE|SKIP|INFO] id what [AUTO|HUMAN] observed=value
;    Underscores stand for spaces (EasyUO tokens are space-delimited).
;
;  EASYUO QUIRKS THIS FILE RESPECTS (same as tests\euo\all-commands-test.euo)
;    - a variable is only expanded when it is a separate, space-delimited word
;    - a value with spaces is built with  , #spc ,
;    - single-line "if" bodies never contain another "if": { } blocks are used
;    - gosub arguments are tokens, not expressions
;    - all subs live below the final "halt"; every tool variable starts with st_
;    - CALLed files cannot gosub the caller's subs, so everything lives in this one file
; ============================================================================

; ---------------------------------------------------------------------------
;  CONFIGURATION  (1 = on, 0 = off)
; ---------------------------------------------------------------------------
set %ST_UNATTENDED 0
; 1 = never show the panel: every HUMAN question is answered SKIP (used for dry runs)
set %ST_SIM_REPEAT 0
; 1 (with ST_UNATTENDED 1) = answer every HUMAN question REPEAT once and then PASS (tests the Repeat flow)
set %ST_REPORT 1
; 1 = write the Markdown report file at the end (the memo is always shown)
set %ST_PANEL_X 1200
set %ST_PANEL_Y 60
; where the panel appears on screen (move it away from the UO window)
set %ST_PET_ID LWCC
; id of one of your pets; stage 4 renames it to EUOTest (leave empty to skip)
set %ST_ITEM_ID FPJRJMD
; id of ONE item in your backpack (any item, for drag / drop / equip tests); empty = skip

set %ST_DO_VARS 1
set %ST_DO_WRITES 1
set %ST_DO_MACROS 1
set %ST_DO_EVENTS 1
set %ST_DO_CMDS 1
set %ST_DO_SHOP 0
set %ST_DO_COMBAT 0
set %ST_DO_BUFFS 0
; stage 9: scanBuffs and the buff variables; needs the buff bar open with 2-3 buffs on the character
set %ST_DO_LANG 1
; stage 8: runs tests\euo\all-commands-test.euo through CALL (needs that file)
set %ST_LANG_DIR
; folder that holds all-commands-test.euo with trailing backslash; empty = look next to the exe
; (spaces in the path are written as  , #spc , )
set %ST_LANG_NOMENU 0
; 1 = skip the menu-control checks of stage 8 (they need the real EasyUO window, so unattended dry runs set this)

; ---------------------------------------------------------------------------
;  INITIALISATION
; ---------------------------------------------------------------------------
set %st_lpc_orig #lpc
set #lpc 1000
set %st_n_pass 0
set %st_n_fail 0
set %st_n_note 0
set %st_n_skip 0
set %st_n_info 0
set %st_n_human 0
set %st_n_auto 0
set %st_stop 0
set %st_run 1
set %st_id 0
set %st_again 0
set %st_rpt 0
set %st_sim 0
set %st_log
set %st_fails
set %st_pend
set %st_pendn 0
set %st_okchars ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789._-:/[]=,
set %st_have 0
set %st_logged 0
if #cliNr > 0
{
  set %st_have 1
  if #cliLogged = 1
  {
    set %st_logged 1
  }
}

; ---- report file name ------------------------------------------------------
set %st_cv #cliVer
if %st_have = 0
{
  set %st_cv noclient
}
set %st_in %st_cv
gosub st_san
set %st_cv %st_out
set %st_in #reforgedVer
gosub st_san
set %st_rv %st_out
set %st_file selftest- , %st_rv , - , %st_cv , - , #date , - , #time , .md

gosub st_panel_build

; ---------------------------------------------------------------------------
;  MAIN FLOW
; ---------------------------------------------------------------------------
gosub st_stage Environment
gosub st_s_env

if %ST_DO_VARS = 1
{
  gosub st_stage Variables_read_only
  gosub st_s_vars
}
if %ST_DO_WRITES = 1
{
  gosub st_stage Variables_write_and_restore
  gosub st_s_writes
}
if %ST_DO_MACROS = 1
{
  gosub st_stage Event_Macro
  gosub st_s_macros
}
if %ST_DO_EVENTS = 1
{
  gosub st_stage Event_and_ExEvent
  gosub st_s_events
}
if %ST_DO_CMDS = 1
{
  gosub st_stage Client_commands
  gosub st_s_cmds
}
if %ST_DO_SHOP = 1
{
  gosub st_stage Vendor_window
  gosub st_s_shop
}
if %ST_DO_COMBAT = 1
{
  gosub st_stage Combat_macros
  gosub st_s_combat
}
if %ST_DO_LANG = 1
{
  gosub st_stage Language_menu_namespace
  gosub st_s_lang
}
if %ST_DO_BUFFS = 1
{
  gosub st_stage Buff_bar
  gosub st_s_buffs
}

gosub st_finish
set #lpc %st_lpc_orig
halt

; ###########################################################################
;  FRAMEWORK
; ###########################################################################

; ---- st_san ----------------------------------------------------------------
;  in %st_in  out %st_out   every character outside the whitelist becomes _
;  (the report goes through cmd.exe, where  & | < > ^ " %  would break it)
sub st_san
  set %st_out
  str len %st_in
  set %st_sl #strres
  for %st_si 1 %st_sl
  {
    str mid %st_in %st_si 1
    set %st_sc #strres
    str pos %st_okchars %st_sc
    if #strres > 0
    {
      set %st_out %st_out , %st_sc
    }
    else
    {
      set %st_out %st_out , _
    }
  }
return

; ---- st_pretty -------------------------------------------------------------
;  in %st_in  out %st_out   underscores back to spaces (panel text only)
sub st_pretty
  set %st_out
  str len %st_in
  set %st_sl #strres
  for %st_si 1 %st_sl
  {
    str mid %st_in %st_si 1
    set %st_sc #strres
    if %st_sc = _
    {
      set %st_out %st_out , #spc
    }
    else
    {
      set %st_out %st_out , %st_sc
    }
  }
return

; ---- st_emit ---------------------------------------------------------------
;  in %st_line (already sanitized, no spaces, not empty)
;  keeps it for the memo and queues one echo for the report file
sub st_emit
  set %st_log %st_log , %st_line , $
  if %ST_REPORT = 1
  {
    set %st_pend %st_pend , >> , %st_file , #spc , echo , #spc , %st_line , &
    set %st_pendn %st_pendn + 1
    if %st_pendn >= 25
    {
      gosub st_flush
    }
  }
return

; ---- st_flush --------------------------------------------------------------
sub st_flush
  if %st_pendn > 0
  {
    execute cmd.exe /c , #spc , %st_pend
    set %st_pend
    set %st_pendn 0
  }
return

; ---- st_stage name ---------------------------------------------------------
sub st_stage
  set %st_stagename %1
  set %st_in %1
  gosub st_san
  set %st_line **STAGE_ , %st_out , **
  gosub st_emit
  set %st_line ---
  gosub st_emit
  if %st_stop = 0
  {
    gosub st_panel_stage
  }
return

; ---- st_case id title -----------------------------------------------------
;  starts an item. Sets %st_run to 0 when the run was stopped, so the caller
;  can skip its actions:   gosub st_case 3.01 title   if %st_run = 1 { ... }
sub st_case
  set %st_id %1
  set %st_cid %1
  set %st_title %2
  set %st_run 1
  set %st_rpt 0
  if %st_stop = 1
  {
    set %st_run 0
  }
  if %st_run = 1
  {
    gosub st_panel_case
  }
return

; ---- st_rec verdict kind what observed ----------------------------------------------
;  verdict PASS FAIL NOTE SKIP INFO   kind AUTO HUMAN
sub st_rec
  set %st_v %1
  set %st_k %2
  ; while the user repeats a step its automatic checks are not recorded a second time
  set %st_sup ( %st_rpt = 1 ) && ( %st_k = AUTO )
  if %st_sup
  {
    return
  }
  set %st_in %3
  gosub st_san
  set %st_w %st_out
  set %st_in %4
  gosub st_san
  set %st_o %st_out
  str len %st_o
  if #strres > 60
  {
    str left %st_o 60
    set %st_o #strres
  }
  if %st_v = PASS
  {
    set %st_n_pass %st_n_pass + 1
  }
  if %st_v = FAIL
  {
    set %st_n_fail %st_n_fail + 1
  }
  if %st_v = NOTE
  {
    set %st_n_note %st_n_note + 1
  }
  if %st_v = SKIP
  {
    set %st_n_skip %st_n_skip + 1
  }
  if %st_v = INFO
  {
    set %st_n_info %st_n_info + 1
  }
  if %st_k = HUMAN
  {
    set %st_n_human %st_n_human + 1
  }
  if %st_k = AUTO
  {
    set %st_n_auto %st_n_auto + 1
  }
  set %st_ix %st_id
  if %st_k = HUMAN
  {
    set %st_ix %st_cid
  }
  set %st_line - , #spc , [ , %st_v , ] , _ , %st_ix , _ , %st_w , _[ , %st_k , ]_observed= , %st_o
  gosub st_emit
  if %st_v = FAIL
  {
    set %st_fails %st_fails , %st_line , $
  }
return

; ---- st_eq what actual expected --------------------------------------------------------
sub st_eq
  if %2 = %3
  {
    gosub st_rec PASS AUTO %1 %2
  }
  else
  {
    gosub st_rec FAIL AUTO %1 actual_ , %2 , _expected_ , %3
  }
return

; ---- st_known what actual expected known_value ---------------------------------------------
;  like st_eq, but a value that matches the documented engine/wiki difference is a NOTE
sub st_known
  if %2 = %3
  {
    gosub st_rec PASS AUTO %1 %2
  }
  else
  {
    if %2 = %4
    {
      gosub st_rec NOTE AUTO %1 known_difference_ , %2 , _wiki_says_ , %3
    }
    else
    {
      gosub st_rec FAIL AUTO %1 actual_ , %2 , _expected_ , %3 , _or_ , %4
    }
  }
return

; ---- st_ok what observed condition -----------------------------------------------------------
;  condition is a 0/1 value computed by the caller
sub st_ok
  if %3 <> 0
  {
    gosub st_rec PASS AUTO %1 %2
  }
  else
  {
    gosub st_rec FAIL AUTO %1 %2
  }
return

; ---- st_info what value -----------------------------------------------------------------------
sub st_info
  gosub st_rec INFO AUTO %1 %2
return

; ---- st_skip what reason ------------------------------------------------------------------------
sub st_skip
  gosub st_rec SKIP AUTO %1 %2
return

; ---- st_ask  (in %st_prompt) ------------------------------------------------------------------------
;  Shows the prompt (underscores = spaces, $ = new line) and waits for a button.
;  out %st_ans = PASS | FAIL | SKIP | REPEAT | STOP
sub st_ask
  set %st_ans SKIP
  if %ST_UNATTENDED = 1
  {
    if %ST_SIM_REPEAT = 1
    {
      set %st_sim %st_sim + 1
      set %st_odd %st_sim % 2
      set %st_ans PASS
      if %st_odd = 1
      {
        set %st_ans REPEAT
      }
    }
    return
  }
  set %st_in %st_prompt
  gosub st_pretty
  menu Set st_body %st_out
  set #menuButton st_none
  set %st_wait 1
  while %st_wait = 1
  {
    wait 1
    if #menuButton <> st_none
    {
      set %st_b #menuButton
      set #menuButton st_none
      if %st_b = st_pass
      {
        set %st_ans PASS
        set %st_wait 0
      }
      if %st_b = st_fail
      {
        set %st_ans FAIL
        set %st_wait 0
      }
      if %st_b = st_skip
      {
        set %st_ans SKIP
        set %st_wait 0
      }
      if %st_b = st_repeat
      {
        set %st_ans REPEAT
        set %st_wait 0
      }
      if %st_b = st_stop
      {
        set %st_ans STOP
        set %st_wait 0
      }
      if %st_b = Close
      {
        set %st_ans STOP
        set %st_wait 0
      }
    }
  }
  if %st_ans = STOP
  {
    set %st_stop 1
  }
return

; ---- st_human what  (in %st_prompt, %st_obs) -----------------------------------------------------------
;  asks, records the answer as HUMAN. out %st_again = 1 when the user pressed Repeat
;  (the caller then repeats its action:  label: ... gosub st_human ... if %st_again = 1 { goto label })
sub st_human
  set %st_again 0
  gosub st_ask
  if %st_ans = REPEAT
  {
    set %st_again 1
    set %st_rpt 1
    return
  }
  set %st_rpt 0
  if %st_ans = PASS
  {
    gosub st_rec PASS HUMAN %1 %st_obs
  }
  if %st_ans = FAIL
  {
    gosub st_rec FAIL HUMAN %1 %st_obs
  }
  if %st_ans = SKIP
  {
    gosub st_rec SKIP HUMAN %1 %st_obs
  }
  if %st_ans = STOP
  {
    gosub st_rec SKIP HUMAN %1 stopped_by_user
  }
return

; ---- panel ----------------------------------------------------------------------------------------------
sub st_panel_build
  if %ST_UNATTENDED = 1
  {
    return
  }
  menu Clear
  menu Window Title EUO SelfTest
  menu Window Size 440 300
  menu Window Color btnface
  menu Window Transparent 100
  menu Font Name Arial
  menu Font Size 9
  menu Font Color black
  menu Font Transparent #true
  menu Font Style B
  menu Text st_l_stage 10 8 stage
  menu Text st_l_title 10 28 title
  menu Font Style
  menu Font Transparent #false
  menu Memo st_body 10 52 420 150 Starting
  menu Button st_pass 10 212 80 28 Pass
  menu Button st_fail 100 212 80 28 Fail
  menu Button st_skip 190 212 80 28 Skip
  menu Button st_repeat 280 212 70 28 Repeat
  menu Button st_stop 360 212 70 28 Stop
  menu Font Transparent #true
  menu Text st_l_count 10 252 0_pass_0_fail
  menu Show %ST_PANEL_X %ST_PANEL_Y
return

sub st_panel_stage
  if %ST_UNATTENDED = 1
  {
    return
  }
  set %st_in %st_stagename
  gosub st_pretty
  menu Set st_l_stage Stage: , #spc , %st_out
return

sub st_panel_case
  if %ST_UNATTENDED = 1
  {
    return
  }
  set %st_in %st_title
  gosub st_pretty
  menu Set st_l_title %st_id , #spc , %st_out
  menu Set st_l_count %st_n_pass , #spc , pass , #spc , %st_n_fail , #spc , fail , #spc , %st_n_skip , #spc , skip
return

; ---- st_finish --------------------------------------------------------------------------------------------
sub st_finish
  set %st_line ---
  gosub st_emit
  set %st_line **SUMMARY**
  gosub st_emit
  set %st_line - , #spc , pass= , %st_n_pass
  gosub st_emit
  set %st_line - , #spc , fail= , %st_n_fail
  gosub st_emit
  set %st_line - , #spc , note= , %st_n_note
  gosub st_emit
  set %st_line - , #spc , skip= , %st_n_skip
  gosub st_emit
  set %st_line - , #spc , info= , %st_n_info
  gosub st_emit
  set %st_line - , #spc , auto_checks= , %st_n_auto , _human_checks= , %st_n_human
  gosub st_emit
  if %st_n_fail > 0
  {
    set %st_line **FAILED_ITEMS**
    gosub st_emit
    set %st_line - , #spc , see_the_FAIL_lines_above
    gosub st_emit
  }
  gosub st_flush
  set %st_sum EUO_SelfTest_finished:_ , %st_n_pass , _pass_ , %st_n_fail , _fail_ , %st_n_note , _note_ , %st_n_skip , _skip$
  if %ST_REPORT = 1
  {
    set %st_sum %st_sum , Report:_ , #curPath , %st_file$
  }
  if %ST_UNATTENDED = 0
  {
    menu Clear
    menu Window Title EUO SelfTest report
    menu Window Size 520 360
    menu Text st_r1 12 8 Click inside the box then Ctrl+A and Ctrl+C to copy the report.
    menu Memo st_report 12 30 496 320 %st_sum , %st_log
    menu Show %ST_PANEL_X %ST_PANEL_Y
  }
return

; ###########################################################################
;  STAGES
; ###########################################################################
sub st_s_env
  gosub st_case 0.1 reforged_version
  gosub st_info reforged_version #reforgedVer
  gosub st_case 0.2 client_attached
  gosub st_info clients_detected #cliCnt
  gosub st_info active_client_slot #cliNr
  if %st_have = 1
  {
    gosub st_info client_version #cliVer
    gosub st_info client_language #cliLang
    gosub st_info logged_in #cliLogged
    gosub st_info shard #shard
    gosub st_info character #charName
  }
  else
  {
    gosub st_skip client_stages no_client_attached
  }
return

; ===========================================================================
;  STAGE 1  variables, read only
; ===========================================================================
;  st_vc name rule [lo hi]   client variable: N/A without a client, SKIP when not
;                            logged in, otherwise checked with the rule
;  st_va name rule [lo hi]   variable that works with or without a client
;  rules:  any  (listed only)   num  (a number)   pos  (> 0)   has  (not empty, not N/A)
;          rng lo hi            eq value        one a b (value is a or b)
sub st_vc
  set %st_vn %1
  set %st_vr %2
  set %st_lo %3
  set %st_hi %4
  set %st_vv # . %st_vn
  set %st_id %st_cid , . , %st_vn
  if %st_have = 0
  {
    gosub st_eq no_client_N/A_# , %st_vn %st_vv N/A
    return
  }
  if %st_logged = 0
  {
    gosub st_skip # , %st_vn not_logged_in
    return
  }
  gosub st_vrule
return

sub st_va
  set %st_vn %1
  set %st_vr %2
  set %st_lo %3
  set %st_hi %4
  set %st_vv # . %st_vn
  set %st_id %st_cid , . , %st_vn
  gosub st_vrule
return

sub st_vrule
  if %st_vr = any
  {
    gosub st_info # , %st_vn %st_vv
    return
  }
  if %st_vr = num
  {
    set %st_ck ( %st_vv >= 0 ) || ( %st_vv < 0 )
    gosub st_ok # , %st_vn , _is_a_number %st_vv %st_ck
    return
  }
  if %st_vr = pos
  {
    set %st_ck %st_vv > 0
    gosub st_ok # , %st_vn , _is_greater_than_0 %st_vv %st_ck
    return
  }
  if %st_vr = has
  {
    str len %st_vv
    set %st_ck ( #strres > 0 ) && ( %st_vv <> N/A )
    gosub st_ok # , %st_vn , _not_empty_not_N/A %st_vv %st_ck
    return
  }
  if %st_vr = rng
  {
    set %st_ck ( %st_vv >= %st_lo ) && ( %st_vv <= %st_hi )
    gosub st_ok # , %st_vn , _in_ , %st_lo , .. , %st_hi %st_vv %st_ck
    return
  }
  if %st_vr = eq
  {
    gosub st_eq # , %st_vn %st_vv %st_lo
    return
  }
  if %st_vr = one
  {
    set %st_ck ( %st_vv = %st_lo ) || ( %st_vv = %st_hi )
    gosub st_ok # , %st_vn , _is_ , %st_lo , _or_ , %st_hi %st_vv %st_ck
    return
  }
return

sub st_s_vars
  gosub st_vg_global
  if %st_logged = 0
  {
    ; client variables: N/A check (no client) or skipped (not logged in)
    gosub st_vg_character
    gosub st_vg_status
    gosub st_vg_buff
    return
  }
  ; gumps the variables read from: status gump and backpack
  event macro 8 2
  event macro 8 7
  wait 10
  gosub st_vg_character
  gosub st_vg_status
  gosub st_vg_container
  gosub st_vg_client
  gosub st_vg_find
  gosub st_vg_skill
  gosub st_vg_journal
  gosub st_vg_lastaction
  gosub st_vg_buff
return

; ---- variables that work with or without a client --------------------------------
sub st_vg_global
  gosub st_case 1.00 variables_without_a_client
  if %st_run = 0
  {
    return
  }
  gosub st_va cliCnt num
  gosub st_va cliNr num
  gosub st_va euoVer eq 1_50_00
  gosub st_va reforgedVer has
  gosub st_va osVer has
  gosub st_va curPath has
  gosub st_va opts any
  gosub st_va time any
  gosub st_va date any
  gosub st_va sysTime pos
  gosub st_va random num
  gosub st_va true any
  gosub st_va false any
  gosub st_va spc any
  gosub st_va smc any
  gosub st_va dot any
  gosub st_va cursorX num
  gosub st_va cursorY num
  gosub st_va dispRes any
  gosub st_va nsName any
  gosub st_va nsType any
  gosub st_va sCnt any
  gosub st_va sCnt2 any
  gosub st_va result any
  gosub st_va strRes any
  gosub st_va menuButton any
  gosub st_va menuRes any
  gosub st_va lpc pos
  gosub st_va sendHeader any
  gosub st_va property any
  gosub st_va pixCol any
return

sub st_vg_character
  gosub st_case 1.10 character_variables
  if %st_run = 0
  {
    return
  }
  st_rp_1:
  gosub st_vc charPosX pos
  gosub st_vc charPosY pos
  gosub st_vc charPosZ num
  gosub st_vc charDir rng 0 7
  gosub st_vc charStatus any
  gosub st_vc charID has
  gosub st_vc charGhost one yes no
  gosub st_vc backpackID has
  gosub st_vc charType has
  gosub st_vc charName has
  gosub st_vc sex rng 0 1
  if %st_logged = 1
  {
    set %st_prompt Compare_with_the_game:$Name_=_ , #charName , $Position_=_ , #charPosX , _/_ , #charPosY , _/_ , #charPosZ , $Direction_=_ , #charDir , _(0=N,_2=E,_4=S,_6=W)$Status_letters_=_ , #charStatus , _(G=war,_H=hidden,_C=poisoned)$$Pass_if_it_matches_the_game.
    set %st_obs #charName
    gosub st_human character_name_position_direction_status_match_the_game
    if %st_again = 1
    {
      goto st_rp_1
    }
  }
return

sub st_vg_status
  gosub st_case 1.20 status_variables
