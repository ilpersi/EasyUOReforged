  gosub st_eq 6.11.layer FindLayer_of_a_one-handed_weapon_is_1 %fx_layer
return

sub st_c612
  gosub st_case 6.12 Macro_24:_arm_and_disarm
  if %st_run = 0
    return
  gosub st_ensure_dagger
  if %st_dagger = N/A
  {
    gosub st_skip 6.12 arm_disarm no_test_weapon
    return
  }
  gosub st_hands_save
  gosub st_bp_open
  exevent equip %st_dagger
  gosub st_wait_bag %st_dagger #CharID
  wait 30
  event macro 24 2
  gosub st_wait_bag %st_dagger #BackpackID
  set %st_a #FindBagID
  set %st_e #BackpackID
  set %st_f %fx_macro , / , %fx_rhand
  gosub st_eq 6.12.disarm event_macro_24_2_disarms_the_right_hand %st_f
  set %st_a #RHandID
  set %st_e %st_dagger
  gosub st_eq 6.12.saved RHandID_holds_the_disarmed_item %fx_rhand
  gosub st_arm_try 24 2
  gosub st_arm_rec 6.12.arm event_macro_24_2_arms_it_again
  ; written by the script: with the hand empty, the macro equips #RHandID. The hand is emptied by a
  ; drag, not by the macro: after a few arm/disarm steps in a row the client went on refusing them
  finditem %st_dagger A
  if #FindBagID = #CharID
  {
    wait 30
    exevent drag %st_dagger
    wait 10
    exevent dropc #BackpackID
    gosub st_wait_bag %st_dagger #BackpackID
  }
  set #RHandID %st_dagger
  gosub st_arm_try 24 2
  gosub st_arm_rec 6.12.written event_macro_24_2_arms_the_item_written_to_#RHandID
return

; records an arm step: PASS when the dagger is worn; when the client still said "You must wait to
; perform another action", a NOTE with the journal (the client's own refusal, not a table value)
sub st_arm_rec
  set %st_a #FindBagID
  set %st_e #CharID
  if %st_a = #CharID
  {
    gosub st_eq %1 %2 %st_f
    return
  }
  gosub st_jlast
  set %st_a %st_a , _journal:_ , %st_jt
  if %st_atw = 0
  {
    gosub st_eq %1 %2 %st_f
    return
  }
  set %st_e #CharID , _(the_client_kept_saying_to_wait)
  gosub st_note %1 %2 %st_f
return

; event macro %1 %2 to arm %st_dagger, again while the journal says to wait: arming soon after a
; disarm is refused with "You must wait to perform another action" (live on 7.0.117.33, still after
; 1.5 s). #FindBagID is then where the dagger is, %st_atw 1 if the client still said to wait.
sub st_arm_try
  set %st_amm %1
  set %st_ams %2
  set %st_at 0
  repeat
    wait 30
    set %st_atj #JIndex
    event macro %st_amm %st_ams
    gosub st_wait_bag %st_dagger #CharID
    findjournal %st_atj * 0 You_must_wait
    set %st_atw #JFound
    set %st_at %st_at + 1
    finditem %st_dagger A
  until #FindBagID = #CharID || %st_atw = 0 || %st_at >= 4
return

; the three newest journal lines, newest first -> %st_jt
sub st_jlast
  set %st_jt
  for %st_jli 1 3
  {
    scanjournal %st_jli
    set %st_jt %st_jt , #Journal , /
  }
return

; waits until the item %1 is in the container %2 (a character for a worn item), about 5 s at most;
; #FindBagID is then where it is
sub st_wait_bag
  set %st_wbi 0
  repeat
    wait 5
    finditem %1 A
    set %st_wbi %st_wbi + 1
  until #FindBagID = %2 || %st_wbi > 20
return

