sub st_c404
  gosub st_case 4.04 move_two_tiles_each_way
  if %st_run = 0
    return
  gosub st_need 1.05
  gosub st_walkcheck
  set %st_mx #CharPosX
  set %st_my #CharPosY
  move %st_mx %st_my 0 %st_tw2
  set %st_a #CharPosX , / , #CharPosY
  set %st_e %st_mx , / , %st_my
  gosub st_eq 4.04.here move_to_your_own_tile_keeps_you_there %fx_pos
  ; east (direction 2), back west (6), south (4), back north (0)
  gosub st_movetest 4.04.e 2 0 2 E
  gosub st_movetest 4.04.w -2 0 6 E
  gosub st_movetest 4.04.s 0 2 4 S
  gosub st_movetest 4.04.n 0 -2 0 S
return

; id dx dy direction-expected walk-letter (the tiles were checked by st_walkcheck)
sub st_movetest
  set %st_m1 %1
  set %st_m2 %2
  set %st_m3 %3
  set %st_m4 %4
  set %st_m5 %5
  if %st_m5 notin %st_walkok
  {
    gosub st_skip %st_m1 move the_tiles_that_way_are_not_walkable
    return
  }
  ; two moves of one tile: a longer move can overshoot and step back, which turns the character
  set %st_ux %st_m2 / 2
  set %st_uy %st_m3 / 2
  set %st_tx #CharPosX + %st_m2
  set %st_ty #CharPosY + %st_m3
  for %st_mi 1 2
  {
    set %st_sx #CharPosX + %st_ux
    set %st_sy #CharPosY + %st_uy
    move %st_sx %st_sy 0 %st_tw5
    waitfor #CharPosX = %st_sx && #CharPosY = %st_sy %st_tw2
  }
  set %st_a #CharPosX , / , #CharPosY
  set %st_e %st_tx , / , %st_ty
  set %st_wid %st_m1 , .pos
  gosub st_eq %st_wid move_walks_exactly_to_the_tile %fx_pos
  ; #CharDir is the client's own walk direction: the direction of the last step taken
  set %st_a #CharDir
  set %st_e %st_m4
  set %st_wid %st_m1 , .dir
  set %st_back %st_m4 + 4
  set %st_back %st_back % 8
  if %st_a <> %st_e && %st_a = %st_back
  {
    set %st_e %st_m4 , _(move_overshot_and_stepped_back)
    gosub st_note %st_wid CharDir_is_the_way_walked %fx_dir
  }
  else
    gosub st_eq %st_wid CharDir_is_the_way_walked %fx_dir
return

sub st_c405
  gosub st_case 4.05 msg_and_the_journal
