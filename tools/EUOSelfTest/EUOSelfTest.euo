sub st_c608
  gosub st_case 6.08 exevent_Drag,_DropG,_DropC
  if %st_run = 0
    return
  gosub st_ensure_dagger
  if %st_dagger = N/A
  {
    gosub st_skip 6.08 drag_and_drop no_test_weapon
    return
  }
  gosub st_bp_open
  ; exevent Drag only asks the server: the client's #LLifted values stay as they were (see 6.10)
  exevent drag %st_dagger
  wait 10
  set %st_gx #CharPosX + 1
  exevent dropg %st_gx #CharPosY
  wait 20
  finditem %st_dagger G_3
  set %st_a #FindKind , / , #FindX
  set %st_e 1/ , %st_gx
  set %st_f %fx_xdrag , / , %fx_drop
  gosub st_eq 6.08.dropg exevent_Drag_then_DropG_puts_it_on_the_ground_at_x+1 %st_f
  set %st_a #LLiftedKind
  set %st_e 0
  gosub st_eq 6.08.free LLiftedKind_0_after_the_drop %fx_liftk
  exevent drag %st_dagger
  wait 10
  exevent dropc #BackpackID
  wait 20
  finditem %st_dagger C_ , #BackpackID
  set %st_a #FindBagID
  set %st_e #BackpackID
  gosub st_eq 6.08.dropc exevent_DropC_puts_it_into_the_backpack %fx_drop
  ; at a place inside the container: the item's #FindX - #ContPosX is that place
  gosub st_bp_open
  exevent drag %st_dagger
  wait 10
  exevent dropc #BackpackID 80 90
  wait 20
  finditem %st_dagger C_ , #BackpackID
  set %st_t1 #FindX - #ContPosX
  set %st_t2 #FindY - #ContPosY
  set %st_a %st_t1 , / , %st_t2
  set %st_e 80/90
  set %st_f %fx_drop , / , %fx_findc
  gosub st_soft 6.08.dropxy exevent_DropC_80_90_places_it_there %st_f
return

sub st_c609
  gosub st_case 6.09 Part_of_a_stack
  if %st_run = 0
    return
  gosub st_ensure_gold
  if %st_goldid = N/A
  {
    gosub st_skip 6.09 split_a_stack no_gold_pile
    return
  }
  gosub st_bp_open
  finditem %st_goldid CA_ , #BackpackID
  set %st_g0 #FindStack
  ; dropped without a place, the 100 would join the rest again: drop them at a place in the backpack.
  ; Which of the two piles keeps the old ID is the server's choice (on ModernUO, the lifted part).
  gosub st_newitem_begin POF B
  exevent drag %st_goldid 100
  wait 10
  exevent dropc #BackpackID 40 40
  wait 20
  gosub st_newitem_end Gold_split
  set %st_rest %st_g0 - 100
  if %st_newid = N/A
  {
    set %st_a no_second_pile
    set %st_e 100_and_ , %st_rest
    gosub st_eq 6.09.split exevent_Drag_100_splits_the_pile_in_two %fx_stack
    return
  }
  finditem %st_goldid CA_ , #BackpackID
  set %st_s1 #FindStack
  finditem %st_newid CA_ , #BackpackID
  set %st_s2 #FindStack
  set %st_a %st_s1 , _and_ , %st_s2
  set %st_c ( %st_s1 = 100 && %st_s2 = %st_rest ) || ( %st_s1 = %st_rest && %st_s2 = 100 )
  set %st_e 100_and_ , %st_rest
  gosub st_ok 6.09.split exevent_Drag_100_splits_the_pile_in_two %fx_stack
  ; the bigger pile stays the gold pile of the later checks
  if %st_s2 > %st_s1
    set %st_goldid %st_newid
return

sub st_c610
  gosub st_case 6.10 event_Drag
  if %st_run = 0
    return
  gosub st_ensure_dagger
  if %st_dagger = N/A
  {
    gosub st_skip 6.10 event_drag no_test_weapon
    return
  }
  gosub st_bp_open
  finditem %st_dagger CA_ , #BackpackID
  set %st_dtype #FindType
  ; the drop point, the middle of the backpack gump, before the drag
  set %st_gx #ContSizeX / 2
  set %st_gx %st_gx + #ContPosX
  set %st_gy #ContSizeY / 2
  set %st_gy %st_gy + #ContPosY
  event drag %st_dagger
  waitfor #LLiftedKind = 1 %st_tw3
  set %st_lifted #false
  if #LLiftedID = %st_dagger
    set %st_lifted #true
  set %st_a #LLiftedID
  set %st_e %st_dagger
  gosub st_eq 6.10.lifted event_Drag_lifts_the_item %fx_drag
  set %st_a #LLiftedKind
  set %st_e 1
  gosub st_eq 6.10.kind LLiftedKind_1 %fx_liftk
  set %st_a #LLiftedType
  set %st_e %st_dtype
  gosub st_eq 6.10.type LLiftedType_is_its_type %fx_liftt
  ; drop it with a click there: the client follows the real cursor, so the click moves it
  click %st_gx %st_gy p mc
  waitfor #LLiftedKind = 0 %st_tw3
  wait 10
  ; with nothing lifted the dagger never left the backpack (client_beta 7.0.117.31 before 152fdfb)
  if %st_lifted = #false
  {
    gosub st_skip 6.10.dropped drop_back nothing_was_seen_lifted_(6.10.lifted)
    return
  }
  finditem %st_dagger C_ , #BackpackID
  set %st_a #FindBagID
  set %st_e #BackpackID
  gosub st_eq 6.10.dropped click_p_drops_it_back_into_the_backpack %fx_drag
return

