  gosub st_vc str rng 0 1000
  gosub st_vc dex rng 0 1000
  gosub st_vc int rng 0 1000
  gosub st_vc hits num
  gosub st_vc maxHits num
  gosub st_vc stamina num
  gosub st_vc maxStam num
  gosub st_vc mana num
  gosub st_vc maxMana num
  gosub st_vc maxStats pos
  gosub st_vc gold num
  gosub st_vc weight num
  gosub st_vc maxWeight pos
  gosub st_vc ar num
  gosub st_vc followers num
  gosub st_vc maxFol num
  gosub st_vc fr num
  gosub st_vc cr num
  gosub st_vc pr num
  gosub st_vc er num
  gosub st_vc luck num
