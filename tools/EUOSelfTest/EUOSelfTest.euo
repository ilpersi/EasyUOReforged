; ---- 5.01  msg + deleteJournal + scanJournal ----------------------------------------------------------
sub st_c_msg
  gosub st_case 5.01 msg_deleteJournal_scanJournal
  if %st_run = 0
  {
    return
  }
  deleteJournal
  scanJournal 1
  gosub st_info journal_line_1_after_deleteJournal #journal
  msg EUO_selftest_msg$
  wait 15
  scanJournal 1
  str pos #journal EUO_selftest_msg
  set %st_ck #strres > 0
  gosub st_ok msg_types_the_text_and_Enter_(the_$_sign)_so_it_shows_in_the_journal #journal %st_ck
  gosub st_vc jIndex pos
return

; ---- 5.02  key + target ------------------------------------------------------------------------------------
sub st_c_key_target
  gosub st_case 5.02 key_and_target
  if %st_run = 0
  {
    return
  }
  st_rp_36:
  gosub st_cursor_cancel
  event macro 13 1
  wait 10
  set %st_t0 #sysTime
  target 3s
  set %st_dt #sysTime - %st_t0
  set %st_ck %st_dt < 2500
  gosub st_ok target_returns_as_soon_as_a_cursor_is_up_(ms) %st_dt %st_ck
  gosub st_cursor_up
  gosub st_ok target_cursor_is_up #targCurs %st_ck
  key esc
  wait 10
  set %st_ck ( #targCurs = 0 )
  gosub st_ok key_esc_cancels_the_target_cursor #targCurs %st_ck
  set %st_t0 #sysTime
  target 1s
  set %st_dt #sysTime - %st_t0
  set %st_ck ( %st_dt >= 900 ) && ( %st_dt <= 3000 )
  gosub st_ok target_1s_without_a_cursor_times_out_after_about_1000_ms %st_dt %st_ck
  event macro 9 3
  wait 8
  key j alt
  wait 12
  set %st_prompt Key_J_with_Alt_was_sent_(Alt+J_toggles_the_Journal_window).$Did_the_Journal_window_open_or_close?
  set %st_obs alt_j
  gosub st_human key_j_alt_toggles_the_journal
  if %st_again = 1
  {
    goto st_rp_36
  }
  key j alt
  wait 10
return

; ---- 5.03  click ---------------------------------------------------------------------------------------------------------
sub st_c_click
  gosub st_case 5.03 click
  if %st_run = 0
  {
    return
  }
  click 15 25 n
  wait 3
  gosub st_info click_n_moves_the_cursor_x_expected_15 #cursorX
  gosub st_info click_n_moves_the_cursor_y_expected_25 #cursorY
  ; right click closes a gump: open the journal and click into the middle of it
  event macro 9 3
  wait 8
  event macro 8 3
  wait 12
  str pos #contName text
  set %st_ck #strres > 0
  gosub st_ok journal_gump_is_open_before_the_right_click #contName %st_ck
  set %st_gx #contPosX + #contSizeX / 2
  set %st_gy #contPosY + #contSizeY / 2
  click %st_gx %st_gy r
  wait 12
  str pos #contName text
  set %st_ck ( #strres = 0 )
  gosub st_ok click_r_right_click_closes_the_journal_gump #contName %st_ck
  ; double click on your own character opens the paperdoll - unless something (a pet, an NPC) stands on you
  st_rp_c1:
  event macro 9 1
  wait 10
  set %st_cx #cliLeft + #cliXRes / 2
  set %st_cy #cliTop + #cliYRes / 2
  click %st_cx %st_cy d
  wait 15
  str pos #contName paperdoll
  set %st_ck #strres > 0
  if %st_ck
  {
    set %st_pd yes
  }
  else
  {
    set %st_pd no
  }
  gosub st_info paperdoll_opened_after_the_double_click_(no_if_a_pet_or_npc_covers_your_character) %st_pd
  set %st_prompt A_double_click_(click_x_y_d)_was_sent_on_the_middle_of_the_game_window,_where_your_character_stands.$Make_sure_no_pet_or_NPC_stands_on_you._Did_YOUR_PAPERDOLL_open?$(Skip_if_something_was_in_the_way.)
  set %st_obs double_click
  gosub st_human click_d_double_clicks_your_character
  if %st_again = 1
  {
    goto st_rp_c1
  }
  event macro 9 1
return

; ---- 5.04  move -------------------------------------------------------------------------------------------------------------
sub st_c_move
  gosub st_case 5.04 move
  if %st_run = 0
  {
    return
  }
  set %st_mx #charPosX
  set %st_my #charPosY
  move %st_mx %st_my 0 2s
  gosub st_eq move_to_the_current_tile_keeps_x #charPosX %st_mx
  gosub st_eq move_to_the_current_tile_keeps_y #charPosY %st_my
  set %st_m_ok 0
  gosub st_mv_try 2 0
  if %st_m_ok = 0
  {
    gosub st_mv_try -2 0
  }
  if %st_m_ok = 0
  {
    gosub st_mv_try 0 2
  }
  if %st_m_ok = 0
  {
    gosub st_mv_try 0 -2
  }
  if %st_m_ok = 1
  {
    gosub st_rec PASS AUTO move_walks_to_a_tile_two_steps_away now_at_ , #charPosX , _ , #charPosY
    move %st_mx %st_my 0 6s
  }
  else
  {
    gosub st_rec FAIL AUTO move_walks_to_a_tile_two_steps_away could_not_reach_any_neighbour_(blocked?)
  }
return

sub st_mv_try
  set %st_tx %st_mx + %1
  set %st_ty %st_my + %2
  move %st_tx %st_ty 0 6s
  if ( #charPosX = %st_tx ) && ( #charPosY = %st_ty )
  {
    set %st_m_ok 1
  }
return

; ---- 5.05  tile ----------------------------------------------------------------------------------------------------------------
sub st_c_tile
  gosub st_case 5.05 tile_init_cnt_get
  if %st_run = 0
  {
    return
  }
  tile init noOverrides
  tile cnt #charPosX #charPosY
  gosub st_vc tileCnt pos
  set %st_found 0
  set %st_n #tileCnt
  for %st_ti 1 %st_n
  {
    tile get #charPosX #charPosY %st_ti
    if #tileZ = #charPosZ
    {
      set %st_found 1
      set %st_tn #tileName
    }
  }
  if %st_found = 1
  {
    gosub st_rec PASS AUTO tile_layer_z_equals_your_charPosZ_(standing_on) %st_tn
  }
  else
  {
    gosub st_rec FAIL AUTO tile_layer_z_equals_your_charPosZ_(standing_on) no_layer_at_z_ , #charPosZ
  }
  gosub st_va tileType any
  gosub st_va tileZ any
  gosub st_va tileName any
  gosub st_va tileFlags any
return

; ---- 5.06  getUOTitle, uoXL swap, pixel commands, ignoreItem, hideItem ------------------------------------------------------
; ---- 5.07  onHotKey --------------------------------------------------------------------------------------------
sub st_c_hotkey
  gosub st_case 5.07 onHotKey
  if %st_run = 0
  {
    return
  }
  if %ST_UNATTENDED = 1
  {
    gosub st_skip onHotKey_F9 needs_a_person_to_press_the_key_(unattended_run)
    return
  }
  set %st_in Press_the_F9_key_within_10_seconds.$(The_script_listens_with_onHotKey,_so_the_UO_window_can_have_the_focus.)
  gosub st_pretty
  menu Set st_body %st_out
  set %st_hk 0
  set %st_w 0
  while %st_w < 200
  {
    onhotkey F9
      set %st_hk 1
    if %st_hk = 1
    {
      set %st_w 999
    }
    wait 1
    set %st_w %st_w + 1
  }
  if %st_hk = 1
  {
    gosub st_rec PASS AUTO onHotKey_F9_is_detected pressed
  }
  else
  {
    gosub st_rec FAIL AUTO onHotKey_F9_is_detected no_key_press_seen_in_10_seconds
  }
return

sub st_c_misc
  gosub st_case 5.06 getUOTitle_uoXL_savePix
  if %st_run = 0
  {
    return
  }
  getUOTitle
  gosub st_eq getUOTitle_returns_the_same_as_cliTitle #strRes #cliTitle
  set %st_n0 #cliNr
  uoXL swap
  gosub st_info uoXL_swap_slot_before_and_after %st_n0 , _ , #cliNr
  set %st_k 1
  while %st_k < #cliCnt
  {
    uoXL swap
    set %st_k %st_k + 1
  }
  gosub st_eq uoXL_swap_through_all_clients_returns_to_the_start #cliNr %st_n0
  savePix 5 5 1
  gosub st_vc pixCol any
  gosub st_skip savePix_cmpPix_semantics covered_by_tests/euo/all-commands-test.euo_(stage_8)
  gosub st_skip ignoreItem_ignoreCont covered_by_tests/euo/all-commands-test.euo_(stage_8)
  gosub st_skip hideItem covered_in_stage_4_(optional,_needs_ST_ITEM_ID)
  gosub st_skip terminate_uo_uoXL_new_shutdown never_run_by_this_tool
return
; ===========================================================================
