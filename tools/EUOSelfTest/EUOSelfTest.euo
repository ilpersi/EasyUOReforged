sub st_s_shop
  gosub st_case 6.01 getShopInfo_and_the_shop_variables
  if %st_run = 0
  {
    return
  }
  st_rp_38:
  if %st_logged = 0
  {
    gosub st_skip vendor_window no_logged_in_client
    return
