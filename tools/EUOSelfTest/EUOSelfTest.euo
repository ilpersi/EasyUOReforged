; status letters made known with staff commands, each put back at once
sub st_c417
  gosub st_case 4.17 Status_letters
  if %st_run = 0
    return
  if %st_staffok = 0
  {
    gosub st_skip 4.17 status_letters needs_staff_commands
    return
  }
  gosub st_flagtest 4.17.war Warmode G
  gosub st_flagtest 4.17.hidden Hidden H
  gosub st_flagtest 4.17.mobiles IgnoreMobiles E
  gosub st_flagtest 4.17.frozen Paralyzed A
  gosub st_flagtest 4.17.female Female B
  ; invulnerable: the yellow health bar sets D, and C too (it counts health-bar states)
  gosub st_flagtest 4.17.blessed Blessed D
return

; id property letter: sets the property to the other value, reads the letter, puts it back
sub st_flagtest
  set %st_f1 %1
  set %st_f2 %2
  set %st_f3 %3
  gosub st_sget %st_f2
  if %st_gok = 0
  {
    gosub st_skip %st_f1 %st_f2 the_shard_did_not_answer_the_get
    return
  }
  set %st_fold %st_gn
  set %st_fnew True
  set %st_fwant in
  if %st_fold = true
  {
    set %st_fnew False
    set %st_fwant notin
  }
  set %st_old %st_fold
  gosub st_cl_changed %st_f2 staffset
  gosub st_staff self set %st_f2 %st_fnew
  if %st_fwant = in
    waitfor %st_f3 in #CharStatus %st_tw3
  else
    waitfor %st_f3 notin #CharStatus %st_tw3
  set %st_a #CharStatus
  set %st_e %st_f3 , _ , %st_fwant
  if %st_fwant = in
    set %st_c %st_f3 in #CharStatus
  else
    set %st_c %st_f3 notin #CharStatus
  set %st_fw %st_f2 , _ , %st_fnew , _sets_letter_ , %st_f3 , _of_#CharStatus
  if %st_f2 = Blessed
  {
    ; ModernUO's Blessed setter sends only the health-bar update: D comes with the next flags update
    set %st_e %st_e , _(after_the_shard's_next_flags_update)
    gosub st_softok %st_f1 %st_fw %fx_statusc
  }
  else
    gosub st_ok %st_f1 %st_fw %fx_statusc
  if %st_f2 = Female
  {
    set %st_a #Sex
    set %st_e 1
    if %st_fnew = False
      set %st_e 0
    set %st_fid %st_f1 , .sex
    gosub st_soft %st_fid Sex_follows_Female_(when_the_shard_resends_the_status) %fx_stat
  }
  if %st_f2 = Blessed && %st_fnew = True
  {
    ; not poisoned, with a yellow bar: C is on too (see the #CharStatus page)
    set %st_a #CharStatus
    set %st_e C_(yellow_bar,_not_poisoned)
    set %st_c C in #CharStatus
    set %st_fid %st_f1 , .c
    gosub st_ok %st_fid C_comes_with_the_yellow_bar %fx_statusc
  }
  gosub st_cl_restore %st_f2
  if %st_fwant = in
    waitfor %st_f3 notin #CharStatus %st_tw3
  else
    waitfor %st_f3 in #CharStatus %st_tw3
  set %st_a #CharStatus
  if %st_fwant = in
    set %st_c %st_f3 notin #CharStatus
  else
    set %st_c %st_f3 in #CharStatus
  set %st_e back_as_it_was
  set %st_fid %st_f1 , .back
  gosub st_ok %st_fid the_letter_goes_back %fx_statusc
return

sub st_c418
  gosub st_case 4.18 Other_known_values
  if %st_run = 0
    return
  if %st_staffok = 0
  {
    gosub st_skip 4.18 known_values needs_staff_commands
    return
  }
  gosub st_knownprop 4.18.tp TithingPoints 1234 TP %fx_tp
  gosub st_knownprop 4.18.statcap StatCap 251 MaxStats %fx_ext
  gosub st_knownprop 4.18.maxfol FollowersMax 6 MaxFol %fx_ext
  ; Direction: East is 2
  gosub st_sget Direction
  set %st_old %st_gn
  gosub st_cl_changed Direction staffset
  ; #CharDir reads the client's own walk direction, so a turn by the shard does not change it
  ; (checked live on 7.0.117.33: the shard said East, #CharDir stayed 0); written down only
  gosub st_staff self set Direction East
  wait %st_tw1
  set %st_a #CharDir
  gosub st_info 4.18.dir CharDir_after_the_shard_turns_you_east_(not_followed:_walk_direction) %fx_dir
  gosub st_cl_restore Direction
return

; id property value variable fields: set, read #variable, put back
sub st_knownprop
  set %st_k1 %1
  set %st_k2 %2
  set %st_k3 %3
  set %st_k4 %4
  set %st_k5 %5
  gosub st_sget %st_k2
  if %st_gok = 0
  {
    gosub st_skip %st_k1 %st_k2 the_shard_did_not_answer_the_get
    return
  }
  set %st_old %st_gn
  gosub st_cl_changed %st_k2 staffset
  gosub st_staff self set %st_k2 %st_k3
  findjournal %st_sj * %st_tw3 Property_has_been_set
  wait 10
  set %st_a # . %st_k4
  set %st_e %st_k3
  set %st_kw %st_k2 , _ , %st_k3 , _reads_# , %st_k4 , _ , %st_k3
  gosub st_eq %st_k1 %st_kw %st_k5
  gosub st_cl_restore %st_k2
return

; ###########################################################################
;  STAGE 5  event hook: messages and gumps
; ###########################################################################
;  From here on, commands run client code through the event hook (code cave).
;  A wrong E_ value can freeze or crash the client: the report is written
;  before every check, so a crash loses at most that check.
sub st_s5
  gosub st_stage_begin 5 %st_sn5
  gosub st_hook_warn
  if %st_stop = 1
    return
  gosub st_setup_once
  gosub st_c501
  gosub st_c502
  gosub st_c503
  gosub st_c504
  gosub st_c505
  gosub st_c506
  gosub st_c507
  gosub st_c508
  gosub st_c509
  gosub st_c510
  gosub st_c511
  gosub st_c512
  gosub st_c513
  gosub st_c514
  gosub st_c515
  gosub st_c516
return

sub st_c501
  gosub st_case 5.01 event_SysMessage
  if %st_run = 0
    return
  set %st_col0 #SysMsgCol
  set #SysMsgCol 33
  gosub st_token
  set %st_j0 #JIndex
  event sysmessage %st_tok
  waitfor %st_tok in #SysMsg %st_tw3
  set %st_a #SysMsg
  set %st_c %st_tok in %st_a
  set %st_e contains_the_text_sent
  set %st_f %fx_sysm , / , %fx_sysmsg
  gosub st_ok 5.01.sysmsg event_SysMessage_shows_in_#SysMsg %st_f
  findjournal %st_j0 * %st_tw3 %st_tok
  set %st_a #JFound
  set %st_c #JFound > 0
  set %st_e found
  gosub st_ok 5.01.journal the_message_is_in_the_journal %fx_jour
  set %st_a #JColor
  set %st_e 33
  gosub st_soft 5.01.color its_#JColor_is_#SysMsgCol_33 %fx_jour
  set #SysMsgCol %st_col0
return

