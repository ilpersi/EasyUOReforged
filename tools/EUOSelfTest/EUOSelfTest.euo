sub st_c203
  gosub st_case 2.03 FindItem_on_the_worn_backpack
  if %st_run = 0
    return
  gosub st_need 1.06
  ; A: the client keeps worn items without showing them while the paperdoll is closed
  finditem #BackpackID A
  set %st_a #FindCnt
  set %st_e 1
  gosub st_eq 2.03.cnt finditem_#BackpackID_A_finds_it %fx_find
  set %st_a #FindID
  set %st_e #BackpackID
  gosub st_eq 2.03.id FindID_is_#BackpackID %fx_find
  set %st_a #FindKind
  set %st_e 0
