  set %st_a %st_jf
  set %st_c %st_jf > %st_j0
  set %st_e above_ , %st_j0
  gosub st_ok 4.05.found msg_text$_is_spoken_and_findjournal_finds_it %fx_jour
  set %st_a %st_jl
  set %st_c %st_tok in %st_jl
  set %st_e contains_the_spoken_token
  gosub st_ok 4.05.journal Journal_holds_the_line %fx_jour
  set %st_a #JIndex
  set %st_c #JIndex >= %st_jf
  set %st_e at_least_ , %st_jf
  gosub st_ok 4.05.jindex JIndex_moved_on %fx_jour
  if %st_jf > 0
  {
    scanjournal %st_jf
    set %st_a #Journal
    set %st_e %st_jl
    gosub st_eq 4.05.scan scanjournal_#JFound_reads_the_same_line %fx_jour
    set %st_a #JColor
    set %st_e %st_jc
    gosub st_eq 4.05.color both_give_the_same_#JColor %fx_jour
  }
return

; the findjournal rules (kept from the old self-test)
sub st_c406
  gosub st_case 4.06 findjournal_rules
  if %st_run = 0
    return
  gosub st_token
  set %st_jb #JIndex
  findjournal %st_jb * 0 %st_tok
  set %st_a #JFound
  set %st_e 0
  gosub st_eq 4.06.none findjournal_with_no_new_line_finds_nothing %fx_jour
  set %st_a #Journal
  set %st_e N/A
  gosub st_eqna 4.06.clear findjournal_with_no_match_clears_#Journal %fx_jour
  set %st_say %st_tok
  gosub st_pace
  msg %st_tok , $
  gosub st_token
  findjournal %st_jb * %st_tw3 %st_tok %st_tokp
  set %st_a #JFound
  set %st_c #JFound > %st_jb
  set %st_e above_ , %st_jb
  gosub st_ok 4.06.wait findjournal_waits_for_any_of_its_texts %fx_jour
  set %st_jc #JColor
  set %st_jf #JFound
  findjournal %st_jb %st_jc 0 %st_tokp
  set %st_a #JFound
  set %st_e %st_jf
  gosub st_eq 4.06.color findjournal_finds_the_line_by_its_own_colour %fx_jour
  set %st_jc2 %st_jc + 1
  findjournal %st_jb %st_jc2 0 %st_tokp
  set %st_a #JFound
  set %st_e 0
  gosub st_eq 4.06.other findjournal_does_not_find_it_in_another_colour %fx_jour
  findjournal %st_jf * 0 %st_tokp
  set %st_a #JFound
  set %st_e 0
  gosub st_eq 4.06.after findjournal_from_the_found_line_goes_on_after_it %fx_jour
  findjournal %st_jb * 0
  set %st_a #JFound
  set %st_e 0
  gosub st_eq 4.06.notext findjournal_with_no_text_finds_nothing %fx_jour
return

sub st_c407
  gosub st_case 4.07 deletejournal
  if %st_run = 0
    return
  gosub st_token
  set %st_j0 #JIndex
  set %st_say %st_tok
  gosub st_pace
  msg %st_tok , $
  findjournal %st_j0 * %st_tw3 %st_tok
  scanjournal 1
  set %st_a #Journal
  set %st_c %st_tok in %st_a
  set %st_e the_spoken_line
  gosub st_ok 4.07.before scanjournal_1_reads_the_new_line %fx_jour
  deletejournal
  scanjournal 1
  set %st_a #Journal
  set %st_e N/A
  gosub st_eqna 4.07.hidden after_deletejournal_the_line_reads_N/A %fx_jour
  findjournal 5 * 0 %st_tok
  set %st_a #JFound
  set %st_e 0
  gosub st_eq 4.07.find findjournal_does_not_search_hidden_lines %fx_jour
  gosub st_token
  set %st_j0 #JIndex
  set %st_say %st_tok
  gosub st_pace
  msg %st_tok , $
  findjournal %st_j0 * %st_tw3 %st_tok
  scanjournal 1
  set %st_a #Journal
  set %st_c %st_tok in %st_a
  set %st_e the_newer_line
  gosub st_ok 4.07.newer a_newer_line_is_read_again %fx_jour
return

sub st_c408
  gosub st_case 4.08 key_esc_and_the_target_cursor
  if %st_run = 0
    return
  if %st_staffok = 0
  {
    gosub st_skip 4.08 key_esc needs_staff_commands_to_raise_a_cursor_(stage_6_does_it_with_a_skill)
    return
  }
  gosub st_staff get Name
  target %st_tw3
  set %st_a #TargCurs
  set %st_e 1
  gosub st_eq 4.08.up a_staff_get_raises_the_target_cursor:_#TargCurs_1 %fx_targ
  key esc
  waitfor #TargCurs = 0 %st_tw2
  set %st_a #TargCurs
  set %st_e 0
  gosub st_eq 4.08.esc key_esc_cancels_it:_#TargCurs_0 %fx_targ
return

sub st_c409
  gosub st_case 4.09 key_with_alt_and_a_right_click
  if %st_run = 0
    return
  set %st_cn0 #ContName
  key j alt
  waitfor text in #ContName %st_tw2
  set %st_cn1 #ContName
  set %st_a %st_cn1
  if text notin %st_cn1
  {
    set %st_e a_journal_gump_(name_with_text)
    gosub st_note 4.09.altj key_j_alt_opened_no_journal_(Alt+J_not_bound_in_this_client?) %fx_cont
    return
  }
  set %st_e a_journal_gump
  gosub st_rec PASS AUTO 4.09.altj key_j_alt_opens_the_journal %fx_cont
  ; a right click in the middle of a gump closes it
  set %st_gx #ContPosX + #ContSizeX / 2
  set %st_gy #ContPosY + #ContSizeY / 2
  click %st_gx %st_gy r
  waitfor text notin #ContName %st_tw2
  set %st_a #ContName
  set %st_c text notin #ContName
  set %st_e not_the_journal
  gosub st_ok 4.09.rclick click_r_in_the_middle_closes_the_journal %fx_contpos
return

sub st_c410
  gosub st_case 4.10 Double-click_on_yourself
  if %st_run = 0
    return
  ; mounted, a double click on yourself dismounts you
  if #MountID <> N/A
  {
    gosub st_skip 4.10 double_click_on_yourself you_are_mounted
    return
  }
  ; a creature near you can take the double click: a big one's picture covers yours from two
  ; tiles away, and a mount is mounted (live on 7.0.117.33: a giant beetle)
  gosub st_mobile_near 3
  if %st_mobhere <> N/A
  {
    set %st_t creature_ , %st_mobhere , _is_within_3_tiles_of_you
    gosub st_skip 4.10 double_click_on_yourself %st_t
    return
  }
  set %st_cx #CliLeft + #CliXRes / 2
  set %st_cy #CliTop + #CliYRes / 2
  click %st_cx %st_cy d
  waitfor paperdoll in #ContName %st_tw3
  ; the click must not have mounted anything: undo it at once
  if #MountID <> N/A
  {
    set %st_a #MountID
    set %st_e N/A
    gosub st_note 4.10.mount the_double_click_mounted_a_creature_(dismounted_again) %fx_mount
    if %st_staffok = 1
    {
      gosub st_staff self dismount
      waitfor #MountID = N/A %st_tw5
    }
    else
    {
      set %st_line - , #spc , [NOTE]_4.10_you_are_mounted_now:_dismount_by_hand
      gosub st_emit
    }
    return
  }
  set %st_a #ContName
  if paperdoll notin %st_a
  {
    set %st_e a_paperdoll_gump
    gosub st_note 4.10.open no_paperdoll:_something_may_stand_on_you %fx_cont
    return
  }
  set %st_e a_paperdoll_gump
  gosub st_rec PASS AUTO 4.10.open click_d_on_your_character_opens_the_paperdoll %fx_cont
  set %st_gx #ContPosX + #ContSizeX / 2
  set %st_gy #ContPosY + #ContSizeY / 2
  click %st_gx %st_gy r
  waitfor paperdoll notin #ContName %st_tw2
  set %st_a #ContName
  set %st_c paperdoll notin %st_a
  set %st_e not_the_paperdoll
  gosub st_ok 4.10.close a_right_click_closes_it %fx_contpos
return

; what the shard says about you, against what EasyUO reads
sub st_c411
  gosub st_case 4.11 The_server's_values_against_the_client's
  if %st_run = 0
    return
  if %st_staffok = 0
  {
    gosub st_skip 4.11 server_values needs_staff_commands
    return
  }
  gosub st_sget Serial
  set %st_in %st_gn
  gosub st_hex
  set %st_srv %st_out
  set %st_in #CharID
  gosub st_id2ser
  set %st_a %st_ser
  set %st_e %st_srv
  gosub st_sval 4.11.serial CharID_is_your_serial %fx_char
  gosub st_sget Name
  str trim %st_gv %st_q
  set %st_e #StrRes
  set %st_a #CharName
  str replace %st_a #spc _
  set %st_a #StrRes
  gosub st_sval 4.11.name CharName_is_your_name %fx_name
  gosub st_sget Backpack
  set %st_in %st_gn
  gosub st_hex
  set %st_srv %st_out
  set %st_in #BackpackID
  gosub st_id2ser
  set %st_a %st_ser
  set %st_e %st_srv
  gosub st_sval 4.11.backpack BackpackID_is_your_backpack %fx_bp
  gosub st_sget Body
  set %st_in %st_gn
  gosub st_hex
  set %st_in %st_out
  gosub st_num2id
  set %st_a #CharType
  set %st_e %st_out
  gosub st_sval 4.11.body CharType_is_your_body %fx_type
  gosub st_sget X
  set %st_a #CharPosX
  set %st_e %st_gn
  gosub st_sval 4.11.x CharPosX_is_your_X %fx_pos
  gosub st_sget Y
  set %st_a #CharPosY
  set %st_e %st_gn
  gosub st_sval 4.11.y CharPosY_is_your_Y %fx_pos
  gosub st_sget Z
  set %st_a #CharPosZ
  set %st_e %st_gn
  gosub st_sval 4.11.z CharPosZ_is_your_Z %fx_pos
  gosub st_sget Direction
  gosub st_dirnum
  set %st_a #CharDir
  set %st_e %st_dn
  gosub st_sval 4.11.dir CharDir_is_your_direction %fx_dir
  gosub st_sget Female
  set %st_e 0
  if %st_gn = true
    set %st_e 1
  set %st_a #Sex
  gosub st_sval 4.11.sex Sex_is_0_male_1_female %fx_stat
  gosub st_sget Map
  set %st_e N/A
  if %st_gn = Felucca
    set %st_e 0
  if %st_gn = Trammel
    set %st_e 1
  if %st_gn = Ilshenar
    set %st_e 2
  if %st_gn = Malas
    set %st_e 3
  if %st_gn = Tokuno
    set %st_e 4
  if %st_gn = TerMur
    set %st_e 5
  set %st_a #CursKind
  gosub st_sval 4.11.facet CursKind_is_your_facet %fx_facet
  gosub st_sget TotalGold
  set %st_a #Gold
  set %st_e %st_gn
  gosub st_sval 4.11.gold Gold_is_the_gold_you_carry %fx_stat
  ; the status packet sends the body weight plus TotalWeight (ModernUO: BodyWeight + TotalWeight)
  gosub st_sget TotalWeight
  set %st_a #Weight - %st_gn
  set %st_lo 0
  set %st_hi 20
  if %st_gok = 1
    gosub st_rng 4.11.weight Weight_is_TotalWeight_plus_a_body_weight_of_0_to_20 %fx_wt
  else
    gosub st_skip 4.11.weight Weight the_shard_did_not_answer_the_get
  gosub st_sget Followers
  set %st_a #Followers
  set %st_e %st_gn
  gosub st_sval 4.11.followers Followers %fx_ext
  gosub st_sget FollowersMax
  set %st_a #MaxFol
  set %st_e %st_gn
  gosub st_sval 4.11.maxfol MaxFol %fx_ext
  gosub st_sget StatCap
  set %st_a #MaxStats
  set %st_e %st_gn
  gosub st_sval 4.11.statcap MaxStats_is_your_stat_cap %fx_ext
  gosub st_sget TithingPoints
  set %st_a #TP
  set %st_e %st_gn
  ; the client gets the tithing points only with a full status: live on client_beta 7.0.117.31 it
  ; read 0 for a whole run (and the right value in the run before). 4.18.tp checks the field with
  ; a value the shard sends at once
  if %st_gok = 1 && #TP = 0 && %st_gn <> 0
  {
    set %st_e %st_gn , _(no_full_status_since_login:_4.18.tp_checks_the_field)
    gosub st_note 4.11.tp TP_is_your_tithing_points %fx_tp
  }
  else
    gosub st_sval 4.11.tp TP_is_your_tithing_points %fx_tp
  ; no Luck here: a player has no Luck property ("Property 'Luck' not found."); 6.14 checks it
  gosub st_sget PhysicalResistance
  set %st_a #AR
  set %st_e %st_gn
  gosub st_sval 4.11.ar AR_is_your_physical_resistance %fx_ar
  gosub st_sget FireResistance
  set %st_a #FR
  set %st_e %st_gn
  gosub st_sval 4.11.fr FR %fx_ext
  gosub st_sget ColdResistance
  set %st_a #CR
  set %st_e %st_gn
  gosub st_sval 4.11.cr CR %fx_ext
  gosub st_sget PoisonResistance
  set %st_a #PR
  set %st_e %st_gn
  gosub st_sval 4.11.pr PR %fx_ext
  gosub st_sget EnergyResistance
  set %st_a #ER
  set %st_e %st_gn
  gosub st_sval 4.11.er ER %fx_ext
  gosub st_sget HitsMax
  set %st_a #MaxHits
  set %st_e %st_gn
  gosub st_sval 4.11.maxhits MaxHits %fx_stat
  gosub st_sget StamMax
  set %st_a #MaxStam
  set %st_e %st_gn
  gosub st_sval 4.11.maxstam MaxStam %fx_stat
  gosub st_sget ManaMax
  set %st_a #MaxMana
  set %st_e %st_gn
  gosub st_sval 4.11.maxmana MaxMana %fx_stat
return

; records a comparison with a server value: SKIP when the shard did not answer
sub st_sval
  set %st_v1 %1
  set %st_v2 %2
  set %st_v3 %3
  if %st_gok = 0
  {
    gosub st_skip %st_v1 %st_v2 the_shard_did_not_answer_the_get
    return
  }
  gosub st_eq %st_v1 %st_v2 %st_v3
return

sub st_c412
  gosub st_case 4.12 Known_stats:_Str_77,_Dex_63,_Int_41
  if %st_run = 0
    return
  if %st_staffok = 0
  {
    gosub st_skip 4.12 known_stats needs_staff_commands
    return
  }
  gosub st_sget Str
  set %st_old %st_gn
  gosub st_cl_changed Str staffset
  gosub st_sget Dex
  set %st_old %st_gn
  gosub st_cl_changed Dex staffset
  gosub st_sget Int
  set %st_old %st_gn
  gosub st_cl_changed Int staffset
  ; odd values; one the character already has proves nothing, so it moves down by 2
  set %st_ks 77
  set %st_kd 63
  set %st_ki 41
  if #Str = %st_ks
    set %st_ks %st_ks - 2
  if #Dex = %st_kd
    set %st_kd %st_kd - 2
  if #Int = %st_ki
    set %st_ki %st_ki - 2
  gosub st_staff self set Str %st_ks Dex %st_kd Int %st_ki
  waitfor #Str = %st_ks && #Dex = %st_kd && #Int = %st_ki %st_tw5
  set %st_a #Str
  set %st_e %st_ks
  gosub st_eq 4.12.str Str_reads_the_value_set %fx_stat
  set %st_a #Dex
  set %st_e %st_kd
  gosub st_eq 4.12.dex Dex_reads_the_value_set %fx_stat
  set %st_a #Int
  set %st_e %st_ki
  gosub st_eq 4.12.int Int_reads_the_value_set %fx_stat
  ; 3.5 x Str, plus 40 or (a human after Mondain's Legacy) 100
  set %st_t %st_ks * 7 / 2
  set %st_t1 %st_t + 40
  set %st_t2 %st_t + 100
  set %st_a #MaxWeight
  set %st_c ( %st_a = %st_t1 ) || ( %st_a = %st_t2 )
  set %st_e %st_t1 , _or_ , %st_t2
  gosub st_ok 4.12.maxweight MaxWeight_follows_Str %fx_stat
  gosub st_sget HitsMax
  set %st_a #MaxHits
  set %st_e %st_gn
  gosub st_sval 4.12.maxhits MaxHits_after_the_change %fx_stat
  gosub st_sget StamMax
  set %st_a #MaxStam
  set %st_e %st_gn
  gosub st_sval 4.12.maxstam MaxStam_after_the_change %fx_stat
  gosub st_sget ManaMax
  set %st_a #MaxMana
  set %st_e %st_gn
  gosub st_sval 4.12.maxmana MaxMana_after_the_change %fx_stat
return

sub st_c413
  gosub st_case 4.13 Known_hits,_stamina_and_mana
  if %st_run = 0
    return
  if %st_staffok = 0
  {
    gosub st_skip 4.13 known_hits needs_staff_commands
    return
  }
  ; values below every maximum the stats of 4.12 give (88 hits, 63 stamina, 41 mana)
  gosub st_staff self set Hits 37 Stam 29 Mana 23
  waitfor #Hits = 37 && #Stamina = 29 && #Mana = 23 %st_tw5
  set %st_a #Hits
  set %st_e 37
  gosub st_eq 4.13.hits Hits_reads_37 %fx_stat
  set %st_a #Stamina
  set %st_e 29
  gosub st_eq 4.13.stam Stamina_reads_29 %fx_stat
  set %st_a #Mana
  set %st_e 23
  gosub st_eq 4.13.mana Mana_reads_23 %fx_stat
  ; back to full (the cleanup puts the stats themselves back)
  set %st_t1 #MaxHits
  set %st_t2 #MaxStam
  set %st_t3 #MaxMana
  gosub st_staff self set Hits %st_t1 Stam %st_t2 Mana %st_t3
  waitfor #Hits = %st_t1 %st_tw3
return

sub st_c414
  gosub st_case 4.14 Gold:_exactly_1234_more
  if %st_run = 0
    return
  if %st_staffok = 0
  {
    gosub st_skip 4.14 gold needs_staff_commands
    return
  }
  set %st_g0 #Gold
  gosub st_newitem_begin POF
  gosub st_staff self addtopack Gold 1234
  set %st_g1 %st_g0 + 1234
  waitfor #Gold = %st_g1 %st_tw5
  gosub st_newitem_end Gold
  set %st_a #Gold
  set %st_e %st_g1
  gosub st_eq 4.14.gold Gold_grows_by_exactly_1234 %fx_stat
  gosub st_sget TotalGold
  set %st_a #Gold
  set %st_e %st_gn
  gosub st_sval 4.14.server Gold_is_the_shard's_TotalGold %fx_stat
  if %st_newid = N/A
  {
    gosub st_skip 4.14.pile the_new_gold_pile finditem_saw_no_new_pile
    return
  }
  set %st_goldid %st_newid
  finditem %st_goldid CA_ , #BackpackID
  set %st_a #FindStack
  set %st_e 1234
  gosub st_eq 4.14.stack FindStack_of_the_new_pile_is_1234 %fx_stack
  set %st_a #FindBagID
  set %st_e #BackpackID
  gosub st_eq 4.14.bag FindBagID_of_the_new_pile_is_the_backpack %fx_find
return

sub st_c415
  gosub st_case 4.15 Weight:_exactly_10_stones_more
  if %st_run = 0
    return
  if %st_staffok = 0
  {
    gosub st_skip 4.15 weight needs_staff_commands
    return
  }
  ; 5 logs of 2 stones each
  gosub st_sget TotalWeight
  set %st_tw0 %st_gn
  set %st_w0 #Weight
  set %st_in 7133
  gosub st_num2id
  set %st_logtype %st_out
  gosub st_newitem_begin %st_logtype
  gosub st_staff self addtopack Log 5
  set %st_w1 %st_w0 + 10
  waitfor #Weight = %st_w1 %st_tw5
  gosub st_newitem_end Logs
  set %st_a #Weight
  set %st_e %st_w1
  gosub st_eq 4.15.weight Weight_grows_by_10_for_5_logs %fx_wt
  gosub st_sget TotalWeight
  set %st_a #Weight - %st_gn
  set %st_e %st_w0 - %st_tw0
  gosub st_sval 4.15.server the_shard's_TotalWeight_grows_by_the_same_10 %fx_wt
  if %st_newid <> N/A
  {
    finditem %st_newid CA_ , #BackpackID
    set %st_a #FindType
    set %st_e %st_logtype
    gosub st_eq 4.15.type FindType_of_the_logs_is_graphic_0x1BDD %fx_find
    set %st_a #FindStack
    set %st_e 5
    gosub st_eq 4.15.stack FindStack_of_the_logs_is_5 %fx_stack
  }
return

sub st_c416
  gosub st_case 4.16 Known_skill:_Anatomy_47
  if %st_run = 0
    return
  if %st_staffok = 0
  {
    gosub st_skip 4.16 known_skill needs_staff_commands
    return
  }
  gosub st_sget Skills.Anatomy.Base
  set %st_old %st_gn
  gosub st_cl_changed Skills.Anatomy.Base staffset
  gosub st_staff self set Skills.Anatomy.Base 47
  chooseskill anat real
  waitfor #Skill = 470 %st_tw5
  set %st_a #Skill
  set %st_e 470
  gosub st_eq 4.16.base chooseskill_anat_real_reads_470 %fx_skill
  gosub st_sget Skills.Anatomy.Value
  set %st_in %st_gn
  gosub st_tenths
  chooseskill anat
  set %st_a #Skill
  set %st_e %st_out
  gosub st_sval 4.16.value chooseskill_anat_reads_the_value_with_bonuses %fx_skillb
  gosub st_sget Skills.Anatomy.Cap
  set %st_in %st_gn
  gosub st_tenths
  set %st_a #SkillCap
  set %st_e %st_out
  gosub st_sval 4.16.cap SkillCap_is_the_shard's_cap %fx_skcap
  gosub st_sget Skills.Anatomy.Lock
  set %st_a #SkillLock
  set %st_e %st_gn
  gosub st_sval 4.16.lock SkillLock_is_the_shard's_lock %fx_sklock
