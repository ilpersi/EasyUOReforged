; ============================================================================
;  EUO SelfTest - client regression test of EasyUO Reforged
; ============================================================================
;  WHAT IT IS FOR
;    A new UO client is out and uo\uoclidata.pas needs its values. Run this
;    script against the new client: it tells you which commands and
;    #variables no longer work, and which table fields are the likely cause.
;    Every check makes a value known first (a staff command, a write, an
;    action) and compares what EasyUO reads with what it must be, or reads
;    one fact from two independent places. It asks you only about what no
;    variable can show: an animation, a text over a head, a colour.
;
;  HOW TO RUN
;    1. Log a character in. A GM/admin character on your own shard lets the
;       script set up everything itself with staff commands; any character
;       works, the script then asks you to prepare things or skips them.
;    2. Open this file in EasyUO Reforged and press Play. The window lists
;       the stages: tick the ones to run and press Run selected.
;    3. While it runs, a small panel shows the check, the progress and the
;       counts, and asks the questions. Stop ends the run, cleans up what the
;       script created or changed, and still writes the report.
;
;  SAVED DATA
;    EUOSelfTest.db (SQLite) next to EasyUOReforged.exe: the options, the
;    runs, and everything a run created or changed, written the moment it
;    happens, so the next run can clean up after a crash.
;
;  REPORT
;    selftest-<ReforgedVer>-<client>-<date>-<time>.md in the report folder,
;    one line per check:
;    - [PASS|FAIL|NOTE|SKIP|INFO]_id_what_[AUTO|HUMAN]_observed=.._expected=.._fields=..
;    Underscores stand for spaces. fields = the uoclidata.pas fields the
;    check depends on. Check IDs are stable: a new check gets a new ID and a
;    removed one is never reused, so two reports line up. The report ends
;    with a summary by table field: the list of what to fix.
;
;  NEVER RUN BY THIS SCRIPT
;    event macro 20 (quit game), anything that logs out, closes or starts a
;    client, shutdown, terminate, uoXL new, send.
;
;  EASYUO QUIRKS THIS FILE RESPECTS
;    - a variable is only replaced when it is a word of its own; glue with ,
;    - a value with spaces is built with  , #spc ,
;    - gosub parameters are words, not expressions; every sub copies %1..%n
;      first, because the next gosub overwrites them
;    - if bodies are { } blocks; for counts down when start > end, so every
;      for over a count is guarded
;    - every check sub takes exactly three words: id what fields, and reads
;      %st_a (what was observed) and %st_e (what was expected)
;    - all subs live below the final halt; every tool variable starts with st_
;    - the MENU 1.6 logic (menu Reforge Mode 1.6): the progress bars need
;      menu SetProp, so no 1.5-only menu line is used
; ============================================================================
menu Reforge Mode 1.6
; this file's revision, in the report header: raise it with every change, so a report shows which copy ran
set %st_rev 2026.11.14.21

; ---------------------------------------------------------------------------
;  DEVELOPER SWITCHES (no game values here: the script finds or asks for them)
; ---------------------------------------------------------------------------
set %ST_UNATTENDED 0
; 1 = dry run: no windows, every HUMAN check is answered SKIP, :memory: database
set %ST_SIM_REPEAT 0
; 1 (with ST_UNATTENDED 1) = answer every HUMAN check Repeat once, then Pass
set %ST_REPORT 1
; 0 = no report file (every line still goes to the Output panel with log)
set %ST_NOSTOP 0
; 1 = go on after stage 1 fails (to walk every stage in a dry run without a client)
set %ST_FAST 0
; 1 = every wait and timeout is 0 (dry runs without a client)
set %ST_STAGES 111111110000
; the stages an unattended run runs, one digit per stage, stage 1 first
set %ST_ONE_CHECK N/A
; an unattended run of one check only (its ID, such as 4.12); N/A = all checks of ST_STAGES

; ---------------------------------------------------------------------------
;  MAIN
; ---------------------------------------------------------------------------
gosub st_init
gosub st_db_open
gosub st_opts_load
if %ST_UNATTENDED = 1
{
  set %st_sel %ST_STAGES
  set %st_from 1
  set %st_only %ST_ONE_CHECK
  gosub st_run
  gosub st_quit
  halt
}
gosub st_startup
set %st_quitnow 0
repeat
  gosub st_mw_show
  gosub st_mw_wait
until %st_quitnow = 1
; the menu window stays when a script stops: Quit would look like it did nothing
menu Hide
gosub st_quit
halt

; ###########################################################################
;  SET-UP
; ###########################################################################
sub st_init
  set %st_lpc_orig #LPC
  set #LPC 1000
  set %st_alpha ABCDEFGHIJKLMNOPQRSTUVWXYZ
  set %st_q "
  ; timeouts in ticks (20 = 1 s)
  set %st_tw1 20
  set %st_tw2 40
  set %st_tw3 60
  set %st_tw5 100
  set %st_tw8 160
  set %st_tw10 200
  set %st_tw15 300
  set %st_tw30 600
  if %ST_FAST = 1
  {
    set %st_tw1 0
    set %st_tw2 0
    set %st_tw3 0
    set %st_tw5 0
    set %st_tw8 0
    set %st_tw10 0
    set %st_tw15 0
    set %st_tw30 0
  }
  ; the stages: name, what they need or change, number of checks
  set %st_nstages 12
  set %st_sn1 Identity_and_attach
  set %st_sn2 Read-only_variables
  set %st_sn3 Memory_writes
  set %st_sn4 Keys,_clicks,_msg_and_staff_setup
  set %st_sn5 Event_hook:_messages_and_gumps
  set %st_sn6 Event_hook:_targeting_and_items
  set %st_sn7 Event_hook:_skills,_spells,_macros
  set %st_sn8 Event_hook:_movement
  set %st_sn9 Combat
  set %st_sn10 Vendor
  set %st_sn11 Pets_and_mount
  set %st_sn12 Buffs
  set %st_tg1 reads_only
  set %st_tg2 reads_only
  set %st_tg3 writes_client_memory
  set %st_tg4 keys+mouse,_staff
  set %st_tg5 event_hook
  set %st_tg6 event_hook,_staff
  set %st_tg7 event_hook,_staff
  set %st_tg8 event_hook,_walks
  set %st_tg9 event_hook,_staff,_ATTACKS
  set %st_tg10 event_hook,_staff
  set %st_tg11 event_hook,_staff
  set %st_tg12 event_hook,_staff
  ; checks per stage (st_case count): the progress bar total is known before a run starts.
  ; A dry run (ST_UNATTENDED 1, ST_NOSTOP 1) logs a line when a count here is out of date.
  gosub st_counts
  ; table-field groups (separator /, shown as , in the report)
  set %fx_logged C_CLILOGGED
  set %fx_char C_CHARPTR/B_ITEMID
  set %fx_pos C_CHARPTR/B_POS
  set %fx_name C_CHARPTR/B_ITEMID/B_STATNAME
  set %fx_stat C_CHARPTR/B_ITEMID/B_STATNAME
  set %fx_ext C_CHARPTR/B_ITEMID/B_STATNAME/B_STATML/F_EXTSTAT
  set %fx_luck C_CHARPTR/B_ITEMID/B_STATNAME/B_STATML/B_STAT1/F_EXTSTAT
  set %fx_wt C_CHARPTR/B_ITEMID/B_STATNAME/B_STATWEIGHT
  set %fx_ar C_CHARPTR/B_ITEMID/B_STATNAME/B_STATAR/B_STATML
  set %fx_tp C_NEXTCPOS/B_TITHE/F_EXTSTAT
  set %fx_bp C_CHARPTR/B_ITEMID/B_ITEMTYPE/B_ITEMSLOT
  set %fx_type C_CHARPTR/B_ITEMTYPE
  set %fx_status C_CHARPTR/B_ITEMID/B_CHARSTATUS
  set %fx_statusc C_CHARPTR/B_ITEMID/B_CHARSTATUS/F_EXCHARSTATC
  set %fx_dir C_CHARDIR
  set %fx_shard C_SHARDPOS
  set %fx_lang C_LHANDID/B_LANG
  set %fx_xres C_CLIXRES
  set %fx_left C_CLILEFT
  set %fx_top C_CLILEFT/B_CLITOP
  set %fx_facet C_CURSORKIND
  set %fx_lshard C_LSHARD
  set %fx_find C_CHARPTR/B_ITEMID/B_ITEMTYPE/B_POS
  set %fx_findc C_CHARPTR/B_ITEMID/B_ITEMTYPE/B_POS/B_GUMPPTR/B_CONTX
  set %fx_stack C_CHARPTR/B_ITEMID/B_ITEMSTACK
  set %fx_col C_CHARPTR/B_ITEMID/B_ITEMSTACK
  set %fx_rep C_CHARPTR/B_ITEMID/B_FINDREP
  set %fx_layer C_CHARPTR/B_ITEMID/B_CHARSTATUS
  set %fx_cont C_CONTPOS/B_CONTNEXT
  set %fx_contsz C_CONTPOS/B_CONTNEXT/B_CONTSIZEX
  set %fx_contpos C_CONTPOS/B_CONTNEXT/B_CONTX
  set %fx_contid C_CONTPOS/B_CONTNEXT/B_CONTITEM/B_ITEMID
  set %fx_conttype C_CONTPOS/B_CONTNEXT/B_CONTITEM/B_ITEMTYPE
  set %fx_nextc C_NEXTCPOS/B_NEXTCX
  set %fx_skill C_SKILLSPOS
  set %fx_skillb C_SKILLSPOS/B_SKILLDIST
  set %fx_skcap C_SKILLCAPS
  set %fx_sklock C_SKILLLOCK
  set %fx_jour C_JOURNALPTR/F_JOURNALDIRECT/B_JCOL/B_JKIND/B_JNEXTPTR
  set %fx_sysmsg C_SYSMSG/B_SYSMSGSTR/F_SYSMSGDIRECT
  set %fx_lobj C_LHANDID
  set %fx_lobjt C_LHANDID/C_CHARPTR/B_ITEMID/B_ITEMTYPE
  set %fx_ltid C_LHANDID/B_LTARGID
  set %fx_ltkind C_LHANDID/B_LTARGKIND
  set %fx_ltxyz C_LHANDID/B_LTARGX
  set %fx_lttile C_LHANDID/B_LTARGTILE
  set %fx_lspell C_LHANDID/B_LSPELL
  set %fx_lskill C_LHANDID/B_LSKILL
  set %fx_lhand C_LHANDID/B_LHAND
  set %fx_rhand C_LHANDID/B_RHAND
  set %fx_lift C_LLIFTEDID
  set %fx_liftt C_LLIFTEDID/B_LLIFTEDTYPE
  set %fx_liftk C_LLIFTEDID/B_LLIFTEDKIND
  set %fx_enemy C_ENEMYID
  set %fx_enemyhp C_ENEMYHITS/B_ENEMYHPVAL
  set %fx_targ C_TARGETCURS
  set %fx_targw C_TARGETCURS/B_TARGPROC/C_LHANDID/B_LTARGID/B_LTARGKIND/B_ITEMID
  set %fx_mount C_CHARPTR/B_ITEMID/B_ITEMTYPE/B_CHARSTATUS/B_POS
  set %fx_tile F_FLAGS
  set %fx_pathc C_CHARPTR/B_POS/B_ITEMTYPE/F_FLAGS/C_MULTILIST/B_MULTINEXT/C_WORLDGRID/B_GRIDNEXT/B_GRIDSIZE/C_STATICVT/B_MULTIOWNER
  set %fx_house C_MULTILIST/B_MULTINEXT/C_WORLDGRID/B_GRIDNEXT/B_GRIDSIZE/C_STATICVT/B_MULTIOWNER
  set %fx_hook E_REDIR/E_OLDDIR
  set %fx_macro E_REDIR/E_OLDDIR/E_MACROADDR/E_MACROTAB/F_MACROMAP
  set %fx_send E_REDIR/E_OLDDIR/E_SENDPACKET/E_SENDLEN/E_SENDECX/F_SENDTHISCALL
  set %fx_sysm E_REDIR/E_OLDDIR/E_SYSMSGADDR/E_NEWOBJ/E_MSGGATE/E_MSGFLAGA/E_MSGFLAGB
  set %fx_exmsg E_REDIR/E_OLDDIR/E_EXMSGADDR/E_NEWOBJ/E_MSGGATE/E_MSGFLAGA/E_MSGFLAGB/C_CHARPTR/B_ITEMID
  set %fx_prop E_REDIR/E_OLDDIR/E_ITEMPROPID/E_ITEMNAMEADDR/E_ITEMPROPADDR/E_ITEMCHECKADDR/E_ITEMREQADDR/F_EVPROPERTY/F_PROPFAST/B_PROPFLAG
  set %fx_pf E_REDIR/E_OLDDIR/E_PATHFINDADDR/E_PATHFINDMID/F_PATHFINDVER/B_PATHPROLOGUE/B_POS
  set %fx_drag E_REDIR/E_OLDDIR/E_DRAGADDR/F_DRAGFASTCALL/C_CHARPTR/B_ITEMID/B_ITEMSTACK
  set %fx_conttop E_REDIR/E_OLDDIR/E_CONTTOP
  set %fx_statbar E_REDIR/E_OLDDIR/E_STATBAR/C_CHARPTR/B_ITEMID
  set %fx_step E_REDIR/E_OLDDIR/C_BLOCKINFO/F_BLOCKINFOFAST
  set %fx_drop E_REDIR/E_OLDDIR/E_SENDPACKET/E_SENDLEN/E_SENDECX/F_SENDTHISCALL/B_PACKETVER
  set %fx_xdrag E_REDIR/E_OLDDIR/E_SENDPACKET/E_SENDLEN/E_SENDECX/F_SENDTHISCALL/C_CHARPTR/B_ITEMID/B_ITEMTYPE
  set %fx_popup E_REDIR/E_OLDDIR/E_SENDPACKET/E_SENDLEN/E_SENDECX/F_SENDTHISCALL/C_POPUPID/C_CHARPTR/B_ITEMID
  set %fx_xsklock E_REDIR/E_OLDDIR/E_SENDPACKET/E_SENDLEN/E_SENDECX/F_SENDTHISCALL/C_SKILLLOCK
  set %fx_shop C_CONTPOS/B_CONTNEXT/B_SHOPCURRENT/B_SHOPNEXT/B_SHOPPRICE/B_ITEMID/B_ITEMTYPE/B_ITEMSTACK
  set %fx_bill C_CONTPOS/B_CONTNEXT/B_BILLFIRST
  set %fx_buff C_CONTPOS/B_CONTNEXT/B_BUFFVEC/B_BUFFSIZE
  set %fx_buffname C_CLILOC/B_STLHEAD/B_CLILOCKEY/B_BUFFVEC/B_BUFFSIZE
  set %fx_bufftime C_BUFFTIMERS/B_STLHEAD/B_BUFFVEC/B_BUFFSIZE
  set %fx_hide C_CHARPTR/B_ITEMID/B_POS
  ; run state
  set %st_db 0
  set %st_runid 0
  set %st_only N/A
  set %st_staffok 0
  set %st_tokn 0
  set %st_tokb #SysTime % 9000 + 1000
  ; speech pacing (st_pace): how fast the client's spam meter really drains, in characters a second.
  ; Its SpamLimit option says 30, but the drain runs in the game tick (76 ms or more) and rounds down:
  ; 20 to 26 on client.exe 7.0.117.33, 13 or less on client_beta 7.0.117.31, where two tick functions
  ; drain it on their own timers. The pace slows down by itself if the client still queues a line
  set %st_prate 12
  set %st_pmax 10
  set %st_spamhits 0
  set %st_pm 0
  set %st_plast #SCnt2
  set %st_naok 0
  set %st_cln 0
  set %st_hookwarned 0
  set %st_handswarned 0
  set %st_lastsum
  set %st_forgot
  set %st_dbmsg
  set %st_have 0
  set %st_logged 0
  if #CliNr > 0
  {
    set %st_have 1
    if #CliLogged = 1
      set %st_logged 1
  }
  ; the default IgnoreCont list (stage 5 puts it back after testing ignorecont reset)
  set %st_defign BARK_GUMP/DAMAGENUMBERS_GUMP/DUMB_GUMP/GAMEAREAEDGEGUMP/MAP_GUMP/MENUBAR/MISSILE_GUMP/NEW_ITEM_PROP_GUMP/RETICLE_GUMP/TARGET_GUMP/UNICODE_BARK_GUMP
return

; ---- checks per stage (one per st_case line; see the README for the list) ----
sub st_counts
  set %st_cnt1 7
  set %st_cnt2 16
  set %st_cnt3 9
  set %st_cnt4 18
  set %st_cnt5 16
  set %st_cnt6 18
  set %st_cnt7 15
  set %st_cnt8 6
  set %st_cnt9 3
  set %st_cnt10 3
  set %st_cnt11 5
  set %st_cnt12 5
return

; ###########################################################################
;  SAVED DATA (SQL)
; ###########################################################################
sub st_db_open
  set %st_db 0
  set %st_dbmsg
  if %ST_UNATTENDED = 1
    sql open :memory:
  else
    sql open EUOSelfTest.db
  if #SqlRes <> OK
  {
    set %st_dbmsg No_saved_data:_sql_open_answered_ , #SqlRes , ._Options_are_asked_each_time,_no_resume,_no_clean-up_after_a_crash.
    log %st_dbmsg
    return
  }
  sql exec CREATE TABLE IF NOT EXISTS shards(shard TEXT PRIMARY KEY, staff INTEGER, prefix TEXT, x INTEGER, y INTEGER, z INTEGER, facet INTEGER)
  sql exec CREATE TABLE IF NOT EXISTS runs(id INTEGER PRIMARY KEY, started INTEGER, shard TEXT, charid TEXT, cliver TEXT, stages TEXT, last_stage INTEGER, state TEXT)
  sql exec CREATE TABLE IF NOT EXISTS cleanup(run INTEGER, kind TEXT, target TEXT, detail TEXT, old_value TEXT, done INTEGER)
  if #SqlRes <> OK
  {
    set %st_dbmsg No_saved_data:_ , #SqlRes
    log %st_dbmsg
    return
  }
  set %st_db 1
return

; ---- options: defaults, then what is saved --------------------------------
sub st_opts_load
  set %st_opt_panelx 1200
  set %st_opt_panely 60
  set %st_opt_rptdir #CurPath
  set %st_opt_stages 111111110000
  set %st_opt_combat 0
  set %st_opt_vendor 0
  set %st_opt_pets 0
  set %st_opt_buffs 0
  set %st_opt_saved 0
  set %st_opt_forgot
  if %st_db = 1
  {
    sql load %st_opt_forgot
    sql load %st_opt_panelx %st_opt_panely %st_opt_rptdir %st_opt_stages %st_opt_combat %st_opt_vendor %st_opt_pets %st_opt_buffs
    if #SqlChanges > 0
      set %st_opt_saved 1
  }
  gosub st_shard_load
return

; shard options: one row per #Shard
sub st_shard_load
  set %st_shard #Shard
  if %st_shard = N/A
    set %st_shard none
  set %st_opt_staff 0
  set %st_opt_pfx [
  set %st_opt_x N/A
  set %st_opt_y N/A
  set %st_opt_z N/A
  set %st_opt_facet N/A
  set %st_opt_shardsaved 0
  if %st_db = 1
  {
    sql query SELECT staff AS st_q_staff, prefix AS st_q_pfx, x AS st_q_x, y AS st_q_y, z AS st_q_z, facet AS st_q_f FROM shards WHERE shard = %st_shard
    if #SqlCnt > 0
    {
      set %st_opt_staff %st_q_staff
      set %st_opt_pfx %st_q_pfx
      set %st_opt_x %st_q_x
      set %st_opt_y %st_q_y
      set %st_opt_z %st_q_z
      set %st_opt_facet %st_q_f
      set %st_opt_shardsaved 1
    }
  }
return

sub st_opts_save
  if %st_db = 0
    return
  sql save %st_opt_panelx %st_opt_panely %st_opt_rptdir %st_opt_stages %st_opt_combat %st_opt_vendor %st_opt_pets %st_opt_buffs
  sql exec INSERT OR REPLACE INTO shards(shard, staff, prefix, x, y, z, facet) VALUES(%st_shard, %st_opt_staff, %st_opt_pfx, %st_opt_x, %st_opt_y, %st_opt_z, %st_opt_facet)
  set %st_opt_saved 1
  set %st_opt_shardsaved 1
return

; Reset options: the option rows go; cleanup rows that are not done stay
sub st_opts_reset
  if %st_db = 1
  {
    sql delete %st_opt_panelx %st_opt_panely %st_opt_rptdir %st_opt_stages %st_opt_combat %st_opt_vendor %st_opt_pets %st_opt_buffs
    sql exec DELETE FROM shards
  }
  gosub st_opts_load
return

; ###########################################################################
;  THE RUN
; ###########################################################################
;  in: %st_sel (one digit per stage), %st_from (first stage), %st_only (one check ID or N/A)
sub st_run
  set %st_stop 0
  set %st_stopwhy
  set %st_n_pass 0
  set %st_n_fail 0
  set %st_n_note 0
  set %st_n_skip 0
  set %st_n_info 0
  set %st_n_human 0
  set %st_n_auto 0
  set %st_bad |
  set %st_fails
  ; the per-field counts of an earlier run from the same window start again from 0
  str len %st_flist
  if #StrRes > 0 && %st_flist <> N/A
  {
    str count %st_flist /
    set %st_fn #StrRes
    if %st_fn > 0
    {
      for %st_fi 1 %st_fn
      {
        str part %st_flist / %st_fi
        set %st_fld #StrRes
        set %st_fa . %st_fld 0
        set %st_ff . %st_fld 0
      }
    }
  }
  set %st_flist
  set %st_rlog
  set %st_pend
  set %st_pendn 0
  set %st_rpt 0
  set %st_sim 0
  set %st_askoff none
  set %st_cln 0
  set %st_hookwarned 0
  set %st_handswarned 0
  set %st_have 0
  set %st_logged 0
  if #CliNr > 0
  {
    set %st_have 1
    if #CliLogged = 1
      set %st_logged 1
  }
  set %st_dagger N/A
  set %st_daggerasked 0
  set %st_goldid N/A
  set %st_mageready 0
  set %st_canmage 0
  set %st_handssaved 0
  set %st_atspot 0
  set %st_spotdone 0
  set %st_staffprobed 0
  set %st_walkok
  set %st_tok N/A
  gosub st_shard_load
  set %st_staff %st_opt_staff
  set %st_staffok 0
  set %st_pfx %st_opt_pfx
  ; what this run will do, for the progress bar
  set %st_total 0
  set %st_nrun 0
  set %st_last 0
  for %st_si %st_from %st_nstages
  {
    str mid %st_sel %st_si 1
    if #StrRes = 1
    {
      set %st_ct %st_cnt . %st_si
      set %st_total %st_total + %st_ct
      set %st_nrun %st_nrun + 1
      set %st_last %st_si
    }
  }
  if %st_only <> N/A
  {
    set %st_total 1
    set %st_nrun 1
  }
  set %st_done 0
  set %st_stagen 0
  ; the runs row
  if %st_db = 1
  {
    set %st_cid #CharID
    set %st_cv #CliVer
    sql exec INSERT INTO runs(started, shard, charid, cliver, stages, last_stage, state) VALUES(#SysTime, %st_shard, %st_cid, %st_cv, %st_sel, 0, 'running')
    set %st_runid #SqlLastID
  }
  gosub st_report_open
  gosub st_pan_build
  ; the stages, safest first
  for %st_s %st_from %st_nstages
  {
    str mid %st_sel %st_s 1
    if #StrRes = 1
    {
      set %st_stagen %st_stagen + 1
      if %st_stop = 0
        gosub st_stage_run %st_s
      if %st_db = 1
        sql exec UPDATE runs SET last_stage = %st_s WHERE id = %st_runid
      gosub st_flush
    }
  }
  ; clean up, then the report
  gosub st_stage_begin 0 Clean-up
  gosub st_cleanup_all
  gosub st_finish
  if %st_db = 1
  {
    set %st_state finished
    if %st_stop = 1
      set %st_state stopped
    sql exec UPDATE runs SET state = %st_state WHERE id = %st_runid
  }
  gosub st_pan_close
return

sub st_stage_run
  set %st_sr %1
  if %st_sr = 1
    gosub st_s1
  if %st_sr = 2
    gosub st_s2
  if %st_sr = 3
    gosub st_s3
  if %st_sr = 4
    gosub st_s4
  if %st_sr = 5
    gosub st_s5
  if %st_sr = 6
    gosub st_s6
  if %st_sr = 7
    gosub st_s7
  if %st_sr = 8
    gosub st_s8
  if %st_sr = 9
    gosub st_s9
  if %st_sr = 10
    gosub st_s10
  if %st_sr = 11
    gosub st_s11
  if %st_sr = 12
    gosub st_s12
  ; developer check: the count table must match the st_case lines of the stage
  if %st_only = N/A && %st_stop = 0
  {
    set %st_want %st_cnt . %st_sr
    if %st_want <> %st_scases
      log DEV: stage %st_sr ran %st_scases checks, st_counts says %st_want
  }
return

; ---- a stage begins: %1 number, %2 name ------------------------------------
sub st_stage_begin
  set %st_scur %1
  set %st_sname %2
  set %st_scases 0
  set %st_sdone 0
  set %st_stot %st_cnt . %st_scur
  if %st_only <> N/A
    set %st_stot 1
  if %st_scur = 0
    set %st_stot 1
  if %st_scur > 0
  {
    set %st_line **STAGE_ , %st_scur , _ , %st_sname , **
    gosub st_emit
  }
  gosub st_pan_stage
return

; ---- a check begins: %1 id, %2 title ---------------------------------------
;  Sets %st_run 0 when the check is not to run (another check was asked for,
;  or the run was stopped); the caller then returns at once.
sub st_case
  set %st_cid %1
  set %st_ctitle %2
  set %st_blk
  set %st_rpt 0
  set %st_run 1
  set %st_scases %st_scases + 1
  if %st_only <> N/A
  {
    if %st_cid <> %st_only
    {
      set %st_run 0
      return
    }
  }
  gosub st_poll_stop
  ; a client that left the game (connection lost, logged out) would fail every later check
  if %st_scur >= 2 && #CliLogged = 0
    gosub st_do_stop the_client_left_the_game_(CliLogged_is_0)
  ; event hook stages: write the report first, so a crash loses at most this check
  if %st_scur >= 5
    gosub st_flush
  set %st_done %st_done + 1
  set %st_sdone %st_sdone + 1
  gosub st_pan_case
  if %st_stop = 1
    set %st_run 0
  if %st_run = 1
    log -- %st_cid %st_ctitle
return

; ---- the Stop button (or the panel's close box) ----------------------------
sub st_poll_stop
  if %ST_UNATTENDED = 1
    return
  set %st_pb #MenuButton
  if %st_pb = st_pstop || %st_pb = st_pan
  {
    set #MenuButton N/A
    gosub st_do_stop stopped_by_you
  }
return

sub st_do_stop
  if %st_stop = 1
    return
  set %st_stop 1
  set %st_stopwhy %1
  set %st_line - , #spc , [INFO]_stop_run_stopped_[AUTO]_observed= , %st_stopwhy , _expected=none_fields=none
  gosub st_emit
return

; ---- dependencies: a check that needs a failed one is skipped, not failed ----
;  gosub st_need <id> : if <id> FAILed or was blocked, every later record of this
;  check is SKIP blocked_by_<id>
sub st_need
  set %st_nd | , %1 , |
  if %st_nd in %st_bad
  {
    set %st_blk %1
  }
return

; a resource the check needs is missing: everything after it in this check is skipped
sub st_block
  set %st_blk %1
return

; ###########################################################################
;  RECORDING
; ###########################################################################
;  Every check sub: gosub st_xxx <id> <what> <fields>, with %st_a = observed and
;  %st_e = expected set before. Fields: table fields joined with /, or none.

sub st_eq
  set %st_x1 %1
  set %st_x2 %2
  set %st_x3 %3
  if %st_a = %st_e
    gosub st_rec PASS AUTO %st_x1 %st_x2 %st_x3
  else
    gosub st_rec FAIL AUTO %st_x1 %st_x2 %st_x3
return

; like st_eq for a check whose expected value is N/A itself
sub st_eqna
  set %st_x1 %1
  set %st_x2 %2
  set %st_x3 %3
  set %st_naok 1
  gosub st_eq %st_x1 %st_x2 %st_x3
return

; %st_c holds the result of a condition (-1 true)
sub st_ok
  set %st_x1 %1
  set %st_x2 %2
  set %st_x3 %3
  if %st_c
    gosub st_rec PASS AUTO %st_x1 %st_x2 %st_x3
  else
    gosub st_rec FAIL AUTO %st_x1 %st_x2 %st_x3
return

; %st_a within %st_lo..%st_hi
sub st_rng
  set %st_x1 %1
  set %st_x2 %2
  set %st_x3 %3
  set %st_e %st_lo , _to_ , %st_hi
  set %st_c ( %st_a >= %st_lo ) && ( %st_a <= %st_hi )
  gosub st_ok %st_x1 %st_x2 %st_x3
return

; %st_a is not empty, N/A, X or YC (the ID of 0)
sub st_has
  set %st_x1 %1
  set %st_x2 %2
  set %st_x3 %3
  set %st_e not_empty
  str len %st_a
  set %st_c ( #StrRes > 0 ) && ( %st_a <> N/A ) && ( %st_a <> X ) && ( %st_a <> YC )
  gosub st_ok %st_x1 %st_x2 %st_x3
return

; like st_eq, but %st_k is a documented difference: NOTE instead of FAIL
sub st_known
  set %st_x1 %1
  set %st_x2 %2
  set %st_x3 %3
  if %st_a = %st_e
  {
    gosub st_rec PASS AUTO %st_x1 %st_x2 %st_x3
    return
  }
  if %st_a = %st_k
  {
    set %st_e %st_e , _or_the_known_difference_ , %st_k
    gosub st_rec NOTE AUTO %st_x1 %st_x2 %st_x3
    return
  }
  gosub st_rec FAIL AUTO %st_x1 %st_x2 %st_x3
return

sub st_info
  set %st_x1 %1
  set %st_x2 %2
  set %st_x3 %3
  set %st_e none
  gosub st_rec INFO AUTO %st_x1 %st_x2 %st_x3
return

sub st_note
  set %st_x1 %1
  set %st_x2 %2
  set %st_x3 %3
  gosub st_rec NOTE AUTO %st_x1 %st_x2 %st_x3
return

; %3 is the reason
sub st_skip
  set %st_x1 %1
  set %st_x2 %2
  set %st_a %3
  set %st_e none
  gosub st_rec SKIP AUTO %st_x1 %st_x2 none
return

; ---- st_rec verdict kind id what fields -------------------------------------
sub st_rec
  set %st_rv %1
  set %st_rk %2
  set %st_rid %3
  set %st_rw %4
  set %st_rf %5
  ; while the user repeats a step, its automatic checks are not recorded again
  if %st_rpt = 1 && %st_rk = AUTO
    return
  ; an observed N/A is no value at all (no client, or nothing could be read): it never passes,
  ; except where the check expects N/A (st_eqna)
  if %st_a = N/A && %st_naok <> 1
  {
    if %st_rv = PASS
      set %st_rv FAIL
    if %st_rv = NOTE
      set %st_rv FAIL
  }
  set %st_naok 0
  ; a check whose prerequisite failed is skipped
  str len %st_blk
  if #StrRes > 0 && %st_rv <> INFO && %st_rv <> SKIP
  {
    set %st_rv SKIP
    set %st_a blocked_by_ , %st_blk
    set %st_e none
  }
  set %st_in %st_a
  gosub st_san
  set %st_ro %st_out
  set %st_in %st_e
  gosub st_san
  set %st_re %st_out
  set %st_rfd none
  if %st_rf <> none && %st_rf <> N/A
  {
    str replace %st_rf / ,
    set %st_rfd #StrRes
  }
  if %st_rv = PASS
    set %st_n_pass %st_n_pass + 1
  if %st_rv = FAIL
    set %st_n_fail %st_n_fail + 1
  if %st_rv = NOTE
    set %st_n_note %st_n_note + 1
  if %st_rv = SKIP
    set %st_n_skip %st_n_skip + 1
  if %st_rv = INFO
    set %st_n_info %st_n_info + 1
  if %st_rk = HUMAN
    set %st_n_human %st_n_human + 1
  else
    set %st_n_auto %st_n_auto + 1
  set %st_line - , #spc , [ , %st_rv , ]_ , %st_rid , _ , %st_rw , _[ , %st_rk , ]_observed= , %st_ro , _expected= , %st_re , _fields= , %st_rfd
  gosub st_emit
  ; failures and blocked checks block what depends on them
  if %st_rv = FAIL || %st_rv = SKIP
  {
    if %st_rv = FAIL || blocked_by_ in %st_ro
    {
      set %st_bad %st_bad , %st_rid , |
      set %st_bad %st_bad , %st_cid , |
    }
  }
  if %st_rv = FAIL
    set %st_fails %st_fails , %st_line , $
  ; the summary by table field counts the checks that ran
  if %st_rv = PASS || %st_rv = FAIL || %st_rv = NOTE
  {
    if %st_rf <> none && %st_rf <> N/A
      gosub st_fieldstat
  }
  gosub st_pan_counts
return

; counts this record for each of its fields (%st_rf, %st_rv)
sub st_fieldstat
  str count %st_rf /
  set %st_fn #StrRes + 1
  set %st_fseen /
  for %st_fi 1 %st_fn
  {
    str part %st_rf / %st_fi
    set %st_fld #StrRes
    set %st_fk / , %st_fld , /
    if %st_fk notin %st_fseen
    {
      set %st_fseen %st_fseen , %st_fld , /
      set %st_fk2 / , %st_fld , /
      set %st_fl2 / , %st_flist
      if %st_fk2 notin %st_fl2
        set %st_flist %st_flist , %st_fld , /
      set %st_ft %st_fa . %st_fld
      set %st_fa . %st_fld %st_ft + 1
      if %st_rv = FAIL
      {
        set %st_ft %st_ff . %st_fld
        set %st_ff . %st_fld %st_ft + 1
      }
    }
  }
return

; ---- st_san: %st_in -> %st_out, safe for cmd.exe echo and one line ---------
sub st_san
  set %st_out %st_in
  str len %st_out
  if #StrRes = 0
    return
  str replace %st_out #spc _
  set %st_out #StrRes
  str replace %st_out & _
  set %st_out #StrRes
  str replace %st_out | _
  set %st_out #StrRes
  str replace %st_out < _
  set %st_out #StrRes
  str replace %st_out > _
  set %st_out #StrRes
  str replace %st_out ^ _
  set %st_out #StrRes
  str replace %st_out %st_q _
  set %st_out #StrRes
  str replace %st_out % _
  set %st_out #StrRes
  str replace %st_out ( _
  set %st_out #StrRes
  str replace %st_out ) _
  set %st_out #StrRes
  str replace %st_out ! _
  set %st_out #StrRes
  str replace %st_out #smc _
  set %st_out #StrRes
  str replace %st_out $ /
  set %st_out #StrRes
  str len %st_out
  if #StrRes > 80
  {
    str left %st_out 80
    set %st_out #StrRes
  }
return

; ###########################################################################
;  THE REPORT FILE
; ###########################################################################
sub st_report_open
  set %st_rok 0
  set %st_in #CliVer
  if %st_have = 0
    set %st_in noclient
  gosub st_san
  set %st_cvs %st_out
  set %st_in #ReforgedVer
  gosub st_san
  set %st_rvs %st_out
  set %st_rname selftest- , %st_rvs , - , %st_cvs , - , #Date , - , #Time , .md
  set %st_rdir %st_opt_rptdir
  str right %st_rdir 1
  if #StrRes <> \
    set %st_rdir %st_rdir , \
  set %st_rpath %st_rdir , %st_rname
  set %st_rtgt >> , %st_q , %st_rpath , %st_q
  if %ST_REPORT = 1
    set %st_rok 1
  ; header
  set %st_line **EUO_SelfTest_report**
  gosub st_emit
  set %st_in #ReforgedVer
  gosub st_san
  set %st_line - , #spc , ReforgedVer= , %st_out , _script= , %st_rev
  gosub st_emit
  set %st_in #CliVer
  gosub st_san
  set %st_line - , #spc , CliVer= , %st_out , _CliLang= , #CliLang
  gosub st_emit
  set %st_in %st_shard
  gosub st_san
  set %st_line - , #spc , shard= , %st_out
  gosub st_emit
  set %st_in #CharName
  gosub st_san
  set %st_line - , #spc , character= , %st_out , _id= , #CharID
  gosub st_emit
  set %st_line - , #spc , date= , #Date , _time= , #Time
  gosub st_emit
  set %st_line - , #spc , options:_staff= , %st_staff , _prefix= , %st_pfx , _spot= , %st_opt_x , / , %st_opt_y , / , %st_opt_z , _facet= , %st_opt_facet
  gosub st_emit
  set %st_line - , #spc , stages= , %st_sel , _from= , %st_from , _one_check= , %st_only , _run= , %st_runid
  gosub st_emit
  str len %st_dbmsg
  if #StrRes > 0
  {
    set %st_line - , #spc , %st_dbmsg
    gosub st_emit
  }
  ; clean-up rows an earlier run left and you chose to forget (or that belong to another shard)
  set %st_t %st_opt_forgot , %st_forgot
  str len %st_t
  if #StrRes > 0 && %st_opt_forgot <> N/A
  {
    set %st_in %st_t
    gosub st_san
    set %st_line - , #spc , not_cleaned_up_by_an_earlier_run:_ , %st_out
    gosub st_emit
    set %st_opt_forgot
    set %st_forgot
    if %st_db = 1
      sql delete %st_opt_forgot
  }
  set %st_line ---
  gosub st_emit
return

; in %st_line: one report line, already safe (no spaces, no cmd characters)
sub st_emit
  log %st_line
  set %st_rlog %st_rlog , %st_line , $
  if %st_rok = 1
  {
    set %st_pend %st_pend , %st_rtgt , #spc , echo , #spc , %st_line , &
    set %st_pendn %st_pendn + 1
    if %st_pendn >= 20
      gosub st_flush
  }
return

; writes what is pending (the end of every stage, and before every hook check)
sub st_flush
  if %st_pendn > 0
  {
    set %st_pend %st_pend , rem
    execute cmd.exe /c , #spc , %st_pend
    set %st_pend
    set %st_pendn 0
  }
return

; ---- the end of the report ------------------------------------------------
sub st_finish
  set %st_line ---
  gosub st_emit
  set %st_line **SUMMARY**
  gosub st_emit
  set %st_line - , #spc , pass= , %st_n_pass , _fail= , %st_n_fail , _note= , %st_n_note , _skip= , %st_n_skip , _info= , %st_n_info
  gosub st_emit
  set %st_line - , #spc , auto_checks= , %st_n_auto , _human_checks= , %st_n_human
  gosub st_emit
  ; how often the client queued a staff command for its spam limit (0 = the pace was right)
  set %st_line - , #spc , speech_queued_by_the_client= , %st_spamhits , _pace_at_the_end= , %st_prate , _characters_a_second
  gosub st_emit
  str len %st_stopwhy
  if #StrRes > 0
  {
    set %st_line - , #spc , the_run_stopped:_ , %st_stopwhy
    gosub st_emit
  }
  ; by table field: what to fix in uoclidata.pas
  set %st_line **TABLE_FIELDS_WITH_FAILING_CHECKS**
  gosub st_emit
  set %st_nff 0
  str len %st_flist
  if #StrRes > 0
  {
    str count %st_flist /
    set %st_fn #StrRes
    if %st_fn > 0
    {
      for %st_fi 1 %st_fn
      {
        str part %st_flist / %st_fi
        set %st_fld #StrRes
        set %st_ftf %st_ff . %st_fld
        set %st_fta %st_fa . %st_fld
        if %st_ftf > 0
        {
          set %st_line - , #spc , %st_fld , :_ , %st_ftf , _of_ , %st_fta , _checks_fail
          gosub st_emit
          set %st_nff %st_nff + 1
        }
      }
    }
  }
  if %st_nff = 0
  {
    set %st_line - , #spc , none
    gosub st_emit
  }
  ; cleanup
  set %st_line **CLEAN-UP**
  gosub st_emit
  if %st_cln = 0
  {
    set %st_line - , #spc , nothing_created_or_changed
    gosub st_emit
  }
  else
  {
    for %st_ci 1 %st_cln
    {
      set %st_in %st_clt . %st_ci
      gosub st_san
      set %st_ct %st_out
      set %st_in %st_clo . %st_ci
      gosub st_san
      set %st_co %st_out
      set %st_cr %st_clr . %st_ci
      set %st_ck2 %st_clk . %st_ci
      set %st_cd2 %st_cld . %st_ci
      set %st_line - , #spc , %st_ck2 , _ , %st_ct , _[ , %st_cd2 , ]_old= , %st_co , _result= , %st_cr
      gosub st_emit
    }
  }
  gosub st_flush
  set %st_sum EUO_SelfTest:_ , %st_n_pass , _pass,_ , %st_n_fail , _fail,_ , %st_n_note , _note,_ , %st_n_skip , _skip
  if %st_rok = 1
    set %st_sum %st_sum , $Report:_ , %st_rpath
  log %st_sum
return

sub st_quit
  set #LPC %st_lpc_orig
  if %st_db = 1
    sql close
return

; ###########################################################################
;  HUMAN CHECKS
; ###########################################################################
;  st_ask: %st_prompt (underscores for spaces, $ for a new line)
;  %st_askoff: the buttons this question has not (fail, rep, skip in one word; none), reset after it
;  out: %st_ans PASS FAIL SKIP REPEAT STOP, %st_saw (what the user typed after Fail)
sub st_ask
  set %st_ans SKIP
  set %st_saw
  if %ST_UNATTENDED = 1
  {
    if %ST_SIM_REPEAT = 1
    {
      set %st_sim %st_sim + 1
      set %st_odd %st_sim % 2
      set %st_ans PASS
      if %st_odd = 1 && rep notin %st_askoff
        set %st_ans REPEAT
    }
    set %st_askoff none
    return
  }
  gosub st_poll_stop
  if %st_stop = 1
  {
    set %st_askoff none
    set %st_ans STOP
    return
  }
  gosub st_flush
  ; after Repeat the step ran again: say so, or the same question looks like nothing happened
  if %st_rpt = 1
    set %st_prompt Again_(you_pressed_Repeat):$ , %st_prompt
  str replace %st_prompt _ #spc
  menu SetProp st_pbody text #StrRes
  gosub st_pan_buttons #true
  ; a yes/no step has no Fail and no Repeat, a warning not even Skip: those buttons are hidden
  menu SetProp st_pfail visible #true
  menu SetProp st_prep visible #true
  menu SetProp st_pskip visible #true
  if fail in %st_askoff
    menu SetProp st_pfail visible #false
  if rep in %st_askoff
    menu SetProp st_prep visible #false
  if skip in %st_askoff
    menu SetProp st_pskip visible #false
  set %st_askoff none
  set #MenuButton N/A
  set %st_wt 1
  while %st_wt = 1
  {
    wait 1
    set %st_b #MenuButton
    if %st_b <> N/A
    {
      set #MenuButton N/A
      if %st_b = st_ppass
      {
        set %st_ans PASS
        set %st_wt 0
      }
      if %st_b = st_pfail
      {
        set %st_ans FAIL
        set %st_wt 0
      }
      if %st_b = st_pskip
      {
        set %st_ans SKIP
        set %st_wt 0
      }
      if %st_b = st_prep
      {
        set %st_ans REPEAT
        set %st_wt 0
      }
      if %st_b = st_pstop || %st_b = st_pan
      {
        set %st_ans STOP
        set %st_wt 0
      }
    }
  }
  if %st_ans = FAIL
  {
    ; an optional note: what you saw
    menu SetProp st_psaw visible #true
    menu SetProp st_psawok visible #true
    menu Set st_psaw
    set %st_wt 1
    while %st_wt = 1
    {
      wait 1
      set %st_b #MenuButton
      if %st_b = st_psawok || %st_b = st_pstop || %st_b = st_pan
        set %st_wt 0
    }
    set #MenuButton N/A
    menu Get st_psaw
    set %st_saw #MenuRes
    menu SetProp st_psaw visible #false
    menu SetProp st_psawok visible #false
  }
  gosub st_pan_buttons #false
  menu SetProp st_pbody text
  if %st_ans = STOP
    gosub st_do_stop stopped_by_you
return

;  st_human id what fields: asks %st_prompt and records the answer as HUMAN.
;  %st_obs holds the values the script read (they go into the report line).
;  out %st_again = 1 when the user pressed Repeat: the caller repeats its action.
sub st_human
  set %st_h1 %1
  set %st_h2 %2
  set %st_h3 %3
  set %st_again 0
  gosub st_ask
  if %st_ans = REPEAT
  {
    set %st_again 1
    set %st_rpt 1
    return
  }
  set %st_rpt 0
  set %st_a %st_obs
  set %st_e as_described
  if %st_ans = FAIL
  {
    str len %st_saw
    if #StrRes > 0
      set %st_a %st_obs , _you_saw:_ , %st_saw
  }
  if %st_ans = STOP
  {
    set %st_a stopped_by_you
    set %st_ans SKIP
  }
  gosub st_rec %st_ans HUMAN %st_h1 %st_h2 %st_h3
return

; asks a yes/no step (Pass = yes, Skip = no; Fail and Repeat are off): out %st_go 1 or 0
sub st_confirm
  set %st_go 0
  set %st_askoff fail_rep
  gosub st_ask
  if %st_ans = PASS
    set %st_go 1
return

; ###########################################################################
;  THE RUNNING PANEL
; ###########################################################################
sub st_pan_build
  if %ST_UNATTENDED = 1
    return
  menu Delete st_pan
  menu Form st_pan %st_opt_panelx %st_opt_panely 460 370 EUO SelfTest
  menu SetProp st_pan width 460
  menu SetProp st_pan height 370
  menu Font Size 9
  menu Font Style b
  menu Text st_pid 10 6 Starting...
  menu SetProp st_pid width 440
  menu Font Style
  menu Text st_pstage 10 26 -
  menu SetProp st_pstage width 440
  menu Text st_pl1 10 48 Overall
  menu Panel st_bo 70 48 380 14
  menu SetProp st_bo color $808080
  menu Panel st_bof 1 1 0 12
  menu SetProp st_bof color $00A000
  menu SetDef parent st_pan
  menu Text st_pl2 10 66 Stage
  menu Panel st_bs 70 66 380 14
  menu SetProp st_bs color $808080
  menu Panel st_bsf 1 1 0 12
  menu SetProp st_bsf color $D08000
  menu SetDef parent st_pan
  menu Text st_pcnt 10 86 PASS 0   FAIL 0   NOTE 0   SKIP 0
  menu SetProp st_pcnt width 440
  menu Text st_pnote 10 104 -
  menu SetProp st_pnote width 440
  menu SetProp st_pnote fontcolor $0000C0
  menu Memo st_pbody 10 124 440 150
  ; long lines break at the right edge (memo wordwrap: an older build ignores both lines)
  menu SetProp st_pbody wordwrap #true
  menu SetProp st_pbody scrollbars 2
  menu Button st_ppass 10 282 80 26 Pass
  menu Button st_pfail 96 282 80 26 Fail
  menu Button st_pskip 182 282 80 26 Skip
  menu Button st_prep 268 282 80 26 Repeat
  menu Button st_pstop 370 282 80 26 Stop
  menu Text st_pl3 10 316 What did you see? (optional)
  menu Edit st_psaw 10 334 360
  menu Button st_psawok 376 332 74 26 OK
  menu SetProp st_pl3 visible #false
  menu SetProp st_psaw visible #false
  menu SetProp st_psawok visible #false
  gosub st_pan_buttons #false
  menu SetDef parent form0
  menu Hide
  menu SetProp st_pan visible #true
return

sub st_pan_buttons
  if %ST_UNATTENDED = 1
    return
  menu SetProp st_ppass enabled %1
  menu SetProp st_pfail enabled %1
  menu SetProp st_pskip enabled %1
  menu SetProp st_prep enabled %1
  menu SetProp st_pl3 visible #false
return

sub st_pan_close
  if %ST_UNATTENDED = 1
    return
  menu SetProp st_pan visible #false
return

sub st_pan_stage
  if %ST_UNATTENDED = 1
    return
  set %st_in %st_sname
  str replace %st_in _ #spc
  set %st_pt Stage , #spc , %st_scur , #spc , ( , %st_stagen , #spc , of , #spc , %st_nrun , ) , :_ , #StrRes
  if %st_scur = 0
    set %st_pt Clean-up_and_report
  str replace %st_pt _ #spc
  menu Set st_pstage #StrRes
  menu SetProp st_pnote text -
  menu SetProp st_bsf width 0
return

sub st_pan_case
  if %ST_UNATTENDED = 1
    return
  str replace %st_ctitle _ #spc
  menu Set st_pid %st_cid , #spc , #StrRes
  set %st_w 378 * %st_done / %st_total
  if %st_w > 378
    set %st_w 378
  menu SetProp st_bof width %st_w
  set %st_w 378 * %st_sdone / %st_stot
  if %st_w > 378
    set %st_w 378
  menu SetProp st_bsf width %st_w
return

sub st_pan_counts
  if %ST_UNATTENDED = 1
    return
  menu Set st_pcnt PASS , #spc , %st_n_pass , #spc , #spc , FAIL , #spc , %st_n_fail , #spc , #spc , NOTE , #spc , %st_n_note , #spc , #spc , SKIP , #spc , %st_n_skip
return

; a line in red on the panel (%st_pmsg, underscores for spaces)
sub st_pan_note
  if %ST_UNATTENDED = 1
    return
  str replace %st_pmsg _ #spc
  menu SetProp st_pnote text #StrRes
return

; the panel waits for Pass (go on) or Stop. %st_prompt: what is about to happen
sub st_pan_hold
  set %st_go 1
  if %ST_UNATTENDED = 1
    return
  set %st_askoff fail_rep_skip
  gosub st_ask
  if %st_ans <> PASS
  {
    set %st_go 0
    set %st_why not_confirmed_before_stage_ , %st_scur
    gosub st_do_stop %st_why
  }
return

; ###########################################################################
;  STAGE 1  identity and attach (reads only)
; ###########################################################################
;  If one of 1.02-1.06 fails, the run stops: nothing after it would mean anything.
sub st_s1
  gosub st_stage_begin 1 %st_sn1
  gosub st_c101
  gosub st_c102
  gosub st_c103
  gosub st_c104
  gosub st_c105
  gosub st_c106
  gosub st_c107
  if %st_only <> N/A || %ST_NOSTOP = 1
    return
  set %st_x | , 1.02 , |
  set %st_y | , 1.03 , |
  set %st_z | , 1.04 , |
  set %st_v | , 1.05 , |
  set %st_w | , 1.06 , |
  if %st_x in %st_bad || %st_y in %st_bad || %st_z in %st_bad || %st_v in %st_bad || %st_w in %st_bad
    gosub st_do_stop stage_1_failed:_nothing_after_it_would_mean_anything
return

