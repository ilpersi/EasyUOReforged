; ===========================================================================
;  STAGE 4  Event / ExEvent / initEvents
; ===========================================================================
sub st_s_events
  if %st_logged = 0
  {
    gosub st_case 4.00 event_exevent
    gosub st_skip event_and_exevent_stage no_logged_in_client
    return
  }
  gosub st_e_messages
  gosub st_e_property
  gosub st_e_pathfind
  gosub st_e_locks
  gosub st_e_ui
  if %ST_ITEM_ID <> N/A
  {
    str len %ST_ITEM_ID
    if #strres > 0
    {
      gosub st_e_items
    }
    else
    {
      gosub st_case 4.50 item_events
      gosub st_skip exevent_drag_dropc_dropg_droppd_event_drag_macro_24 set_ST_ITEM_ID_to_an_item_id_from_your_backpack
    }
  }
  gosub st_e_pet
return

; ---- 4.01  event sysmessage / exmsg / sleep / initEvents --------------------------------------------------
