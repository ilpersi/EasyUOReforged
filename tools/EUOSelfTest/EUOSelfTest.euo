; ---- 4.50  item events (needs ST_ITEM_ID) ---------------------------------------------------------------------------------
sub st_e_items
  gosub st_case 4.50 exevent_drag_dropg_dropc_droppd
  if %st_run = 0
  {
    return
  }
  ; findItem by id only sees items in OPEN containers and on the ground: open the backpack first
  event macro 8 7
  wait 12
  st_rp_34:
  findItem %ST_ITEM_ID
  if #findCnt = 0
  {
    gosub st_skip item_events ST_ITEM_ID_not_found_in_the_client
    return
  }
  set %st_i_bag #findBagID
  gosub st_info item_starts_in_container %st_i_bag
  ; --- to the ground, one tile east ---
  exevent drag %ST_ITEM_ID
  wait 10
  set %st_dx #charPosX + 1
  exevent dropg %st_dx #charPosY
  wait 20
  findItem %ST_ITEM_ID
  gosub st_eq exevent_drag_and_dropg_put_the_item_on_the_ground_(findKind_1) #findKind 1
  gosub st_eq exevent_dropg_x_is_the_requested_x #findX %st_dx
  ; --- back into the backpack ---
  exevent drag %ST_ITEM_ID
  wait 10
  exevent dropc #backpackID
  wait 20
  findItem %ST_ITEM_ID
  gosub st_eq exevent_dropc_puts_the_item_into_the_backpack #findBagID #backpackID
  ; --- onto the paperdoll (only works for wearable items) ---
  exevent drag %ST_ITEM_ID
  wait 10
  exevent dropPD
  wait 20
  findItem %ST_ITEM_ID
  if #findBagID = #charID
  {
    gosub st_rec PASS AUTO exevent_droppd_equips_a_wearable_item equipped
    set %st_prompt The_item_should_now_be_worn_or_held_by_your_character.$Is_it?
    set %st_obs equipped
    gosub st_human exevent_droppd_item_is_visibly_equipped
    if %st_again = 1
    {
      goto st_rp_34
    }
    exevent drag %ST_ITEM_ID
    wait 10
    exevent dropc #backpackID
    wait 20
  }
  else
  {
    gosub st_skip exevent_droppd item_is_not_wearable_(use_a_weapon_or_clothing)
    exevent dropc #backpackID
    wait 20
  }
  ; --- macro 24 arm / disarm: the item id is written to #rHandID, macro 24 2 toggles it in the right hand ---
  set #rHandID %ST_ITEM_ID
  event macro 24 2
  wait 25
  findItem %ST_ITEM_ID
  if #findBagID = #charID
  {
    gosub st_rec PASS AUTO macro_24_2_arms_the_item_written_to_rHandID equipped
    event macro 24 2
    wait 25
    findItem %ST_ITEM_ID
    gosub st_eq macro_24_2_again_disarms_it_back_into_the_backpack #findBagID #backpackID
  }
  else
  {
    gosub st_rec NOTE AUTO macro_24_2_arms_the_item_written_to_rHandID item_not_armed_(not_a_one-handed_weapon_or_the_hand_is_busy)
  }
  exevent drag %ST_ITEM_ID
  wait 10
  exevent dropc #backpackID
  wait 20
  findItem %ST_ITEM_ID
  gosub st_eq item_is_back_in_the_backpack_at_the_end #findBagID #backpackID
  ; --- hideItem (optional: the client forgets the item, so it cannot be picked up again until it is re-sent) ---
  set %st_prompt Optional_step:_hideItem_(Skip_is_fine).$It_removes_the_picture_of_a_ground_item_from_the_client_-_and_the_client_then_cannot_pick_it_up_again.$The_test_item_stays_lying_on_the_ground_next_to_you_(hidden)_until_you_walk_about_20_tiles_away_and_back_or_relog.$Press_Pass_only_if_that_is_acceptable.
  gosub st_ask
  if %st_ans = PASS
  {
    exevent drag %ST_ITEM_ID
    wait 15
    set %st_hx #charPosX + 1
    exevent dropg %st_hx #charPosY
    wait 20
    findItem %ST_ITEM_ID
    gosub st_eq item_is_on_the_ground_before_hideItem #findKind 1
    hideItem %ST_ITEM_ID
    wait 10
    findItem %ST_ITEM_ID
    gosub st_eq hideItem_removes_the_item_from_the_client #findCnt 0
    set %st_prompt hideItem_was_sent._The_item_should_have_disappeared_from_the_ground_one_tile_east_of_you.$Is_it_gone_from_your_screen?
    set %st_obs hidden
    gosub st_human hideItem_removes_the_item_picture
    set %st_line - , #spc , [NOTE] , _ , 4.50 , _ , the_test_item_lies_hidden_on_the_ground_at_ , %st_hx , _ , #charPosY , _ , walk_away_and_back_or_relog_to_see_it
    gosub st_emit
  }
  else
  {
    gosub st_skip hideItem skipped_by_the_user
  }
return

; ---- 4.60  pet (needs ST_PET_ID) ---------------------------------------------------------------------------------------------
