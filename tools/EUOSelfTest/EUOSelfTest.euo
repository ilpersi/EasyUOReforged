sub st_c201
  gosub st_case 2.01 Character_state
  if %st_run = 0
    return
  set %st_a #CharDir
  set %st_lo 0
  set %st_hi 7
  gosub st_rng 2.01.dir CharDir_is_0_to_7 %fx_dir
  ; only the letters A to H can appear (a mobile's layer byte is 0)
  set %st_a #CharStatus
  set %st_c %st_a <> N/A
  str len %st_a
  if #StrRes > 0 && %st_a <> N/A
  {
    set %st_t %st_a
    str replace %st_t A
    set %st_t #StrRes
    str replace %st_t B
    set %st_t #StrRes
    str replace %st_t C
    set %st_t #StrRes
    str replace %st_t D
    set %st_t #StrRes
    str replace %st_t E
    set %st_t #StrRes
    str replace %st_t F
    set %st_t #StrRes
    str replace %st_t G
    set %st_t #StrRes
    str replace %st_t H
    set %st_t #StrRes
    str len %st_t
    set %st_c #StrRes = 0
    if %st_t = N/A
      set %st_c #true
  }
  set %st_e letters_A_to_H_only
  gosub st_ok 2.01.status CharStatus_has_only_status_letters %fx_statusc
  set %st_a #CharGhost
  set %st_e no
  if %st_a = yes
  {
    set %st_e no_(you_are_dead)
    gosub st_note 2.01.ghost CharGhost %fx_type
  }
  else
    gosub st_eq 2.01.ghost CharGhost_is_no_while_alive %fx_type
  set %st_a #CharType
  gosub st_has 2.01.type CharType_is_a_body_type %fx_type
  set %st_a #Sex
  set %st_lo 0
  set %st_hi 1
  gosub st_rng 2.01.sex Sex_is_0_or_1 %fx_stat
return

