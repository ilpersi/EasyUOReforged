  set %st_a #FindLayer
  set %st_e 21
  gosub st_eq 2.03.layer FindLayer_of_the_backpack_is_21 %fx_layer
  ; a backpack is graphic 3701 or 2482 (the checks #BackpackID itself makes)
  set %st_in 3701
  gosub st_num2id
  set %st_t1 %st_out
  set %st_in 2482
  gosub st_num2id
  set %st_a #FindType
  set %st_c ( %st_a = %st_t1 ) || ( %st_a = %st_out )
  set %st_e %st_t1 , _or_ , %st_out
  gosub st_ok 2.03.type FindType_is_a_backpack_graphic %fx_find
return

sub st_c204
  gosub st_case 2.04 Status_values:_ranges_and_consistency
  if %st_run = 0
    return
  gosub st_need 1.04
  set %st_lo 1
  set %st_hi 65000
  set %st_a #Str
  gosub st_rng 2.04.str Str %fx_stat
  set %st_a #Dex
  gosub st_rng 2.04.dex Dex %fx_stat
  set %st_a #Int
  gosub st_rng 2.04.int Int %fx_stat
  set %st_a #Hits , / , #MaxHits
  set %st_c ( #Hits >= 0 ) && ( #Hits <= #MaxHits ) && ( #MaxHits > 0 )
  set %st_e 0_to_#MaxHits
  gosub st_ok 2.04.hits Hits_not_above_#MaxHits %fx_stat
  set %st_a #Stamina , / , #MaxStam
  set %st_c ( #Stamina >= 0 ) && ( #Stamina <= #MaxStam ) && ( #MaxStam > 0 )
  set %st_e 0_to_#MaxStam
  gosub st_ok 2.04.stam Stamina_not_above_#MaxStam %fx_stat
  set %st_a #Mana , / , #MaxMana
  set %st_c ( #Mana >= 0 ) && ( #Mana <= #MaxMana ) && ( #MaxMana > 0 )
  set %st_e 0_to_#MaxMana
  gosub st_ok 2.04.mana Mana_not_above_#MaxMana %fx_stat
  set %st_a #MaxStats
  set %st_lo 1
  set %st_hi 65000
  gosub st_rng 2.04.maxstats MaxStats_is_a_stat_cap %fx_ext
  set %st_a #Gold
  set %st_lo 0
  set %st_hi 2000000000
  gosub st_rng 2.04.gold Gold_is_not_negative %fx_stat
  set %st_a #Weight
  gosub st_rng 2.04.weight Weight_is_not_negative %fx_wt
  ; the server's own rule: 40 + 3.5 x Str, or 100 + 3.5 x Str for a human after Mondain's Legacy
  set %st_t #Str * 7 / 2
  set %st_t #MaxWeight - %st_t
  set %st_a #MaxWeight
  set %st_c ( %st_t = 40 ) || ( %st_t = 100 )
  set %st_e 40_or_100_+_3.5_x_#Str
  gosub st_ok 2.04.maxweight MaxWeight_follows_#Str %fx_stat
  set %st_a #AR
  set %st_lo -100
  set %st_hi 100
  gosub st_rng 2.04.ar AR_is_a_resistance %fx_ar
  set %st_a #FR
  gosub st_rng 2.04.fr FR_is_a_resistance %fx_ext
  set %st_a #CR
  gosub st_rng 2.04.cr CR_is_a_resistance %fx_ext
  set %st_a #PR
  gosub st_rng 2.04.pr PR_is_a_resistance %fx_ext
  set %st_a #ER
  gosub st_rng 2.04.er ER_is_a_resistance %fx_ext
  set %st_a #Followers , / , #MaxFol
  set %st_c ( #Followers >= 0 ) && ( #Followers <= #MaxFol ) && ( #MaxFol <> N/A )
  set %st_e 0_to_#MaxFol
  gosub st_ok 2.04.followers Followers_not_above_#MaxFol %fx_ext
  set %st_a #MinDmg , / , #MaxDmg
  set %st_c ( #MinDmg >= 0 ) && ( #MinDmg <= #MaxDmg )
  set %st_e MinDmg_not_above_MaxDmg
  gosub st_ok 2.04.dmg MinDmg_not_above_#MaxDmg %fx_luck
  set %st_a #Luck
  set %st_lo -10000
  set %st_hi 100000
  gosub st_rng 2.04.luck Luck_is_a_number %fx_luck
  set %st_a #TP
  set %st_lo 0
  set %st_hi 2000000000
  gosub st_rng 2.04.tp TP_is_not_negative %fx_tp
return

