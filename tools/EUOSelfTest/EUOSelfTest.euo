  set %st_prompt Open_a_vendor_BUY_window_(say_vendor_buy_to_a_shopkeeper)_and_double-click_ONE_line_into_your_buy_list.$Press_Pass_when_the_window_is_open,_Skip_to_skip_this_stage.
  set %st_obs vendor_window
