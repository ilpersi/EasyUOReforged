sub st_c507
  gosub st_case 5.07 Moving_the_backpack_gump
  if %st_run = 0
    return
  gosub st_need 5.06
  gosub st_bp_open
  set %st_p0 #ContPosX
  set %st_p1 #ContPosY
  ; an item in the backpack moves with the gump: #FindX - #ContPosX stays the same
  set %st_item N/A
  finditem * C_ , #BackpackID
  if #FindCnt > 0
  {
    set %st_item #FindID
    set %st_ix #FindX - #ContPosX
    set %st_iy #FindY - #ContPosY
  }
  set #ContPosX 200
  set #ContPosY 220
  wait 5
  set %st_a #ContPosX , / , #ContPosY
  set %st_e 200/220
  gosub st_eq 5.07.write ContPosX/Y_200_220_read_back %fx_contpos
  set %st_a #ContID
  set %st_e #BackpackID
  gosub st_eq 5.07.same the_backpack_is_still_on_top %fx_contid
  contpos 210 230
  wait 5
  set %st_a #ContPosX , / , #ContPosY
  set %st_e 210/230
  gosub st_eq 5.07.cmd contpos_210_230_read_back %fx_contpos
  if %st_item <> N/A
  {
    finditem %st_item C_ , #BackpackID
    set %st_a #FindX , / , #FindY
    set %st_t1 210 + %st_ix
    set %st_t2 230 + %st_iy
    set %st_e %st_t1 , / , %st_t2
    gosub st_eq 5.07.item an_item's_#FindX/Y_moves_with_the_gump %fx_findc
  }
  set #ContPosX %st_p0
  set #ContPosY %st_p1
  wait 5
  set %st_a #ContPosX , / , #ContPosY
  set %st_e %st_p0 , / , %st_p1
  gosub st_eq 5.07.back the_gump_is_back_where_it_was %fx_contpos
return

sub st_c508
  gosub st_case 5.08 nextcpos_places_the_next_container
  if %st_run = 0
    return
  gosub st_need 1.06
  ; the client option "Offset interface windows rather than perfectly stacking them" decides
  ; (docs/nextcpos-analysis.md, client.exe 7.0.117.33): on, a container opens at #NextCPos and both
  ; values then grow by 16; off, it opens at the top right and #NextCPos is not used. Only containers.
  set %st_n1 #NextCPosX
  set %st_n2 #NextCPosY
  set %st_f %fx_nextc , / , %fx_contpos
  if %st_staffok = 1
  {
    set %st_in 3702
    gosub st_num2id
    gosub st_newitem_begin %st_out B
    gosub st_staff self addtopack Bag
    gosub st_newitem_end Bag
    if %st_newid = N/A
    {
      gosub st_skip 5.08 nextcpos the_bag_was_not_made
      return
    }
    set %st_bag %st_newid
    nextcpos 300 150
    set #LObjectID %st_bag
    event macro 17 0
    waitfor #ContID = %st_bag %st_tw3
    wait 5
    gosub st_nextc_judge nextcpos_300_150_opens_a_new_bag_there
    set #NextCPosX %st_n1
    set #NextCPosY %st_n2
    gosub st_cl_restore %st_bag
    return
  }
  ; without staff commands: the backpack, closed and opened again
  event macro 9 7
  wait 10
  nextcpos 300 150
  event macro 8 7
  waitfor #ContID = #BackpackID %st_tw3
  wait 5
  gosub st_nextc_judge nextcpos_300_150_opens_the_backpack_there
  set #NextCPosX %st_n1
  set #NextCPosY %st_n2
return

; 5.08 after the container opened: #NextCPos 316/166 means the option is on (the window must be at
; 300/150), still 300/150 means it is off (a NOTE: the window is at the top right); %1 = what
sub st_nextc_judge
  set %st_v #NextCPosX , / , #NextCPosY
  set %st_a #ContPosX , / , #ContPosY
  if %st_v = 316/166
  {
    set %st_e 300/150
    gosub st_eq 5.08 %1 %st_f
    return
  }
  set %st_a %st_a , _NextCPos_ , %st_v
  if %st_v = 300/150
  {
    set %st_e 300/150_with_the_client_option_Offset_interface_windows_on
    gosub st_note 5.08 the_option_Offset_interface_windows_is_off:_containers_open_at_the_top_right %st_f
    return
  }
  set %st_e 300/150_NextCPos_316/166_(option_on)_or_NextCPos_still_300/150_(option_off)
  gosub st_rec FAIL AUTO 5.08 %1 %st_f
return

