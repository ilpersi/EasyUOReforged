    set %st_ck #minDmg <= #maxDmg
    gosub st_ok minDmg_not_above_maxDmg #minDmg %st_ck
    set %st_prompt Compare_with_your_Status_gump_(expanded):$Str/Dex/Int_=_ , #str , _/_ , #dex , _/_ , #int , $Hits/Stam/Mana_=_ , #hits , _/_ , #stamina , _/_ , #mana , $Gold_=_ , #gold , $Weight_=_ , #weight , _/_ , #maxWeight , $AR_=_ , #ar , _Followers_=_ , #followers , _/_ , #maxFol , $Resists_F/C/P/E_=_ , #fr , _/_ , #cr , _/_ , #pr , _/_ , #er , $Luck_=_ , #luck , _Damage_=_ , #minDmg , _-_ , #maxDmg , _TithingPoints_=_ , #tp
    set %st_obs #str , _/_ , #dex , _/_ , #int
    gosub st_human status_values_match_the_Status_gump
    if %st_again = 1
    {
      goto st_rp_2
    }
  }
return

