  set %st_g4 #CliTop
  set %st_old %st_g3 , / , %st_g4 , / , %st_g1 , / , %st_g2
  gosub st_cl_changed game_area cliwin
  st_rp_307:
  set #CliXRes 640
  set #CliYRes 480
  set #CliLeft 40
  set #CliTop 80
  wait 5
  set %st_a #CliXRes
  set %st_e 640
  gosub st_eq 3.07.xres CliXRes_reads_back_640 %fx_xres
  set %st_a #CliYRes
  set %st_e 480
