sub st_c614
  gosub st_case 6.14 Skill_bonus:_#Skill_with_and_without_it
  if %st_run = 0
    return
  if %st_staffok = 0
  {
    gosub st_skip 6.14 skill_bonus needs_staff_commands
    return
  }
  ; the ring slot (layer 8) must be free
  set %st_rg N/A
  finditem * CA_ , #CharID
  set %st_rc #FindCnt
  if %st_rc > 0
  {
    for %st_ri 1 %st_rc
    {
      set #FindIndex %st_ri
      if #FindLayer = 8
        set %st_rg #FindID
    }
  }
  if %st_rg <> N/A
  {
    set %st_t you_wear_a_ring_ , %st_rg , _(layer_8)
    gosub st_skip 6.14 skill_bonus %st_t
    return
  }
  ; a ring with Anatomy +5 and Luck +77: the base stays, the value and luck grow.
  ; The bonus stops at the skill's cap (ModernUO Skill.Value): a base near it is lowered to 50.0 first
  chooseskill anat real
  set %st_sb0 #Skill
  set %st_t #SkillCap - 60
  if %st_sb0 > %st_t
  {
    gosub st_sget Skills.Anatomy.Base
    set %st_old %st_gn
    gosub st_cl_changed Skills.Anatomy.Base staffset
    gosub st_staff self set Skills.Anatomy.Base 50
    set %st_ski 0
    repeat
      wait 5
      chooseskill anat real
      set %st_ski %st_ski + 1
    until #Skill = 500 || %st_ski > 12
    set %st_sb0 #Skill
  }
  chooseskill anat
  set %st_sv0 #Skill
  set %st_l0 #Luck
  set %st_in 4234
  gosub st_num2id
  gosub st_newitem_begin %st_out B
  gosub st_staff self addtopack GoldRing
  gosub st_newitem_end Gold_ring
  if %st_newid = N/A
  {
    gosub st_skip 6.14 skill_bonus the_ring_was_not_made
    return
  }
  set %st_ring %st_newid
  ; two commands: one line of 104 characters lost its end (the ring got no luck, live on 7.0.117.33)
  gosub st_oset %st_ring SkillBonuses.Skill_1_Name Anatomy SkillBonuses.Skill_1_Value 5
  gosub st_oset %st_ring Attributes.Luck 77
  wait 10
  exevent equip %st_ring
  wait 20
  ; #Skill is what chooseskill read: read it again until the bonus is there
  set %st_t %st_sv0 + 50
  set %st_ski 0
  repeat
    wait 5
    chooseskill anat
    set %st_ski %st_ski + 1
  until #Skill = %st_t || %st_ski > 12
  set %st_a #Skill
  set %st_e %st_t
  gosub st_eq 6.14.value chooseskill_anat_adds_the_+5.0_of_the_ring %fx_skillb
  chooseskill anat real
  set %st_a #Skill
  set %st_e %st_sb0
  gosub st_eq 6.14.base chooseskill_anat_real_keeps_the_base %fx_skill
  ; the server sends luck with the status only when asked: open the status window again
  set %st_t %st_l0 + 77
  event macro 9 2
  wait 10
  event macro 8 2
  waitfor #Luck = %st_t %st_tw3
  set %st_a #Luck
  set %st_e %st_t
  if #Luck = %st_t
  {
    gosub st_eq 6.14.luck Luck_grows_by_the_ring's_77 %fx_luck
    return
  }
  ; not read: did the ring get its luck (its tooltip), and does the status window show it?
  event property %st_ring
  wait 15
  set %st_a #Property
  gosub st_info 6.14.ring the_ring's_tooltip %fx_prop
  set %st_prompt The_ring_gives_Luck_+77._Look_at_Luck_in_your_status_window_(the_big_one).$
    +$Does_it_show_ , %st_t , ?_The_script_reads_ , #Luck , $$Pass_=_yes,_Fail_=_no,_Skip_=_you_can't_tell.
  set %st_askoff rep
  gosub st_ask
  set %st_a #Luck
  set %st_e %st_t
  if %st_ans = PASS
    gosub st_eq 6.14.luck Luck_reads_what_the_status_window_shows %fx_luck
  if %st_ans = FAIL
  {
    set %st_e %st_t , _(the_status_window_does_not_show_it_either:_the_server_did_not_send_it)
    gosub st_note 6.14.luck Luck_did_not_grow_by_the_ring's_77 %fx_luck
  }
  if %st_ans <> PASS && %st_ans <> FAIL
    gosub st_skip 6.14.luck Luck not_compared_with_the_status_window
return

sub st_c615
  gosub st_case 6.15 ignoreitem
  if %st_run = 0
    return
  gosub st_ensure_dagger
  if %st_dagger = N/A
  {
    gosub st_skip 6.15 ignoreitem no_test_weapon
    return
  }
  ignoreitem %st_dagger
  finditem %st_dagger A
  set %st_a #FindCnt
  set %st_e 0
  gosub st_eq 6.15.hidden ignoreitem_hides_the_ID_from_finditem none
  ignoreitem %st_dagger
  finditem %st_dagger A
  set %st_a #FindCnt
  set %st_e 1
  gosub st_eq 6.15.toggle ignoreitem_again_brings_it_back none
  ignoreitem %st_dagger st
  ignoreitem reset st
  finditem %st_dagger A
  set %st_a #FindCnt
  set %st_e 1
  gosub st_eq 6.15.reset ignoreitem_reset_list_brings_it_back none
return

sub st_c616
  gosub st_case 6.16 hideitem
  if %st_run = 0
    return
  gosub st_ensure_dagger
  if %st_dagger = N/A
  {
    gosub st_skip 6.16 hideitem no_test_weapon
    return
  }
  if %st_staffok = 0
  {
    set %st_prompt Optional_step:_hideitem.$
      +$It_drops_the_test_weapon_one_tile_east_of_you_and_hides_it._The_client_then_can't_pick_it_up
      +_until_you_walk_about_20_tiles_away_and_back,_or_log_in_again.$$Pass_=_do_it,_Skip_=_skip_it.
    gosub st_confirm
    if %st_go = 0
    {
      gosub st_skip 6.16 hideitem skipped_by_you
      return
    }
  }
  gosub st_bp_open
  exevent drag %st_dagger
  wait 10
  set %st_gx #CharPosX + 1
  exevent dropg %st_gx #CharPosY
  wait 20
  finditem %st_dagger G_3
  set %st_a #FindKind
  set %st_e 1
  gosub st_eq 6.16.ground the_item_is_on_the_ground_first %fx_drop
  hideitem %st_dagger
  wait 10
  finditem %st_dagger G_3
  set %st_a #FindCnt
  set %st_e 0
  gosub st_eq 6.16.gone hideitem_removes_it_from_the_client's_list %fx_hide
  if %st_staffok = 1
  {
    ; the server still has it: delete it and make a new one when one is needed
    gosub st_cl_restore %st_dagger
    set %st_dagger N/A
  }
  else
  {
    set %st_line - , #spc , [NOTE]_6.16_the_test_weapon_lies_hidden_at_ , %st_gx , _ , #CharPosY , _walk_away_and_back_or_log_in_again
    gosub st_emit
    set %st_dagger N/A
  }
return

sub st_c617
  gosub st_case 6.17 event_Property_of_an_item
  if %st_run = 0
    return
  gosub st_ensure_dagger
  if %st_dagger = N/A
  {
    gosub st_skip 6.17 property no_test_weapon
    return
  }
  event property %st_dagger
  wait 15
  set %st_a #Property
  set %st_c ( dagger in #Property ) || ( %st_staffok = 0 )
  set %st_e names_a_dagger
  if %st_staffok = 0
  {
    str len #Property
    set %st_c #StrRes > 0
    set %st_e a_tooltip
  }
  gosub st_ok 6.17 event_Property_of_the_test_weapon %fx_prop
return

sub st_c618
  gosub st_case 6.18 exevent_PopUp
  if %st_run = 0
    return
  gosub st_need 1.03
  ; a gump that comes on top changes at least one of these, and the report line shows what the
  ; script saw; but a tooltip that goes away changes them too, so you say whether the menu is there
  gosub st_bp_open
  wait 10
  set %st_n0 #ContName , _ , #ContKind , _ , #ContSizeX , _ , #ContSizeY , _ , #ContPosX , _ , #ContPosY
  exevent popup #CharID
  set %st_pi 0
  repeat
    wait 5
    set %st_n1 #ContName , _ , #ContKind , _ , #ContSizeX , _ , #ContSizeY , _ , #ContPosX , _ , #ContPosY
    set %st_pi %st_pi + 1
  until %st_n1 <> %st_n0 || %st_pi > 12
  set %st_obs no_new_gump_on_top
  if %st_n1 <> %st_n0
    set %st_obs on_top:_ , %st_n1
  set %st_prompt exevent_PopUp_asked_the_server_for_YOUR_context_menu.$
    +$Is_a_context_menu_showing_on_your_character?$Repeat_=_ask_for_it_again.
  set %st_pfirst 1
  set %st_again 1
  while %st_again = 1
  {
    if %st_pfirst = 0
    {
      key esc
      wait 10
      exevent popup #CharID
      wait 20
    }
    set %st_pfirst 0
    gosub st_human 6.18 exevent_PopUp_#CharID_opens_your_context_menu %fx_popup
  }
  key esc
  wait 10
return

