; ---- st_rw id name value fields: writes #name, reads it back, puts the old value back
sub st_rw
  set %st_w1 %1
  set %st_w2 %2
  set %st_w3 %3
  set %st_w4 %4
  set %st_wold # . %st_w2
  ; writing the value already there proves nothing: take another one
  if %st_wold = %st_w3
  {
    set %st_t %st_w3 + 0
    if %st_t = %st_w3
      set %st_w3 %st_w3 + 1
    else
    {
      if %st_w3 = #CharID
        set %st_w3 #BackpackID
      else
        set %st_w3 #CharID
    }
  }
  set # . %st_w2 %st_w3
  wait 2
  set %st_a # . %st_w2
  set %st_e %st_w3
  set %st_wid %st_w1 , .write
  set %st_ww %st_w2 , _reads_back_the_written_value
  gosub st_eq %st_wid %st_ww %st_w4
  set # . %st_w2 %st_wold
  wait 2
  set %st_a # . %st_w2
  set %st_e %st_wold
  set %st_wid %st_w1 , .restore
  set %st_ww %st_w2 , _restored
  gosub st_eq %st_wid %st_ww %st_w4
return

