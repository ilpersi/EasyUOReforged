  if %st_run = 0
    return
  ; the client has the status values (name, stats, gold...) only once the status window has been
  ; opened since login; this stage only reads, so it asks you to open it
  if #CharName = N/A && #Str = N/A && #CliLogged = 1
  {
    set %st_prompt The_client_has_no_status_values_yet_(name,_stats,_gold):_it_gets_them_the_first_time
      +_the_status_window_is_opened_after_you_log_in.$$Open_your_status_window_once
      +_(paperdoll:_the_Status_button),_then_press_Pass._Skip_=_go_on_without_them.
    gosub st_confirm
    if %st_go = 1
      waitfor #CharName <> N/A %st_tw5
  }
  set %st_a #CharName
  gosub st_has 1.04 CharName_is_read_from_the_status %fx_name
return

