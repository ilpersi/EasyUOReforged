; ---- 3.04  macro 5 walk ---------------------------------------------------------------------------------
sub st_m_walk
  gosub st_case 3.04 macro_5_walk
  if %st_run = 0
  {
    return
  }
  set %st_moved 0
  gosub st_walk_try 3 7
  if %st_moved = 0
  {
    gosub st_walk_try 7 3
  }
  if %st_moved = 0
  {
    gosub st_walk_try 5 1
  }
  if %st_moved = 0
  {
    gosub st_walk_try 1 5
  }
  if %st_moved = 1
  {
    gosub st_rec PASS AUTO macro_5_walk_changes_charPos moved_from_ , %st_wx , _ , %st_wy
  }
  else
  {
    gosub st_rec FAIL AUTO macro_5_walk_changes_charPos no_move_in_any_direction_(blocked?)
  }
return

; direction to try, direction back. a first call may only turn the character
sub st_walk_try
  set %st_wx #charPosX
  set %st_wy #charPosY
  event macro 5 %1
  wait 8
  event macro 5 %1
  wait 8
  event macro 5 %1
  wait 8
  set %st_ck ( #charPosX <> %st_wx ) || ( #charPosY <> %st_wy )
  if %st_ck
  {
    set %st_moved 1
    event macro 5 %2
    wait 8
    event macro 5 %2
    wait 8
    event macro 5 %2
    wait 8
    event macro 5 %2
    wait 8
  }
return

; ---- 3.05  macro 6 war / peace -------------------------------------------------------------------------------
sub st_m_war
  gosub st_case 3.05 macro_6_toggle_war_peace
  if %st_run = 0
  {
    return
  }
  set %st_s0 #charStatus
  str pos %st_s0 G
  set %st_war0 #strres
  event macro 6 0
  wait 12
  set %st_s1 #charStatus
  str pos %st_s1 G
  set %st_war1 #strres
  set %st_ck ( ( %st_war0 > 0 ) && ( %st_war1 = 0 ) ) || ( ( %st_war0 = 0 ) && ( %st_war1 > 0 ) )
  gosub st_ok macro_6_flips_the_G_(war)_bit_of_charStatus %st_s0 , _to_ , %st_s1 %st_ck
  event macro 6 0
  wait 12
  set %st_s2 #charStatus
  gosub st_eq macro_6_again_restores_the_status %st_s2 %st_s0
return

; ---- 3.06  macros 13 and 14 skill -----------------------------------------------------------------------------------
sub st_m_skill
  gosub st_case 3.06 macros_13_and_14_use_skill
  if %st_run = 0
  {
    return
  }
  st_rp_18:
  gosub st_cursor_cancel
  event macro 13 1
  wait 10
  gosub st_cursor_up
