  event sysMessage EUO_selftest_system_message
  wait 8
  str pos #sysMsg EUO_selftest
  set %st_ck #strres > 0
  gosub st_ok event_sysmessage_shows_up_in_sysMsg #sysMsg %st_ck
  set %st_prompt Event_SysMessage_wrote_EUO_selftest_system_message_in_the_lower_left_of_the_game_window.$Did_you_see_it?
  set %st_obs sysmessage
  gosub st_human event_sysmessage_text_is_visible
  st_rp_30:
  if %st_again = 1
  {
    goto st_rp_29
  }
  event exMsg #charID 3 33 EUO_selftest_overhead_text
  wait 10
  set %st_prompt Event_ExMsg_put_EUO_selftest_overhead_text_above_YOUR_character.$Do_you_see_it?
  set %st_obs exmsg
  gosub st_human event_exmsg_overhead_text_is_visible
  if %st_again = 1
  {
    goto st_rp_30
  }
  event sleep 100
  gosub st_info event_sleep_100_ran_(it_only_stalls_the_client,_the_script_is_not_delayed) ok
  initEvents
