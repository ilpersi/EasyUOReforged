sub st_c605
  gosub st_case 6.05 Static_target:_#LTargetKind_3
  if %st_run = 0
    return
  if %st_staffok = 0
  {
    gosub st_skip 6.05 static_target needs_staff_commands
    return
  }
  ; a static (a layer after the ground) within one tile
  set %st_sfound 0
  tile init
  for %st_sdx -1 1
  {
    for %st_sdy -1 1
    {
      if %st_sfound = 0
      {
        set %st_sx #CharPosX + %st_sdx
        set %st_sy #CharPosY + %st_sdy
        tile cnt %st_sx %st_sy
        if #TileCnt >= 2
        {
          tile get %st_sx %st_sy 2
          set %st_sfound 1
          set %st_stile #TileType
          set %st_sz #TileZ
        }
      }
    }
  }
  if %st_sfound = 0
  {
    gosub st_skip 6.05 static_target no_static_within_one_tile_of_the_test_spot
    return
  }
  gosub st_cancel_cursor
  gosub st_newitem_begin %st_dtypes G
  gosub st_staff add Dagger
  gosub st_wait_cursor
  set #LTargetX %st_sx
  set #LTargetY %st_sy
  set #LTargetZ %st_sz
  set #LTargetTile %st_stile
  set #LTargetKind 3
  event macro 22 0
  waitfor #TargCurs = 0 %st_tw3
  set %st_a #TargCurs
  set %st_e 0
  set %st_f %fx_macro , / , %fx_lttile , / , %fx_ltkind
  gosub st_eq 6.05.answered macro_22_on_#LTargetTile_answers_the_cursor %st_f
  gosub st_newitem_end Dagger_on_a_static
  set %st_a %st_newid
  gosub st_has 6.05.item an_item_is_made_on_the_static %st_f
  if %st_newid <> N/A
  {
    finditem %st_newid G_3
    set %st_a #FindX , / , #FindY
    set %st_e %st_sx , / , %st_sy
    gosub st_eq 6.05.pos it_lies_on_the_static's_tile %st_f
  }
return

sub st_c606
  gosub st_case 6.06 Target_Self_and_Last_Target_through_the_server
  if %st_run = 0
    return
  gosub st_need 1.03
  if %st_staffok = 0
  {
    ; without staff commands: a skill's cursor answered with Target Self
    gosub st_cancel_cursor
    event macro 13 1
    gosub st_wait_cursor
    event macro 23 0
    waitfor #TargCurs = 0 %st_tw3
    set %st_a #TargCurs
    set %st_e 0
    gosub st_eq 6.06.self event_macro_23_answers_the_cursor %fx_macro
    return
  }
  gosub st_cancel_cursor
  set %st_sj #JIndex
  gosub st_staff get Name
  gosub st_wait_cursor
  event macro 23 0
  findjournal %st_sj * %st_tw3 Name_=_
  set %st_a #Journal
  set %st_cn #CharName
  str replace %st_cn #spc _
  set %st_c #StrRes in #Journal
  set %st_e Name_=_ , #StrRes
  gosub st_ok 6.06.self Target_Self_(macro_23)_targets_you %fx_macro
  set #LTargetID #CharID
  set #LTargetKind 1
  set %st_sj #JIndex
  gosub st_staff get Serial
  gosub st_wait_cursor
  event macro 22 0
  findjournal %st_sj * %st_tw3 Serial_=_
  set %st_t #Journal
  str part %st_t _=_ 2
  set %st_in #StrRes
  gosub st_hex
  set %st_srv %st_out
  set %st_in #CharID
  gosub st_id2ser
  set %st_a %st_srv
  set %st_e %st_ser
  set %st_f %fx_macro , / , %fx_ltid , / , %fx_ltkind
  gosub st_eq 6.06.last Last_Target_(macro_22)_targets_#LTargetID %st_f
return

