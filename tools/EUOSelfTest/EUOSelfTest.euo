  }
  st_rp_31:
  chooseSkill anat
  set %st_l0 #skillLock
  exevent skillLock anat locked
  wait 10
  chooseSkill anat
  gosub st_eq exevent_skilllock_anat_locked_is_read_back_by_skillLock #skillLock locked
  event skillLock anat down
  wait 10
  chooseSkill anat
  gosub st_eq event_skilllock_anat_down_is_read_back_by_skillLock #skillLock down
  exevent skillLock anat %st_l0
  wait 10
  chooseSkill anat
  gosub st_eq anatomy_lock_restored #skillLock %st_l0
  event macro 8 2
  wait 10
  exevent statLock str down
  wait 10
  set %st_prompt ExEvent_StatLock_set_STRENGTH_to_DOWN.$Look_at_your_Status_gump:_is_the_Strength_arrow_pointing_down?$(It_is_set_back_to_up_afterwards.)
  set %st_obs str_down
  gosub st_human exevent_statlock_str_down_changes_the_arrow
