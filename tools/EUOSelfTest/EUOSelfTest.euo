  wait 10
  str len #property
  set %st_ck #strres > 0
  gosub st_ok event_property_of_the_backpack_returns_text #property %st_ck
return

; ---- 4.03  event pathfind ----------------------------------------------------------------------------------------
sub st_e_pathfind
  gosub st_case 4.03 event_pathfind
  if %st_run = 0
  {
    return
  }
  ; The client's walk-to routine may stop after a few tiles, so success means: the character got CLOSER
  ; to the target (arriving exactly is reported too). Four directions are tried, the first that works counts.
  set %st_p_ok 0
  set %st_px #charPosX
  set %st_py #charPosY
  gosub st_pf_try 3 0
  if %st_p_ok = 0
  {
    gosub st_pf_try -3 0
  }
  if %st_p_ok = 0
  {
    gosub st_pf_try 0 3
  }
  if %st_p_ok = 0
  {
    gosub st_pf_try 0 -3
  }
  if %st_p_ok = 1
  {
    gosub st_rec PASS AUTO event_pathfind_moves_the_character_toward_the_target tiles_away_ , %st_d0 , _to_ , %st_d1
    event pathfind %st_px %st_py
    wait 60
  }
  else
  {
    gosub st_rec FAIL AUTO event_pathfind_moves_the_character_toward_the_target never_got_closer_in_4_directions_(all_blocked?)
  }
return

; dx dy: pathfind to (x+dx, y+dy), wait, and see whether the character is nearer than before
sub st_pf_try
  set %st_tx %st_px + %1
  set %st_ty %st_py + %2
  set %st_d0 %1 abs
  set %st_d0b %2 abs
  set %st_d0 %st_d0 + %st_d0b
  event pathfind %st_tx %st_ty
  wait 60
  set %st_d1 %st_tx - #charPosX abs
  set %st_d1b %st_ty - #charPosY abs
  set %st_d1 %st_d1 + %st_d1b
  if %st_d1 < %st_d0
  {
    set %st_p_ok 1
  }
  else
  {
    event pathfind %st_px %st_py
    wait 40
  }
return

; ---- 4.04  skill and stat locks -------------------------------------------------------------------------------------
sub st_e_locks
  gosub st_case 4.04 event_skilllock_exevent_skilllock_exevent_statlock
  if %st_run = 0
