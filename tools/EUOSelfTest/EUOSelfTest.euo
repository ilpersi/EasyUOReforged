  set %st_a #CliTop
  set %st_e 80
  gosub st_eq 3.07.top CliTop_reads_back_80 %fx_top
  set %st_prompt The_script_set_#CliXRes_640,_#CliYRes_480,_#CliLeft_40,_#CliTop_80.$
    +$Look_at_the_UO_window:_the_game_area_(the_picture_of_the_world)_is_now_640_x_480,
    +_40_pixels_from_the_left_and_80_from_the_top_of_the_window.$$It_is_put_back_right_after_you_answer.
  set %st_obs 640x480_at_40,80
  gosub st_human 3.07.seen the_game_area_shrinks_and_moves %fx_xres
  if %st_again = 1
    goto st_rp_307
  gosub st_cl_restore game_area
  set %st_a #CliXRes , / , #CliYRes , / , #CliLeft , / , #CliTop
  set %st_e %st_g1 , / , %st_g2 , / , %st_g3 , / , %st_g4
