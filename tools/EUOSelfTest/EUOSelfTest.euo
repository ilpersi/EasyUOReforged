sub st_c211
  gosub st_case 2.11 Cursor_and_pixels
  if %st_run = 0
    return
  set %st_a #CursorX , / , #CursorY
  set %st_c ( #CursorX >= -1 ) && ( #CursorY >= -1 )
  set %st_e numbers
  gosub st_ok 2.11.cursor CursorX/#CursorY_are_numbers none
  ; read a pixel of the game area and compare it at once: it must match
  set %st_px #CliLeft + 4
  set %st_py #CliTop + 4
  savepix %st_px %st_py 7
  set %st_a #PixCol
  set %st_lo 0
  set %st_hi 16777215
  gosub st_rng 2.11.pixcol savepix_puts_a_colour_in_#PixCol none
  set %st_cm 0
  cmppix 7 t
    set %st_cm 1
  set %st_a %st_cm
  set %st_e 1
  gosub st_eq 2.11.cmppix cmppix_at_once_matches_what_savepix_read none
return

sub st_c212
  gosub st_case 2.12 Tiles_under_the_character
  if %st_run = 0
    return
  gosub st_need 1.05
  tile init
  tile cnt #CharPosX #CharPosY
  set %st_a #TileCnt
  set %st_lo 1
  set %st_hi 500
  gosub st_rng 2.12.cnt tile_cnt_finds_tiles_where_you_stand %fx_tile
  set %st_tn #TileCnt
  set %st_found 0
  set %st_tl
  if %st_tn > 0
  {
    for %st_ti 1 %st_tn
    {
      tile get #CharPosX #CharPosY %st_ti
      set %st_tl %st_tl , #TileZ , : , #TileName , /
      if #TileZ = #CharPosZ
      {
        set %st_found 1
        set %st_tt #TileType
        set %st_tf #TileFlags
      }
    }
  }
  set %st_a %st_tl
  set %st_e a_layer_at_#CharPosZ
  if %st_found = 1
    gosub st_rec PASS AUTO 2.12.z a_tile_layer_is_at_#CharPosZ %fx_pos
  else
    gosub st_note 2.12.z no_tile_at_#CharPosZ_(standing_on_top_of_a_taller_tile?) %fx_pos
  if %st_found = 1
  {
    set %st_a %st_tt , / , %st_tf
    gosub st_info 2.12.type TileType/#TileFlags_of_that_layer %fx_tile
  }
return

