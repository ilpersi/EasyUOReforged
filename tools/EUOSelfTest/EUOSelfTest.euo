  set %st_a #ContSizeX , / , #ContSizeY
  set %st_c ( #ContSizeX >= 50 ) && ( #ContSizeX <= 1000 ) && ( #ContSizeY >= 50 ) && ( #ContSizeY <= 1000 )
  set %st_e 50_to_1000_each
  gosub st_ok 5.06.dims the_backpack_gump_has_a_plausible_size %fx_contsz
