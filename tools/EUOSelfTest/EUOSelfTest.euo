    return
  gosub st_setup_once
  gosub st_c701
  gosub st_c702
  gosub st_c703
  gosub st_c704
  gosub st_c705
  gosub st_c706
  gosub st_c707
  gosub st_c708
  gosub st_c709
  gosub st_c710
  gosub st_c711
  gosub st_c712
  gosub st_c713
  gosub st_c714
  gosub st_c715
return

sub st_c701
  gosub st_case 7.01 Macro_6:_war_and_peace
  if %st_run = 0
    return
  set %st_s0 #CharStatus
  set %st_w0 0
  if G in %st_s0
    set %st_w0 1
  set %st_old 0
  gosub st_cl_changed war_mode macro6
  event macro 6 0
  if %st_w0 = 1
    waitfor G notin #CharStatus %st_tw3
  else
    waitfor G in #CharStatus %st_tw3
  set %st_s1 #CharStatus
  set %st_w1 0
  if G in %st_s1
    set %st_w1 1
  set %st_a %st_s0 , _then_ , %st_s1
  set %st_c %st_w1 <> %st_w0
  set %st_e G_flips
  set %st_f %fx_macro , / , %fx_status
  gosub st_ok 7.01.flip event_macro_6_flips_the_G_letter_(war_mode) %st_f
  event macro 6 0
  if %st_w0 = 1
    waitfor G in #CharStatus %st_tw3
  else
    waitfor G notin #CharStatus %st_tw3
  set %st_a #CharStatus
  set %st_e %st_s0
  gosub st_eq 7.01.back event_macro_6_again_puts_it_back %st_f
  gosub st_cl_forget war_mode
return

sub st_c702
  gosub st_case 7.02 Macro_14:_last_skill
  if %st_run = 0
    return
  gosub st_cancel_cursor
  wait 20
  set #LSkill 1
  event macro 14 0
  gosub st_wait_cursor
  set %st_a #TargCurs
  set %st_e 1
  set %st_f %fx_macro , / , %fx_lskill
  gosub st_eq 7.02 event_macro_14_uses_#LSkill_1_(Anatomy) %st_f
  gosub st_cancel_cursor
return

sub st_c703
  gosub st_case 7.03 Macros_15_and_16:_spells
  if %st_run = 0
    return
  gosub st_ensure_magery
  if %st_canmage = 0
  {
    gosub st_skip 7.03 spells %st_magewhy
    return
  }
  ; the Cast Spell macro does not remember the spell: only the spellbook and the spell icons set
  ; #LSpell (the code of client.exe 7.0.117.33 and client_beta 7.0.117.31, docs/beta-31-variables.md):
  ; a marker written first must stay
  set %st_ls0 #LSpell
  set #LSpell 9
  gosub st_cancel_cursor
  wait 20
  set %st_j0 #JIndex
  event macro 15 4
  gosub st_wait_cursor
  set %st_a #TargCurs
  set %st_e 1
  gosub st_eq 7.03.cursor event_macro_15_4_(Magic_Arrow)_raises_a_cursor %fx_macro
  findjournal %st_j0 * %st_tw3 In_Por_Ylem
  set %st_a #Journal
  set %st_c #JFound > 0
  set %st_e In_Por_Ylem
  gosub st_softok 7.03.words your_character_says_the_words_of_the_spell %fx_macro
  set %st_a #LSpell
  set %st_e 9
  gosub st_eq 7.03.lspell the_Cast_Spell_macro_leaves_#LSpell_as_it_was %fx_lspell
  gosub st_cancel_cursor
  wait 40
  ; #LSpell counts Magery from 1: Magic Arrow is 5, not the 4 of event macro 15
  set #LSpell 5
  event macro 16 0
  gosub st_wait_cursor
  set %st_a #TargCurs
  set %st_e 1
  set %st_f %fx_macro , / , %fx_lspell
  gosub st_eq 7.03.last event_macro_16_casts_#LSpell_5_again %st_f
  gosub st_cancel_cursor
  set #LSpell %st_ls0
return

sub st_c704
  gosub st_case 7.04 Skill_locks
  if %st_run = 0
    return
  chooseskill anat
  set %st_l0 #SkillLock
  set %st_old %st_l0
  gosub st_cl_changed anat skilllock
  exevent skilllock anat locked
  chooseskill anat
  waitfor #SkillLock = locked %st_tw3
  set %st_a #SkillLock
  set %st_e locked
  set %st_f %fx_xsklock , / , %fx_sklock
  gosub st_eq 7.04.ex exevent_SkillLock_anat_locked_reads_locked %st_f
  if %st_staffok = 1
  {
    gosub st_sget Skills.Anatomy.Lock
    set %st_a %st_gn
    set %st_e Locked
    gosub st_sval 7.04.server the_shard_has_the_lock_too %fx_xsklock
  }
  event skilllock anat down
  chooseskill anat
  waitfor #SkillLock = down %st_tw3
  set %st_a #SkillLock
  set %st_e down
  gosub st_eq 7.04.ev event_SkillLock_anat_down_reads_down %st_f
  gosub st_cl_restore anat
  chooseskill anat
  waitfor #SkillLock = %st_l0 %st_tw3
  set %st_a #SkillLock
  set %st_e %st_l0
  gosub st_eq 7.04.back the_lock_is_back_as_it_was %st_f
return

sub st_c705
  gosub st_case 7.05 Stat_lock
  if %st_run = 0
    return
  set %st_old up
  if %st_staffok = 1
  {
    gosub st_sget StrLock
    if %st_gok = 1
      set %st_old %st_gn
  }
  gosub st_cl_changed str statlock
  ; a lock other than the one it has (it was already down on the owner's character)
  set %st_sl down
  set %st_slv Down
  if %st_old = Down
  {
    set %st_sl locked
    set %st_slv Locked
  }
  st_rp_705:
  exevent statlock str %st_sl
  wait 15
  if %st_staffok = 1
  {
    gosub st_sget StrLock
    set %st_a %st_gn
    set %st_e %st_slv
    gosub st_sval 7.05 exevent_StatLock_str_reaches_the_shard %fx_send
  }
  else
  {
    event macro 8 2
    wait 10
    set %st_prompt The_script_ran:_exevent_StatLock_str_down$
      +$Look_at_your_Status_gump_(the_script_opened_it):_the_small_arrow_next_to_Strength_should_point_down.$
      +$It_is_put_back_after_you_answer.
    set %st_obs str_down
    gosub st_human 7.05 exevent_StatLock_str_down_turns_the_arrow %fx_send
    if %st_again = 1
      goto st_rp_705
  }
  gosub st_cl_restore str
return

sub st_c706
  gosub st_case 7.06 Macro_32:_Always_Run
  if %st_run = 0
    return
  set %st_j0 #JIndex
  event macro 32 0
  findjournal %st_j0 * %st_tw3 Always_Run_is_now
  set %st_r1 #Journal
  set %st_a %st_r1
  set %st_c #JFound > 0
  set %st_e Always_Run_is_now_on/off
  gosub st_ok 7.06.toggle event_macro_32_toggles_Always_Run %fx_macro
  set %st_j0 #JIndex
  event macro 32 0
  findjournal %st_j0 * %st_tw3 Always_Run_is_now
  set %st_a #Journal
  set %st_c ( #JFound > 0 ) && ( #Journal <> %st_r1 )
  set %st_e the_other_answer
  gosub st_ok 7.06.back event_macro_32_again_toggles_it_back %fx_macro
return

sub st_c707
  gosub st_case 7.07 Macros_50,_51,_52:_the_targeting_system
  if %st_run = 0
    return
  set %st_mobs
  if %st_staffok = 1
  {
    ; two chickens next to you, held in place
    gosub st_spawn Chicken
    set %st_ch1 %st_newid
    gosub st_spawn Chicken
    set %st_ch2 %st_newid
    set %st_mobs | , %st_ch1 , | , %st_ch2 , |
  }
  event macro 52 5
  wait 10
  set %st_t1 #LTargetID
  ; a mobile near you: the client's "nearest" may be another one than the chickens, such as your pet
  ; (live on 7.0.117.33 it took the pet on your tile)
  set %st_c #false
  set %st_a %st_t1
  finditem %st_t1 G_2
  if #FindCnt > 0
  {
    set #FindIndex 1
    set %st_a %st_t1 , _at_distance_ , #FindDist
    if #FindID = %st_t1 && #FindID <> #CharID
      set %st_c #true
  }
  if %st_staffok = 1
  {
    set %st_e a_mobile_within_2_tiles_(the_two_chickens_or_another)
    gosub st_ok 7.07.nearest event_macro_52_5_selects_a_mobile_near_you %fx_macro
  }
  else
    gosub st_info 7.07.nearest event_macro_52_5_selected %fx_macro
  event macro 50 5
  wait 10
  set %st_t2 #LTargetID
  event macro 50 5
  wait 10
  set %st_t3 #LTargetID
  set %st_a %st_t1 , _ , %st_t2 , _ , %st_t3
  set %st_c ( %st_t1 <> %st_t2 ) || ( %st_t2 <> %st_t3 )
  if %st_c
  {
    set %st_e the_selection_moves
    gosub st_ok 7.07.next event_macro_50_5_selects_the_next_mobile %fx_macro
    event macro 51 5
    wait 10
    set %st_a #LTargetID
    set %st_e %st_t2
    gosub st_eq 7.07.prev event_macro_51_5_goes_back %fx_macro
  }
  else
    gosub st_skip 7.07.next macros_50_51 fewer_than_two_mobiles_near_you
  if %st_staffok = 1
  {
    gosub st_cl_restore %st_ch1
    gosub st_cl_restore %st_ch2
  }
return

sub st_c708
  gosub st_case 7.08 Macro_58:_bandage_yourself
  if %st_run = 0
    return
  set %st_bandage N/A
  set %st_in 3617
  gosub st_num2id
  set %st_btype %st_out
  if %st_staffok = 1
  {
    gosub st_newitem_begin %st_btype B
    gosub st_staff self addtopack Bandage 10
    gosub st_newitem_end Bandages
    set %st_bandage %st_newid
    gosub st_staff self set Hits 30
    wait 10
  }
  else
  {
    set %st_prompt Optional_step:_event_macro_58_(Bandage_Self).$
      +$You_need_bandages_in_your_backpack._Pass_=_use_one,_Skip_=_you_have_none.
    gosub st_confirm
    if %st_go = 0
    {
      gosub st_skip 7.08 bandage_self skipped_by_you
      return
    }
    finditem %st_btype CA_ , #BackpackID
    if #FindCnt > 0
      set %st_bandage #FindID
  }
  ; every bandage in the backpack: the client may take another pile than the one made here
  set %st_b0 N/A
  if %st_bandage <> N/A
  {
    gosub st_typecount %st_btype
    set %st_b0 %st_tcn
  }
  set %st_j0 #JIndex
  event macro 58 0
  findjournal %st_j0 * %st_tw5 applying_the_bandage bandage
  set %st_a #Journal
  set %st_c #JFound > 0
  set %st_e You_begin_applying_the_bandages
  gosub st_softok 7.08.journal event_macro_58_starts_bandaging %fx_macro
  if %st_b0 <> N/A
  {
    wait 10
    gosub st_typecount %st_btype
    set %st_a %st_tcn
    set %st_e %st_b0 - 1
    gosub st_soft 7.08.used one_bandage_is_used_(all_piles_counted) %fx_macro
  }
  if %st_staffok = 1
  {
    wait 60
    set %st_t #MaxHits
    gosub st_staff self set Hits %st_t
  }
return

sub st_c709
  gosub st_case 7.09 Macro_12:_open_door
  if %st_run = 0
    return
  ; the shard opens the door on the tile in front of you (ModernUO BaseDoor.OpenDoorMacroUsed) and says
  ; "Opening door...". An open door moves aside, so the macro sent again finds none in front of you.
  set %st_prompt Optional_step:_event_macro_12_(Open_Door).$
    +$Stand_next_to_a_closed_door_and_face_it:$the_shard_opens_the_door_on_the_tile_in_front_of_you.$
    +$Pass_=_send_it._The_script_then_reads_the_shard's_answer,$and_asks_you_(with_Fail)_only_if_there_is_none.$
    +$Skip_=_there_is_no_door.
  gosub st_confirm
  if %st_go = 0
  {
    gosub st_skip 7.09 open_door skipped_by_you
    return
  }
  st_rp_709:
  set %st_j0 #JIndex
  event macro 12 0
  findjournal %st_j0 * %st_tw3 Opening_door
  if #JFound > 0
  {
    set %st_a #Journal
    set %st_c #true
    set %st_e Opening_door...
    gosub st_ok 7.09 event_macro_12_opens_the_door_in_front_of_you %fx_macro
    return
  }
  set %st_prompt The_script_ran_event_macro_12_0_(Open_Door),_but_the_shard_did_not_say_Opening_door...$
    +$Did_the_door_in_front_of_you_open?$
    +$Repeat_=_send_it_again:_face_a_closed_door_first_(an_open_door_has_moved_aside).
  set %st_obs no_Opening_door_message
  gosub st_human 7.09 macro_12_opens_the_door_in_front_of_you %fx_macro
  if %st_again = 1
    goto st_rp_709
return

sub st_c710
  gosub st_case 7.10 Macros_35_and_36:_weapon_abilities
  if %st_run = 0
    return
  gosub st_ensure_dagger
  if %st_dagger <> N/A
  {
    gosub st_hands_save
    exevent equip %st_dagger
    wait 20
  }
  set %st_prompt Optional_step:_event_macro_35_and_36_(primary_and_secondary_weapon_ability).$
    +$The_script_put_the_test_weapon_in_your_hand_(if_it_could)._Pass_=_send_them,_Skip_=_skip.
  gosub st_confirm
  if %st_go = 0
  {
    gosub st_skip 7.10 weapon_abilities skipped_by_you
    return
  }
  st_rp_710a:
  event macro 35 0
  wait 15
  set %st_prompt The_script_ran_event_macro_35_0_(Primary_Ability).$
    +$Look_at_the_weapon_ability_icons_(or_the_journal):_the_primary_ability_should_be_ready_(highlighted).
  set %st_obs primary
  gosub st_human 7.10.primary macro_35_readies_the_primary_ability %fx_macro
  if %st_again = 1
    goto st_rp_710a
  event macro 35 0
  wait 10
  st_rp_710b:
  event macro 36 0
  wait 15
  set %st_prompt The_script_ran_event_macro_36_0_(Secondary_Ability).$
    +$Look_at_the_weapon_ability_icons_(or_the_journal):_the_secondary_ability_should_be_ready.
  set %st_obs secondary
  gosub st_human 7.10.secondary macro_36_readies_the_secondary_ability %fx_macro
  if %st_again = 1
    goto st_rp_710b
  event macro 36 0
  wait 10
return

sub st_c711
  gosub st_case 7.11 Macro_37:_equip_last_weapon
  if %st_run = 0
    return
  gosub st_ensure_dagger
  if %st_dagger = N/A
  {
    gosub st_skip 7.11 equip_last_weapon no_test_weapon
    return
  }
  gosub st_hands_save
  gosub st_bp_open
  exevent equip %st_dagger
  gosub st_wait_bag %st_dagger #CharID
  wait 30
  event macro 24 2
  gosub st_wait_bag %st_dagger #BackpackID
  set %st_t #FindBagID
  ; the client may refuse it soon after the disarm, as in 6.12: again while it says to wait
  gosub st_arm_try 37 0
  set %st_a %st_t , _then_ , #FindBagID
  set %st_e #BackpackID , _then_ , #CharID
  if #FindBagID <> #CharID && %st_atw = 1
  {
    gosub st_jlast
    set %st_a %st_a , _journal:_ , %st_jt
    set %st_e %st_e , _(the_client_kept_saying_to_wait)
    gosub st_note 7.11 event_macro_37_equips_the_last_weapon_again %fx_macro
    return
  }
  ; the client asks the server, and ModernUO has no Equip Last Weapon (its 0xBF 0x1E handler is a
  ; house-design query; that macro 37 sends 0x1E is not checked in the client)
  if #FindBagID <> #CharID && %st_staffok = 1
  {
    set %st_e %st_e , _(ModernUO_has_no_Equip_Last_Weapon)
    gosub st_note 7.11 event_macro_37_equips_the_last_weapon_again %fx_macro
    return
  }
  gosub st_eq 7.11 event_macro_37_equips_the_last_weapon_again %fx_macro
return

sub st_c712
  gosub st_case 7.12 Macro_56:_targeting_system_on/off
  if %st_run = 0
    return
  set %st_prompt Optional_step:_event_macro_56_toggles_the_targeting_system,_and_the_script_toggles_it_back_after_your_answer.$
    +$Pass_=_send_it,_Skip_=_skip.
  gosub st_confirm
  if %st_go = 0
  {
    gosub st_skip 7.12 targeting_system skipped_by_you
    return
  }
  st_rp_712:
  event macro 56 0
  wait 12
  set %st_prompt The_script_ran_event_macro_56_0.$
    +$Look_at_the_lower_left_of_the_game_area:_the_client_should_have_said_the_targeting_system_was_turned_on_or_off.
  set %st_obs targeting_system
  gosub st_human 7.12 macro_56_toggles_the_targeting_system %fx_macro
  event macro 56 0
  wait 8
  if %st_again = 1
    goto st_rp_712
return

sub st_c713
  gosub st_case 7.13 Macros_this_script_does_not_run
  if %st_run = 0
    return
  ; one line, not a SKIP each: they are left out on purpose (the reasons are in the README)
  set %st_a 20,25,28,29,33,34,38-48,49,53,54,60,61-66,67_(reasons_in_the_README)
  gosub st_info 7.13 event_macros_not_run_by_this_self-test none
return

sub st_c714
  gosub st_case 7.14 Macro_55:_current_target
  if %st_run = 0
    return
  if %st_staffok = 0
  {
    gosub st_skip 7.14 current_target needs_staff_commands
    return
  }
  ; a chicken held next to you, selected with the targeting macros; then a staff cursor that
  ; macro 55 answers with the selected one
  gosub st_spawn Chicken
  set %st_ch1 %st_newid
  if %st_ch1 = N/A
  {
    gosub st_skip 7.14 current_target the_chicken_was_not_made
    return
  }
  gosub st_selmob %st_ch1
  set %st_a #LTargetID
  set %st_e %st_ch1
  gosub st_eq 7.14.select the_targeting_macros_select_the_chicken %fx_macro
  if #LTargetID = %st_ch1
  {
    gosub st_cancel_cursor
    gosub st_staff get Name
    gosub st_wait_cursor
    event macro 55 0
    findjournal %st_sj * %st_tw3 Name_=_
    set %st_a #Journal
    set %st_c ( #JFound > 0 ) && ( chicken in #Journal )
    set %st_e Name_=_a_chicken
    gosub st_ok 7.14.target event_macro_55_targets_the_selected_mobile %fx_macro
    gosub st_cancel_cursor
  }
  gosub st_cl_restore %st_ch1
return

sub st_c715
  gosub st_case 7.15 Macro_59:_bandage_target
  if %st_run = 0
    return
  if %st_staffok = 0
  {
    gosub st_skip 7.15 bandage_target needs_staff_commands
    return
  }
  ; bandages in the backpack, a wounded chicken held next to you and selected: the shard says
  ; "You begin applying the bandages." (ModernUO Bandage.BeginHeal)
  set %st_in 3617
  gosub st_num2id
  set %st_btype %st_out
  finditem %st_btype CA_ , #BackpackID
  if #FindCnt = 0
  {
    gosub st_newitem_begin %st_btype B
    gosub st_staff self addtopack Bandage 10
    gosub st_newitem_end Bandages
  }
  gosub st_spawn Chicken
  set %st_ch1 %st_newid
  if %st_ch1 = N/A
  {
    gosub st_skip 7.15 bandage_target the_chicken_was_not_made
    return
  }
  gosub st_oset %st_ch1 Hits 1
  wait 10
  gosub st_selmob %st_ch1
  if #LTargetID <> %st_ch1
  {
    set %st_a #LTargetID
    set %st_e %st_ch1
    gosub st_eq 7.15.select the_targeting_macros_select_the_chicken %fx_macro
    gosub st_cl_restore %st_ch1
    return
  }
  set %st_j0 #JIndex
  event macro 59 0
  findjournal %st_j0 * %st_tw3 You_begin_applying
  set %st_a #Journal
  set %st_c #JFound > 0
  set %st_e You_begin_applying_the_bandages.
  gosub st_ok 7.15 event_macro_59_bandages_the_selected_mobile %fx_macro
  gosub st_cl_restore %st_ch1
return

; selects the mobile %1 with the targeting macros (52 5 nearest, then 50 5 next, 8 at most);
; #LTargetID is then the selected one
sub st_selmob
  set %st_smi %1
  set %st_smn 0
  event macro 52 5
  wait 10
  while #LTargetID <> %st_smi && %st_smn < 8
  {
    event macro 50 5
    wait 10
    set %st_smn %st_smn + 1
  }
return

; ###########################################################################
;  STAGE 8  event hook: movement
; ###########################################################################
sub st_s8
  gosub st_stage_begin 8 %st_sn8
  gosub st_hook_warn
  if %st_stop = 1
    return
  gosub st_setup_once
  gosub st_pathmobiles
  gosub st_c801
  gosub st_c802
  gosub st_c803
  gosub st_c804
  gosub st_c805
  gosub st_c806
return

sub st_c801
  gosub st_case 8.01 Macro_5:_walk
  if %st_run = 0
    return
  gosub st_need 1.05
  gosub st_walkcheck
  ; the parameter is #CharDir + 1: 3 east, 7 west, 5 south, 1 north
  gosub st_macwalk 8.01.e 3 1 0 2 E
  gosub st_macwalk 8.01.w 7 -1 0 6 E
  gosub st_macwalk 8.01.s 5 0 1 4 S
  gosub st_macwalk 8.01.n 1 0 -1 0 S
return

; id param dx dy direction walk-letter: two steps (a first press may only turn)
sub st_macwalk
  set %st_m1 %1
  set %st_m2 %2
  set %st_m3 %3
  set %st_m4 %4
  set %st_m5 %5
  set %st_m6 %6
  if %st_m6 notin %st_walkok
  {
    gosub st_skip %st_m1 macro_5 the_tiles_that_way_are_not_walkable
    return
  }
  set %st_tx #CharPosX + %st_m3 * 2
  set %st_ty #CharPosY + %st_m4 * 2
  set %st_tries 0
  while ( #CharPosX <> %st_tx || #CharPosY <> %st_ty ) && %st_tries < 6
  {
    event macro 5 %st_m2
    wait 8
    set %st_tries %st_tries + 1
  }
  set %st_a #CharPosX , / , #CharPosY
  set %st_e %st_tx , / , %st_ty
  set %st_wid %st_m1 , .pos
  set %st_f %fx_macro , / , %fx_pos
  gosub st_eq %st_wid event_macro_5_walks_two_tiles %st_f
  set %st_a #CharDir
  set %st_e %st_m5
  set %st_wid %st_m1 , .dir
  gosub st_eq %st_wid CharDir_is_the_direction_walked %fx_dir
return

sub st_c802
  gosub st_case 8.02 event_PathFind
  if %st_run = 0
    return
  gosub st_need 1.05
  gosub st_walkcheck
  if E notin %st_walkok
  {
    gosub st_skip 8.02 event_pathfind the_tiles_east_are_not_walkable
    return
  }
  set %st_px #CharPosX
  set %st_py #CharPosY
  set %st_pz #CharPosZ
  set %st_tx %st_px + 2
  path can %st_tx %st_py
  set %st_tz #PathZ
  event pathfind %st_tx %st_py %st_tz
  waitfor #CharPosX = %st_tx && #CharPosY = %st_py %st_tw5
  set %st_a #CharPosX , / , #CharPosY , / , #CharPosZ
  set %st_e %st_tx , / , %st_py , / , %st_tz
  ; client_beta's own walk can end on a tile next to the goal (docs/pathfinding.md): it walked, so the
  ; event reached the client; a NOTE, not a FAIL
  set %st_c #false
  if #CharPosX >= %st_tx - 1 && #CharPosX <= %st_tx + 1 && #CharPosY >= %st_py - 1 && #CharPosY <= %st_py + 1
    set %st_c #true
  if %st_a <> %st_e && %st_c = #true
  {
    set %st_e %st_e , _(the_client's_own_walk_stopped_next_to_it)
    gosub st_note 8.02.there event_PathFind_x_y_z_walks_there %fx_pf
  }
  else
    gosub st_eq 8.02.there event_PathFind_x_y_z_walks_there %fx_pf
  event pathfind %st_px %st_py %st_pz
  waitfor #CharPosX = %st_px && #CharPosY = %st_py %st_tw5
  set %st_a #CharPosX , / , #CharPosY
  set %st_e %st_px , / , %st_py
  gosub st_eq 8.02.back and_back %fx_pf
return

sub st_c803
  gosub st_case 8.03 path_find_and_path_walk
  if %st_run = 0
    return
  gosub st_need 1.05
  gosub st_walkcheck
  if S notin %st_walkok
  {
    gosub st_skip 8.03 path_walk the_tiles_south_are_not_walkable
    return
  }
  set %st_px #CharPosX
  set %st_py #CharPosY
  set %st_ty %st_py + 2
  path find %st_px %st_ty
  set %st_a #PathState , / , #PathCnt
  set %st_e ok/2
  gosub st_eq 8.03.find path_find_two_tiles_south_plans_2_steps %fx_pathc
  set %st_a #PathX , / , #PathY
  set %st_e %st_px , / , %st_ty
  gosub st_eq 8.03.end the_route_ends_on_the_tile %fx_pathc
  path walk
  set %st_a #PathState , / , #CharPosX , / , #CharPosY
  set %st_e arrived/ , %st_px , / , %st_ty
  set %st_f %fx_macro , / , %fx_step
  gosub st_eq 8.03.walk path_walk_arrives_there %st_f
return

sub st_c804
  gosub st_case 8.04 path_go
  if %st_run = 0
    return
  gosub st_need 1.05
  set %st_tx %st_opt_x
  set %st_ty %st_opt_y
  set %st_tz %st_opt_z
  if %st_tx = N/A
  {
    set %st_tx #CharPosX
    set %st_ty #CharPosY - 2
    set %st_tz #CharPosZ
  }
  path go %st_tx %st_ty %st_tz 0 %st_tw15
  set %st_a #PathState , / , #CharPosX , / , #CharPosY
  set %st_e arrived/ , %st_tx , / , %st_ty
  set %st_f %fx_macro , / , %fx_step
  gosub st_eq 8.04 path_go_back_to_the_test_spot %st_f
return

sub st_c805
  gosub st_case 8.05 path_step
  if %st_run = 0
    return
  gosub st_need 1.05
  gosub st_walkcheck
  if E notin %st_walkok
  {
    gosub st_skip 8.05 path_step the_tiles_east_are_not_walkable
    return
  }
  set %st_px #CharPosX
  set %st_py #CharPosY
  set %st_pz #CharPosZ
  set %st_tx %st_px + 2
  path find %st_tx %st_py
  set %st_n 0
  repeat
    path step
    wait 1
    set %st_n %st_n + 1
  until #PathState <> walking || %st_n > 300
  set %st_a #PathState , / , #CharPosX
  set %st_e arrived/ , %st_tx
  set %st_f %fx_macro , / , %fx_step
  gosub st_eq 8.05.walk path_step_in_a_loop_arrives %st_f
  path go %st_px %st_py %st_pz 0 %st_tw10
return

sub st_c806
  gosub st_case 8.06 path_check:_the_client's_own_step_check
  if %st_run = 0
    return
  gosub st_need 1.05
  path check #CharPosX #CharPosY
  set %st_a #PathState , / , #PathZ
  set %st_e ok/ , #CharPosZ
  gosub st_eq 8.06.own path_check_on_your_own_tile_is_ok_at_#CharPosZ %fx_step
  set %st_tx #CharPosX + 1
  path can %st_tx #CharPosY
  set %st_cs #PathState
  set %st_cz #PathZ
  path check %st_tx #CharPosY #CharPosZ 2
  set %st_a #PathState , / , #PathZ
  set %st_e %st_cs , / , %st_cz
  if %st_cs <> ok
    set %st_e blocked/0
  gosub st_soft 8.06.east path_check_east_agrees_with_path_can %fx_step
return

; ###########################################################################
;  STAGE 9  combat (opt-in: attacks a monster)
; ###########################################################################
sub st_s9
  gosub st_stage_begin 9 %st_sn9
  gosub st_hook_warn
  if %st_stop = 1
    return
  gosub st_setup_once
  set %st_mob N/A
  gosub st_c901
  gosub st_c902
  gosub st_c903
  ; peace, and the monster goes
  if G in #CharStatus
    event macro 6 0
  if %st_mob <> N/A && %st_staffok = 1
    gosub st_cl_restore %st_mob
return

sub st_c901
  gosub st_case 9.01 Macro_27:_attack_last
  if %st_run = 0
    return
  if %st_staffok = 1
  {
    ; a rat with 120 hits, held in place, so a few blows don't kill it
    gosub st_spawn Rat
    set %st_mob %st_newid
    if %st_mob <> N/A
      gosub st_oset %st_mob HitsMaxSeed 120 Hits 120
  }
  else
  {
    ; you point at the monster yourself: "nearest" may be your own pet
    set %st_prompt This_stage_makes_your_character_ATTACK.$
      +$Stand_within_2_tiles_of_a_weak_monster_you_don't_mind_fighting_(not_a_pet,_not_a_vendor).$
      +$Press_Pass,_then_click_the_monster_with_the_target_cursor_the_script_shows.$
      +$Skip_skips_the_combat_stage.
    gosub st_confirm
    if %st_go = 1
    {
      set %st_lt0 #LTargetID
      set #TargCurs 1
      waitfor #TargCurs = 0 %st_tw30
      if #LTargetID <> %st_lt0 && #LTargetID <> #CharID
        set %st_mob #LTargetID
    }
  }
  if %st_mob = N/A
  {
    gosub st_skip 9.01 attack_last no_monster
    return
  }
  set %st_old 0
  if G in #CharStatus
    set %st_old 1
  gosub st_cl_changed war_mode macro6
  set #LTargetID %st_mob
  set #LTargetKind 1
  event macro 27 0
  waitfor #EnemyID = %st_mob %st_tw5
  set %st_a #EnemyID
  set %st_e %st_mob
  set %st_f %fx_macro , / , %fx_enemy
  gosub st_eq 9.01 event_macro_27_attacks_#LTargetID:_#EnemyID %st_f
return

sub st_c902
  gosub st_case 9.02 EnemyHits_falls
  if %st_run = 0
    return
  gosub st_need 9.01
  set %st_e0 #EnemyHits
  set %st_a %st_e0
  set %st_lo 0
  set %st_hi 100
  gosub st_rng 9.02.range EnemyHits_is_a_percentage %fx_enemyhp
  waitfor #EnemyHits < %st_e0 %st_tw15
  set %st_a %st_e0 , _then_ , #EnemyHits
  set %st_c #EnemyHits < %st_e0
  set %st_e lower
  gosub st_ok 9.02.falls EnemyHits_falls_as_you_hit_it %fx_enemyhp
return

sub st_c903
  gosub st_case 9.03 Macros_52_and_53:_attack_selected
  if %st_run = 0
    return
  gosub st_need 9.01
  ; the monster must be the selected one before Attack Selected: "nearest" may be your pet (live on
  ; 7.0.117.33 it was the pet on your tile), and macro 53 would attack it
  gosub st_selmob %st_mob
  set %st_a #LTargetID
  set %st_e %st_mob
  gosub st_eq 9.03.select the_targeting_macros_select_the_monster %fx_macro
  if #LTargetID <> %st_mob
    return
  event macro 53 0
  wait 20
  set %st_a #EnemyID
  set %st_e %st_mob
  set %st_f %fx_macro , / , %fx_enemy
  gosub st_eq 9.03.attack event_macro_53_attacks_the_selected_one %st_f
return

; ###########################################################################
;  STAGE 10  vendor (opt-in)
; ###########################################################################
sub st_s10
  gosub st_stage_begin 10 %st_sn10
  gosub st_hook_warn
  if %st_stop = 1
    return
  gosub st_setup_once
  set %st_vendor N/A
  set %st_shopok 0
  gosub st_c1001
  gosub st_c1002
  gosub st_c1003
  key esc
  if %st_vendor <> N/A && %st_staffok = 1
    gosub st_cl_restore %st_vendor
return

sub st_c1001
  gosub st_case 10.01 getshopinfo_and_the_shop_variables
  if %st_run = 0
    return
  if %st_staffok = 1
  {
    gosub st_spawn Provisioner
    set %st_vendor %st_newid
    if %st_vendor <> N/A
    {
      finditem %st_vendor G_3
      set %st_a #FindRep
      set %st_e 7
      gosub st_soft 10.01.rep FindRep_of_an_invulnerable_vendor_is_7 %fx_rep
    }
    ; a vendor does not hear a character it can't see (ModernUO: hidden staff): unhidden until the clean-up
    if H in #CharStatus
    {
      gosub st_sget Hidden
      set %st_old %st_gn
      gosub st_cl_changed Hidden staffset
      gosub st_staff self set Hidden false
      waitfor H notin #CharStatus %st_tw3
    }
    set %st_say vendor_buy
    gosub st_pace
    msg vendor buy$
  }
  else
  {
    set %st_prompt Stand_next_to_a_vendor_and_open_its_BUY_window_(say_vendor_buy),_then_press_Pass.
      +_Skip_skips_the_vendor_stage.
    gosub st_confirm
    if %st_go = 0
    {
      gosub st_skip 10.01 vendor skipped_by_you
      return
    }
  }
  set %st_n 0
  repeat
    wait 5
    getshopinfo
    set %st_n %st_n + 1
  until #ShopCnt > 0 || %st_n > 20
  set %st_a #ShopCnt
  set %st_lo 1
  set %st_hi 1000
  gosub st_rng 10.01.cnt getshopinfo_finds_the_entries %fx_shop
  if #ShopCnt = 0
    return
  set %st_shopok 1
  set %st_a #ShopCurPos
  set %st_hi #ShopCnt
  gosub st_rng 10.01.pos ShopCurPos_is_an_entry %fx_shop
  set %st_a #ShopItemType
  gosub st_has 10.01.type ShopItemType %fx_shop
  set %st_a #ShopItemID
  gosub st_has 10.01.id ShopItemID %fx_shop
  set %st_a #ShopItemPrice
  set %st_lo 1
  set %st_hi 10000000
  gosub st_rng 10.01.price ShopItemPrice_is_a_price %fx_shop
  set %st_a #ShopItemMax
  set %st_hi 100000
  gosub st_rng 10.01.max ShopItemMax_is_a_stock %fx_shop
  set %st_a #ShopItemName
  gosub st_has 10.01.name ShopItemName %fx_shop
  set %st_t #ShopItemName + 0
  if %st_t > 0
  {
    set %st_e an_item_name
    gosub st_note 10.01.cliloc ShopItemName_is_a_cliloc_number_(the_shard_sends_it_so) %fx_shop
  }
  set %st_shopid #ShopItemID
  set %st_shoptype #ShopItemType
  set %st_shopprice #ShopItemPrice
return

sub st_c1002
  gosub st_case 10.02 The_shop_entry_is_an_item_FindItem_sees
  if %st_run = 0
    return
  if %st_shopok = 0
  {
    gosub st_skip 10.02 shop_item no_shop_gump
    return
  }
  finditem %st_shopid A
  set %st_a #FindType
  set %st_e %st_shoptype
  gosub st_eq 10.02 finditem_#ShopItemID_has_the_#ShopItemType %fx_shop
return

sub st_c1003
  gosub st_case 10.03 setshopitem_and_buying
  if %st_run = 0
    return
  if %st_shopok = 0
  {
    gosub st_skip 10.03 setshopitem no_shop_gump
    return
  }
  set %st_prompt In_the_vendor's_buy_window,_double-click_the_FIRST_entry_once,_so_it_goes_into_your_buy_list
    +_with_an_amount_of_1._Then_press_Pass.$$The_script_will_then_set_the_amount_to_3_with_setshopitem
    +_and_ask_you_to_press_the_buy_list's_Accept_button:_you_buy_3_of_them.$Skip_=_skip_this_check.
  gosub st_confirm
  if %st_go = 0
  {
    gosub st_skip 10.03 setshopitem skipped_by_you
    return
  }
  getshopinfo
  set %st_shopid #ShopItemID
  set %st_shoptype #ShopItemType
  set %st_shopprice #ShopItemPrice
  set %st_g0 #Gold
  gosub st_typecount %st_shoptype
  set %st_tc0 %st_tcn
  ; with staff commands what you buy is deleted at the end and its price given back
  if %st_staffok = 1
    gosub st_newitem_begin %st_shoptype B
  setshopitem %st_shopid 3
  set %st_prompt The_script_ran:_setshopitem_ , %st_shopid , _3$
    +$Now_press_Accept_in_the_buy_list_(the_list_may_still_show_1:_the_amount_is_set_anyway),_then_press_Pass.
  gosub st_confirm
  if %st_go = 0
  {
    gosub st_skip 10.03 setshopitem skipped_by_you
    return
  }
  ; what arrives in the backpack, piles counted: the gold does not show it for staff, who buy for
  ; free on ModernUO (BaseVendor: AccessLevel GameMaster or higher)
  set %st_bi 0
  repeat
    wait 5
    gosub st_typecount %st_shoptype
    set %st_t %st_tcn - %st_tc0
    set %st_bi %st_bi + 1
  until %st_t >= 3 || %st_bi > 20
  set %st_a %st_t
  set %st_e 3
  gosub st_eq 10.03.count setshopitem_3_buys_3_(the_backpack_gets_3) %fx_bill
  set %st_g1 %st_g0 - 3 * %st_shopprice
  if %st_staffok = 0
  {
    waitfor #Gold = %st_g1 %st_tw5
    set %st_a #Gold
    set %st_e %st_g1
    gosub st_eq 10.03.gold Gold_falls_by_3_prices %fx_bill
  }
  if %st_staffok = 1
  {
    gosub st_newitems_all Bought
    set %st_t %st_g0 - #Gold
    if %st_t > 0
    {
      set %st_old %st_t
      gosub st_cl_changed gold_spent gold
    }
  }
return

; how many objects of type %1 the backpack holds, piles counted -> %st_tcn
sub st_typecount
  set %st_tct %1
  set %st_tcn 0
  finditem %st_tct CA_ , #BackpackID
  set %st_tcc #FindCnt
  if %st_tcc > 0
  {
    for %st_tci 1 %st_tcc
    {
      set #FindIndex %st_tci
      set %st_tcn %st_tcn + #FindStack
    }
  }
return

; every object of %st_nit that was not there at st_newitem_begin, recorded for the clean-up
; (st_newitem_end records only the first one); %1 = what
sub st_newitems_all
  set %st_niwhat %1
  wait 10
  gosub st_newitem_scan
  if %st_nic > 0
  {
    for %st_nii 1 %st_nic
    {
      set #FindIndex %st_nii
      set %st_nik | , #FindID , |
      if %st_nik notin %st_niold
        gosub st_cl_created #FindID %st_niwhat
    }
  }
return

; ###########################################################################
;  STAGE 11  pets and mount (opt-in)
; ###########################################################################
sub st_s11
  gosub st_stage_begin 11 %st_sn11
  gosub st_hook_warn
  if %st_stop = 1
    return
  gosub st_setup_once
  set %st_pet N/A
  set %st_own N/A
  set %st_mounted 0
  gosub st_c1101
  gosub st_c1102
  gosub st_c1103
  gosub st_c1104
  gosub st_c1105
  ; the newest entry first: the pet's name (11.02), then the horse itself
  if %st_pet <> N/A && %st_staffok = 1
  {
    gosub st_cl_restore %st_pet
    gosub st_cl_restore %st_pet
  }
  ; the mount you rode when the stage began (11.04 got you off it)
  if %st_own <> N/A
    gosub st_cl_restore %st_own
return

sub st_c1101
  gosub st_case 11.01 A_pet_and_#Followers
  if %st_run = 0
    return
  set %st_f0 #Followers
  if %st_staffok = 1
  {
    gosub st_spawn Horse
    set %st_pet %st_newid
    if %st_pet <> N/A
    {
      set %st_in #CharID
      gosub st_id2ser
      gosub st_oset %st_pet Controlled true ControlMaster %st_ser
      set %st_t %st_f0 + 1
      waitfor #Followers = %st_t %st_tw5
      set %st_a #Followers
      set %st_e %st_t
      gosub st_eq 11.01 Followers_grows_by_the_horse's_slot %fx_ext
    }
    else
      gosub st_skip 11.01 pet the_horse_was_not_made
    return
  }
  set %st_prompt Pets_stage:_press_Pass,_then_click_ONE_OF_YOUR_PETS_(a_horse_you_can_ride_is_best)
    +_with_the_target_cursor_the_script_shows._Skip_=_you_have_no_pet_here.
  gosub st_confirm
  if %st_go = 0
  {
    gosub st_skip 11.01 pet skipped_by_you
    return
  }
  set %st_lt0 #LTargetID
  set #TargCurs 1
  waitfor #TargCurs = 0 %st_tw30
  if #LTargetID <> %st_lt0
    set %st_pet #LTargetID
  set %st_a %st_pet
  gosub st_info 11.01 the_pet_you_picked %fx_ext
return

sub st_c1102
  gosub st_case 11.02 exevent_RenamePet
  if %st_run = 0
    return
  if %st_pet = N/A
  {
    gosub st_skip 11.02 renamepet no_pet
    return
  }
  event property %st_pet
  wait 15
  str part #Property $ 1
  set %st_old #StrRes
  gosub st_cl_changed %st_pet petname
  set %st_tokn %st_tokn + 1
  set %st_t %st_tokn % 26 + 1
  str mid %st_alpha %st_t 1
  set %st_pname Euotest , #StrRes
  exevent renamepet %st_pet %st_pname
  wait 20
  if %st_staffok = 1
  {
    set %st_sj #JIndex
    gosub st_oget %st_pet Name
    set %st_a %st_gv
    set %st_e %st_q , %st_pname , %st_q
    gosub st_sval 11.02.server the_shard_has_the_new_name %fx_send
  }
  event property %st_pet
  wait 15
  set %st_a #Property
  set %st_c %st_pname in #Property
  set %st_e starts_with_ , %st_pname
  gosub st_ok 11.02.prop event_Property_shows_the_new_name %fx_prop
  if %st_staffok = 0
    gosub st_cl_restore %st_pet
return

sub st_c1103
  gosub st_case 11.03 event_StatBar_of_the_pet
  if %st_run = 0
    return
  if %st_pet = N/A
  {
    gosub st_skip 11.03 statbar no_pet
    return
  }
  ; your status window and a health bar are both status_gump: a new gump on top changes the size
  ; or the place too
  set %st_n0 #ContName , _ , #ContSizeX , _ , #ContSizeY , _ , #ContPosX , _ , #ContPosY
  event statbar %st_pet
  set %st_pi 0
  repeat
    wait 5
    set %st_n1 #ContName , _ , #ContSizeX , _ , #ContSizeY , _ , #ContPosX , _ , #ContPosY
    set %st_pi %st_pi + 1
  until %st_n1 <> %st_n0 || %st_pi > 12
  set %st_a #ContName , / , #ContHP
  set %st_c ( %st_n1 <> %st_n0 ) && ( #ContName = status_gump ) && ( #ContHP >= 1 ) && ( #ContHP <= 100 )
  set %st_e a_new_status_gump_with_#ContHP_1_to_100
  gosub st_ok 11.03 event_StatBar_opens_the_pet's_health_bar %fx_statbar
  ; close it with a right click in its middle, only if it came (not another gump)
  if %st_n1 <> %st_n0
  {
    set %st_gx #ContPosX + #ContSizeX / 2
    set %st_gy #ContPosY + #ContSizeY / 2
    click %st_gx %st_gy r
    wait 10
  }
  gosub st_status_keep
return

sub st_c1104
  gosub st_case 11.04 Mounting:_#MountID_and_#MountType
  if %st_run = 0
    return
  if %st_pet = N/A
  {
    gosub st_skip 11.04 mount no_pet
    return
  }
  ; the shard refuses a second mount ("Please dismount first"): you get off the one you ride, and
  ; the end of the stage gets you on it again (live on 7.0.117.33: the run began on the beetle)
  if #MountID <> N/A
  {
    gosub st_mount_before
    set #LObjectID #CharID
    event macro 17 0
    waitfor #MountID = N/A %st_tw5
    if #MountID <> N/A
    {
      gosub st_skip 11.04 mount you_ride_a_mount_that_did_not_let_you_off
      return
    }
    wait 10
    gosub st_mount_find
    set %st_old riding
    if %st_own <> N/A
      gosub st_cl_changed %st_own mount
    else
      gosub st_cl_changed your_mount mount
  }
  set #LObjectID %st_pet
  event macro 17 0
  waitfor #MountID <> N/A %st_tw5
  set %st_a #MountID
  gosub st_has 11.04.id double-clicking_the_horse_mounts_it:_#MountID %fx_mount
  if #MountID = N/A
    return
  set %st_mounted 1
  ; the horse items 0x3E9F to 0x3EA2
  set %st_mt |
  for %st_i 16031 16034
  {
    set %st_in %st_i
    gosub st_num2id
    set %st_mt %st_mt , %st_out , |
  }
  set %st_a #MountType
  set %st_t | , #MountType , |
  set %st_c %st_t in %st_mt
  set %st_e a_horse_item_(0x3E9F_to_0x3EA2)
  if %st_staffok = 0
    set %st_c #MountType <> N/A
  gosub st_ok 11.04.type MountType_is_a_mount_item %fx_mount
  finditem #MountID A
  set %st_a #FindLayer
  set %st_e 25
  gosub st_eq 11.04.layer the_mount_item_is_in_layer_25 %fx_layer
return

sub st_c1105
  gosub st_case 11.05 Dismounting
  if %st_run = 0
    return
  gosub st_need 11.04
  ; only after 11.04 put you on the horse: a double click on yourself would get you off your own
  ; mount, or open your paperdoll and pass with nothing tested
  if %st_mounted <> 1
  {
    gosub st_skip 11.05 dismount 11.04_did_not_mount_the_horse
    return
  }
  set #LObjectID #CharID
  event macro 17 0
  waitfor #MountID = N/A %st_tw5
  set %st_a #MountID
  set %st_e N/A
  gosub st_eqna 11.05 double-clicking_yourself_dismounts:_#MountID_N/A %fx_mount
  key esc
return

; what is around you before you get off your mount -> %st_mids0
sub st_mount_before
  set %st_mids0 |
  finditem * G_1
  if #FindCnt = 0
    return
  for %st_mfi 1 #FindCnt
  {
    set #FindIndex %st_mfi
    set %st_mids0 %st_mids0 , #FindID , |
  }
return

; the mount you just got off: what is new next to you, not you or the test horse -> %st_own
; (not by #FindRep: it read 255 for every mobile on client_beta 7.0.117.31)
sub st_mount_find
  set %st_own N/A
  finditem * G_1
  if #FindCnt = 0
    return
  for %st_mfi 1 #FindCnt
  {
    set #FindIndex %st_mfi
    set %st_mk | , #FindID , |
    if #FindID <> #CharID && #FindID <> %st_pet && %st_mk notin %st_mids0
      set %st_own #FindID
  }
return

; ###########################################################################
;  STAGE 12  buffs (opt-in)
; ###########################################################################
sub st_s12
  gosub st_stage_begin 12 %st_sn12
  gosub st_hook_warn
  if %st_stop = 1
    return
  gosub st_setup_once
  set %st_bn 0
  set %st_bok 0
  set %st_timed 0
  set %st_id1 0
  set %st_bb0 #BuffBarOpen
  gosub st_c1201
  gosub st_c1202
  gosub st_c1203
  gosub st_c1204
  gosub st_c1205
  ; Protection off again (12.01 turned it on), then the buff bar as it was
  gosub st_cl_restore Protection
  if %st_bb0 = #false && #BuffBarOpen = #true
  {
    event macro 57 0
    waitfor #BuffBarOpen = #false %st_tw3
  }
return

sub st_c1201
  gosub st_case 12.01 Buffs_on_the_character
  if %st_run = 0
    return
  if #BuffBarOpen = N/A
  {
    gosub st_skip 12.01 buffs no_buff_bar_layout_for_this_client
    gosub st_block 12.01
    return
  }
  if #BuffBarOpen = #false
  {
    event macro 57 0
    waitfor #BuffBarOpen = #true %st_tw3
  }
  if %st_staffok = 1
  {
    gosub st_ensure_magery
    set %st_t #MaxMana
    gosub st_staff self set Mana %st_t
    gosub st_cancel_cursor
    ; Bless (has a timer) on yourself
    event macro 15 16
    gosub st_wait_cursor
    event macro 23 0
    set %st_pi 0
    repeat
      wait 5
      scanbuffs 30018
      set %st_pi %st_pi + 1
    until #BuffCnt > 0 || %st_pi > 12
    ; the next spell only after the cast recovery
    wait 40
    ; then Protection, which stays on until it is cast again (even after logging out or dying): the
    ; number of buffs shows whether the cast turned it on (the clean-up casts it again) or off (it
    ; was on already: cast again now)
    scanbuffs
    set %st_pn0 #BuffCnt
    event macro 15 14
    set %st_pi 0
    repeat
      wait 5
      scanbuffs
      set %st_pi %st_pi + 1
    until #BuffCnt <> %st_pn0 || %st_pi > 30
    gosub st_cancel_cursor
    set %st_pst the_cast_changed_nothing
    if #BuffCnt > %st_pn0
    {
      set %st_pst turned_on_(the_end_of_the_stage_turns_it_off)
      set %st_old off
      gosub st_cl_changed Protection buff
    }
    if #BuffCnt < %st_pn0
    {
      ; it was on: on again, up to three tries
      set %st_pj 0
      repeat
        wait 40
        scanbuffs
        set %st_pn1 #BuffCnt
        event macro 15 14
        set %st_pi 0
        repeat
          wait 5
          scanbuffs
          set %st_pi %st_pi + 1
        until #BuffCnt > %st_pn1 || %st_pi > 30
        set %st_pj %st_pj + 1
      until #BuffCnt > %st_pn1 || %st_pj >= 3
      gosub st_cancel_cursor
      set %st_pst it_was_on:_the_cast_turned_it_off_then_on_again
      if #BuffCnt <= %st_pn1
        set %st_pst it_was_on:_the_cast_turned_it_off_and_NOT_on_again_(cast_Protection)
    }
    set %st_a %st_pst
    gosub st_info 12.01.prot Protection %fx_buff
  }
  else
  {
    set %st_prompt Buffs_stage:_put_2_or_3_different_buffs_on_your_character,_at_least_one_with_a_timer
      +_(Bless,_Curse_or_Strength._Hiding_has_none),_then_press_Pass._Skip_skips_the_buffs_stage.
    gosub st_confirm
    if %st_go = 0
    {
      gosub st_skip 12.01 buffs skipped_by_you
      gosub st_block 12.01
      return
    }
  }
  ; from here on the other buff checks can run (a skip above skips them all)
  set %st_bok 1
  set %st_a #BuffBarOpen
  set %st_e #true
  set %st_f %fx_macro , / , %fx_buff
  gosub st_eq 12.01.open BuffBarOpen_is_true_with_the_bar_open %st_f
  scanbuffs
  set %st_bn #BuffCnt
  set %st_a %st_bn
  set %st_lo 1
  set %st_hi 100
  gosub st_rng 12.01.cnt scanbuffs_finds_the_buffs %fx_buff
  if %st_staffok = 1
  {
    scanbuffs 30018
    set %st_a #BuffCnt
    set %st_e 1
    gosub st_eq 12.01.bless scanbuffs_30018_finds_Bless %fx_buff
    scanbuffs
  }
return

sub st_c1202
  gosub st_case 12.02 Every_buff_through_#BuffIndex
  if %st_run = 0
    return
  gosub st_need 12.01
  if %st_bn = 0
  {
    gosub st_skip 12.02 buffs no_buff_found
    return
  }
  st_rp_1202:
  scanbuffs
  set %st_a #BuffIndex
  set %st_e 1
  gosub st_eq 12.02.first scanbuffs_selects_the_first_buff %fx_buff
  set %st_list
  set %st_timed 0
  set %st_id1 0
  for %st_bi 1 %st_bn
  {
    set #BuffIndex %st_bi
    gosub st_buff_one
  }
  set #BuffIndex 1
  set %st_prompt EasyUO_reads_ , %st_bn , _buffs:$ , %st_list , $
    +Hover_each_icon_of_the_buff_bar:_do_the_names_and_times_match_the_tooltips?
    +_(the_client_refreshes_the_time_about_every_5_seconds)
  set %st_obs %st_bn , _buffs
  gosub st_human 12.02.seen buff_names_and_times_match_the_tooltips %fx_buffname
  if %st_again = 1
    goto st_rp_1202
return

; one buff of 12.02: #BuffIndex is already set
sub st_buff_one
  set %st_bid 12.02.b , %st_bi
  set %st_a #BuffIndex
  set %st_e %st_bi
  set %st_x %st_bid , .index
  gosub st_eq %st_x BuffIndex_reads_back %fx_buff
  set %st_a #BuffID
  set %st_lo 1
  set %st_hi 100000
  set %st_x %st_bid , .id
  gosub st_rng %st_x BuffID_is_an_icon_number %fx_buff
  set %st_a #BuffCliloc
  set %st_hi 10000000
  set %st_x %st_bid , .cliloc
  gosub st_rng %st_x BuffCliloc_is_a_cliloc_number %fx_buffname
  set %st_a #BuffName
  set %st_x %st_bid , .name
  gosub st_has %st_x BuffName %fx_buffname
  set %st_a #BuffTime
  set %st_lo -1
  set %st_hi 100000
  set %st_x %st_bid , .time
  gosub st_rng %st_x BuffTime_in_seconds_or_-1 %fx_bufftime
  set %st_ds #BuffDesc
  set %st_a %st_ds
  set %st_c ~ notin %st_ds
  set %st_e no_~N_NAME~_left
  set %st_x %st_bid , .desc
  gosub st_ok %st_x BuffDesc_has_its_arguments_filled_in %fx_buffname
  set %st_bt #BuffTime
  set %st_list %st_list , %st_bi , :_ , #BuffName , _( , %st_bt , s)$
  if %st_bi = 1
    set %st_id1 #BuffID
  if %st_timed = 0 && %st_bt > 0
  {
    set %st_timed 1
    set %st_tid #BuffID
    set %st_tt0 %st_bt
  }
return

sub st_c1203
  gosub st_case 12.03 BuffTime_counts_down
  if %st_run = 0
    return
  gosub st_need 12.01
  if %st_timed = 0
  {
    gosub st_skip 12.03 buff_time no_buff_with_a_timer
    return
  }
  wait %st_tw15
  scanbuffs %st_tid
  if #BuffCnt = 0
  {
    gosub st_skip 12.03 buff_time the_buff_ran_out_during_the_wait
    return
  }
  set %st_t1 #BuffTime
  set %st_a %st_tt0 , _then_ , %st_t1
  set %st_c ( %st_t1 <> N/A ) && ( %st_t1 < %st_tt0 )
  set %st_e lower_after_15_seconds
  gosub st_ok 12.03 BuffTime_goes_down %fx_bufftime
return

sub st_c1204
  gosub st_case 12.04 scanbuffs_with_an_icon_ID
  if %st_run = 0
    return
  gosub st_need 12.01
  if %st_bn = 0
  {
    gosub st_skip 12.04 scanbuffs_id no_buff_found
    return
  }
  scanbuffs %st_id1
  set %st_a #BuffCnt , / , #BuffID
  set %st_c ( #BuffCnt >= 1 ) && ( #BuffID = %st_id1 )
  set %st_e 1+/ , %st_id1
  gosub st_ok 12.04.keep scanbuffs_with_the_first_icon_ID_keeps_it %fx_buff
  scanbuffs 1
  set %st_a #BuffCnt , / , #BuffName
  set %st_c ( #BuffCnt = 0 ) && ( #BuffName = N/A )
  set %st_e 0/N/A
  gosub st_ok 12.04.none scanbuffs_with_an_ID_not_there_finds_nothing %fx_buff
  scanbuffs
  set %st_a #BuffCnt
  set %st_e %st_bn
  gosub st_soft 12.04.all scanbuffs_without_an_ID_finds_them_all_again %fx_buff
return

sub st_c1205
  gosub st_case 12.05 The_buff_bar_closed
  if %st_run = 0
    return
  gosub st_need 12.01
  if %st_bok <> 1
  {
    gosub st_skip 12.05 buff_bar 12.01_did_not_run
    return
  }
  event macro 57 0
  waitfor #BuffBarOpen = #false %st_tw3
  set %st_a #BuffBarOpen
  set %st_e #false
  set %st_f %fx_macro , / , %fx_buff
  gosub st_eq 12.05.closed event_macro_57_closes_the_bar:_#BuffBarOpen_false %st_f
  scanbuffs
  set %st_a #BuffCnt
  set %st_e 0
  gosub st_eq 12.05.empty scanbuffs_with_the_bar_closed_finds_0 %fx_buff
  event macro 57 0
  waitfor #BuffBarOpen = #true %st_tw3
  set %st_a #BuffBarOpen
  set %st_e #true
  gosub st_eq 12.05.open event_macro_57_opens_it_again %st_f
  scanbuffs
  set %st_a #BuffCnt
  set %st_c #BuffCnt >= 1
  set %st_e at_least_1
  gosub st_ok 12.05.again the_buffs_are_read_again %fx_buff
return

; ###########################################################################
;  HELPERS: once per run, at the first stage that types (4 and later)
; ###########################################################################
;  Asks the shard whether staff commands work, and (with them) goes to the test spot,
;  so a run that starts at a later stage is set up like a full one.
sub st_setup_once
  if %st_staffprobed = 0
  {
    gosub st_staff_probe
    set %st_staffprobed 1
  }
  if %st_spotdone = 0 && %st_staffok = 1
  {
    gosub st_spot_go
    set %st_spotdone 1
  }
  ; a stage that begins away from the test spot goes back first (live on client_beta 7.0.117.31 a
  ; run moved 25 tiles off between stages 4 and 6, and 6.05 found no static there)
  if %st_spotdone = 1 && %st_staffok = 1
  {
    if #CharPosX <> %st_opt_x || #CharPosY <> %st_opt_y || #CursKind <> %st_opt_facet
      gosub st_spot_go
  }
  if %st_scur >= 5
    gosub st_status_keep
return

; The client keeps your status values (name, stats, gold...) only while one of your status gumps is
; open: the status window or your health bar (live on 7.0.117.33: closing them set every one to N/A).
; From the event-hook stages on, the status window is opened again whenever they are missing.
sub st_status_keep
  if #Str <> N/A || #CliLogged <> 1
    return
  event macro 8 2
  waitfor #Str <> N/A %st_tw3
return

; ###########################################################################
;  HELPERS: warnings
; ###########################################################################
sub st_hands_warn
  if %st_handswarned = 1
    return
  set %st_handswarned 1
  set %st_pmsg Hands_off:_the_script_types_into_the_client_and_moves_the_mouse_until_the_run_ends.
  gosub st_pan_note
  set %st_prompt From_now_on_the_script_types_into_the_UO_client_and_moves_the_mouse.$
    +$Don't_type_and_don't_move_the_mouse_until_the_run_ends:_the_client_reads_the_real_cursor,
    +_and_text_you_type_would_mix_with_the_script's.$$Pass_=_go_on,_Stop_=_end_the_run_here.
  gosub st_pan_hold
return

sub st_hook_warn
  gosub st_hands_warn
  if %st_hookwarned = 1 || %st_stop = 1
    return
  set %st_hookwarned 1
  set %st_prompt The_next_checks_run_client_code_through_the_EVENT_HOOK_(event,_exevent,_event_macro,_path).$
    +$If_an_E_value_in_uoclidata.pas_is_wrong_for_this_client,_the_client_can_FREEZE_or_CRASH.
    +_The_report_is_written_before_every_check,_so_a_crash_loses_at_most_that_check,
    +_and_the_next_run_offers_to_resume_and_to_clean_up.$$Pass_=_go_on,_Stop_=_end_the_run_here.
  gosub st_pan_hold
  set %st_pmsg Event_hook_stages:_hands_off_the_keyboard_and_mouse.
  gosub st_pan_note
return

; ###########################################################################
;  HELPERS: staff commands (ModernUO)
; ###########################################################################
;  gosub st_staff word word ...  types <prefix>word word ... and Enter.
;  %st_sj is #JIndex before the command, for findjournal.
sub st_staff
  set %st_sc %st_pfx , %1
  if %0 >= 2
    set %st_sc %st_sc , #spc , %2
  if %0 >= 3
    set %st_sc %st_sc , #spc , %3
  if %0 >= 4
    set %st_sc %st_sc , #spc , %4
  if %0 >= 5
    set %st_sc %st_sc , #spc , %5
  if %0 >= 6
    set %st_sc %st_sc , #spc , %6
  if %0 >= 7
    set %st_sc %st_sc , #spc , %7
  if %0 >= 8
    set %st_sc %st_sc , #spc , %8
  if %0 >= 9
    set %st_sc %st_sc , #spc , %9
  set %st_say %st_sc
  gosub st_pace
  set %st_sj #JIndex
  log staff: %st_sc
  msg %st_sc , $
  wait 10
  ; the client still queued it: slow down (a third slower each time, 4 characters a second at least)
  if %ST_FAST = 0
  {
    findjournal %st_sj * 0 Spam_detected
    if #JFound > 0
    {
      set %st_spamhits %st_spamhits + 1
      set %st_prate %st_prate * 2
      set %st_prate %st_prate / 3
      if %st_prate < 4
        set %st_prate 4
      log the client queued a staff command: speech pace now %st_prate characters a second
    }
  }
return

; Waits until the client will send the line %st_say at once, then counts it. The client sends speech at
; once only while its spam meter is below the SpamLimit option (30 by default); each line adds its
; length, and the meter drains by SpamLimit a second, computed once a game tick (76 ms or more) and
; rounded down, which makes 20 to 26 a second (13 or less on client_beta 7.0.117.31: its two tick
; functions $592720 and $592B10 each call the drain $594E20 on their own timer). Above it the client queues the line ("[Spam detected,
; speech queued for N seconds]") and staff answers come late: the clean-up and the staff checks typed
; too fast for it. Read from client.exe 7.0.117.33 ($5AB120 the test, $5AB140 the count, $5AF830 the
; drain, called from the game tick $5AFE60); client_beta has the same message. The script keeps its own
; copy of the meter at the slowest drain (%st_prate) and stays well below the limit (%st_pmax), as the
; player may speak too.
sub st_pace
  if %ST_FAST = 1
    return
  str len %st_say
  set %st_pn #StrRes
  repeat
    set %st_pnow #SCnt2
    set %st_pd %st_pnow - %st_plast
    set %st_pd %st_pd * %st_prate
    set %st_pd %st_pd / 10
    set %st_pm %st_pm - %st_pd
    if %st_pm < 0
      set %st_pm 0
    set %st_plast %st_pnow
    if %st_pm > %st_pmax
      wait 2
  until %st_pm <= %st_pmax
  set %st_pm %st_pm + %st_pn
return

; is the shard answering staff commands? -> %st_staffok, %st_stafflvl
sub st_staff_probe
  set %st_staffok 0
  set %st_stafflvl N/A
  if %st_staff <> 1
    return
  gosub st_staff self get AccessLevel
  findjournal %st_sj * %st_tw3 AccessLevel_=_
  if #JFound = 0
    return
  str part #Journal _=_ 2
  set %st_stafflvl #StrRes
  if %st_stafflvl <> Player && %st_stafflvl <> Counselor
    set %st_staffok 1
return

;  gosub st_sget Prop : [self get Prop -> %st_gok, %st_gv (all after "= "), %st_gn (its first word)
sub st_sget
  set %st_gp %1
  set %st_gok 0
  set %st_gv N/A
  set %st_gn N/A
  if %st_staffok = 0
    return
  gosub st_staff self get %st_gp
  gosub st_sget_read
return

sub st_sget_read
  set %st_gt %st_gp , _=_
  findjournal %st_sj * %st_tw3 %st_gt
  if #JFound = 0
    return
  set %st_gok 1
  set %st_t #Journal
  str part %st_t _=_ 2
  set %st_gv #StrRes
  str part %st_gv _ 1
  set %st_gn #StrRes
return

;  gosub st_oget <id> Prop : [serial <n> get Prop, results as st_sget
sub st_oget
  set %st_oi %1
  set %st_gp %2
  set %st_gok 0
  set %st_gv N/A
  set %st_gn N/A
  if %st_staffok = 0
    return
  set %st_in %st_oi
  gosub st_id2ser
  gosub st_staff serial %st_ser get %st_gp
  gosub st_sget_read
return

;  gosub st_oset <id> prop value ... : [serial <n> set prop value ...
sub st_oset
  set %st_oi %1
  set %st_o2 %2
  set %st_o3 %3
  set %st_o4 %4
  set %st_o5 %5
  set %st_o6 %6
  set %st_o7 %7
  set %st_on %0
  set %st_in %st_oi
  gosub st_id2ser
  if %st_on = 3
    gosub st_staff serial %st_ser set %st_o2 %st_o3
  if %st_on = 5
    gosub st_staff serial %st_ser set %st_o2 %st_o3 %st_o4 %st_o5
  if %st_on = 7
    gosub st_staff serial %st_ser set %st_o2 %st_o3 %st_o4 %st_o5 %st_o6 %st_o7
return

; %st_in 0x1A2B (or a plain number) -> %st_out decimal
sub st_hex
  set %st_out %st_in
  if 0x in %st_in
  {
    str replace %st_in 0x $
    set %st_out #StrRes + 0
  }
return

; %st_in 47 or 47.3 -> %st_out in tenths
sub st_tenths
  str part %st_in #dot 1
  set %st_out #StrRes * 10
  str part %st_in #dot 2
  if #StrRes <> N/A
  {
    str left #StrRes 1
    set %st_out %st_out + #StrRes
  }
return

; %st_gn, a ModernUO Direction -> %st_dn 0..7
sub st_dirnum
  set %st_dn %st_gn
  if %st_gn = North
    set %st_dn 0
  if %st_gn = Right
    set %st_dn 1
  if %st_gn = East
    set %st_dn 2
  if %st_gn = Down
    set %st_dn 3
  if %st_gn = South
    set %st_dn 4
  if %st_gn = Left
    set %st_dn 5
  if %st_gn = West
    set %st_dn 6
  if %st_gn = Up
    set %st_dn 7
  if %st_dn >= 8
    set %st_dn %st_dn % 8
return

; ---- EasyUO IDs and serials ----------------------------------------------
;  EasyUO writes a number n as ((n xor 69) + 7) in base 26, A = 0, lowest digit first.
;  xor 69 flips the bits 1, 4 and 64.
sub st_id2ser
  set %st_ser 0
  str len %st_in
  set %st_il #StrRes
  if %st_il = 0
    return
  for %st_ij %st_il 1
  {
    str mid %st_in %st_ij 1
    str pos %st_alpha #StrRes
    set %st_ser %st_ser * 26 + #StrRes - 1
  }
  set %st_ser %st_ser - 7
  gosub st_xor69
return

; %st_in number -> %st_out EasyUO ID or type
sub st_num2id
  set %st_ser %st_in
  gosub st_xor69
  set %st_nn %st_ser + 7
  set %st_out
  repeat
    set %st_d %st_nn % 26 + 1
    str mid %st_alpha %st_d 1
    set %st_out %st_out , #StrRes
    set %st_nn %st_nn / 26
  until %st_nn = 0
return

sub st_xor69
  set %st_b ( %st_ser / 1 ) % 2
  if %st_b = 1
    set %st_ser %st_ser - 1
  else
    set %st_ser %st_ser + 1
  set %st_b ( %st_ser / 4 ) % 2
  if %st_b = 1
    set %st_ser %st_ser - 4
  else
    set %st_ser %st_ser + 4
  set %st_b ( %st_ser / 64 ) % 2
  if %st_b = 1
    set %st_ser %st_ser - 64
  else
    set %st_ser %st_ser + 64
return

; a word nobody else writes: %st_tok (the one before: %st_tokp). Never shown in the panel.
sub st_token
  set %st_tokp %st_tok
  set %st_tokn %st_tokn + 1
  set %st_tok euost , %st_tokb , x , %st_tokn
return

; PASS when %st_a = %st_e, NOTE otherwise (a shard or client setting can explain it)
sub st_soft
  set %st_x1 %1
  set %st_x2 %2
  set %st_x3 %3
  if %st_a = %st_e
    gosub st_rec PASS AUTO %st_x1 %st_x2 %st_x3
  else
    gosub st_rec NOTE AUTO %st_x1 %st_x2 %st_x3
return

; PASS when %st_c, NOTE otherwise
sub st_softok
  set %st_x1 %1
  set %st_x2 %2
  set %st_x3 %3
  if %st_c
    gosub st_rec PASS AUTO %st_x1 %st_x2 %st_x3
  else
    gosub st_rec NOTE AUTO %st_x1 %st_x2 %st_x3
return

; ###########################################################################
;  HELPERS: cursor, targets, containers, new objects
; ###########################################################################
sub st_wait_cursor
  waitfor #TargCurs = 1 %st_tw3
return

sub st_cancel_cursor
  if #TargCurs = 1
  {
    key esc
    waitfor #TargCurs = 0 %st_tw2
  }
return

; answers an open target cursor with the object %1
sub st_targ_obj
  set #LTargetID %1
  set #LTargetKind 1
  event macro 22 0
  waitfor #TargCurs = 0 %st_tw3
return

; answers an open target cursor with the ground at %1 %2 %3
sub st_targ_ground
  set #LTargetX %1
  set #LTargetY %2
  set #LTargetZ %3
  set #LTargetKind 2
  event macro 22 0
  waitfor #TargCurs = 0 %st_tw3
return

; the backpack gump open and on top
sub st_bp_open
  if #ContID = #BackpackID
    return
  event macro 8 7
  waitfor #ContID = #BackpackID %st_tw3
  if #ContID = #BackpackID
    return
  event macro 9 7
  wait 10
  event macro 8 7
  waitfor #ContID = #BackpackID %st_tw3
return

; ---- a new object: the IDs before, then the first ID that was not there ----
;  gosub st_newitem_begin <types> <B|G>   (B: in the backpack, G: within 3 tiles)
;  ... make it ...
;  gosub st_newitem_end <what>            -> %st_newid (N/A: none), recorded for the clean-up
sub st_newitem_begin
  set %st_nit %1
  set %st_niw %2
  gosub st_newitem_scan
  set %st_niold %st_nilist
return

sub st_newitem_scan
  set %st_nilist |
  if %st_niw = G
    finditem %st_nit G_3
  else
    finditem %st_nit CA_ , #BackpackID
  set %st_nic #FindCnt
  if %st_nic > 0
  {
    for %st_nii 1 %st_nic
    {
      set #FindIndex %st_nii
      set %st_nilist %st_nilist , #FindID , |
    }
  }
return

sub st_newitem_end
  set %st_niwhat %1
  set %st_newid N/A
  set %st_nitry 0
  repeat
    gosub st_newitem_scan
    if %st_nic > 0
    {
      for %st_nii 1 %st_nic
      {
        set #FindIndex %st_nii
        set %st_nik | , #FindID , |
        if %st_nik notin %st_niold && %st_newid = N/A
          set %st_newid #FindID
      }
    }
    if %st_newid = N/A
      wait 5
    set %st_nitry %st_nitry + 1
  until %st_newid <> N/A || %st_nitry > 12
  if %st_newid <> N/A
    gosub st_cl_created %st_newid %st_niwhat
return

; a mobile made at your feet and held in place -> %st_newid
sub st_spawn
  set %st_spt %1
  gosub st_newitem_begin * G
  gosub st_staff self add %st_spt
  gosub st_newitem_end %st_spt
  if %st_newid <> N/A
    gosub st_oset %st_newid CantWalk true
return

; ---- the test weapon (a dagger) -> %st_dagger, or N/A ----------------------
sub st_ensure_dagger
  if %st_dagger <> N/A
  {
    finditem %st_dagger A
    if #FindCnt > 0
      return
    finditem %st_dagger G_5
    if #FindCnt > 0
      return
    set %st_dagger N/A
  }
  set %st_in 3922
  gosub st_num2id
  set %st_dt1 %st_out
  set %st_in 3921
  gosub st_num2id
  set %st_dt2 %st_out
  set %st_dtypes %st_dt1 , _ , %st_dt2
  if %st_staffok = 1
  {
    gosub st_newitem_begin %st_dtypes B
    gosub st_staff self addtopack Dagger
    gosub st_newitem_end Dagger
    set %st_dagger %st_newid
    return
  }
  if %st_daggerasked = 1
    return
  set %st_daggerasked 1
  set %st_prompt The_next_checks_need_a_test_weapon:_put_a_dagger_(or_another_one-handed_weapon)_in_your_backpack.$
    +$Press_Pass,_then_click_the_weapon_with_the_target_cursor_the_script_shows.$Skip_=_you_have_none.
  gosub st_confirm
  if %st_go = 0
    return
  set %st_lt0 #LTargetID
  set #TargCurs 1
  waitfor #TargCurs = 0 %st_tw30
  if #LTargetID <> %st_lt0
    set %st_dagger #LTargetID
return

; ---- a gold pile of 1234 (stage 4 makes it) -> %st_goldid ------------------
sub st_ensure_gold
  if %st_goldid <> N/A
  {
    finditem %st_goldid CA_ , #BackpackID
    if #FindCnt > 0
      return
  }
  set %st_goldid N/A
  if %st_staffok = 0
    return
  gosub st_newitem_begin POF B
  gosub st_staff self addtopack Gold 1234
  gosub st_newitem_end Gold
  set %st_goldid %st_newid
return

; ---- what casting Magic Arrow and Bless needs -> %st_canmage ---------------
sub st_ensure_magery
  if %st_mageready = 1
    return
  set %st_mageready 1
  set %st_canmage 0
  set %st_magewhy no_spellbook
  if %st_staffok = 1
  {
    gosub st_sget Skills.Magery.Base
    set %st_old %st_gn
    gosub st_cl_changed Skills.Magery.Base staffset
    gosub st_staff self set Skills.Magery.Base 100
    gosub st_newitem_begin * B
    gosub st_staff self addtopack Spellbook 18446744073709551615
    gosub st_newitem_end Spellbook
    gosub st_newitem_begin * B
    gosub st_staff self addtopack BagOfReagents 20
    gosub st_newitem_end Reagents
    set %st_t #MaxMana
    gosub st_staff self set Mana %st_t
    set %st_canmage 1
    return
  }
  set %st_prompt The_spell_checks_need_a_spellbook_with_Magic_Arrow,_Bless_and_Protection,
    +_reagents_(sulfurous_ash,_garlic,_ginseng,_mandrake_root)_and_mana.$$Pass_=_you_have_them,_Skip_=_skip_the_spells.
  gosub st_confirm
  if %st_go = 1
    set %st_canmage 1
  else
    set %st_magewhy skipped_by_you
return

; ---- what you hold before the equip checks, for the clean-up ---------------
sub st_hands_save
  if %st_handssaved = 1
    return
  set %st_handssaved 1
  set %st_hh1 N/A
  set %st_hh2 N/A
  finditem * CA_ , #CharID
  set %st_hc #FindCnt
  if %st_hc > 0
  {
    for %st_hi2 1 %st_hc
    {
      set #FindIndex %st_hi2
      if #FindLayer = 1
        set %st_hh1 #FindID
      if #FindLayer = 2
        set %st_hh2 #FindID
    }
  }
  set %st_old %st_hh1 , / , %st_hh2
  gosub st_cl_changed hands hands
  ; the hands must be free for the test weapon: what you hold goes into the backpack until the clean-up
  if %st_hh1 <> N/A
  {
    exevent drag %st_hh1
    wait 10
    exevent dropc #BackpackID
    wait 20
  }
  if %st_hh2 <> N/A
  {
    exevent drag %st_hh2
    wait 10
    exevent dropc #BackpackID
    wait 20
  }
return

; ###########################################################################
;  HELPERS: the test spot
; ###########################################################################
;  finditem #CharID, then the match that is you: a two- or three-letter ID (a low serial, as on a
;  fresh shard) also matches every object of that type. -> %st_fme (its index, 0 = not found)
sub st_findme
  set %st_fme 0
  finditem #CharID
  set %st_fmc #FindCnt
  if %st_fmc > 0
  {
    for %st_fmi 1 %st_fmc
    {
      set #FindIndex %st_fmi
      if #FindID = #CharID && %st_fme = 0
        set %st_fme %st_fmi
    }
    if %st_fme > 0
      set #FindIndex %st_fme
  }
return

; a character with the E letter walks through creatures: path plans the same way
sub st_pathmobiles
  if E in #CharStatus
    path set mobiles ignore
  else
    path set mobiles block
return

; another creature on your own tile -> %st_mobhere (its ID, or N/A)
sub st_mobile_here
  set %st_mobhere N/A
  finditem * G_0
  set %st_mhc #FindCnt
  if %st_mhc > 0
  {
    for %st_mhi 1 %st_mhc
    {
      set #FindIndex %st_mhi
      if #FindID <> #CharID && #FindStack = 0 && #FindX = #CharPosX && #FindY = #CharPosY
        set %st_mobhere #FindID
    }
  }
return

; another creature within %1 tiles of you -> %st_mobhere (its ID, or N/A)
sub st_mobile_near
  set %st_mobhere N/A
  finditem * G_ , %1
  set %st_mhc #FindCnt
  if %st_mhc > 0
  {
    for %st_mhi 1 %st_mhc
    {
      set #FindIndex %st_mhi
      if #FindID <> #CharID && #FindStack = 0
        set %st_mobhere #FindID
    }
  }
return

;  -> %st_atspot 1 at the spot; %st_spotwhy when not
sub st_spot_go
  set %st_atspot 0
  set %st_spotwhy
  if %st_opt_x = N/A
  {
    ; no spot saved: the place you stand on
    set %st_opt_x #CharPosX
    set %st_opt_y #CharPosY
    set %st_opt_z #CharPosZ
    set %st_opt_facet #CursKind
  }
  if %st_staffok = 1
  {
    set %st_old #CharPosX , / , #CharPosY , / , #CharPosZ , / , #CursKind
    gosub st_cl_changed position pos
    if #CursKind <> %st_opt_facet
    {
      gosub st_facetname %st_opt_facet
      gosub st_staff go %st_fname
      waitfor #CursKind = %st_opt_facet %st_tw5
    }
    gosub st_staff go %st_opt_x %st_opt_y %st_opt_z
    waitfor #CharPosX = %st_opt_x && #CharPosY = %st_opt_y %st_tw5
  }
  else
  {
    if #CharPosX <> %st_opt_x || #CharPosY <> %st_opt_y || #CursKind <> %st_opt_facet
    {
      set %st_prompt Walk_to_the_test_spot_X_ , %st_opt_x , _Y_ , %st_opt_y , _height_ , %st_opt_z , _facet_ , %st_opt_facet
        +_and_press_Pass._Skip_=_test_where_you_stand.
      gosub st_confirm
      if %st_go = 0
      {
        set %st_spotwhy you_chose_to_test_where_you_stand
        set %st_opt_x #CharPosX
        set %st_opt_y #CharPosY
        set %st_opt_z #CharPosZ
        set %st_opt_facet #CursKind
      }
    }
  }
  if #CharPosX = %st_opt_x && #CharPosY = %st_opt_y && #CursKind = %st_opt_facet
    set %st_atspot 1
  else
  {
    str len %st_spotwhy
    if #StrRes = 0
      set %st_spotwhy not_at_the_spot_(teleport_or_walk_failed)
  }
return

sub st_facetname
  set %st_fname Felucca
  if %1 = 1
    set %st_fname Trammel
  if %1 = 2
    set %st_fname Ilshenar
  if %1 = 3
    set %st_fname Malas
  if %1 = 4
    set %st_fname Tokuno
  if %1 = 5
    set %st_fname TerMur
return

; the tiles the walks use, two east and two south of where you stand, with path can
;  -> %st_walkok holds E and/or S for the ways that are free, %st_walkall 1 when both are
sub st_walkcheck
  gosub st_pathmobiles
  set %st_walkok
  set %st_walkmap
  set %st_wx #CharPosX
  set %st_wy #CharPosY
  set %st_wz #CharPosZ
  set %st_wgood 1
  for %st_wi 1 2
  {
    set %st_tx %st_wx + %st_wi
    path can %st_tx %st_wy %st_wz
    if #PathState <> ok
      set %st_wgood 0
  }
  if %st_wgood = 1
    set %st_walkok %st_walkok , E
  set %st_wgood 1
  for %st_wi 1 2
  {
    set %st_ty %st_wy + %st_wi
    path can %st_wx %st_ty %st_wz
    if #PathState <> ok
      set %st_wgood 0
  }
  if %st_wgood = 1
    set %st_walkok %st_walkok , S
  set %st_walkall 0
  if E in %st_walkok && S in %st_walkok
    set %st_walkall 1
  set %st_walkmap free: , %st_walkok
return

; ###########################################################################
;  CLEAN-UP: what a run created or changed, written the moment it happens
; ###########################################################################
;  In memory: %st_clk.i kind, %st_clt.i target, %st_cld.i detail, %st_clo.i old value,
;  %st_clx.i done (0/1), %st_clr.i result. In SQL: the cleanup table.

; gosub st_cl_changed <target> <detail> with %st_old: written BEFORE the change
sub st_cl_changed
  set %st_c1 %1
  set %st_c2 %2
  if %st_cln > 0
  {
    for %st_ci 1 %st_cln
    {
      set %st_ct %st_clt . %st_ci
      set %st_cx %st_clx . %st_ci
      if %st_ct = %st_c1 && %st_cx = 0
        return
    }
  }
  set %st_cln %st_cln + 1
  set %st_clk . %st_cln changed
  set %st_clt . %st_cln %st_c1
  set %st_cld . %st_cln %st_c2
  set %st_clo . %st_cln %st_old
  set %st_clx . %st_cln 0
  set %st_clr . %st_cln not_restored
  if %st_db = 1
    sql exec INSERT INTO cleanup(run, kind, target, detail, old_value, done) VALUES(%st_runid, 'changed', %st_c1, %st_c2, %st_old, 0)
return

; gosub st_cl_created <id> <what>: written right after finditem found it
sub st_cl_created
  set %st_c1 %1
  set %st_c2 %2
  set %st_cln %st_cln + 1
  set %st_clk . %st_cln created
  set %st_clt . %st_cln %st_c1
  set %st_cld . %st_cln %st_c2
  set %st_clo . %st_cln N/A
  set %st_clx . %st_cln 0
  set %st_clr . %st_cln not_deleted
  if %st_db = 1
    sql exec INSERT INTO cleanup(run, kind, target, detail, old_value, done) VALUES(%st_runid, 'created', %st_c1, %st_c2, NULL, 0)
return

; undoes the newest open entry for <target> now
sub st_cl_restore
  set %st_c1 %1
  if %st_cln = 0
    return
  for %st_ci %st_cln 1
  {
    set %st_ct %st_clt . %st_ci
    set %st_cx %st_clx . %st_ci
    if %st_ct = %st_c1 && %st_cx = 0
    {
      gosub st_cl_do %st_ci
      return
    }
  }
return

; the check put it back itself: only mark it done
sub st_cl_forget
  set %st_c1 %1
  if %st_cln = 0
    return
  for %st_ci %st_cln 1
  {
    set %st_ct %st_clt . %st_ci
    set %st_cx %st_clx . %st_ci
    if %st_ct = %st_c1 && %st_cx = 0
    {
      set %st_clx . %st_ci 1
      set %st_clr . %st_ci restored_by_the_check
      if %st_db = 1
        sql exec UPDATE cleanup SET done = 1 WHERE run = %st_runid AND target = %st_c1 AND done = 0
      return
    }
  }
return

; everything still open, newest first
sub st_cleanup_all
  if %st_cln = 0
    return
  for %st_cj %st_cln 1
  {
    set %st_cx %st_clx . %st_cj
    if %st_cx = 0
      gosub st_cl_do %st_cj
  }
return

; undoes entry %1 of the in-memory list
sub st_cl_do
  set %st_cd %1
  set %st_uk %st_clk . %st_cd
  set %st_ut %st_clt . %st_cd
  set %st_ud %st_cld . %st_cd
  set %st_uo %st_clo . %st_cd
  gosub st_cl_undo
  set %st_clr . %st_cd %st_umsg
  if %st_uok = 1
  {
    set %st_clx . %st_cd 1
    if %st_db = 1
      sql exec UPDATE cleanup SET done = 1 WHERE run = %st_runid AND target = %st_ut AND done = 0
  }
return

; in: %st_uk kind, %st_ut target, %st_ud detail, %st_uo old value -> %st_uok 1/0, %st_umsg
sub st_cl_undo
  set %st_uok 0
  set %st_umsg FAILED
  if %st_uk = created
  {
    if %st_staffok = 0
    {
      set %st_umsg FAILED:_delete_it_by_hand_(no_staff_commands)
      return
    }
    set %st_in %st_ut
    gosub st_id2ser
    gosub st_staff serial %st_ser delete
    wait 10
    gosub st_staff serial %st_ser get Name
    findjournal %st_sj * %st_tw3 not_a_valid_serial
    if #JFound > 0
    {
      set %st_uok 1
      set %st_umsg deleted
    }
    else
      set %st_umsg FAILED:_still_there
    return
  }
  if %st_ud = staffset
  {
    if %st_staffok = 0
    {
      set %st_umsg FAILED:_needs_staff_commands
      return
    }
    gosub st_staff self set %st_ut %st_uo
    findjournal %st_sj * %st_tw3 Property_has_been_set
    ; read it back: with speech queued, an earlier command's confirmation came after this one (live on
    ; client_beta 7.0.117.31: Dex and Int were marked restored and were not)
    gosub st_sget %st_ut
    if %st_gok = 1 && %st_gn = %st_uo
    {
      set %st_uok 1
      set %st_umsg restored
      return
    }
    set %st_umsg FAILED:_the_shard_did_not_answer
    if %st_gok = 1
      set %st_umsg FAILED:_the_shard_has_ , %st_gn
    return
  }
  if %st_ud = gold
  {
    if %st_staffok = 0
    {
      set %st_umsg FAILED:_needs_staff_commands
      return
    }
    gosub st_staff self addtopack Gold %st_uo
    wait 10
    set %st_uok 1
    set %st_umsg given_back
    return
  }
  if %st_ud = pos
  {
    str part %st_uo / 1
    set %st_u1 #StrRes
    str part %st_uo / 2
    set %st_u2 #StrRes
    str part %st_uo / 3
    set %st_u3 #StrRes
    str part %st_uo / 4
    set %st_u4 #StrRes
    if %st_staffok = 0
    {
      set %st_umsg FAILED:_walk_back_to_ , %st_u1 , _ , %st_u2
      return
    }
    if #CursKind <> %st_u4
    {
      gosub st_facetname %st_u4
      gosub st_staff go %st_fname
      waitfor #CursKind = %st_u4 %st_tw5
    }
    gosub st_staff go %st_u1 %st_u2 %st_u3
    waitfor #CharPosX = %st_u1 && #CharPosY = %st_u2 %st_tw5
    if #CharPosX = %st_u1 && #CharPosY = %st_u2
    {
      set %st_uok 1
      set %st_umsg restored
    }
    return
  }
  if %st_ud = skilllock
  {
    exevent skilllock %st_ut %st_uo
    chooseskill %st_ut
    waitfor #SkillLock = %st_uo %st_tw3
    if #SkillLock = %st_uo
    {
      set %st_uok 1
      set %st_umsg restored
    }
    return
  }
  if %st_ud = statlock
  {
    exevent statlock %st_ut %st_uo
    wait 10
    set %st_uok 1
    set %st_umsg sent
    return
  }
  if %st_ud = cliwin
  {
    str part %st_uo / 1
    set #CliLeft #StrRes
    str part %st_uo / 2
    set #CliTop #StrRes
    str part %st_uo / 3
    set #CliXRes #StrRes
    str part %st_uo / 4
    set #CliYRes #StrRes
    wait 5
    set %st_uok 1
    set %st_umsg restored
    return
  }
  if %st_ud = title
  {
    setuotitle %st_uo
    wait 5
    set %st_uok 1
    set %st_umsg restored
    return
  }
  if %st_ud = macro6
  {
    set %st_u1 0
    if G in #CharStatus
      set %st_u1 1
    if %st_u1 <> %st_uo
    {
      event macro 6 0
      wait 15
    }
    set %st_uok 1
    set %st_umsg restored
    return
  }
  if %st_ud = hands
  {
    str part %st_uo / 1
    set %st_u1 #StrRes
    str part %st_uo / 2
    set %st_u2 #StrRes
    if %st_u1 <> N/A
      exevent equip %st_u1
    if %st_u2 <> N/A
      exevent equip %st_u2
    wait 15
    set %st_uok 1
    set %st_umsg restored
    return
  }
  if %st_ud = petname
  {
    exevent renamepet %st_ut %st_uo
    wait 10
    set %st_uok 1
    set %st_umsg sent
    return
  }
  if %st_ud = mount
  {
    ; not found on your tile when you got off it (an ethereal mount goes to the backpack)
    if %st_ut = your_mount
    {
      set %st_umsg FAILED:_get_on_your_mount_by_hand
      return
    }
    if #MountID <> N/A
    {
      set %st_umsg FAILED:_you_ride_another_mount
      return
    }
    set #LObjectID %st_ut
    event macro 17 0
    waitfor #MountID <> N/A %st_tw5
    if #MountID = N/A
    {
      set %st_umsg FAILED:_get_on_it_by_hand
      return
    }
    set %st_uok 1
    set %st_umsg mounted_again
    return
  }
  if %st_ud = buff
  {
    ; Protection: cast again, it goes off (seen as one buff fewer while the buff bar is open)
    gosub st_cancel_cursor
    scanbuffs
    set %st_un0 #BuffCnt
    event macro 15 14
    if #BuffBarOpen <> #true
    {
      wait 40
      set %st_uok 1
      set %st_umsg cast_again_(buff_bar_closed:_not_seen)
      return
    }
    set %st_ui 0
    repeat
      wait 5
      scanbuffs
      set %st_ui %st_ui + 1
    until #BuffCnt < %st_un0 || %st_ui > 30
    if #BuffCnt < %st_un0
    {
      set %st_uok 1
      set %st_umsg turned_off
    }
    else
      set %st_umsg FAILED:_cast_Protection_to_turn_it_off
    return
  }
  set %st_umsg FAILED:_unknown_kind_ , %st_ud
return

; ###########################################################################
;  START-UP: what an earlier run left
; ###########################################################################
sub st_startup
  set %st_resume 0
  if %st_db = 0
  {
    gosub st_first_run
    return
  }
  ; a run still marked running crashed
  sql query SELECT id AS st_q_id, stages AS st_q_stages, last_stage AS st_q_last, state AS st_q_state FROM runs ORDER BY id DESC LIMIT 1
  if #SqlCnt > 0
  {
    if %st_q_state = running
    {
      set %st_resume 1
      set %st_resume_run %st_q_id
      set %st_resume_sel %st_q_stages
      set %st_resume_from %st_q_last + 1
      if %st_resume_from > %st_nstages
        set %st_resume 0
    }
  }
  ; clean-up rows that are not done
  gosub st_pending_cleanup
  gosub st_first_run
return

sub st_pending_cleanup
  sql query SELECT c.rowid AS st_q_rid, c.kind AS st_q_kind, c.target AS st_q_target, c.detail AS st_q_detail, c.old_value AS st_q_old, r.shard AS st_q_shard, r.charid AS st_q_char FROM cleanup c LEFT JOIN runs r ON r.id = c.run WHERE c.done = 0 ORDER BY c.rowid DESC
  set %st_pn #SqlCnt
  if %st_pn = 0
    return
  set %st_ptext An_earlier_run_did_not_finish_cleaning_up._Still_open:$
  for %st_pi 1 %st_pn
  {
    sql row %st_pi
    set %st_ptext %st_ptext , open:_ , %st_q_kind , _ , %st_q_target , _( , %st_q_detail , )_old= , %st_q_old , _shard= , %st_q_shard , _char= , %st_q_char , $
  }
  set %st_ptext %st_ptext , $Clean_up_now_needs_the_same_shard_and_character_(staff_commands_for_created_objects).
  menu Clear
  menu Window Title EUO SelfTest - clean-up
  menu Window Size 560 330
  str replace %st_ptext _ #spc
  menu Memo cl_text 10 10 540 260 #StrRes
  menu Button cl_now 10 285 160 30 Clean up now
  menu Button cl_later 180 285 120 30 Later
  menu Button cl_forget 310 285 160 30 Forget them
  menu Show
  set #MenuButton N/A
  while #MenuButton = N/A
    wait 1
  set %st_pb #MenuButton
  if %st_pb = cl_now
  {
    gosub st_shard_load
    set %st_staff %st_opt_staff
    set %st_pfx %st_opt_pfx
    gosub st_staff_probe
    sql query SELECT c.rowid AS st_q_rid, c.kind AS st_q_kind, c.target AS st_q_target, c.detail AS st_q_detail, c.old_value AS st_q_old, r.shard AS st_q_shard, r.charid AS st_q_char FROM cleanup c LEFT JOIN runs r ON r.id = c.run WHERE c.done = 0 ORDER BY c.rowid DESC
    set %st_pn #SqlCnt
    for %st_pi 1 %st_pn
    {
      ; the rows are loaded again each time: the undo may run other queries
      sql query SELECT c.rowid AS st_q_rid, c.kind AS st_q_kind, c.target AS st_q_target, c.detail AS st_q_detail, c.old_value AS st_q_old, r.shard AS st_q_shard, r.charid AS st_q_char FROM cleanup c LEFT JOIN runs r ON r.id = c.run WHERE c.done = 0 ORDER BY c.rowid DESC
      if #SqlCnt >= 1
      {
        sql row 1
        set %st_rid %st_q_rid
        if %st_q_shard = %st_shard && %st_q_char = #CharID
        {
          set %st_uk %st_q_kind
          set %st_ut %st_q_target
          set %st_ud %st_q_detail
          set %st_uo %st_q_old
          gosub st_cl_undo
          log clean-up %st_uk %st_ut : %st_umsg
        }
        else
          set %st_uok 2
        ; done, or not for this shard/character: either way not offered again in this loop
        if %st_uok = 1
          sql exec UPDATE cleanup SET done = 1 WHERE rowid = %st_rid
        else
          set %st_forgot %st_forgot , not_cleaned:_ , %st_q_kind , _ , %st_q_target , /
      }
    }
  }
  if %st_pb = cl_forget
  {
    set %st_t
    for %st_pi 1 %st_pn
    {
      sql row %st_pi
      set %st_t %st_t , %st_q_kind , _ , %st_q_target , _old= , %st_q_old , /
    }
    sql exec UPDATE cleanup SET done = 1 WHERE done = 0
    ; written into the next report, so nothing disappears silently
    set %st_opt_forgot %st_opt_forgot , %st_t
    sql save %st_opt_forgot
  }
return

; the first run asks for each missing option
sub st_first_run
  if %st_opt_saved = 1 && %st_opt_shardsaved = 1
    return
  gosub st_settings
return

; ###########################################################################
;  THE MAIN WINDOW
; ###########################################################################
sub st_mw_show
  menu Clear
  menu Window Title EUO SelfTest
  menu Window Size 600 500
  menu Font Size 9
  menu Font Style b
  menu Text mw_head 10 8 Stages: they run in this order, safest first. Untick what you don't want.
  menu Font Style
  set %st_y 32
  for %st_i 1 %st_nstages
  {
    str mid %st_opt_stages %st_i 1
    set %st_chk #false
    if #StrRes = 1
      set %st_chk #true
    set %st_nm %st_sn . %st_i
    set %st_tgv %st_tg . %st_i
    set %st_ct %st_cnt . %st_i
    set %st_cap %st_i , ._ , %st_nm , _-_ , %st_ct , _checks_[ , %st_tgv , ]
    str replace %st_cap _ #spc
    set %st_cap #StrRes
    set %st_cbn mw_cb , %st_i
    menu Check %st_cbn 10 %st_y 580 20 %st_chk %st_cap
    gosub st_optin_on %st_i
    if %st_oi = 0
    {
      menu SetProp %st_cbn enabled #false
      menu Set %st_cbn #false
    }
    set %st_y %st_y + 22
  }
  set %st_t Staff_commands:_off
  if %st_opt_staff = 1
    set %st_t Staff_commands:_on,_prefix_ , %st_opt_pfx
  set %st_t %st_t , ._Test_spot:_ , %st_opt_x , _ , %st_opt_y , _ , %st_opt_z , _facet_ , %st_opt_facet , ._Opt-in_stages_are_switched_on_in_Settings.
  str replace %st_t _ #spc
  menu Text mw_opts 10 304 #StrRes
  str len %st_dbmsg
  if #StrRes > 0
  {
    str replace %st_dbmsg _ #spc
    menu Text mw_db 10 324 #StrRes
  }
  str len %st_lastsum
  if #StrRes > 0
  {
    str replace %st_lastsum _ #spc
    menu Text mw_last 10 344 #StrRes
  }
  menu Button mw_runsel 10 380 130 30 Run selected
  menu Button mw_runall 150 380 110 30 Run all
  if %st_resume = 1
  {
    set %st_t Resume_from_stage_ , %st_resume_from
    str replace %st_t _ #spc
    menu Button mw_resume 270 380 200 30 #StrRes
  }
  menu Text mw_onel 10 428 Run one check (ID):
  menu Edit mw_oneid 130 425 80 4.12
  menu Button mw_one 220 422 120 30 Run one check
  menu Button mw_set 350 422 110 30 Settings
  menu Button mw_quit 470 422 110 30 Quit
  menu Show
return

; is stage %1 offered? (the opt-in ones only when switched on) -> %st_oi
sub st_optin_on
  set %st_oi 1
  if %1 = 9
    set %st_oi %st_opt_combat
  if %1 = 10
    set %st_oi %st_opt_vendor
  if %1 = 11
    set %st_oi %st_opt_pets
  if %1 = 12
    set %st_oi %st_opt_buffs
return

sub st_mw_wait
  set #MenuButton N/A
  while #MenuButton = N/A
    wait 1
  set %st_pb #MenuButton
  set #MenuButton N/A
  if %st_pb = mw_quit || %st_pb = CLOSED
  {
    set %st_quitnow 1
    return
  }
  if %st_pb = mw_set
  {
    gosub st_settings
    return
  }
  set %st_only N/A
  set %st_from 1
  if %st_pb = mw_runsel || %st_pb = mw_runall
  {
    set %st_sel
    for %st_i 1 %st_nstages
    {
      set %st_cbn mw_cb , %st_i
      menu Get %st_cbn
      set %st_v 0
      if #MenuRes = #true || %st_pb = mw_runall
        set %st_v 1
      gosub st_optin_on %st_i
      if %st_oi = 0
        set %st_v 0
      set %st_sel %st_sel , %st_v
    }
    if %st_pb = mw_runsel
    {
      set %st_opt_stages %st_sel
      gosub st_opts_save
    }
  }
  if %st_pb = mw_resume
  {
    set %st_sel %st_resume_sel
    set %st_from %st_resume_from
  }
  if %st_pb = mw_one
  {
    menu Get mw_oneid
    set %st_only #MenuRes
    str part %st_only #dot 1
    set %st_os #StrRes
    set %st_sel
    for %st_i 1 %st_nstages
    {
      set %st_v 0
      if %st_i = %st_os
        set %st_v 1
      set %st_sel %st_sel , %st_v
    }
    if %st_os >= 1 && %st_os <= %st_nstages
      set %st_from %st_os
  }
  if %st_pb <> mw_runsel && %st_pb <> mw_runall && %st_pb <> mw_resume && %st_pb <> mw_one
    return
  ; an older run left as running is over now
  if %st_db = 1 && %st_resume = 1
    sql exec UPDATE runs SET state = 'stopped' WHERE id = %st_resume_run
  set %st_resume 0
  gosub st_run
  set %st_lastsum %st_sum
  gosub st_show_report
return

; the report in a window you can copy from
sub st_show_report
  menu Clear
  menu Window Title EUO SelfTest - report
  menu Window Size 640 480
  menu Text rp_t 10 8 Click in the box, then Ctrl+A and Ctrl+C to copy the report.
  set %st_t %st_sum , $$ , %st_rlog
  menu Memo rp_text 10 30 620 400 %st_t
  menu Button rp_back 10 440 120 30 Back
  menu Show
  set #MenuButton N/A
  while #MenuButton = N/A
    wait 1
  set #MenuButton N/A
return

; ###########################################################################
;  SETTINGS
; ###########################################################################
sub st_settings
  gosub st_shard_load
  menu Clear
  menu Window Title EUO SelfTest - settings
  menu Window Size 560 470
  menu Font Size 9
  set %st_t Shard:_ , %st_shard , ._These_three_lines_are_kept_for_this_shard.
  str replace %st_t _ #spc
  menu Text st_l1 10 10 #StrRes
  set %st_chk #false
  if %st_opt_staff = 1
    set %st_chk #true
  menu Check st_sstaff 10 32 540 20 %st_chk Use staff commands (a GM or admin character on a ModernUO shard)
  menu Text st_l2 30 60 Command prefix:
  menu Edit st_spfx 140 57 40 %st_opt_pfx
  menu Text st_l3 30 90 Test spot  X / Y / Z / facet:
  menu Edit st_sx 200 87 60 %st_opt_x
  menu Edit st_sy 265 87 60 %st_opt_y
  menu Edit st_sz 330 87 40 %st_opt_z
  menu Edit st_sf 375 87 30 %st_opt_facet
  menu Button st_shere 415 84 135 28 Use where I stand
  menu Text st_l4 30 118 Open ground with walkable tiles two steps east and south. Facet: 0 Fel, 1 Tram, 2 Ilsh, 3 Malas, 4 Tokuno, 5 Ter Mur.
  menu Text st_l5 10 160 Panel position  X / Y:
  menu Edit st_spx 160 157 60 %st_opt_panelx
  menu Edit st_spy 225 157 60 %st_opt_panely
  menu Text st_l6 10 192 Report folder:
  menu Edit st_sdir 110 189 440 %st_opt_rptdir
  menu Text st_l7 10 230 Opt-in stages (they create monsters, vendors, pets, buffs):
  set %st_chk #false
  if %st_opt_combat = 1
    set %st_chk #true
  menu Check st_so9 30 252 500 20 %st_chk 9. Combat - attacks a monster
  set %st_chk #false
  if %st_opt_vendor = 1
    set %st_chk #true
  menu Check st_so10 30 274 500 20 %st_chk 10. Vendor - opens a buy window (and buys 3 items)
  set %st_chk #false
  if %st_opt_pets = 1
    set %st_chk #true
  menu Check st_so11 30 296 500 20 %st_chk 11. Pets and mount - renames, mounts and dismounts a pet
  set %st_chk #false
  if %st_opt_buffs = 1
    set %st_chk #true
  menu Check st_so12 30 318 500 20 %st_chk 12. Buffs - casts Bless and Protection, or asks you for buffs
  menu Button st_ssave 10 420 120 30 Save
  menu Button st_scancel 140 420 120 30 Cancel
  menu Button st_sreset 400 420 150 30 Reset options
  menu Show
  set %st_sdone 0
  while %st_sdone = 0
  {
    set #MenuButton N/A
    while #MenuButton = N/A
      wait 1
    set %st_pb #MenuButton
    if %st_pb = st_shere
    {
      menu Set st_sx #CharPosX
      menu Set st_sy #CharPosY
      menu Set st_sz #CharPosZ
      menu Set st_sf #CursKind
    }
    if %st_pb = st_ssave
    {
      menu Get st_sstaff
      set %st_opt_staff 0
      if #MenuRes = #true
        set %st_opt_staff 1
      menu Get st_spfx
      set %st_opt_pfx #MenuRes
      menu Get st_sx
      set %st_opt_x #MenuRes
      menu Get st_sy
      set %st_opt_y #MenuRes
      menu Get st_sz
      set %st_opt_z #MenuRes
      menu Get st_sf
      set %st_opt_facet #MenuRes
      menu Get st_spx
      set %st_opt_panelx #MenuRes
      menu Get st_spy
      set %st_opt_panely #MenuRes
      menu Get st_sdir
      set %st_opt_rptdir #MenuRes
      menu Get st_so9
      set %st_opt_combat 0
      if #MenuRes = #true
        set %st_opt_combat 1
      menu Get st_so10
      set %st_opt_vendor 0
      if #MenuRes = #true
        set %st_opt_vendor 1
      menu Get st_so11
      set %st_opt_pets 0
      if #MenuRes = #true
        set %st_opt_pets 1
      menu Get st_so12
      set %st_opt_buffs 0
      if #MenuRes = #true
        set %st_opt_buffs 1
      gosub st_opts_save
      set %st_sdone 1
    }
    if %st_pb = st_scancel || %st_pb = CLOSED
      set %st_sdone 1
    if %st_pb = st_sreset
    {
      gosub st_opts_reset
      set %st_sdone 1
    }
  }
return
