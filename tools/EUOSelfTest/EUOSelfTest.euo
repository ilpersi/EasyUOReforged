sub st_c601
  gosub st_case 6.01 target_and_a_skill's_cursor
  if %st_run = 0
    return
  gosub st_cancel_cursor
  set #LSkill 2
  event macro 13 1
  set %st_t0 #SysTime
  target %st_tw3
  set %st_dt #SysTime - %st_t0
  set %st_a %st_dt
  set %st_c %st_dt < 2500
  set %st_e under_2500_ms
  gosub st_ok 6.01.target target_returns_as_soon_as_a_cursor_is_up_(ms) none
  set %st_a #TargCurs
  set %st_e 1
  set %st_f %fx_macro , / , %fx_targ
  gosub st_eq 6.01.cursor event_macro_13_1_(Anatomy)_raises_a_target_cursor %st_f
  ; the client leaves #LSkill as it was after event macro 13 (live on 7.0.117.33): only noted
  set %st_a #LSkill
  gosub st_info 6.01.lskill13 LSkill_after_event_macro_13_1 %fx_lskill
  key esc
  waitfor #TargCurs = 0 %st_tw2
  set %st_a #TargCurs
  set %st_e 0
  gosub st_eq 6.01.esc key_esc_cancels_the_cursor %fx_targ
  set %st_t0 #SysTime
  target 20
  set %st_dt #SysTime - %st_t0
  set %st_a %st_dt
  set %st_c ( %st_dt >= 900 ) && ( %st_dt <= 3000 )
  set %st_e about_1000_ms
  if %ST_FAST = 0
    gosub st_ok 6.01.timeout target_20_without_a_cursor_waits_its_timeout none
  ; #LSkill drives macro 14 (Last Skill): written 1, the macro uses Anatomy
  set %st_ls0 #LSkill
  set #LSkill 1
  wait 20
  event macro 14 0
  waitfor #TargCurs = 1 %st_tw3
  set %st_a #TargCurs
  set %st_e 1
  set %st_f %fx_macro , / , %fx_lskill
  gosub st_eq 6.01.lskill event_macro_14_uses_the_skill_written_to_#LSkill_(Anatomy) %st_f
  gosub st_cancel_cursor
  set #LSkill %st_ls0
return

sub st_c602
  gosub st_case 6.02 Writing_#TargCurs_installs_a_target_handler
  if %st_run = 0
    return
  gosub st_need 1.03
  gosub st_cancel_cursor
  ; the handler runs when the cursor is clicked on an object (Target Self does not call it: live on
  ; 7.0.117.33): the gold pile in the backpack gives you something to click
  gosub st_ensure_gold
  gosub st_bp_open
  set %st_lt0 #LTargetID
  set %st_lk0 #LTargetKind
  set #LTargetID #CharID
  set #LTargetKind 2
  set #TargCurs 1
  wait 5
  set %st_a #TargCurs
  set %st_e 1
  gosub st_eq 6.02.up set_#TargCurs_1_reads_back_1 %fx_targw
  ; a click sent by the script does not answer this cursor (live on 7.0.117.33): you click
  set %st_prompt The_script_shows_a_target_cursor:_click_any_item_in_your_backpack_with_it,_then_press_Pass.$
    +$Skip_=_you_can't.
  gosub st_confirm
  if %st_go = 0
  {
    gosub st_cancel_cursor
    set #LTargetID %st_lt0
    set #LTargetKind %st_lk0
    gosub st_skip 6.02.click target_handler not_clicked
    return
  }
  waitfor #TargCurs = 0 %st_tw3
  set %st_a #TargCurs
  set %st_e 0
  gosub st_eq 6.02.done the_cursor_is_gone_after_the_click %fx_targw
  set %st_a #LTargetID
  set %st_c #false
  if #LTargetID = %st_goldid || #LTargetID = #BackpackID
    set %st_c #true
  else
  {
    finditem #LTargetID C_ , #BackpackID
    if #FindCnt > 0
      set %st_c #true
  }
  set %st_e the_backpack_or_an_item_in_it
  gosub st_ok 6.02.id the_handler_put_the_clicked_object_in_#LTargetID %fx_targw
  set %st_a #LTargetKind
  set %st_e 1
  gosub st_eq 6.02.kind the_handler_put_1_in_#LTargetKind %fx_targw
  set #LTargetID %st_lt0
  set #LTargetKind %st_lk0
return

sub st_c603
  gosub st_case 6.03 Test_weapon_made_through_the_target_cursor
  if %st_run = 0
    return
  gosub st_need 1.06
  if %st_staffok = 0
  {
    gosub st_ensure_dagger
    if %st_dagger = N/A
      gosub st_skip 6.03 test_weapon no_weapon_in_the_backpack
    else
    {
      set %st_a %st_dagger
      gosub st_info 6.03 the_weapon_you_picked %fx_ltid
    }
    return
  }
  gosub st_cancel_cursor
  set %st_in 3922
  gosub st_num2id
  set %st_dt1 %st_out
  set %st_in 3921
  gosub st_num2id
  set %st_dt2 %st_out
  set %st_dtypes %st_dt1 , _ , %st_dt2
  gosub st_newitem_begin %st_dtypes B
  gosub st_staff addtopack Dagger
  gosub st_wait_cursor
  set %st_a #TargCurs
  set %st_e 1
  gosub st_eq 6.03.cursor addtopack_raises_a_target_cursor %fx_targ
  gosub st_targ_obj #BackpackID
  set %st_a #TargCurs
  set %st_e 0
  set %st_f %fx_macro , / , %fx_ltid
  gosub st_eq 6.03.answered macro_22_on_#LTargetID_answers_the_cursor %st_f
  gosub st_newitem_end Dagger
  set %st_a %st_newid
  gosub st_has 6.03.made a_dagger_is_made_in_the_backpack %fx_ltid
  if %st_newid = N/A
    return
  set %st_dagger %st_newid
  finditem %st_dagger CA_ , #BackpackID
  set %st_a #FindType
  set %st_c ( #FindType = %st_dt1 ) || ( #FindType = %st_dt2 )
  set %st_e %st_dt1 , _or_ , %st_dt2 , _(graphic_0xF52/0xF51)
  gosub st_ok 6.03.type FindType_of_the_dagger %fx_find
  set %st_a #FindBagID
  set %st_e #BackpackID
  gosub st_eq 6.03.bag FindBagID_is_the_backpack %fx_find
  set %st_a #FindKind
  set %st_e 0
  gosub st_eq 6.03.kind FindKind_0_in_a_container %fx_find
  set %st_a #FindStack
  set %st_e 1
  gosub st_eq 6.03.stack FindStack_of_one_dagger_is_1 %fx_stack
  set %st_a #FindLayer
  set %st_e N/A
  gosub st_eqna 6.03.layer FindLayer_of_a_carried_item_is_N/A %fx_layer
  ; a known colour
  gosub st_oset %st_dagger Hue 33
  wait 10
  finditem %st_dagger CA_ , #BackpackID
  set %st_a #FindCol
  set %st_e 33
  gosub st_eq 6.03.col FindCol_after_Hue_33 %fx_col
return

