; ===========================================================================
;  STAGE 2  read/write variables: write a test value, read it back, restore
; ===========================================================================
;  st_rw name testvalue   writes #name, checks the read-back, restores the old value
;                         (leaves %st_old = value before, %st_new = value read back)
sub st_rw
  set %st_vn %1
  set %st_tv %2
  set %st_id %st_cid , . , %st_vn
  set %st_old # . %st_vn
  set # . %st_vn %st_tv
  wait 2
  set %st_new # . %st_vn
  gosub st_eq write_# , %st_vn %st_new %st_tv
return

; script cycle counters keep running: the read-back is the written value plus a few cycles
sub st_rwcnt
  set %st_vn %1
  set %st_id %st_cid , . , %st_vn
  set # . %st_vn 1000
  set %st_new # . %st_vn
  set %st_ck ( %st_new >= 1000 ) && ( %st_new < 1100 )
  gosub st_ok write_# , %st_vn , _counter_keeps_counting_from_the_written_value %st_new %st_ck
  set # . %st_vn 0
return

sub st_rw_restore
  set # . %st_vn %st_old
  wait 2
  set %st_back # . %st_vn
  if %st_old = N/A
  {
    gosub st_skip restore_# , %st_vn was_N/A_before
    return
  }
  gosub st_eq restore_# , %st_vn %st_back %st_old
return

; client rw variable: needs a logged in client (N/A without a client)
sub st_rwc
  set %st_vn %1
  set %st_id %st_cid , . , %st_vn
  if %st_have = 0
  {
    set %st_vv # . %st_vn
    gosub st_eq no_client_N/A_# , %st_vn %st_vv N/A
    return
  }
  if %st_logged = 0
  {
    gosub st_skip # , %st_vn not_logged_in
    return
  }
  gosub st_rw %1 %2
  gosub st_rw_restore
return

sub st_s_writes
  gosub st_case 2.01 script_variables_no_client_needed
  if %st_run = 0
  {
    return
  }
  gosub st_rwcnt sCnt
  gosub st_rwcnt sCnt2
  gosub st_rw result 77
  gosub st_rw_restore
  gosub st_rw strRes abc
  gosub st_rw_restore
  gosub st_rw sendHeader abc
  gosub st_rw_restore
  gosub st_rw lpc 500
  gosub st_rw_restore
  set %st_vv #menuRes
  gosub st_info menuRes_is_read_only_listed %st_vv

  if %st_logged = 0
  {
    gosub st_rwc sysMsgCol 33
    gosub st_rwc lShard 5
    gosub st_rwc lSpell 5
    gosub st_rwc lSkill 1
    gosub st_rwc lTargetID #charID
    gosub st_rwc lHandID #charID
    gosub st_rwc rHandID #charID
    gosub st_rwc lObjectID #charID
    gosub st_rwc cliXRes 640
    gosub st_rwc contPosX 100
    gosub st_rwc nextCPosX 100
    gosub st_rwc targCurs 1
    gosub st_rwc buffIndex 2
    return
  }

  gosub st_case 2.02 last_action_variables
  if %st_run = 1
  {
    gosub st_rwc sysMsgCol 33
    gosub st_rwc lShard 5
    gosub st_rwc lSpell 5
    gosub st_rwc lSkill 1
    gosub st_rwc lTargetKind 1
    gosub st_rwc lTargetTile 100
    gosub st_rwc lTargetX 1000
    gosub st_rwc lTargetY 1001
    gosub st_rwc lTargetZ 7
    gosub st_rwc lTargetID #charID
    gosub st_rwc lHandID #charID
    gosub st_rwc rHandID #charID
    gosub st_rwc lObjectID #charID
    findItem * C_ , #backpackID
    gosub st_rwc findIndex 1
    gosub st_rwc buffIndex 2
    gosub st_rwc findMod 5_6
    set #findMod 0_0
  }

  gosub st_case 2.03 game_window_position_and_size
  st_rp_7:
  if %st_run = 1
  {
    set %st_w_old1 #cliXRes
    set %st_w_old2 #cliYRes
    set %st_w_old3 #cliLeft
    set %st_w_old4 #cliTop
    gosub st_rw cliXRes 640
    gosub st_rw cliYRes 480
    gosub st_rw cliLeft 40
    gosub st_rw cliTop 80
    set %st_prompt The_game_window_should_now_be_640_x_480_and_moved_to_(40,80)_inside_the_client.$Did_it_shrink_and_move?$$(It_is_restored_right_after_you_answer.)
    set %st_obs 640x480_at_40_80
    gosub st_human game_window_resized_and_moved_as_written
    if %st_again = 1
    {
      goto st_rp_7
    }
    set #cliXRes %st_w_old1
    set #cliYRes %st_w_old2
    set #cliLeft %st_w_old3
    set #cliTop %st_w_old4
    wait 3
    gosub st_eq restore_cliXRes #cliXRes %st_w_old1
    gosub st_eq restore_cliYRes #cliYRes %st_w_old2
    gosub st_eq restore_cliLeft #cliLeft %st_w_old3
    gosub st_eq restore_cliTop #cliTop %st_w_old4
  }

  gosub st_case 2.04 container_position
  st_rp_8:
  if %st_run = 1
  {
    event macro 8 7
    wait 10
    set %st_c_old1 #contPosX
    set %st_c_old2 #contPosY
    gosub st_rw contPosX 200
    gosub st_rw contPosY 220
    set %st_prompt The_backpack_gump_should_now_sit_at_screen_position_(200,220).$Did_it_move?
    set %st_obs 200_220
    gosub st_human backpack_gump_moved_to_the_written_position
    if %st_again = 1
    {
      goto st_rp_8
    }
    set #contPosX %st_c_old1
    set #contPosY %st_c_old2
    wait 3
    gosub st_eq restore_contPosX #contPosX %st_c_old1
    gosub st_eq restore_contPosY #contPosY %st_c_old2
  }

  gosub st_case 2.05 next_container_position
  st_rp_9:
  if %st_run = 1
  {
    event macro 9 1
    wait 5
    set %st_n1 #nextCPosX
    set %st_n2 #nextCPosY
    gosub st_rw nextCPosX 300
    gosub st_rw nextCPosY 150
    nextCPos 300 150
    event macro 8 1
    wait 10
    set %st_prompt The_paperdoll_should_open_at_about_(300,150)_(nextCPos).$Did_it_open_there?
    set %st_obs 300_150
    gosub st_human next_gump_opens_at_the_nextCPos_position
    if %st_again = 1
    {
      goto st_rp_9
    }
    event macro 9 1
    set #nextCPosX %st_n1
    set #nextCPosY %st_n2
    wait 2
    gosub st_eq restore_nextCPosX #nextCPosX %st_n1
    gosub st_eq restore_nextCPosY #nextCPosY %st_n2
  }

  gosub st_case 2.06 target_cursor_flag
  st_rp_10:
  if %st_run = 1
  {
    set %st_t_old #targCurs
    set #targCurs 1
    wait 3
    gosub st_eq write_targCurs #targCurs 1
    set %st_prompt Your_mouse_cursor_should_now_be_a_TARGET_cursor_(crosshair).$Is_it?$Pass_then_the_script_cancels_it.
    set %st_obs targCurs_1
    gosub st_human target_cursor_is_shown_when_targCurs_is_set
    if %st_again = 1
    {
      goto st_rp_10
    }
    set #targCurs 0
    wait 3
    gosub st_eq write_targCurs_0_cancels_the_cursor #targCurs 0
  }

  gosub st_case 2.07 client_title
  st_rp_11:
  if %st_run = 1
  {
    gosub st_rw cliTitle EUO_SelfTest_title
    set %st_prompt The_UO_client_window_title_(taskbar)_should_now_read_EUO_SelfTest_title.$Does_it?
    set %st_obs title
    gosub st_human client_window_title_changed
    if %st_again = 1
    {
      goto st_rp_11
    }
    gosub st_rw_restore
  }
return
; ===========================================================================
;  STAGE 3  Event Macro   (numbers and parameters from the EasyUO wiki table)
; ===========================================================================
;  Each macro is sent, the engine checks what it can read (AUTO) and you only
;  confirm what is visible on screen (HUMAN). Everything is undone afterwards.
sub st_cursor_up
  set %st_ck ( #targCurs <> 0 ) && ( #targCurs <> N/A )
return

; cancels a pending target cursor without clicking anything
sub st_cursor_cancel
  set #targCurs 0
  wait 3
return

sub st_s_macros
  if %st_logged = 0
  {
    gosub st_case 3.00 event_macro
    gosub st_skip event_macro_stage no_logged_in_client
