  gosub st_vc shopItemMax pos
  gosub st_vc shopItemName has
  set %st_in #shopItemName
  gosub st_san
  str len %st_out
  set %st_nl #strres
  gosub st_info shopItemName_(a_number_here_is_a_cliloc_id,_the_same_as_the_old_clients) #shopItemName
  set %st_prompt EasyUO_reads_the_vendor_line_it_considers_current:$name_ , #shopItemName , $type_ , #shopItemType , _price_ , #shopItemPrice , _max_ , #shopItemMax , $position_ , #shopCurPos , _of_ , #shopCnt , $$Compare_with_the_vendor_window_(the_name_may_show_as_a_cliloc_number_on_new_clients).$Does_the_price_and_the_count_match?
  set %st_obs #shopItemPrice
  gosub st_human shop_variables_match_the_vendor_window
  st_rp_39:
  if %st_again = 1
  {
    goto st_rp_38
  }
  setShopItem #shopItemID 3
  set %st_prompt SetShopItem_asked_for_quantity_3_of_that_line_in_your_buy_list.$Look_at_the_buy_list:_does_that_item_say_3_(the_gump_may_not_repaint)?
  set %st_obs quantity_3
  gosub st_human setShopItem_sets_the_quantity_in_the_buy_list
  if %st_again = 1
  {
    goto st_rp_39
  }
return

; ===========================================================================
;  STAGE 7  combat macros  (acts on a monster: %ST_DO_COMBAT 1)
; ===========================================================================
sub st_s_combat
  gosub st_case 7.01 macros_27_and_53_attack
  if %st_run = 0
  {
    return
  }
  st_rp_40:
  if %st_logged = 0
  {
    gosub st_skip combat_stage no_logged_in_client
    return
  }
  set %st_prompt This_stage_makes_your_character_ATTACK.$Stand_within_2_tiles_of_a_weak_monster_you_do_not_mind_fighting_(not_a_pet,_not_a_vendor).$Press_Pass_to_start,_Skip_to_skip.
  set %st_obs combat
  gosub st_ask
  if %st_ans <> PASS
  {
    gosub st_skip combat_stage not_confirmed_by_the_user
    return
  }
  str pos #charStatus G
  if #strres = 0
  {
    event macro 6 0
    wait 15
  }
  event macro 52 5
  wait 10
  gosub st_info macro_52_5_nearest_mobile #lTargetID
  event macro 27 0
  wait 20
  set %st_ck ( #enemyID <> 0 ) && ( #enemyID <> N/A )
  gosub st_ok macro_27_attack_last_sets_enemyID #enemyID %st_ck
  gosub st_vc enemyHits any
  set %st_prompt Macro_27_(Attack_Last)_was_sent.$Is_your_character_attacking_the_monster?
  set %st_obs #enemyID
  gosub st_human macro_27_attacks_the_last_target
  st_rp_41:
  if %st_again = 1
  {
    goto st_rp_40
  }
  event macro 53 0
  wait 15
  set %st_prompt Macro_53_(Attack_Selected)_was_sent.$Is_your_character_still_attacking?
  set %st_obs attack
  gosub st_human macro_53_attacks_the_selected_target
  if %st_again = 1
  {
    goto st_rp_41
  }
  str pos #charStatus G
  if #strres > 0
  {
    event macro 6 0
    wait 15
  }
return

; ===========================================================================
;  STAGE 8  language, menu, namespace, misc   (tests\euo\all-commands-test.euo)
; ===========================================================================
sub st_s_lang
  gosub st_case 8.01 all_commands_test_in_embedded_mode
  if %st_run = 0
  {
    return
  }
  set %st_ldir N/A
  str len %ST_LANG_DIR
  if #strres > 0
  {
    gosub st_lang_try %ST_LANG_DIR
  }
  if %st_ldir = N/A
  {
    gosub st_lang_try #curPath , tests\euo\
  }
  if %st_ldir = N/A
  {
    gosub st_lang_try #curPath
  }
  if %st_ldir = N/A
  {
    gosub st_skip language_menu_namespace_stage all-commands-test.euo_and_call-helper.euo_not_found_(set_ST_LANG_DIR)
    return
  }
  gosub st_info all-commands-test_folder %st_ldir
  set %CFG_EMBEDDED 1
  set %CFG_TEST_DIR %st_ldir
  set %n_run 0
  set %n_pass 0
  set %n_fail 0
  set %n_note 0
  set %n_skip 0
  set %n_info 0
  set %fails
  call %st_ldir , all-commands-test.euo
  set %CFG_EMBEDDED 0
  set %st_c_run %n_run
  set %st_c_pass %n_pass
  set %st_c_fail %n_fail
  set %st_c_note %n_note
  set %st_c_skip %n_skip
  set %st_c_info %n_info
  set %st_c_fails %fails
  set #lpc 1000
  set %st_n_pass %st_n_pass + %st_c_pass
  set %st_n_fail %st_n_fail + %st_c_fail
  set %st_n_note %st_n_note + %st_c_note
  set %st_n_skip %st_n_skip + %st_c_skip
  set %st_n_info %st_n_info + %st_c_info
  set %st_n_auto %st_n_auto + %st_c_run
  set %st_line - , #spc , [LANG] , _checks_run= , %st_c_run , _pass= , %st_c_pass , _fail= , %st_c_fail , _note= , %st_c_note , _skip= , %st_c_skip
  gosub st_emit
  str len %st_c_fails
  if #strres > 0
  {
    set %st_in %st_c_fails
    set %st_lp [LANG_FAIL]
    gosub st_emit_long
  }
  gosub st_panel_build
return

sub st_lang_try
  set %st_lt %1
  set %call_probe N/A
  call %st_lt , call-helper probe
  if %call_probe = ok
  {
    set %st_ldir %st_lt
  }
return

; in %st_in (raw text), %st_lp (prefix, no spaces): writes it as several report lines of at most 100 characters
sub st_emit_long
  gosub st_san
  set %st_t %st_out
  str len %st_t
  set %st_tl #strres
  set %st_p 1
  while %st_p <= %st_tl
  {
    str mid %st_t %st_p 100
    set %st_line - , #spc , %st_lp , _ , #strres
    gosub st_emit
    set %st_p %st_p + 100
  }
return

; ===========================================================================
;  STAGE 9  buff bar  (port addition; needs the buff bar open with 2-3 buffs on the character: %ST_DO_BUFFS 1)
; ===========================================================================
sub st_s_buffs
  gosub st_case 9.01 scanBuffs_and_the_buff_variables
  if %st_run = 0
  {
    return
  }
  if %st_logged = 0
  {
    gosub st_skip buff_bar_stage no_logged_in_client
    return
  }
  set %st_c9 %st_cid
  st_rp_50:
  set %st_prompt Buff_bar_stage.$Open_the_buff_bar_(Event_Macro_57_toggles_it)_and_put_2_or_3_different_buffs_on_your_character,_at_least_one_with_a_timer_(for_example_Bless,_Curse_or_Strength;_Hiding_has_no_timer).$Press_Pass_when_they_show_in_the_buff_bar,_Skip_to_skip_this_stage.
  set %st_obs buff_bar
  gosub st_ask
  if %st_ans <> PASS
  {
    gosub st_skip buff_bar_stage not_confirmed_by_the_user
    return
  }
  scanBuffs
  set %st_bn #buffCnt
  set %st_ck %st_bn > 0
  set %st_ob buffCnt_ , %st_bn
  gosub st_ok scanBuffs_finds_the_buffs_of_the_open_buff_bar %st_ob %st_ck
  if %st_bn = 0
  {
    return
  }
  gosub st_eq scanBuffs_selects_the_first_buff_(buffIndex) #buffIndex 1

  ; every buff in turn, through #buffIndex
  set %st_list
  set %st_timed 0
  set %st_id1 0
  for %st_bi 1 %st_bn
  {
    set #buffIndex %st_bi
    gosub st_buff_one
  }
  set #buffIndex 1

  set %st_cid %st_c9
  set %st_prompt EasyUO_reads_ , %st_bn , _buffs:$ , %st_list , $Hover_each_icon_in_the_buff_bar:_do_the_names_and_the_times_match_the_tooltips?$(The_client_refreshes_the_time_about_every_5_seconds.)
  set %st_obs %st_bn , _buffs
  gosub st_human buff_names_and_times_match_the_buff_bar_tooltips
  if %st_again = 1
  {
    goto st_rp_50
  }

  ; ---- 9.02  the time counts down --------------------------------------------------------------------------
  gosub st_case 9.02 buff_time_counts_down
  if %st_run = 0
  {
    return
  }
  if %st_timed = 0
  {
    gosub st_skip buff_time_counts_down no_buff_with_a_timer_(put_Bless_or_Curse_on_the_character)
  }
  else
  {
    wait 120
    scanBuffs %st_tid
    set %st_cnt2 #buffCnt
    if %st_cnt2 = 0
    {
      gosub st_skip buff_time_counts_down the_buff_ran_out_during_the_12_second_wait
    }
    else
    {
      set %st_t1 #buffTime
      set %st_ck ( %st_t1 <> N/A ) && ( %st_t1 < %st_tt0 )
      set %st_ob %st_tt0 , _then_ , %st_t1
      gosub st_ok buffTime_goes_down_over_12_seconds_(seconds_left_then_now) %st_ob %st_ck
    }
  }

  ; ---- 9.03  scanBuffs with an icon id ----------------------------------------------------------------------
  gosub st_case 9.03 scanBuffs_with_an_icon_id
  if %st_run = 0
  {
    return
  }
  scanBuffs %st_id1
  set %st_ck ( #buffCnt >= 1 ) && ( #buffID = %st_id1 )
  set %st_ob %st_id1 , _gives_ , #buffCnt
  gosub st_ok scanBuffs_with_the_icon_id_of_buff_1_keeps_that_icon %st_ob %st_ck
  scanBuffs 1
  set %st_ck ( #buffCnt = 0 ) && ( #buffName = N/A )
  set %st_ob #buffCnt , _ , #buffName
  gosub st_ok scanBuffs_with_an_icon_id_that_is_not_there_finds_nothing %st_ob %st_ck
  scanBuffs
  gosub st_eq scanBuffs_without_an_id_finds_all_buffs_again #buffCnt %st_bn

  ; ---- 9.04  buff bar closed ------------------------------------------------------------------------------------
  gosub st_case 9.04 buff_bar_closed
  if %st_run = 0
  {
    return
  }
  st_rp_51:
  event macro 57 0
  wait 15
  scanBuffs
  gosub st_info buffCnt_with_the_buff_bar_closed #buffCnt
  set %st_prompt Macro_57_toggled_the_buff_bar.$Is_it_CLOSED_now?$(scanBuffs_found_ , #buffCnt , _buffs;_with_the_window_closed_the_client_keeps_no_list_that_can_be_read.)
  set %st_obs closed
  gosub st_human buff_bar_closed_by_macro_57
  if %st_again = 1
  {
    event macro 57 0
    wait 10
    goto st_rp_51
  }
  event macro 57 0
  wait 15
  scanBuffs
  gosub st_eq buffCnt_after_the_buff_bar_is_opened_again #buffCnt %st_bn
  set %st_prompt Macro_57_opened_the_buff_bar_again.$Is_it_open_and_do_the_buffs_show?
  set %st_obs #buffCnt , _buffs
  gosub st_human buff_bar_open_again
return

; ---- one buff of the walk in 9.01: #buffIndex is already set -----------------------------------------------------
sub st_buff_one
  set %st_cid %st_c9 , _b , %st_bi
  gosub st_vc buffIndex eq %st_bi
  gosub st_vc buffID pos
  gosub st_vc buffCliloc pos
  gosub st_vc buffName has
  gosub st_vc buffDesc any
  gosub st_vc buffTime rng -1 100000
  ; no ~N_NAME~ placeholder may be left in the description
  set %st_ds #buffDesc
  str pos %st_ds ~
  set %st_ck #strres = 0
  set %st_id %st_cid , .buffDesc_markup
  gosub st_ok buffDesc_has_all_its_arguments_filled_in %st_ds %st_ck
  set %st_id %st_cid , .buff
  set %st_bt #buffTime
  gosub st_info buff_ , %st_bi , _icon_ , #buffID , _cliloc_ , #buffCliloc , _seconds_ , %st_bt #buffName
  set %st_list %st_list , %st_bi , :_ , #buffName , _( , %st_bt , s) , $
  if %st_bi = 1
  {
    set %st_id1 #buffID
  }
  if %st_timed = 0
  {
    if %st_bt > 0
    {
      set %st_timed 1
      set %st_tid #buffID
      set %st_tt0 %st_bt
    }
  }
return
