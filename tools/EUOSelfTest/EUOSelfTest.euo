sub st_c504
  gosub st_case 5.04 Macros_10_and_11:_minimize_and_maximize
  if %st_run = 0
    return
  event macro 8 1
  waitfor paperdoll in #ContName %st_tw3
  st_rp_504:
  set %st_s0 #ContSize
  event macro 10 1
  wait 15
  set %st_s1 #ContSize
  event macro 11 1
  wait 15
  set %st_s2 #ContSize
  set %st_a %st_s0 , _then_ , %st_s1 , _then_ , %st_s2
  set %st_e smaller_then_back
  if %st_s1 <> %st_s0 && %st_s2 = %st_s0
  {
    gosub st_rec PASS AUTO 5.04 macro_10_1_shrinks_the_paperdoll,_11_1_restores_it %fx_macro
  }
  else
  {
    ; the size did not show it: ask
    event macro 10 1
    wait 15
    set %st_prompt The_script_ran_event_macro_10_1_(minimize_the_paperdoll).$
      +$Look_at_your_paperdoll:_it_should_be_minimized_now_(a_small_picture_without_buttons).$
      +$After_you_answer,_event_macro_11_1_maximizes_it_again.
    set %st_obs %st_a
    gosub st_human 5.04 macro_10_1_minimizes_the_paperdoll %fx_macro
    event macro 11 1
    wait 10
    if %st_again = 1
      goto st_rp_504
  }
  event macro 9 1
return

sub st_c505
  gosub st_case 5.05 Macros_8_and_9:_skills_and_status_gumps
  if %st_run = 0
    return
  set %st_n0 #ContName
  event macro 8 4
  waitfor #ContName <> %st_n0 %st_tw3
  set %st_n1 #ContName
  set %st_a %st_n1
  set %st_c %st_n1 <> %st_n0
  set %st_e a_new_gump_on_top
  gosub st_ok 5.05.skills event_macro_8_4_opens_the_skills_gump %fx_macro
  event macro 9 4
  waitfor #ContName <> %st_n1 %st_tw3
  set %st_a #ContName
  set %st_c #ContName <> %st_n1
  set %st_e not_ , %st_n1
  gosub st_ok 5.05.skillsclose event_macro_9_4_closes_it %fx_macro
  ; the status window may be open already (the stage keeps it open): close it first
  event macro 9 2
  waitfor #ContName <> status_gump %st_tw2
  event macro 8 2
  waitfor #ContName = status_gump %st_tw3
  set %st_a #ContName
  set %st_e status_gump
  gosub st_eq 5.05.status event_macro_8_2_opens_the_status_gump %fx_macro
  event macro 9 2
  waitfor #ContName <> status_gump %st_tw3
  set %st_a #ContName
  set %st_c #ContName <> status_gump
  set %st_e not_status_gump
  gosub st_ok 5.05.statusclose event_macro_9_2_closes_it %fx_macro
  gosub st_status_keep
return

