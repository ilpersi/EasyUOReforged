; puts the default IgnoreCont list back after ignorecont reset
sub st_ign_defaults
  str count %st_defign /
  set %st_in2 #StrRes + 1
  for %st_ii 1 %st_in2
  {
    str part %st_defign / %st_ii
    ignorecont #StrRes
  }
return

