sub st_vg_find
  gosub st_case 1.50 finditem_variables
  if %st_run = 0
  {
    return
  }
  st_rp_4:
  findItem * C_ , #backpackID
  gosub st_vc findCnt num
  if %st_logged = 1
  {
    if #findCnt > 0
    {
      gosub st_vc findID has
      gosub st_vc findType has
      gosub st_vc findKind eq 0
      gosub st_vc findBagID eq #backpackID
      gosub st_vc findStack num
      gosub st_vc findX num
      gosub st_vc findY num
      gosub st_vc findCol num
      gosub st_vc findRep any
      gosub st_vc findZ any
      gosub st_vc findDist any
      gosub st_vc findIndex any
      gosub st_vc findMod any
      ; name and properties of the first item: event property fills #property, its lines are joined by $
      set %st_f1 #findID
      event property %st_f1
      wait 12
      set %st_pr #property
      str len %st_pr
      if #strres = 0
      {
        set %st_pr no_properties_returned
      }
      set %st_fname %st_pr
      str pos %st_pr $
      if #strres > 1
      {
        set %st_nlp #strres - 1
        str left %st_pr %st_nlp
        set %st_fname #strres
      }
      set %st_prompt FindItem_listed_ , #findCnt , _items_in_your_backpack.$First_one:_id_ , %st_f1 , _type_ , #findType , _stack_ , #findStack , $$Name_and_properties_(event_property):$ , %st_pr , $$Open_the_backpack:_is_that_the_first_item_in_the_list,_and_do_the_name_and_properties_match_its_tooltip?
      set %st_obs %st_fname
      gosub st_human finditem_lists_the_backpack_contents
      if %st_again = 1
      {
        goto st_rp_4
      }
    }
    else
    {
      gosub st_skip finditem_details empty_backpack
    }
  }
return


