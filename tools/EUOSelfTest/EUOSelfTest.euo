  gosub st_m_say
  gosub st_m_gumps
  gosub st_m_minmax
  gosub st_m_walk
  gosub st_m_war
  gosub st_m_skill
  gosub st_m_spell
  gosub st_m_lastobject
  gosub st_m_target
  gosub st_m_targetsys
  gosub st_m_animations
  gosub st_m_names_buff
  gosub st_m_extras
  gosub st_m_skips
  gosub st_m_closegumps
return

