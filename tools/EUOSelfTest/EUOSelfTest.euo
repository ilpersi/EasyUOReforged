    +$Look_over_your_character's_head:_the_text_ , %st_vis , _should_appear_there_for_a_few_seconds,
    +_small_letters_with_dark_edges_(font_3),_in_colour_33_(red).
  set %st_obs %st_vis , _font_3_colour_33
  gosub st_human 5.02 event_ExMsg_text_over_your_head %fx_exmsg
  if %st_again = 1
    goto st_rp_502
return

