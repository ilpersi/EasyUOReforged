; Probe for tests/tools/Record16MenuGolden.py: EasyUO 1.6 MENU golden values.
; "menu reforge mode 1.6" makes Reforged run it under the 1.6 logic; 1.6 ignores the line.
; "menu window" and "menu show": colour names, numbers and system colours, size
; and title checks, position from "show x y", and layered transparency.
;@wait W1
;@alpha R:W1:
;@wait W2
;@alpha R:W2:
;@wait W3
;@alpha R:W3:
;@forms
menu reforge mode 1.6
menu window color red
menu getprop form0 color
set %r RED= , #menures
menu window color 65280
menu getprop form0 color
set %r %r , _NUM= , #menures
menu window color ltgray
menu getprop form0 color
set %r %r , _LTGRAY= , #menures
menu window color btnface
menu getprop form0 color
set %r %r , _BTNFACE= , #menures
menu window color
menu getprop form0 color
set %r %r , _NONE= , #menures
menu window size 250 120
menu getprop form0 width
set %r %r , _W= , #menures
menu getprop form0 height
set %r %r , _H= , #menures
menu window size -5 50
menu getprop form0 width
set %r %r , _WNEG= , #menures
menu window size 100
menu getprop form0 width
set %r %r , _WONE= , #menures
menu window title Hello Big World
menu getprop form0 text
set %r %r , _TITLE= , #menures
menu show 300 200
menu getprop form0 left
set %r %r , _SHOWL= , #menures
menu getprop form0 top
set %r %r , _SHOWT= , #menures
menu show a b
menu getprop form0 left
set %r %r , _SHOWAB= , #menures
menu getprop form0 visible
set %r %r , _VIS= , #menures
menu window transparent 50
menu window transparent 101
menu window title R:W1: , %r
wait 30
menu window transparent 0
menu window title R:W2:
wait 30
menu window transparent 100
menu window transparent -1
menu window title R:W3:
wait 30
halt
