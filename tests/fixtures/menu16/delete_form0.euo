; Probe for tests/tools/Record16MenuGolden.py: EasyUO 1.6 MENU golden values.
; "menu reforge mode 1.6" makes Reforged run it under the 1.6 logic; 1.6 ignores the line.
; "menu delete form0" destroys form0 until the next start: show/hide/window
; then do nothing and "menu clear" does not bring it back.
;@wait A
;@forms
menu reforge mode 1.6
menu window size 300 200
menu text inside 5 5 inside
menu delete form0
menu show
set #menures Q
menu getprop form0 visible
set %r VIS0= , #menures
menu window title nothing
menu clear
set #menures Q2
menu getprop form0 visible
set %r %r , _AFTERCLEAR= , #menures
set #menures Q3
menu getdef parent
set %r %r , _DP= , #menures
menu form rep 10 10 300 50 x
menu setprop rep text R:A: , %r
halt
