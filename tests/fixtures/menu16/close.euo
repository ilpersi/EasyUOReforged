; Probe for tests/tools/Record16MenuGolden.py: EasyUO 1.6 MENU golden values.
; "menu reforge mode 1.6" makes Reforged run it under the 1.6 logic; 1.6 ignores the line.
; Closing forms with [X]: another form records its name and only hides; form0
; records CLOSED; a button click records its lower-cased name; "set #menubutton
; form0" reads back CLOSED, "FORM0" reads back as written.
;@wait W1
;@close Closer
;@wait W2
;@close R:W2:
;@wait W3
;@click MyBtn
;@wait S3
menu reforge mode 1.6
menu form f2 50 60 200 100 Closer
menu setprop f2 visible #true
set #menubutton n/a
menu window title R:W1:ready
set %t #scnt + 5
while #menubutton = n/a && #scnt < %t
  wait 1
set %r F2CLOSE= , #menubutton
menu getprop f2 visible
set %r %r , _V= , #menures
menu show
set #menubutton n/a
menu window title R:W2: , %r
set %t #scnt + 5
while #menubutton = n/a && #scnt < %t
  wait 1
set %r %r , _FORM0CLOSE= , #menubutton
menu getprop form0 visible
set %r %r , _V0= , #menures
menu getdef parent
set %r %r , _DP= , #menures
menu setdef parent form0
menu button MyBtn 10 10 80 20 MyBtn
menu show
set #menubutton n/a
menu window title R:W3: , %r
set %t #scnt + 5
while #menubutton = n/a && #scnt < %t
  wait 1
set %r %r , _CLICK= , #menubutton
set #menubutton form0
set %r %r , _SETFORM0= , #menubutton
set #menubutton FORM0
set %r %r , _SETFORM0U= , #menubutton
menu window title R:S3: , %r
halt
