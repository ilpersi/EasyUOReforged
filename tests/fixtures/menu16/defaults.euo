; Probe for tests/tools/Record16MenuGolden.py: EasyUO 1.6 MENU golden values.
; "menu reforge mode 1.6" makes Reforged run it under the 1.6 logic; 1.6 ignores the line.
; form0 and the defaults as a script finds them at start, #MenuButton and #MenuRes
; at start, "window size" giving the exact client size, and an alpha-only sub-command
; ("menu state") doing nothing.
;@wait A
menu reforge mode 1.6
set %m #menubutton
set %n #menures
set #menures Q
menu getprop form0 left
set %r L= , #menures
menu getprop form0 top
set %r %r , _T= , #menures
menu getprop form0 width
set %r %r , _W= , #menures
menu getprop form0 height
set %r %r , _H= , #menures
menu getprop form0 text
set %r %r , _C= , #menures
menu getprop form0 visible
set %r %r , _V= , #menures
menu getprop form0 color
set %r %r , _COL= , #menures
menu getprop form0 enabled
set %r %r , _EN= , #menures
menu getdef fontname
set %r %r , _FN= , #menures
menu getdef fontsize
set %r %r , _FS= , #menures
menu getdef fontcolor
set %r %r , _FC= , #menures
menu getdef fontstyle
set %r %r , _FST= , #menures
menu getdef color
set %r %r , _DC= , #menures
menu getdef alignment
set %r %r , _AL= , #menures
menu getdef parent
set %r %r , _P= , #menures
set %r %r , _MB= , %m , _MR= , %n , _
menu window size 200 100
menu getprop form0 width
set %r %r , _WS= , #menures
menu getprop form0 height
set %r %r , _HS= , #menures
menu state xyz 1
menu window title R:A: , %r
;@forms
halt
