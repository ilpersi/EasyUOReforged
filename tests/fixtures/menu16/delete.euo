; Probe for tests/tools/Record16MenuGolden.py: EasyUO 1.6 MENU golden values.
; "menu reforge mode 1.6" makes Reforged run it under the 1.6 logic; 1.6 ignores the line.
; "menu delete": a panel takes its registered children with it (nested too);
; unknown names and a missing name do nothing; a deleted name can be used again.
;@wait A
menu reforge mode 1.6
menu panel p1 10 10 100 80
menu text t1 5 5 inner
menu button b1 5 30 50 20 B
menu panel p2 5 55 50 20
menu text t2 1 1 deep
menu setdef parent form0
menu text t3 120 10 outer
menu delete p1
set #menures Q
menu getprop t1 left
set %r T1= , #menures
set #menures Q
menu getprop b1 left
set %r %r , _B1= , #menures
set #menures Q
menu getprop p2 left
set %r %r , _P2= , #menures
set #menures Q
menu getprop t2 left
set %r %r , _T2= , #menures
menu getprop t3 left
set %r %r , _T3= , #menures
menu delete nothere
menu delete
menu getprop t3 left
set %r %r , _T3STILL= , #menures
menu delete t3
set #menures Q
menu getprop t3 left
set %r %r , _T3GONE= , #menures
menu text t3 130 10 again
menu getprop t3 left
set %r %r , _T3AGAIN= , #menures
menu getdef parent
set %r %r , _DP= , #menures
menu window title R:A: , %r
halt
