; Probe for tests/tools/Record16MenuGolden.py: EasyUO 1.6 MENU golden values.
; "menu reforge mode 1.6" makes Reforged run it under the 1.6 logic; 1.6 ignores the line.
; getprop of every property on every control type and getdef of every key, as
; the controls are created. A property that does not apply leaves Q in #MenuRes.
; Each control reports through its own hidden report form.
;@wait FORM0
;@wait FM
;@wait PN
;@wait TX
;@wait BT
;@wait ED
;@wait CK
;@wait RD
;@wait CB
;@wait LS
;@wait IM
;@wait DEF
;@wait END
menu reforge mode 1.6
set #lpc 1000
menu window size 300 200
menu form fm 500 100 120 60 FormText
menu setdef parent form0
menu panel pn 10 10 80 40
menu setdef parent form0
menu text tx 10 60 TextText
menu button bt 10 80 70 20 ButtonText
menu edit ed 10 110 70 EditText
menu check ck 10 140 70 20 #true CheckText
menu radio rd 90 140 70 20 #true RadioText
menu combo create cb 100 10 80
menu list create ls 100 40 80 50
menu image create im 200 10 40 40
set #menures Q
menu getprop form0 alignment
set %r ALIGNMENT= , #menures
set #menures Q
menu getprop form0 checked
set %r %r , _CHECKED= , #menures
set #menures Q
menu getprop form0 color
set %r %r , _COLOR= , #menures
set #menures Q
menu getprop form0 enabled
set %r %r , _ENABLED= , #menures
set #menures Q
menu getprop form0 fontcolor
set %r %r , _FONTCOLOR= , #menures
set #menures Q
menu getprop form0 fontname
set %r %r , _FONTNAME= , #menures
set #menures Q
menu getprop form0 fontsize
set %r %r , _FONTSIZE= , #menures
set #menures Q
menu getprop form0 fontstyle
set %r %r , _FONTSTYLE= , #menures
set #menures Q
menu getprop form0 height
set %r %r , _HEIGHT= , #menures
set #menures Q
menu getprop form0 left
set %r %r , _LEFT= , #menures
set #menures Q
menu getprop form0 parent
set %r %r , _PARENT= , #menures
set #menures Q
menu getprop form0 text
set %r %r , _TEXT= , #menures
set #menures Q
menu getprop form0 tooltip
set %r %r , _TOOLTIP= , #menures
set #menures Q
menu getprop form0 top
set %r %r , _TOP= , #menures
set #menures Q
menu getprop form0 visible
set %r %r , _VISIBLE= , #menures
set #menures Q
menu getprop form0 width
set %r %r , _WIDTH= , #menures
set #menures Q
menu getprop form0 LEFT
set %r %r , _CASELEFT= , #menures
set #menures Q
menu getprop form0 nonsense
set %r %r , _NONSENSE= , #menures
menu form rform0 0 0 10 10 r
menu setprop rform0 text R:FORM0: , %r
