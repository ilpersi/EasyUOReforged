; ============================================================================
;  moveitem hand test: the new MOVEITEM command on a live client and a ModernUO shard.
;  It ends in halt.
;
;  %case auto (the default) runs unattended, with a staff character (GameMaster or above) on your own
;  shard:   EUOCli run tests/euo/moveitem-hand-test.euo --client 1 --timeout 1200
;  It makes its own test objects with staff commands (logs, bags, a dagger, chests), moves only those,
;  and deletes them at the end. CREATED lines name each one, CLEANUP lines say what became of it. It
;  never puts anything on the ground itself (P2 makes its log on the ground with a staff command).
;  Cases M1-M11 run as staff. P1-P4 run as a Player: [StaffAccess player lowers the level and
;  [StaffAccess (which a Player may use) restores it right after, and again in the clean-up if needed.
;  If a run stops while it says "now a PLAYER", type [StaffAccess in the game.
;  Each result is a line: RESULT <case> <PASS|FAIL|INFO> <what> observed=... expected=...
;
;  %case held needs your hand: set it below, run the script, and within 90 s pick an item up with the
;  mouse and keep holding it. Expected: RESULT H PASS ... observed=held. Then drop the item yourself.
; ============================================================================
set %case auto

set %alpha ABCDEFGHIJKLMNOPQRSTUVWXYZ
set %pfx [
set %prate 10
set %pmax 10
set %pm 0
set %plast #SCnt2
set %created |
set %passes 0
set %fails 0
set %lowered 0
set %logt N/A
set %LA N/A
set %LB N/A
set %LBr N/A
set %LN N/A
set %LF N/A
set %LP N/A
set %LPr N/A
set %B1 N/A
set %B2 N/A
set %D1 N/A
set %C1 N/A
set %C2 N/A
set %CF N/A

if #CliLogged <> 1
{
  log ABORT not logged in
  halt
}

if %case = held
{
  log HELD pick an item up with the mouse within 90 s and keep holding it
  waitfor #LLiftedKind = 1 90s
  if #WaitRes = #false
  {
    log ABORT nothing was picked up in 90 s
    halt
  }
  set %held #LLiftedID
  moveitem %held #BackpackID
  gosub mp_eq H #MoveRes held moveitem_refuses_while_something_hangs_on_the_cursor
  gosub mp_eq H.still #LLiftedKind 1 the_item_is_still_on_your_cursor:_drop_it_yourself
  halt
}

if #LLiftedKind <> 0
{
  log ABORT something hangs on the cursor
  halt
}
gosub mp_staff self get AccessLevel
findjournal %sj * 60 AccessLevel_=_
if #JFound = 0
{
  log ABORT the shard did not answer a staff command
  halt
}
str part #Journal _=_ 2
set %lvl #StrRes
log PROBE moveitem hand test on #CliVer as #CharName level %lvl
if %lvl = Player || %lvl = Counselor
{
  log ABORT needs GameMaster or above
  halt
}
if #ContID <> #BackpackID
{
  event macro 8 7
  waitfor #ContID = #BackpackID 60
}
gosub mp_snap CA_
set %start %snap

; ---- the test objects ---------------------------------------------------------
gosub mp_snapold CA_
gosub mp_staff self addtopack Log 30
gosub mp_newid CA_
set %LA %newid
gosub mp_created %LA LA_log_30
gosub mp_snapold CA_
gosub mp_staff self addtopack Log 50
gosub mp_newid CA_
set %LB %newid
gosub mp_created %LB LB_log_50
gosub mp_snapold CA_
gosub mp_staff self addtopack Log 10
gosub mp_newid CA_
set %LN %newid
gosub mp_created %LN LN_log_10_not_movable
gosub mp_snapold CA_
gosub mp_staff self addtopack Bag
gosub mp_newid CA_
set %B1 %newid
gosub mp_created %B1 B1_bag
gosub mp_snapold CA_
gosub mp_staff self addtopack Bag
gosub mp_newid CA_
set %B2 %newid
gosub mp_created %B2 B2_bag_never_opened
gosub mp_snapold CA_
gosub mp_staff self addtopack Dagger
gosub mp_newid CA_
set %D1 %newid
gosub mp_created %D1 D1_dagger
gosub mp_snapold G_2
gosub mp_staff self add WoodenChest
gosub mp_newid G_2
set %C1 %newid
gosub mp_created %C1 C1_chest_never_opened
if %LA = N/A || %LB = N/A || %LN = N/A || %B1 = N/A || %B2 = N/A || %D1 = N/A || %C1 = N/A
{
  log ABORT a test object was not made
  goto mh_cleanup
}
finditem %LA A
set %logt #FindType
gosub mp_oset %LN Movable false
wait 20

; ---- M1: the whole stack into an open bag ------------------------------------------
set #LObjectID %B1
event macro 17 0
waitfor #ContID = %B1 60
set %t0 #SysTime
moveitem %LA %B1
set %ms #SysTime - %t0
gosub mp_eq M1 #MoveRes ok the_whole_stack_into_an_open_bag
gosub mp_info M1.ms ms %ms
gosub mp_where %LA
gosub mp_eq M1.where %wc %B1 in_the_bag
gosub mp_eq M1.stack %ws 30 all_30

; ---- M2: 10 of 50 to a place in the bag ---------------------------------------------
gosub mp_snapold CA_
set %t0 #SysTime
moveitem %LB %B1 10 40 40
set %ms #SysTime - %t0
gosub mp_eq M2 #MoveRes ok 10_of_50_to_40_40_in_the_bag
gosub mp_info M2.ms ms %ms
gosub mp_where %LB
gosub mp_eq M2.where %wc %B1 the_old_ID_is_in_the_bag
gosub mp_eq M2.stack %ws 10 with_the_10
gosub mp_newid CA_
set %LBr %newid
gosub mp_created %LBr LBr_rest_of_LB
gosub mp_where %LBr
gosub mp_eq M2.rest %ws 40 the_rest_(40)_stays_in_the_backpack_under_a_new_ID

; ---- M3: back into the backpack with no place: joins a pile there -------------------
set %t0 #SysTime
moveitem %LB #BackpackID
set %ms #SysTime - %t0
gosub mp_eq M3 #MoveRes ok back_into_the_backpack_joins_a_pile
gosub mp_info M3.ms ms %ms
gosub mp_where %LB
gosub mp_info M3.id where_the_moved_ID_is_now_(-1_=_merged) %wk , / , %wc

; ---- M4: into a bag in the backpack nobody opened -----------------------------------
moveitem %LA %B2
gosub mp_eq M4 #MoveRes ok into_a_bag_in_the_backpack_never_opened

; ---- M5, M6, M10: what sends nothing ---------------------------------------------
set %t0 #SysTime
moveitem XYZXYZA %B1
set %ms #SysTime - %t0
gosub mp_eq M5 #MoveRes noitem an_unknown_ID
gosub mp_info M5.ms ms_(no_wait) %ms
moveitem %LA XYZXYZA
gosub mp_eq M6 #MoveRes nodest an_unknown_destination
moveitem %LA
gosub mp_eq M10 #MoveRes error no_destination
moveitem %LA %B1 0
gosub mp_eq M10.zero #MoveRes error amount_0

; ---- M7: an item that can not be lifted (Movable false) --------------------------------
set %t0 #SysTime
moveitem %LN %B1
set %ms #SysTime - %t0
gosub mp_eq M7 #MoveRes nolift Movable_false_is_never_lifted
gosub mp_info M7.ms ms_(3_lifts) %ms
gosub mp_where %LN
gosub mp_eq M7.where %wc #BackpackID still_in_the_backpack

; ---- M8: a drop the shard refuses (onto a dagger) --------------------------------------
set %t0 #SysTime
moveitem %LBr %D1
set %ms #SysTime - %t0
gosub mp_eq M8 #MoveRes refused a_drop_onto_a_dagger_is_refused
gosub mp_info M8.ms ms_(3_attempts) %ms
gosub mp_where %LBr
gosub mp_eq M8.where %wc #BackpackID back_in_the_backpack

; ---- M9: a chest on the ground nobody opened, then opened ---------------------------
moveitem %LBr %C1 5
gosub mp_eq M9 #MoveRes left not_seen_in_a_chest_never_opened
set #LObjectID %C1
event macro 17 0
waitfor #ContID = %C1 60
gosub mp_where %LBr
gosub mp_info M9.after the_moved_ID_after_opening_(kind/bag) %wk , / , %wc

; ---- M11: FINDITEM's results are not touched ---------------------------------------
gosub mp_snapold CA_
finditem %LBr A
set %f1 #FindID , _ , #FindCnt , _ , #FindStack
moveitem %LBr %B1 1
set %f2 #FindID , _ , #FindCnt , _ , #FindStack
gosub mp_eq M11 %f2 %f1 finditem_results_are_the_same_after_a_moveitem

; ---- P: as a Player --------------------------------------------------------------
gosub mp_snapold CA_
gosub mp_staff self addtopack Log 20
gosub mp_newid CA_
set %LP %newid
gosub mp_created %LP LP_log_20
gosub mp_snapold G_2
gosub mp_staff self add Log 5
gosub mp_newid G_2
set %LF %newid
gosub mp_created %LF LF_log_5_moved_4_tiles_east
gosub mp_snapold G_2
gosub mp_staff self add WoodenChest set Locked true
gosub mp_newid G_2
set %C2 %newid
gosub mp_created %C2 C2_chest_locked
gosub mp_snapold G_2
gosub mp_staff self add WoodenChest
gosub mp_newid G_2
set %CF %newid
gosub mp_created %CF CF_chest_moved_4_tiles_east
set %p4x #CharPosX + 4
if %LF <> N/A
  gosub mp_oset %LF X %p4x
if %CF <> N/A
  gosub mp_oset %CF X %p4x
wait 20
if %LP = N/A || %LF = N/A || %C2 = N/A || %CF = N/A
{
  log RESULT P INFO player_objects_not_made:_player_cases_skipped
  goto mh_cleanup
}
set %jm #JIndex
gosub mp_staff StaffAccess player
findjournal %jm * 60 Staff_access_set_to_Player
if #JFound = 0
{
  log RESULT P INFO StaffAccess_did_not_lower_the_level:_player_cases_skipped
  goto mh_cleanup
}
set %lowered 1
log PROBE now a PLAYER. If this run stops before the restore, type [StaffAccess in the game.
wait 20

; P1: two moves right after each other: the second waits out the action delay itself
gosub mp_snapold CA_
moveitem %LP %B1 5 60 60
gosub mp_eq P1.first #MoveRes ok first_move_as_a_player
set %t0 #SysTime
moveitem %LP #BackpackID 1 70 70
set %ms #SysTime - %t0
gosub mp_eq P1.second #MoveRes ok a_move_right_after_it_is_ok_too_(retried_after_the_delay)
gosub mp_info P1.ms ms_of_the_second %ms
gosub mp_newid CA_
set %LPr %newid
gosub mp_created %LPr LPr_rest_of_LP

; P2: an item 4 tiles away
moveitem %LF #BackpackID
gosub mp_eq P2 #MoveRes nolift an_item_4_tiles_away_is_not_picked_up
gosub mp_where %LF
gosub mp_eq P2.where %wk 1 still_on_the_ground

; P3: a locked chest
wait 14
gosub mp_where %LPr
set %p3from %wc
moveitem %LPr %C2
gosub mp_eq P3 #MoveRes refused a_locked_chest_refuses_the_drop
gosub mp_where %LPr
gosub mp_eq P3.where %wc %p3from back_where_it_was

; P4: a chest 4 tiles away
wait 14
moveitem %LPr %CF
gosub mp_eq P4 #MoveRes refused a_chest_4_tiles_away_refuses_the_drop

gosub mp_restore

; ---- clean-up ----------------------------------------------------------------------
mh_cleanup:
log PROBE clean-up
gosub mp_restore
if %lowered = 1
{
  log ABORT clean-up skipped: staff commands need the real access level back first
  halt
}
gosub mp_cl %B1 B1
gosub mp_cl %B2 B2
gosub mp_cl %C1 C1
gosub mp_cl %C2 C2
gosub mp_cl %CF CF
gosub mp_cl %D1 D1
gosub mp_cl %LA LA
gosub mp_cl %LB LB
gosub mp_cl %LBr LBr
gosub mp_cl %LN LN
gosub mp_cl %LP LP
gosub mp_cl %LPr LPr
gosub mp_cl %LF LF
if %logt <> N/A
{
  finditem %logt CA_
  set %sw_c #FindCnt
  set %sw_list |
  set %sw_cnt 0
  if %sw_c > 0
  {
    for %sw_i 1 %sw_c
    {
      set #FindIndex %sw_i
      set %sw_k | , #FindID , |
      if %sw_k notin %start
      {
        set %sw_list %sw_list , #FindID , |
        set %sw_cnt %sw_cnt + 1
      }
    }
  }
  log PROBE sweep: %sw_cnt new logs left %sw_list
  if %sw_cnt > 0
  {
    for %sw_n 1 %sw_cnt
    {
      set %sw_p %sw_n + 1
      str part %sw_list | %sw_p
      set %sw_id #StrRes
      gosub mp_cl %sw_id sweep_log
    }
  }
}
log SUMMARY pass= , %passes fail= , %fails
halt

; ###########################################################################
;  HELPERS
; ###########################################################################

; puts the real access level back after [StaffAccess player (no-op when not lowered), twice at most, and checks
; it with [self get AccessLevel against %lvl, the level read at the start
sub mp_restore
  if %lowered <> 1
    return
  for %r_try 1 2
  {
    if %lowered = 1
    {
      set %jm #JIndex
      gosub mp_staff StaffAccess
      wait 20
      gosub mp_staff self get AccessLevel
      set %rl N/A
      findjournal %sj * 60 AccessLevel_=_
      if #JFound > 0
      {
        str part #Journal _=_ 2
        set %rl #StrRes
      }
      gosub mp_journal P.restore
      if %rl = %lvl
      {
        set %lowered 0
        log PROBE access level restored: %rl
      }
    }
  }
  if %lowered = 1
    log ALERT the access level was not restored: type [StaffAccess in the game
return

; where an object is, from the client's own list (closed containers included) -> %wk (-1 not in the list,
; 0 in a container, 1 on the ground), %wc (its container), %ws (stack), %wx, %wy
sub mp_where
  set %w_id %1
  set %wk -1
  set %wc N/A
  set %ws 0
  set %wx 0
  set %wy 0
  finditem %w_id A
  if #FindCnt > 0
  {
    set %wk #FindKind
    set %wc #FindBagID
    set %ws #FindStack
    set %wx #FindX
    set %wy #FindY
  }
return

; exevent drag %1 %2, then waits (40 ticks at most) for the ID to leave the list -> %lifted, %liftms
sub mp_lift
  set %l_id %1
  set %l_amt %2
  set %lifted 0
  set %l_n 0
  set %l_t0 #SysTime
  exevent drag %l_id %l_amt
  repeat
    gosub mp_where %l_id
    if %wk = -1
      set %lifted 1
    else
    {
      wait 1
      set %l_n %l_n + 1
    }
  until %lifted = 1 || %l_n >= 40
  set %liftms #SysTime - %l_t0
return

; exevent dropc %1 [%2 %3]; %d_t0 = when
sub mp_drop
  set %d_c %1
  set %d_x %2
  set %d_y %3
  set %d_t0 #SysTime
  if %0 >= 3
    exevent dropc %d_c %d_x %d_y
  else
    exevent dropc %d_c
return

; waits until %1 is directly in container %2, %3 ticks at most -> %in, %inms (from %d_t0)
sub mp_wait_in
  set %i_id %1
  set %i_c %2
  set %i_max %3
  set %in 0
  set %i_n 0
  repeat
    gosub mp_where %i_id
    if %wk = 0 && %wc = %i_c
      set %in 1
    else
    {
      wait 1
      set %i_n %i_n + 1
    }
  until %in = 1 || %i_n >= %i_max
  set %inms #SysTime - %d_t0
return

; waits until %1 is in the list anywhere, %2 ticks at most -> %seen, %seenms (from %d_t0)
sub mp_wait_seen
  set %v_id %1
  set %v_max %2
  set %seen 0
  set %v_n 0
  repeat
    gosub mp_where %v_id
    if %wk <> -1
      set %seen 1
    else
    {
      wait 1
      set %v_n %v_n + 1
    }
  until %seen = 1 || %v_n >= %v_max
  set %seenms #SysTime - %d_t0
return

; says "I wish to lock this down" and targets %1 -> %locked (1: the shard reads Movable False)
sub mp_lockdown
  set %k_id %1
  set %locked 0
  set %jm #JIndex
  gosub mp_say I wish to lock this down
  waitfor #TargCurs = 1 60
  if #TargCurs <> 1
  {
    gosub mp_journal lockdown.no_cursor
    return
  }
  set #LTargetID %k_id
  set #LTargetKind 1
  event macro 22 0
  waitfor #TargCurs = 0 60
  wait 10
  gosub mp_journal lockdown
  gosub mp_oget %k_id Movable
  if %gn = False
    set %locked 1
return

; deletes %1 (label %2) if the client still knows it
sub mp_cl
  set %c_id %1
  set %c_lab %2
  if %c_id = N/A
    return
  gosub mp_where %c_id
  if %wk = -1
  {
    log CLEANUP %c_lab %c_id not_in_the_list_(gone,_merged,_or_inside_a_deleted_container)
    return
  }
  gosub mp_odelete %c_id
  wait 10
  gosub mp_where %c_id
  if %wk = -1
    log CLEANUP %c_lab %c_id deleted
  else
    log CLEANUP %c_lab %c_id STILL_THERE_delete_it_by_hand
return

sub mp_created
  if %1 = N/A
  {
    log CREATED %2 NOT_MADE
    return
  }
  set %created %created , %1 , |
  log CREATED %2 %1
return

sub mp_eq
  set %e_c %1
  set %e_o %2
  set %e_e %3
  set %e_w %4
  if %e_o = %e_e
  {
    set %passes %passes + 1
    log RESULT %e_c PASS %e_w observed= , %e_o expected= , %e_e
  }
  else
  {
    set %fails %fails + 1
    log RESULT %e_c FAIL %e_w observed= , %e_o expected= , %e_e
  }
return

sub mp_info
  log RESULT %1 INFO %2 value= , %3
return

; the journal lines since %jm, each as a JOURNAL line with the case %1
sub mp_journal
  set %j_c %1
  set %j_n %jm + 1
  set %j_end #JIndex
  while %j_n <= %j_end
  {
    scanjournal %j_n
    log JOURNAL %j_c #Journal
    set %j_n %j_n + 1
  }
return

; ---- new objects: the IDs before, then the first ID that was not there ----
sub mp_snap
  set %s_w %1
  set %snap |
  finditem * %s_w
  set %s_c #FindCnt
  if %s_c > 0
  {
    for %s_i 1 %s_c
    {
      set #FindIndex %s_i
      set %snap %snap , #FindID , |
    }
  }
return

sub mp_snapold
  gosub mp_snap %1
  set %old %snap
return

; the first object in %1 (CA_ or G_2) not in %old -> %newid
sub mp_newid
  set %n_w %1
  set %newid N/A
  set %n_try 0
  repeat
    finditem * %n_w
    set %n_c #FindCnt
    if %n_c > 0
    {
      for %n_i 1 %n_c
      {
        set #FindIndex %n_i
        set %n_k | , #FindID , |
        if %n_k notin %old && %newid = N/A
          set %newid #FindID
      }
    }
    if %newid = N/A
      wait 5
    set %n_try %n_try + 1
  until %newid <> N/A || %n_try > 12
return

; ---- staff commands (ModernUO), paced below the client's spam limit ----------
sub mp_staff
  set %sc %pfx , %1
  if %0 >= 2
    set %sc %sc , #spc , %2
  if %0 >= 3
    set %sc %sc , #spc , %3
  if %0 >= 4
    set %sc %sc , #spc , %4
  if %0 >= 5
    set %sc %sc , #spc , %5
  if %0 >= 6
    set %sc %sc , #spc , %6
  if %0 >= 7
    set %sc %sc , #spc , %7
  if %0 >= 8
    set %sc %sc , #spc , %8
  if %0 >= 9
    set %sc %sc , #spc , %9
  if %0 >= 10
    set %sc %sc , #spc , %10
  if %0 >= 11
    set %sc %sc , #spc , %11
  gosub mp_send
return

; speech, no prefix
sub mp_say
  set %sc %1
  if %0 >= 2
    set %sc %sc , #spc , %2
  if %0 >= 3
    set %sc %sc , #spc , %3
  if %0 >= 4
    set %sc %sc , #spc , %4
  if %0 >= 5
    set %sc %sc , #spc , %5
  if %0 >= 6
    set %sc %sc , #spc , %6
  gosub mp_send
return

sub mp_send
  set %say %sc
  gosub mp_pace
  set %sj #JIndex
  log staff: %sc
  msg %sc , $
  wait 10
  findjournal %sj * 0 Spam_detected
  if #JFound > 0
  {
    set %prate %prate * 2
    set %prate %prate / 3
    if %prate < 4
      set %prate 4
    log the client queued a line: pace now %prate characters a second
  }
return

; waits until the client will send %say at once (see EUOSelfTest's st_pace)
sub mp_pace
  str len %say
  set %plen #StrRes
  repeat
    set %pnow #SCnt2
    set %pd %pnow - %plast
    set %pd %pd * %prate
    set %pd %pd / 10
    set %pm %pm - %pd
    if %pm < 0
      set %pm 0
    set %plast %pnow
    if %pm > %pmax
      wait 2
  until %pm <= %pmax
  set %pm %pm + %plen
return

; [serial <id> get Prop -> %gv (all after "= "), %gn (its first word)
sub mp_oget
  set %g_id %1
  set %g_p %2
  set %gv N/A
  set %gn N/A
  set %in2 %g_id
  gosub mp_id2ser
  gosub mp_staff serial %ser get %g_p
  set %g_t %g_p , _=_
  findjournal %sj * 60 %g_t
  if #JFound = 0
    return
  set %g_line #Journal
  str part %g_line _=_ 2
  set %gv #StrRes
  str part %gv _ 1
  set %gn #StrRes
return

sub mp_oset
  set %o_id %1
  set %o_p %2
  set %o_v %3
  set %in2 %o_id
  gosub mp_id2ser
  gosub mp_staff serial %ser set %o_p %o_v
return

sub mp_odelete
  set %x_id %1
  set %in2 %x_id
  gosub mp_id2ser
  gosub mp_staff serial %ser delete
return

sub mp_oaddtopack
  set %a_id %1
  set %a_t %2
  set %a_n %3
  set %in2 %a_id
  gosub mp_id2ser
  gosub mp_staff serial %ser addtopack %a_t %a_n
return

; EasyUO ID %in2 -> serial %ser: ((n xor 69) + 7) in base 26, A = 0, lowest digit first
sub mp_id2ser
  set %ser 0
  str len %in2
  set %il #StrRes
  if %il = 0
    return
  for %ij %il 1
  {
    str mid %in2 %ij 1
    str pos %alpha #StrRes
    set %ser %ser * 26 + #StrRes - 1
  }
  set %ser %ser - 7
  set %b ( %ser / 1 ) % 2
  if %b = 1
    set %ser %ser - 1
  else
    set %ser %ser + 1
  set %b ( %ser / 4 ) % 2
  if %b = 1
    set %ser %ser - 4
  else
    set %ser %ser + 4
  set %b ( %ser / 64 ) % 2
  if %b = 1
    set %ser %ser - 64
  else
    set %ser %ser + 64
return
