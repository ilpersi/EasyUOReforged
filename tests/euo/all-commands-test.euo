; ============================================================================
;  EasyUO Reforged - all-commands / all-variables self-test
; ============================================================================
;  WHAT IT DOES
;    Exercises every script command and every #variable of the port and prints
;    one line per check:  what was EXPECTED next to what the engine ACTUALLY
;    returned, so you can read the report and see for yourself whether they
;    match.  The report opens in a scrollable window (Ctrl+A, Ctrl+C copies it)
;    and a summary message box closes the run.
;
;  HOW TO RUN
;    1. (Optional) start a UO client and log a character in.  The script works
;       with NO client too: client commands are silent no-ops in that case and
;       every client #variable must read N/A - that is checked as well.
;    2. Make  call-helper.euo  (same folder as this file) findable: leave both
;       files in  <exe folder>\tests\euo\ , or copy call-helper.euo next to
;       the exe, or put its folder into %CFG_TEST_DIR below.  Without it only
;       the CALL tests are skipped.
;    3. Open this file in a tab of EasyUO Reforged and press Play.
;    4. A run takes a few seconds without a client, longer with one (the
;       read-only client checks wait for gumps and for a target timeout).
;
;  HOW TO READ THE REPORT
;    [PASS]  check succeeded
;    [FAIL]  expected and actual differ   <- the interesting ones
;    [NOTE]  a "soft" check (depends on live client data) or a known place
;            where the old wiki documentation and the engine disagree; both
;            values are printed so you can decide which side is right
;    [INFO]  a live value, printed only so you can eyeball it
;    [SKIP]  not run (flag off, no client, no helper file, ...)
;
;  SAFETY
;    Everything that changes game state or the machine is OFF by default and
;    sits behind the %DO_* flags below.  Read-only client checks run
;    automatically when a character is logged in.  ShutDown is NEVER executed.
;    Side effects of a default run: it opens the status gump / paperdoll /
;    backpack in the client, and it writes a few  *euo_selftest_*  persistent
;    variables to HKCU\Software\EasyUO (the language cannot delete them).
;
;  EASYUO QUIRKS THIS SCRIPT RESPECTS
;    - tokens are split on spaces: a value with spaces is built with  , #spc ,
;    - a ';' only starts a comment at the beginning of a token
;    - single-line "if" bodies must not contain another "if": use { } blocks
;    - gosub arguments are tokens, not expressions: compute into a variable first
;    - all subs live below the final "halt"; "exit" is never used in this file
;    - items marked [Reforged] exist only in EasyUO Reforged, not in the original
; ============================================================================

; ---------------------------------------------------------------------------
;  CONFIGURATION  (1 = on, 0 = off)
; ---------------------------------------------------------------------------
set %CFG_QUIET 0
; 1 = no window and no message boxes (used for unattended dry runs)
set %CFG_TEST_DIR
; folder that holds call-helper.euo, with trailing backslash.  Blank = look in
; the folder of the exe (#curpath) and in its  tests\euo\  sub folder.
; Spaces in the path must be written as  , #spc ,
set %CFG_PET_ID
; id of one of your pets.  Only used by %DO_ITEMS: the pet is RENAMED to
; EUOTest (the old name cannot be read back, so it is not restored)
set %CFG_EQUIP_ID
; id of ONE wearable item from your backpack (only used by %DO_ITEMS: it is
; equipped with exevent equip, and also dragged onto the paperdoll)

set %DO_MENU 1
; build/read every menu control type (no window is shown until the very end)
set %DO_TIMING 1
; wait / sleep timing checks (about 3 seconds)
set %DO_TILE 1
; Tile Init/Cnt/Get - needs a logged-in client with readable map files.  It runs
; LAST (a failure inside Tile stops the script, the report is already on screen)

set %DO_CLIENT_WRITES 1
; write every read/write client variable and restore it; contPos/nextCPos/setUOTitle
set %DO_INPUT 1
; click (cursor-only variants), key esc, msg (TYPES INTO CHAT), move, pathfind, event macro say
set %DO_ITEMS 1
; event drag, exevent drag/dropc/popup/renamepet/equip, hideItem  (moves ONE backpack item and puts it back)
set %DO_LOCKS 1
; exevent skillLock (restored) and statLock (cannot be read back or restored by a script)
set %DO_SHOP 0
; getShopInfo / setShopItem - open a vendor "buy" gump first
set %DO_EXECUTE 1
; execute cmd.exe /c exit
set %DO_SEND 1
; send HTTPPost to euo-selftest.invalid (a host name that can never resolve,
; so no connection is made and nothing can answer)
set %DO_UOXL_NEW 0
; uoXL new - STARTS ANOTHER UO CLIENT
set %DO_TERMINATE_UO 0
; terminate uo - CLOSES THE CURRENT UO CLIENT
set %DO_TERMINATE_EUO 0
; terminate euo - CLOSES EASYUO REFORGED itself (last thing the script does)
set %DO_INTERACTIVE 1
; message boxes, beep, pause (press Play), onHotKey (press F9), menu clicks

; ---------------------------------------------------------------------------
;  INITIALISATION
; ---------------------------------------------------------------------------
set %lpc_orig #lpc
set #lpc 1000
set %n_run 0
set %n_pass 0
set %n_fail 0
set %n_note 0
set %n_skip 0
set %n_info 0
set %log
set %fails
set %tile_note
set %c_soft 0

; "return" with no active gosub is a true no-op (it does not even touch #result)
set #result keep
return 99
set %top_return_result #result

; ---- mode detection --------------------------------------------------------
set %HAVE_CLIENT 0
set %LOGGED 0
if #cliNr > 0
{
  set %HAVE_CLIENT 1
}
if %HAVE_CLIENT = 1
{
  if #cliLogged = 1
  {
    set %LOGGED 1
  }
}
; @@mode-detect-end

; ---------------------------------------------------------------------------
;  MAIN FLOW
; ---------------------------------------------------------------------------
gosub sec_banner
gosub sec_variables
gosub sec_operators
gosub sec_control
gosub sec_subs
gosub sec_call
gosub sec_strings
gosub sec_namespaces
gosub sec_misc
gosub sec_sysvars
if %DO_MENU = 1
{
  gosub sec_menu
}
else
{
  gosub t_skip menu_controls flag_DO_MENU_off
}
if %DO_TIMING = 1
{
  gosub sec_timing
}
else
{
  gosub t_skip wait_sleep_timing flag_DO_TIMING_off
}
gosub sec_hotkey
gosub sec_vartable

if %LOGGED = 1
{
  gosub sec_client_ro
}
else
{
  gosub t_skip client_read_only_tier no_logged_in_client
}

if %DO_CLIENT_WRITES = 1
{
  if %LOGGED = 1
  {
    gosub sec_client_writes
  }
  else
  {
    gosub t_skip client_writes no_logged_in_client
  }
}
else
{
  gosub t_skip client_writes flag_DO_CLIENT_WRITES_off
}

if %DO_INPUT = 1
{
  if %LOGGED = 1
  {
    gosub sec_input
  }
  else
  {
    gosub t_skip input_click_key_msg_move no_logged_in_client
  }
}
else
{
  gosub t_skip input_click_key_msg_move flag_DO_INPUT_off
}

if %DO_ITEMS = 1
{
  if %LOGGED = 1
  {
    gosub sec_items
  }
  else
  {
    gosub t_skip item_drag_drop_popup no_logged_in_client
  }
}
else
{
  gosub t_skip item_drag_drop_popup flag_DO_ITEMS_off
}

if %DO_LOCKS = 1
{
  if %LOGGED = 1
  {
    gosub sec_locks
  }
  else
  {
    gosub t_skip skill_stat_locks no_logged_in_client
  }
}
else
{
  gosub t_skip skill_stat_locks flag_DO_LOCKS_off
}

if %DO_SHOP = 1
{
  if %LOGGED = 1
  {
    gosub sec_shop
  }
  else
  {
    gosub t_skip shop_commands no_logged_in_client
  }
}
else
{
  gosub t_skip shop_commands flag_DO_SHOP_off
}

if %DO_EXECUTE = 1
{
  gosub sec_execute
}
else
{
  gosub t_skip execute_command flag_DO_EXECUTE_off
}

if %DO_SEND = 1
{
  gosub sec_send
}
else
{
  gosub t_skip send_http_post flag_DO_SEND_off
}

if %DO_UOXL_NEW = 1
{
  gosub sec_uoxl_new
}
else
{
  gosub t_skip uoxl_new flag_DO_UOXL_NEW_off
}

if %DO_INTERACTIVE = 1
{
  gosub sec_interactive
}
else
{
  gosub t_skip interactive_display_sound_pause_hotkey flag_DO_INTERACTIVE_off
}

gosub t_skip shutdown_command NOT_TESTED_by_design_it_would_power_off_the_PC

; ignoreCont is checked last of the client tests: "ignoreCont reset" empties
; the client-gump ignore list for the rest of this run
if %LOGGED = 1
{
  gosub sec_ignorecont
}
else
{
  gosub t_skip ignorecont_command no_logged_in_client
}

if %DO_TERMINATE_UO = 1
{
  gosub sec_terminate_uo
}
else
{
  gosub t_skip terminate_uo flag_DO_TERMINATE_UO_off
}

; ---- report window (shown BEFORE tile, which may stop the script) ---------
if %DO_TILE = 1
{
  if %LOGGED = 1
  {
    set %tile_note TILE_section_pending:_if_this_is_the_last_line_the_script_stopped_inside_Tile_Init
  }
}
gosub sec_report

; ---- tile (last: a missing map file makes Tile Init abort the script) -----
if %DO_TILE = 1
{
  if %LOGGED = 1
  {
    gosub sec_tile
    set %tile_note
    gosub sec_report_refresh
  }
  else
  {
    gosub t_skip tile_command no_logged_in_client
    gosub sec_report_refresh
  }
}
else
{
  gosub t_skip tile_command flag_DO_TILE_off
  gosub sec_report_refresh
}

; ---- the end ---------------------------------------------------------------
set #lpc %lpc_orig
if %CFG_QUIET = 0
{
  display ok %summary
}
if %DO_TERMINATE_EUO = 1
{
  terminate euo
}
halt

; ###########################################################################
;  SECTIONS  (each one is a sub called from the main flow above)
; ###########################################################################

; ===========================================================================
;  00  environment banner
; ===========================================================================
sub sec_banner
  gosub t_head 00_environment
  gosub t_info reforged_version #reforgedver
  gosub t_info euo_version #euover
  gosub t_info os_version #osver
  gosub t_info clients_detected #clicnt
  gosub t_info active_client_slot #clinr
  if %HAVE_CLIENT = 1
  {
    gosub t_info mode CLIENT_ATTACHED
    gosub t_info client_version #cliver
    gosub t_info client_language #clilang
    gosub t_info logged_in #clilogged
    gosub t_info shard #shard
    gosub t_info character #charname
  }
  else
  {
    gosub t_info mode NO_CLIENT_(client_commands_are_no-ops_and_client_variables_read_N/A)
  }
  if %LOGGED = 1
  {
    gosub t_info client_tier READ-ONLY_CLIENT_CHECKS_WILL_RUN
  }
  else
  {
    gosub t_info client_tier SKIPPED_(no_logged_in_character)
  }
return

; ===========================================================================
;  01  variables
; ===========================================================================
sub sec_variables
  gosub t_head 01_variables
  set %v_a hello
  gosub t_eq set_and_read %v_a hello
  set %v_name Bob
  set %v_NAME Joe
  gosub t_eq variable_names_are_case_insensitive %v_name Joe
  set %v_blank
  str len %v_blank
  gosub t_eq set_without_value_gives_empty_string_len #strres 0
  gosub t_eq undefined_variable_reads_N/A %v_never_set N/A
  set %v_copy %v_a
  gosub t_eq copy_variable_to_variable %v_copy hello
  set %v_us_1x ok
  gosub t_eq name_with_underscore_and_digits %v_us_1x ok
  set %v_sum 2 + 2
  gosub t_eq set_evaluates_expression %v_sum 4
  set %v_neg -5 + 2
  gosub t_eq negative_literal_arithmetic %v_neg -3
  set %v_big 123456789012345678 + 1
  gosub t_eq int64_arithmetic_18_digits %v_big 123456789012345679
  set %v_q hello + 1
  gosub t_eq QUIRK_non_numeric_operand_counts_as_0 %v_q 1

  ; ---- hexadecimal ------------------------------------------------------
  set %v_hex $ff
  set %v_r %v_hex + 0
  gosub t_eq hex_literal_ff_plus_0 %v_r 255
  set %v_r $ff + $01
  gosub t_eq hex_plus_hex %v_r 256
  set %w_a 2
  set %w_b $a
  set %w_c ( %w_a * %w_b ) + 1
  gosub t_eq wiki_set_example_c_equals_21 %w_c 21
  set %w_d %w_a * ( %w_b + 1 )
  gosub t_eq wiki_set_example_d_equals_22 %w_d 22
  set %w_e %w_a * %w_b + 1
  gosub t_eq wiki_set_example_e_equals_21 %w_e 21

  ; ---- the set shorthand forms ---------------------------------------------
  set %v_n 5 -
  gosub t_eq set_n_minus_decrements %v_n 4
  set %v_n 5 +
  gosub t_eq set_n_plus_increments %v_n 6
  set %v_n -5 abs
  gosub t_eq set_n_abs_postfix %v_n 5
  set %v_n abs -5
  gosub t_eq set_abs_n_prefix %v_n 5
  set %v_n 7
  set %v_n %v_n + 1
  gosub t_eq increment_idiom %v_n 8

  ; ---- deleteVar -----------------------------------------------------------
  set %v_del x
  deleteVar v_del
  gosub t_eq deletevar_removes_the_variable %v_del N/A

  ; ---- constants ------------------------------------------------------------
  gosub t_eq true_constant_is_minus_one #true -1
  gosub t_eq false_constant_is_zero #false 0
  set %v_sp a , #spc , b
  str pos %v_sp b
  gosub t_eq spc_constant_is_one_space #strres 3
  set %v_sm a , #smc , b
  str pos %v_sm #smc
  gosub t_eq smc_constant_is_a_semicolon #strres 2
  set %v_dt a , #dot , b
  str pos %v_dt #dot
  gosub t_eq dot_constant_is_a_dot #strres 2

  ; ---- concatenation and the array operator ------------------------------------
  set %v_cat1 A , B , C
  gosub t_eq comma_concatenates %v_cat1 ABC
  set %c_var1 3
  set %c_var2 spotNumber
  set %c_var23 Tada!
  set %c_test1 %c_var2 , %c_var1
  set %c_test2 %c_var2 . %c_var1
  gosub t_eq wiki_comma_left_associative %c_test1 spotNumber3
  gosub t_eq wiki_dot_right_associative_builds_a_name %c_test2 Tada!
  set %q_a 3
  set %q_z3 8
  set %q_w8 1337
  set %v_chain %q_w . %q_z . %q_a
  gosub t_eq wiki_array_chain_w_z_a %v_chain 1337
  for %k 1 3
  {
    set %v_arr . %k %k * 10
  }
  gosub t_eq array_idiom_write_element_1 %v_arr1 10
  gosub t_eq array_idiom_write_element_3 %v_arr3 30
  set %k 2
  set %v_got %v_arr . %k
  gosub t_eq array_idiom_read_element_2 %v_got 20

  ; ---- line continuation -----------------------------------------------------------
  set %v_lc1 foo
+bar
  gosub t_eq line_continuation_without_space %v_lc1 foobar
  set %v_lc2 A ,
+ B ,
+ C
  gosub t_eq line_continuation_with_space %v_lc2 ABC

  ; ---- persistent variables (registry HKCU\Software\EasyUO) ----------------------------
  set *euo_selftest_a hello
  gosub t_eq persistent_variable_round_trip *euo_selftest_a hello
  set *euo_selftest_n 42
  set %v_pn *euo_selftest_n + 1
  gosub t_eq persistent_variable_is_usable_in_expressions %v_pn 43
  gosub t_eq persistent_variable_never_set *euo_selftest_never_set_xyz N/A
return

; ===========================================================================
;  02  operators and expressions
; ===========================================================================
sub sec_operators
  gosub t_head 02_operators
  ; ---- arithmetic: precedence and associativity -----------------------------
  set %o 5 + 3 * 2
  gosub t_eq mul_before_add_5_plus_3_times_2 %o 11
  set %o 8 - 3 - 2
  gosub t_eq subtraction_is_left_associative %o 3
  set %o 10 - 4 + 2
  gosub t_eq add_and_sub_same_level_left_to_right %o 8
  set %o 1 + 2 * 2 * 4
  gosub t_eq wiki_1_plus_2_times_2_times_4 %o 17
  set %o ( 1 + 2 ) * 2 * 4
  gosub t_eq wiki_parentheses_first %o 24
  set %o ( 2 + 2 ) * ( 3 - 1 )
  gosub t_eq wiki_two_paren_groups %o 8
  set %o ( ( 1 + 2 ) * ( 3 + 4 ) ) - 1
  gosub t_eq nested_parentheses %o 20
  set %o 2 + 3 * 4 - 6 / 2
  gosub t_eq mixed_precedence %o 11
  set %o 100 / 10 / 5
  gosub t_eq division_is_left_associative %o 2
  set %o 100 / ( 10 / 5 )
  gosub t_eq division_with_parentheses %o 50
  set %o 17 % 5 * 2
  gosub t_eq modulo_and_multiply_left_to_right %o 4
  set %o 5 - -3
  gosub t_eq minus_a_negative_literal %o 8

  ; ---- integer division and modulo --------------------------------------------
  set %o 7 / 2
  gosub t_eq integer_division_drops_remainder %o 3
  set %o -7 / 2
  gosub t_eq integer_division_truncates_toward_zero %o -3
  set %o 7 % 3
  gosub t_eq modulo %o 1
  set %o -7 % 3
  gosub t_eq modulo_sign_follows_dividend %o -1
  set %o 5 / 0
  gosub t_eq division_by_zero_gives_0 %o 0
  set %o 5 % 0
  gosub t_eq modulo_by_zero_gives_0 %o 0

  ; ---- ABS -----------------------------------------------------------------------
  set %o abs -12
  gosub t_eq abs_prefix %o 12
  set %o 3 - 10 abs
  gosub t_eq abs_postfix_applies_to_the_whole_set_expression %o 7

  ; ---- comparisons: numeric ------------------------------------------------------------
  set %o 10 > 9
  gosub t_eq numeric_greater_10_9 %o -1
  set %o 9 > 10
  gosub t_eq numeric_not_greater_9_10_not_a_string_compare %o 0
  set %o 9 < 10
  gosub t_eq numeric_less %o -1
  set %o 5 <= 5
  gosub t_eq less_or_equal_true %o -1
  set %o 5 >= 6
  gosub t_eq greater_or_equal_false %o 0
  set %o 5 =< 5
  gosub t_eq undocumented_alias_equal_or_less %o -1
  set %o 6 => 5
  gosub t_eq undocumented_alias_equal_or_greater %o -1
  set %o 5 = 5
  gosub t_eq equal_numbers %o -1
  set %o 5 = 05
  gosub t_eq equal_numbers_ignore_leading_zero %o -1
  set %o 5 <> 6
  gosub t_eq not_equal_numbers %o -1
  set %o $ff = 255
  gosub t_eq hex_equals_decimal %o -1

  ; ---- comparisons: text ------------------------------------------------------------------
  set %o abc = ABC
  gosub t_eq text_equality_ignores_case %o -1
  set %o abc = abd
  gosub t_eq text_inequality %o 0
  set %o abc <> ABC
  gosub t_eq text_not_equal_ignores_case %o 0
  set %o hello > 33
  gosub t_eq wiki_text_greater_than_number_is_false %o 0
  set %o hello < 33
  gosub t_eq text_less_than_number_is_false_too %o 0
  set %o 33 >= hello
  gosub t_eq number_ge_text_is_false %o 0

  ; ---- in / notIn ----------------------------------------------------------------------------
  set %o ell in hello
  gosub t_eq in_true %o -1
  set %o xyz in hello
  gosub t_eq in_false %o 0
  set %o ELL in hello
  gosub t_eq in_is_case_insensitive %o -1
  set %o xyz notin hello
  gosub t_eq notin_true %o -1
  set %o ell notin hello
  gosub t_eq notin_false %o 0

  ; ---- logical -------------------------------------------------------------------------------------
  set %o #true && #true
  gosub t_eq and_true_true %o -1
  set %o #true && #false
  gosub t_eq and_true_false %o 0
  set %o #false || #true
  gosub t_eq or_false_true %o -1
  set %o #false || #false
  gosub t_eq or_false_false %o 0
  set %o ! #true
  gosub t_eq not_true %o 0
  set %o ! #false
  gosub t_eq not_false %o -1
  set %o ! ! #true
  gosub t_eq double_not %o -1
  set %o ! ( 1 = 2 )
  gosub t_eq not_of_parenthesised_comparison %o -1
  set %o #true || #false && #false
  gosub t_eq and_binds_tighter_than_or %o -1
  set %o ( #true || #false ) && #false
  gosub t_eq parentheses_override_precedence %o 0
  set %o ( 1 = 1 ) + 5
  gosub t_eq true_is_minus_one_so_true_plus_5_is_4 %o 4
  set %o ( 1 = 2 ) + 5
  gosub t_eq false_is_zero_so_false_plus_5_is_5 %o 5
  set %o ( 3 > 2 ) && ( 5 > 4 ) && ( 7 > 6 )
  gosub t_eq wiki_three_way_and %o -1

  ; ---- wiki: "is this a number?" trick ----------------------------------------------------------
  set %cnt invalid
  if ! ( %cnt > 0 || %cnt < 1 )
  {
    set %cnt 0
  }
  set %cnt %cnt + 1
  gosub t_eq wiki_number_validity_trick %cnt 1

  ; ---- QUIRKS preserved from the original engine -----------------------------------------------------
  set %o ! 5
  gosub t_eq QUIRK_not_is_bitwise_not_5_gives_minus_6 %o -6
  set %o 5 && 3
  gosub t_eq QUIRK_and_is_bitwise_5_and_3_is_1 %o 1
  set %o 5 || 2
  gosub t_eq QUIRK_or_is_bitwise_5_or_2_is_7 %o 7

  ; ---- wiki: "if ! %var = world" ---------------------------------------------------------------------
  set %var hello
  set %o no
  if ! %var = world
  {
    set %o yes
  }
  gosub t_dd wiki_if_not_var_equals_world_without_parentheses %o yes no
  set %o no
  if ! ( %var = world )
  {
    set %o yes
  }
  gosub t_eq if_not_with_parentheses_works_as_documented %o yes
  set %o no
  if %var <> world
  {
    set %o yes
  }
  gosub t_eq if_not_equal_operator %o yes
return

; ===========================================================================
;  03  control flow: if / else, for, while, repeat..until, goto
; ===========================================================================
sub sec_control
  gosub t_head 03_control_flow

  ; ---- if / else ------------------------------------------------------------
  set %r none
  if 1 = 1
    set %r then
  else
    set %r else
  gosub t_eq if_true_single_line_runs_then %r then
  set %r none
  if 1 = 2
    set %r then
  else
    set %r else
  gosub t_eq if_false_single_line_runs_else %r else
  set %r none
  if 1 = 1
  {
    set %r a
    set %r %r , b
  }
  else
  {
    set %r wrong
  }
  gosub t_eq if_true_block %r ab
  set %r none
  if 1 = 2
  {
    set %r wrong
  }
  else
  {
    set %r c
    set %r %r , d
  }
  gosub t_eq if_false_block_runs_else_block %r cd
  set %a 2
  set %r none
  if %a = 1
  {
    set %r One
  }
  else
  {
    if %a = 2
    {
      set %r Two
    }
    else
    {
      set %r Three
    }
  }
  gosub t_eq wiki_nested_if_else_chain %r Two
  set %r 0
  if 1 = 2 2
    set %r %r + 1
    set %r %r + 10
  set %r %r + 100
  gosub t_eq wiki_if_with_skip_count_condition_false %r 100
  set %r 0
  if 1 = 1 2
    set %r %r + 1
    set %r %r + 10
  set %r %r + 100
  gosub t_eq wiki_if_with_skip_count_condition_true %r 111
  set %r none
  if 1 = 2
    set %r then

  ; a blank line and a comment between the if-body and the else

  else
    set %r else
  gosub t_eq else_after_blank_and_comment_lines %r else
  set %r
  if 1 = 1
    set %r %r , a
  else
    set %r %r , X
  if 1 = 2
    set %r %r , Y
  else
    set %r %r , b
  gosub t_eq sequential_if_else_pairs_do_not_interfere %r ab
  set %r no
  if ! ( 1 = 2 )
    set %r yes
  gosub t_eq if_not_parenthesised_comparison %r yes
  set %r no
  if ! #false
    set %r yes
  gosub t_eq if_not_false %r yes
  set %r no
  if #true
    set %r yes
  gosub t_eq if_true_constant %r yes
  set %r no
  if #false
    set %r yes
  gosub t_eq if_false_constant_skips %r no
  set %v_flag #true
  set %r no
  if %v_flag
    set %r yes
  gosub t_eq wiki_if_boolean_variable %r yes
  set %r no
  if 1
    set %r yes
  gosub t_eq QUIRK_only_minus_1_counts_as_true_if_1_is_false %r no

  ; ---- for ---------------------------------------------------------------------
  set %sum 0
  for %i 1 5
    set %sum %sum + %i
  gosub t_eq for_count_up_single_line_body %sum 15
  gosub t_eq for_variable_after_loop_is_end_plus_1 %i 6
  set %sum 0
  for %i 3 1
    set %sum %sum + %i
  gosub t_eq for_count_down %sum 6
  gosub t_eq for_variable_after_down_loop_is_end_minus_1 %i 0
  set %cnt 0
  for %i 7 7
  {
    set %cnt %cnt + 1
  }
  gosub t_eq for_equal_bounds_run_once %cnt 1
  gosub t_eq for_variable_after_equal_bounds %i 8
  set %cnt 0
  set %sum 0
  for %i -2 2
  {
    set %cnt %cnt + 1
    set %sum %sum + %i
  }
  gosub t_eq for_negative_start_iterations %cnt 5
  gosub t_eq for_negative_start_sum %sum 0
  set %lo 2
  set %hi 4
  set %r
  for %i %lo %hi
  {
    set %r %r , %i
  }
  gosub t_eq for_bounds_from_variables %r 234
  set %cnt 0
  for %i 1 3
  {
    for %j 1 3
    {
      set %cnt %cnt + 1
    }
  }
  gosub t_eq for_nested_3_by_3 %cnt 9
  set %cnt 0
  for %i 1 3
  {
    for %j 1 %i
    {
      set %cnt %cnt + 1
    }
  }
  gosub t_eq for_nested_inner_bound_depends_on_outer %cnt 6
  set %r
  for %i 1 5
  {
    if %i = 4
      break
    if %i = 2
      continue
    set %r %r , %i
  }
  gosub t_eq for_with_break_and_continue %r 13

  ; ---- while ----------------------------------------------------------------------
  set %i 0
  while %i < 5
  {
    set %i %i + 1
  }
  gosub t_eq while_loop %i 5
  set %w 0
  while 1 = 2
  {
    set %w 1
  }
  gosub t_eq while_false_first_never_runs_body %w 0
  set %i 0
  set %odd 0
  while %i < 10
  {
    set %i %i + 1
    if %i = 8
      break
    if %i % 2 = 0
      continue
    set %odd %odd + 1
  }
  gosub t_eq while_break_stops_the_loop %i 8
  gosub t_eq while_continue_skips_rest_of_body %odd 4
  set %k 0
  while %k < 3
    set %k %k + 1
  gosub t_eq while_single_line_body %k 3
  set %cnt 0
  set %i 0
  while %i < 3
  {
    set %i %i + 1
    set %j 0
    while %j < 3
    {
      set %j %j + 1
      if %j = 2
        break
      set %cnt %cnt + 1
    }
  }
  gosub t_eq while_break_leaves_only_the_inner_loop %cnt 3

  ; ---- repeat .. until ------------------------------------------------------------------
  set %i 0
  repeat
  {
    set %i %i + 1
  }
  until %i >= 5
  gosub t_eq repeat_until_counts_up %i 5
  set %i 10
  repeat
  {
    set %i %i + 1
  }
  until %i > 0
  gosub t_eq repeat_body_runs_at_least_once %i 11
  set %i 0
  set %odd 0
  repeat
  {
    set %i %i + 1
    if %i = 9
      break
    if %i % 2 = 0
      continue
    set %odd %odd + 1
  }
  until %i >= 20
  gosub t_eq repeat_break_leaves_the_loop %i 9
  gosub t_eq repeat_continue_goes_to_the_until_test %odd 4
  set %str Hello , #spc , World
  repeat
  {
    set %str %str , !
    str len %str
  }
  until #strres >= 30
  str len %str
  gosub t_eq wiki_repeat_until_str_len #strres 30

  ; ---- goto / labels ------------------------------------------------------------------------
  set %r
  goto g_fwd1
  set %r %r , SKIPPED
g_fwd1:
  set %r %r , reached
  gosub t_eq goto_forward %r reached
  set %n 0
g_back1:
  set %n %n + 1
  if %n < 3
    goto g_back1
  gosub t_eq goto_backward_loop %n 3
  set %r no
  goto G_Colon1:
  set %r SKIPPED
g_colon1:
  set %r yes
  gosub t_eq goto_label_case_and_trailing_colon %r yes
  set %k 2
  set %r
  goto g_case , %k
g_case1:
  set %r one
  goto g_case_end
g_case2:
  set %r two
  goto g_case_end
g_case3:
  set %r three
g_case_end:
  gosub t_eq wiki_goto_switch_emulation %r two
  set %r before
  goto g_does_not_exist
  set %r %r , after
  gosub t_eq goto_to_missing_label_is_a_noop %r beforeafter
  set %r none
  goto gn_start1
gn_t1:
  set %r above
  goto gn_end1
gn_start1:
  goto gn_t1
  set %r SKIPPED_1
  set %r SKIPPED_2
  set %r SKIPPED_3
gn_t1:
  set %r below
gn_end1:
  gosub t_eq goto_duplicate_label_equal_distance_below_wins %r below
  set %r none
  goto gn_start2
gn_t2:
  set %r above
  goto gn_end2
gn_start2:
  goto gn_t2
  set %r SKIPPED_1
  set %r SKIPPED_2
  set %r SKIPPED_3
  set %r SKIPPED_4
gn_t2:
  set %r below
gn_end2:
  gosub t_eq goto_duplicate_label_nearest_one_wins %r above

  ; ---- unknown words, blocks and the no-op commands ---------------------------------------------------
  set %r start
  xyzzy_not_a_command 1 2 3
  initEvents
  stopCD
  playCD
  {
    set %r %r , block
  }
  set %r %r , end
  gosub t_eq unknown_words_initevents_stopcd_playcd_and_bare_blocks_are_noops %r startblockend
return

; ===========================================================================
;  04  gosub / sub / return
; ===========================================================================
sub sec_subs
  gosub t_head 04_gosub_sub_return
  gosub t_eq top_level_return_is_a_noop_and_keeps_result %top_return_result keep
  gosub s_add 3 4
  gosub t_eq gosub_return_expression_goes_to_result #result 7
  gosub s_args one two three
  gosub t_eq gosub_percent_0_is_the_parameter_count %sa_0 3
  gosub t_eq gosub_percent_1 %sa_1 one
  gosub t_eq gosub_percent_2 %sa_2 two
  gosub t_eq gosub_percent_3 %sa_3 three
  gosub s_args
  gosub t_eq gosub_without_parameters_gives_0 %sa_0 0
  gosub s_ten 1 2 3 4 5 6 7 8 9 ten
  gosub t_eq gosub_ten_parameters_percent_10 #result ten
  gosub s_ret_bare
  gosub t_eq return_without_value_resets_result_to_NA #result N/A
  gosub s_ret_text
  gosub t_eq return_text_value #result hello
  set %trace
  gosub s_lvl1
  gosub t_eq gosub_nested_three_levels %trace a1_a2_a3_b3_b2_b1_
  gosub s_dup
  gosub t_eq gosub_duplicate_sub_names_last_definition_wins #result second
  set %r before
  gosub s_does_not_exist
  set %r %r , after
  gosub t_eq gosub_to_missing_sub_is_a_noop %r beforeafter
  gosub s_case_probe
  gosub t_eq sub_and_gosub_names_are_case_insensitive #result found
  set %rs_depth 0
  gosub s_rsum 50
  gosub t_eq recursion_sum_1_to_50 #result 1275
  gosub t_eq recursion_depth_counter_back_to_0 %rs_depth 0
  gosub s_xor 1875 618
  gosub t_eq wiki_return_expression_bitwise_xor_1875_618 #result 1337
  gosub s_blockbody 5
  gosub t_eq sub_with_braces_and_early_return #result big
  gosub s_blockbody 1
  gosub t_eq sub_with_braces_falls_to_the_second_return #result small
return

; ###########################################################################
;  test subs used by the control-flow and gosub sections
; ###########################################################################
sub s_add
  return %1 + %2

sub s_args
  set %sa_0 %0
  set %sa_1 %1
  set %sa_2 %2
  set %sa_3 %3
return

sub s_ten
  return %10

sub s_ret_bare
  return

sub s_ret_text
  return hello

sub s_lvl1
  set %trace %trace , a1_
  gosub s_lvl2
  set %trace %trace , b1_
return

sub s_lvl2
  set %trace %trace , a2_
  gosub s_lvl3
  set %trace %trace , b2_
return

sub s_lvl3
  set %trace %trace , a3_
  set %trace %trace , b3_
return

sub s_dup
  return first

sub s_dup
  return second

sub S_CASE_probe
  return found

sub s_rsum
  if %1 <= 0
  {
    return 0
  }
  set %rs_depth %rs_depth + 1
  set %rs_n . %rs_depth %1
  set %rs_m %1 - 1
  gosub s_rsum %rs_m
  set %rs_sub #result
  set %rs_cur %rs_n . %rs_depth
  set %rs_depth %rs_depth - 1
  return %rs_cur + %rs_sub

sub s_xor
  return %1 && ! %2 || ! %1 && %2

sub s_blockbody
{
  if %1 > 3
  {
    return big
  }
  return small
}

; ===========================================================================
;  05  call / exit  (needs call-helper.euo)
; ===========================================================================
sub sec_call
  gosub t_head 05_call_and_exit
  gosub find_helper
  if %HELPER_DIR = N/A
  {
    gosub t_skip call_tests call-helper.euo_not_found_tried:_ , %tried
    return
  }
  gosub t_info call_helper_folder %HELPER_DIR
  gosub t_eq call_finds_the_file_without_its_extension %call_probe ok

  set %main_marker from_main
  call %HELPER_DIR , call-helper.euo exit alpha beta gamma
  gosub t_eq call_parameter_count_percent_0 %call_argc 4
  gosub t_eq call_parameter_1 %call_a1 exit
  gosub t_eq call_parameter_2 %call_a2 alpha
  gosub t_eq call_parameter_3 %call_a3 beta
  gosub t_eq call_parameter_4 %call_a4 gamma
  gosub t_eq call_callee_sees_callers_variables %call_sees_main from_main
  gosub t_eq call_callee_variable_visible_to_caller %call_set_in_callee set_by_callee
  gosub t_eq call_callee_can_change_callers_variable %main_marker changed_by_callee
  gosub t_eq call_gosub_inside_callee_uses_the_callees_sub %call_inner_result inner_ok_x_y
  gosub t_eq call_exit_returns_to_the_caller %call_exit_ran ok
  gosub t_eq call_code_after_exit_does_not_run %call_after_exit N/A
  gosub t_eq call_callee_cannot_gosub_a_sub_of_the_caller %call_leak N/A

  set %call_eof_ran N/A
  call %HELPER_DIR , call-helper.euo eof
  gosub t_eq call_running_off_the_end_of_the_file_returns %call_eof_ran ok
  set %after_eof_call reached
  gosub t_eq call_caller_continues_after_eof_return %after_eof_call reached

  set %call_exit_ran N/A
  set %call_nested_after N/A
  call %HELPER_DIR , call-helper.euo nested
  gosub t_eq call_nested_inner_call_ran %call_exit_ran ok
  gosub t_eq call_nested_outer_continues_after_inner_returns %call_nested_after ok

  set %r before
  call %HELPER_DIR , no-such-helper-file-xyz.euo
  set %r %r , after
  gosub t_eq call_of_a_missing_file_is_a_noop %r beforeafter
return

sub find_helper
  set %HELPER_DIR N/A
  set %tried
  set %cfg_dir %CFG_TEST_DIR
  str len %cfg_dir
  if #strres > 0
  {
    str right %cfg_dir 1
    if #strres <> \
    {
      set %cfg_dir %cfg_dir , \
    }
    gosub call_try %cfg_dir
  }
  if %HELPER_DIR = N/A
  {
    gosub call_try #curpath
  }
  if %HELPER_DIR = N/A
  {
    gosub call_try #curpath , tests\euo\
  }
return

sub call_try
  set %_ct %1
  set %tried %tried , %_ct , _|_
  set %call_probe N/A
  call %_ct , call-helper probe
  if %call_probe = ok
  {
    set %HELPER_DIR %_ct
  }
return

; ===========================================================================
;  06  str command
; ===========================================================================
sub sec_strings
  gosub t_head 06_str_command
  ; NOTE: text comparison in this report is case-insensitive, so the CASE of
  ; the lower/upper results is something you check by reading actual[...]
  set %s HELLO
  str len %s
  gosub t_eq str_len #strres 5
  set %e
  str len %e
  gosub t_eq str_len_of_empty_string #strres 0
  set %sp a , #spc , b , #spc , c
  str len %sp
  gosub t_eq str_len_counts_spaces #strres 5
  str pos %s LL
  gosub t_eq str_pos #strres 3
  str pos %s ll
  gosub t_eq str_pos_ignores_case #strres 3
  str pos %s ZZ
  gosub t_eq str_pos_not_found_gives_0 #strres 0
  str left %s 4
  gosub t_eq str_left #strres HELL
  str left %s 99
  gosub t_eq str_left_longer_than_the_string #strres HELLO
  str right %s 2
  gosub t_eq str_right #strres LO
  str mid %s 2 3
  gosub t_eq str_mid #strres ELL
  str lower %s
  gosub t_eq str_lower_(check_the_case_in_actual) #strres hello
  set %s2 Hello
  str upper %s2
  gosub t_eq str_upper_[Reforged]_(check_the_case_in_actual) #strres HELLO
  str ins %s I 3
  gosub t_dd wiki_str_ins_HELLO_I_3 #strres HELILO HEILLO
  str del %s 3 2
  gosub t_eq str_del #strres HEO
  str count %s L
  gosub t_eq str_count #strres 2
  str count %s ZZ
  gosub t_eq str_count_without_match #strres 0
  set %tt _this_is_a_test_and_tests_are_cool_
  str count %tt _
  gosub t_eq wiki_str_count_underscores_in_the_cheffe_sample #strres 9
  str pos %tt _ 1
  gosub t_eq str_pos_with_index_1 #strres 1
  str pos %tt _ 2
  gosub t_eq str_pos_with_index_2 #strres 6
  str pos %tt _ 3
  gosub t_eq str_pos_with_index_3 #strres 9
  str left abc xyz
  gosub t_eq str_with_a_bad_numeric_argument_leaves_NA #strres N/A
  str len
  gosub t_eq str_with_too_few_parameters_gives_NA #strres N/A
return

; ===========================================================================
;  07  namespaces
; ===========================================================================
sub sec_namespaces
  gosub t_head 07_namespaces
  gosub t_eq default_namespace_name #nsname std
  gosub t_eq default_namespace_type #nstype local
  set !t std_value
  gosub t_eq namespace_variable_in_the_default_namespace !t std_value

  namespace local nsA
  gosub t_eq namespace_local_sets_the_name #nsname nsA
  gosub t_eq namespace_local_sets_the_type #nstype local
  gosub t_eq namespace_variable_is_empty_in_a_new_namespace !t N/A
  set !t A_value
  namespace local nsB
  set !t B_value
  namespace local nsA
  gosub t_eq namespace_variables_are_isolated_A !t A_value
  namespace local NSB
  gosub t_eq namespace_names_are_case_insensitive_B !t B_value
  namespace local std
  gosub t_eq namespace_std_still_holds_its_value !t std_value

  ; ---- push / pop and global ------------------------------------------------
  namespace global nsG
  namespace clear
  namespace local nsA
  namespace push
  namespace local nsB
  namespace push
  namespace global nsG
  gosub t_eq namespace_global_sets_the_type #nstype global
  gosub t_eq namespace_global_sets_the_name #nsname nsG
  set !g_val G_value
  gosub t_eq namespace_global_variable !g_val G_value
  namespace pop
  gosub t_eq pop_restores_name_nsB #nsname nsB
  gosub t_eq pop_restores_type_local #nstype local
  gosub t_eq pop_restores_visible_variables !t B_value
  namespace pop
  gosub t_eq pop_restores_name_nsA #nsname nsA
  gosub t_eq pop_restores_variables_nsA !t A_value
  gosub t_eq global_variable_is_not_visible_from_a_local_namespace !g_val N/A
  namespace global nsG
  gosub t_eq global_variable_survives_switching_namespaces !g_val G_value
  namespace clear
  gosub t_eq namespace_clear_on_global_namespace !g_val N/A
  namespace local nsA
  namespace pop
  gosub t_dd wiki_pop_with_nothing_pushed_goes_back_to_STD #nsname std nsA

  ; ---- clear -------------------------------------------------------------------
  namespace local nsC
  set !x 1
  set !y 2
  namespace clear
  gosub t_eq namespace_clear_removes_x !x N/A
  gosub t_eq namespace_clear_removes_y !y N/A
  namespace local nsA
  gosub t_eq namespace_clear_leaves_other_namespaces_alone !t A_value

  ; ---- copy ------------------------------------------------------------------------
  namespace local nsSrc
  set !ret_a 1
  set !ret_b 2
  set !other 3
  namespace local nsDst
  namespace copy ret* from local nsSrc
  gosub t_eq copy_from_local_star_filter_ret_a !ret_a 1
  gosub t_eq copy_from_local_star_filter_ret_b !ret_b 2
  gosub t_eq copy_skips_names_that_do_not_match !other N/A
  namespace clear
  namespace copy * from local nsSrc
  gosub t_eq copy_star_copies_everything_other !other 3
  gosub t_eq copy_star_copies_everything_ret_a !ret_a 1
  namespace clear
  namespace copy r*_a from local nsSrc
  gosub t_eq copy_filter_with_text_before_and_after_the_star_matches !ret_a 1
  gosub t_eq copy_filter_with_text_before_and_after_the_star_skips_ret_b !ret_b N/A
  namespace clear
  ; a filter that STARTS with * looks like a persistent variable (*_a) to the
  ; parser and is replaced by that variable's value (N/A) before the command
  ; sees it, so nothing matches
  namespace copy *_a from local nsSrc
  gosub t_eq QUIRK_a_leading_star_filter_is_read_as_a_persistent_variable_so_nothing_is_copied !ret_a N/A
  namespace local nsSrc
  namespace copy ret* to local nsTo1
  namespace local nsTo1
  gosub t_eq copy_to_local_creates_the_target_ret_b !ret_b 2
  gosub t_eq copy_to_local_filter_skips_other !other N/A
  namespace local nsSrc
  namespace copy ret* to global nsG2
  namespace local nsDst3
  namespace copy * from global nsG2
  gosub t_eq copy_via_global_ret_a !ret_a 1
  gosub t_eq copy_via_global_ret_b !ret_b 2
  gosub t_eq copy_via_global_filter_skips_other !other N/A
  namespace global nsG2
  namespace clear
  gosub t_eq cleanup_of_the_global_test_namespace !ret_a N/A
  namespace local std
return

; ===========================================================================
;  08  misc commands that need neither a client nor a window
; ===========================================================================
sub sec_misc
  gosub t_head 08_misc_commands
  ; ---- linesPerCycle <-> #lpc -------------------------------------------------
  linesPerCycle 77
  gosub t_eq linespercycle_command_sets_lpc #lpc 77
  set #lpc 123
  gosub t_eq lpc_variable_is_writable #lpc 123
  set #lpc 0
  gosub t_eq lpc_zero_is_ignored #lpc 123
  set #lpc abc
  gosub t_eq lpc_non_numeric_value_is_ignored #lpc 123
  set #lpc 1000

  ; ---- writable result variables ----------------------------------------------------
  set #result abc
  gosub t_eq result_is_writable #result abc
  set #strRes xyz
  gosub t_eq strres_is_writable #strres xyz
  set #sendHeader X-Test:_abc
  gosub t_eq sendheader_round_trip #sendheader X-Test:_abc
  set #sendHeader N/A
  gosub t_eq sendheader_reset_to_NA #sendheader N/A
  set #menuButton Nothing
  gosub t_eq menubutton_is_writable #menubutton Nothing

  ; ---- send: bad arguments never touch the network --------------------------------------
  set %r before
  send HTTPPost 127.0.0.1
  send nonsense a b c d
  send
  set %r %r , after
  gosub t_eq send_with_bad_arguments_is_a_noop %r beforeafter

  ; ---- sleep / wait with bad arguments are no-ops ----------------------------------------
  set %r before
  sleep abc
  sleep -5
  sleep
  wait
  wait abc
  set %r %r , after
  gosub t_eq sleep_and_wait_with_bad_arguments_are_noops %r beforeafter

  ; ---- deleteVar of something that does not exist ---------------------------------------------
  deleteVar v_surely_not_defined
  deleteVar
  gosub t_eq deletevar_of_an_undefined_variable_is_harmless %v_surely_not_defined N/A

  ; ---- unknown variables ------------------------------------------------------------------------------
  gosub t_eq unknown_system_variable_reads_NA #foo_bar_baz N/A
  gosub t_eq strmax_is_in_the_editor_keyword_list_but_not_implemented #strmax N/A
  gosub t_skip menu_test_command internal_developer_hook_not_part_of_the_scripting_API
return

; ===========================================================================
;  09  system variables that need no client
; ===========================================================================
sub sec_sysvars
  gosub t_head 09_system_variables_without_a_client
  gosub t_eq euover_stays_at_the_original_value #euover 1_50_00
  set %rv #reforgedver
  str count %rv #dot
  gosub t_eq reforgedver_is_YY.MM.DD.commit_so_3_dots #strres 3
  gosub t_info reforgedver #reforgedver
  set %d #date
  gosub c_digits date_is_yymmdd %d 6
  set %tm #time
  gosub c_digits time_is_hhmmss %tm 6

  set %st1 #systime
  set %ok %st1 >= 1000000000000
  gosub t_chk systime_is_milliseconds_since_1980 %st1 >=_1000000000000 %ok
  set %st2 #systime
  set %ok %st2 >= %st1
  gosub t_chk systime_never_goes_backwards %st2 >=_previous_read %ok

  set #sCnt 1000
  set %v #sCnt
  gosub c_range scnt_after_set_1000 %v 1000 1002
  set #sCnt2 5000
  set %v #sCnt2
  gosub c_range scnt2_after_set_5000 %v 5000 5003

  set %rmin 1000
  set %rmax -1
  set %rbad 0
  for %k 1 40
  {
    set %rv #random
    if %rv < %rmin
      set %rmin %rv
    if %rv > %rmax
      set %rmax %rv
    if %rv < 0 || %rv > 999
      set %rbad %rbad + 1
  }
  gosub t_eq random_stays_within_0_and_999 %rbad 0
  set %ok %rmax > %rmin
  set %act min , %rmin , _max , %rmax
  gosub t_chk random_is_not_constant_over_40_reads %act max_greater_than_min %ok

  set %ov #osver
  str count %ov _
  gosub t_eq osver_is_platform_major_minor_joined_by_underscores #strres 2
  gosub t_info osver %ov
  set %o EXEC in #opts
  gosub t_eq opts_contains_EXEC %o -1
  set %o SEND in #opts
  gosub t_eq opts_contains_SEND %o -1
  gosub t_info opts #opts
  str right #curpath 1
  gosub t_str curpath_ends_with_a_backslash #strres \
  gosub t_info curpath #curpath

  set %cc #clicnt
  set %cn #clinr
  set %ok ( %cc >= 0 ) && ( %cn >= 0 ) && ( %cn <= %cc )
  set %act clinr , _ , %cn , _of_clicnt_ , %cc
  gosub t_chk clinr_is_between_0_and_clicnt %act 0..clicnt %ok
  gosub c_num cursorx_is_an_integer #cursorx
  gosub c_num cursory_is_an_integer #cursory
  gosub t_info dispres_before_any_display #dispres
return

; ===========================================================================
;  11  wait / sleep timing
; ===========================================================================
sub sec_timing
  gosub t_head 11_wait_and_sleep_timing
  set %t0 #systime
  sleep 100
  set %dt #systime - %t0
  set %ok ( %dt >= 90 ) && ( %dt <= 1500 )
  gosub t_chk sleep_100_elapsed_ms %dt 90..1500 %ok

  set %t0 #systime
  wait 5
  set %dt #systime - %t0
  set %ok ( %dt >= 225 ) && ( %dt <= 1500 )
  gosub t_chk wait_5_ticks_is_about_250_ms %dt 225..1500 %ok

  set %t0 #systime
  wait 1s
  set %dt #systime - %t0
  set %ok ( %dt >= 950 ) && ( %dt <= 2500 )
  gosub t_chk wait_1s_is_about_1000_ms %dt 950..2500 %ok

  set %t0 #systime
  wait 2 2
  set %dt #systime - %t0
  set %ok ( %dt >= 90 ) && ( %dt <= 1500 )
  gosub t_chk wait_2_ticks_plus_up_to_2_random_ticks %dt 90..1500 %ok

  set %t0 #systime
  wait 0
  set %dt #systime - %t0
  set %ok %dt <= 300
  gosub t_chk wait_0_returns_at_once %dt 0..300 %ok

  set %c0 #sCnt
  set %t0 #sCnt2
  wait 1s
  set %c1 #sCnt
  set %t1 #sCnt2
  set %dc %c1 - %c0
  set %dt %t1 - %t0
  gosub c_range scnt_advances_by_about_1_per_second %dc 1 2
  gosub c_range scnt2_advances_by_about_10_per_second %dt 9 12
return

; ===========================================================================
;  12  onHotKey (negative checks: nothing is pressed)
; ===========================================================================
sub sec_hotkey
  gosub t_head 12_onhotkey_without_a_key_press
  ; keep your hands off F9 during this run.  When the key is NOT pressed the
  ; line (or block) after onHotKey is skipped.
  set %hk 0
  onhotkey F9
    set %hk 1
  gosub t_eq onhotkey_not_pressed_skips_the_next_line %hk 0
  set %hk 0
  onhotkey F9 ctrl alt shift
    set %hk 1
  gosub t_eq onhotkey_with_modifiers_not_pressed_skips_the_next_line %hk 0
  set %hk 0
  onhotkey F9
  {
    set %hk 1
    set %hk 2
  }
  gosub t_eq onhotkey_not_pressed_skips_the_whole_block %hk 0
  set %hk 0
  onhotkey nosuchkey
    set %hk 1
  gosub t_eq onhotkey_with_an_unknown_key_never_fires %hk 0
return

; ===========================================================================
;  10  menu controls  (nothing is shown until the final report window)
; ===========================================================================
sub sec_menu
  gosub t_head 10_menu_controls
  menu Clear
  menu Window Title EUO selftest menu
  menu Window Size 320 420
  menu Window Color btnface
  menu Window Transparent 100
  menu Font Name Arial
  menu Font Size 9
  menu Font Style BI
  menu Font Color black
  menu Font BGColor white
  menu Font Align left
  menu Font Transparent #false
  menu Font Style
  menu Font BGColor btnface

  ; ---- edit -----------------------------------------------------------------------
  menu Edit ed1 10 60 150 initial
  menu Get ed1
  gosub t_eq menu_edit_initial_text #menures initial
  menu Font Size notanumber
  menu Font Color notacolor
  menu Font
  menu Get ed1
  gosub t_eq menu_font_with_bad_arguments_changes_nothing #menures initial
  menu Set ed1 changed
  menu Get ed1
  gosub t_eq menu_set_then_get_edit #menures changed
  menu Get ED1
  gosub t_eq menu_names_are_case_insensitive #menures changed
  menu GetNum ed1 99
  gosub t_eq menu_getnum_returns_the_default_for_non_numeric_text #menures 99
  menu Set ed1 42
  menu GetNum ed1 99
  gosub t_eq menu_getnum_returns_the_number #menures 42
  menu GetNum nosuchcontrol 5
  gosub t_eq menu_getnum_of_an_unknown_name_returns_the_default #menures 5
  menu Get nosuchcontrol
  gosub t_eq menu_get_of_an_unknown_name_gives_NA #menures N/A
  set #menuRes forty
  gosub t_dd wiki_menures_is_read_only #menures N/A forty

  ; ---- label and button (not readable with menu get) ------------------------------------------
  menu Text lbl1 10 10 A label with several words
  menu Get lbl1
  gosub t_eq menu_get_of_a_label_gives_NA #menures N/A
  menu Set lbl1 Another caption
  menu Button btn1 10 30 80 25 Click me
  menu Set btn1 New caption
  menu Get btn1
  gosub t_eq menu_get_of_a_button_gives_NA #menures N/A

  ; ---- memo [Reforged] ---------------------------------------------------------------------------
  menu Memo mm1 10 90 150 60 line1$line2$line3
  menu Get mm1
  set %mm #menures
  str count %mm $
  gosub t_eq menu_memo_dollar_is_a_line_break_that_folds_back #strres 2
  str left %mm 5
  gosub t_eq menu_memo_first_line #strres line1
  menu Set mm1 a$b
  menu Get mm1
  str len #menures
  gosub t_eq menu_memo_set_then_get_length #strres 3

  ; ---- checkboxes ---------------------------------------------------------------------------------
  menu Check chk1 10 160 120 20 #true Checked box
  menu Check chk2 10 180 120 20 #false Unchecked box
  menu Get chk1
  gosub t_eq menu_check_created_checked #menures -1
  menu Get chk2
  gosub t_eq menu_check_created_unchecked #menures 0
  menu Set chk2 1
  menu Get chk2
  gosub t_eq menu_set_check_to_1 #menures -1
  menu Set chk1 0
  menu Get chk1
  gosub t_eq menu_set_check_to_0 #menures 0

  ; ---- combo box (index is 1-based, 0 = nothing selected) ---------------------------------------------
  menu Combo Create cmb1 10 205 120
  menu Combo Add cmb1 One
  menu Combo Add cmb1 Two
  menu Combo Add cmb1 Three
  menu Get cmb1
  gosub t_eq menu_combo_nothing_selected_is_0 #menures 0
  menu Combo Select cmb1 2
  menu Get cmb1
  gosub t_eq menu_combo_select_2_reads_back_2 #menures 2
  menu Combo Select cmb1 3
  menu Get cmb1
  gosub t_eq menu_combo_select_3_reads_back_3 #menures 3
  menu Combo Clear cmb1
  menu Get cmb1
  gosub t_eq menu_combo_clear_selects_nothing_Reforged #menures 0

  ; ---- list box (index is 1-based, 0 = nothing selected) -------------------------------------------------
  menu List Create lst1 10 235 120 60
  menu List Add lst1 First
  menu List Add lst1 Second
  menu List Add lst1 Third
  menu Get lst1
  gosub t_eq menu_list_nothing_selected_is_0 #menures 0
  menu List Select lst1 3
  menu Get lst1
  gosub t_eq menu_list_select_3_reads_back_3 #menures 3
  menu List Select lst1 1
  menu Get lst1
  gosub t_eq menu_list_select_1_reads_back_1 #menures 1
  menu List Clear lst1
  menu Get lst1
  gosub t_soft menu_list_clear_selects_nothing_Reforged #menures 0

  ; ---- shapes (all 6 shape types, with line and fill styles) -----------------------------------------------
  for %st 1 6
  {
    menu Shape shp , %st 200 10 40 40 %st %st 1 blue %st green
  }
  menu Shape shp9 250 10 40 40 3 7 2 $0000FF 7 $00FFFF
  menu Get shp1
  gosub t_eq menu_get_of_a_shape_gives_NA #menures N/A

  ; ---- images (nothing to read back: these must simply not fail) ------------------------------------------------
  menu Image Create img1 200 60 100 100
  menu Image Rectangle img1 0 0 99 99 white #true
  menu Image Rectangle img1 5 5 94 94 black #false 2
  menu Image Ellipse img1 10 10 60 60 red #true
  menu Image Ellipse img1 10 10 60 60 blue #false 2
  menu Image Line img1 0 0 99 99 green
  menu Image Line img1 0 99 99 0 green 3
  menu Image Pix img1 50 50 red
  menu Image PixLine img1 0 90 AAAPPP666999AAP
  menu Image FloodFill img1 70 20 yellow
  menu Image Pos img1 200 60
  menu Image Pos img1 200 60 120 120
  set %r images_ok
  gosub t_eq menu_image_commands_ran_without_stopping_the_script %r images_ok
  gosub t_skip menu_image_file needs_an_image_file_on_disk

  ; ---- delete --------------------------------------------------------------------------------------------------------
  menu Delete ed1
  menu Get ed1
  gosub t_eq menu_delete_removes_the_control #menures N/A
  menu Delete ed1
  menu Delete nosuchcontrol
  set %r delete_ok
  gosub t_eq menu_delete_of_a_missing_control_is_harmless %r delete_ok
return

