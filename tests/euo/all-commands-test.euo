; ###########################################################################
;  CLIENT TIER - read only  (runs automatically when a character is logged in)
; ###########################################################################
;  Most numbers here cannot be known in advance, so the "expected" column
;  shows the CRITERION that was checked.  Checks that depend on what is
;  happening in the game right now are "soft": a miss is a [NOTE], not a [FAIL].
sub sec_client_ro
  gosub t_head 14_client_read_only
  ; open the status bar (needed for the #hits/#str/... variables), the
  ; paperdoll and the backpack
  event macro 8 2
  wait 5
  event macro 8 1
  wait 5
  event macro 8 7
  wait 5

  ; ---- character ---------------------------------------------------------------
  gosub c_nonneg char_pos_x_is_>=_0 #charposx
  gosub c_nonneg char_pos_y_is_>=_0 #charposy
  gosub c_num char_pos_z_is_a_number #charposz
  gosub c_range char_dir_is_0..7 #chardir 0 7
  set %g #charghost
  set %ok ( %g = yes ) || ( %g = no )
  gosub t_chk char_ghost_is_yes_or_no %g yes_or_no %ok
  gosub t_info char_status_(C=poisoned_H=hidden_B=female_G=war_D=lethal_A=frozen) #charstatus
  gosub c_has char_id_is_a_base26_id #charid
  gosub c_has backpack_id_is_a_base26_id #backpackid
  gosub c_has char_type_[Reforged] #chartype

  ; ---- status bar ------------------------------------------------------------------
  gosub c_has char_name #charname
  gosub c_range sex_is_0_male_or_1_female #sex 0 1
  gosub c_nonneg str_is_>=_0 #str
  gosub c_nonneg dex_is_>=_0 #dex
  gosub c_nonneg int_is_>=_0 #int
  set %h #hits
  set %mh #maxhits
  set %ok ( %h >= 0 ) && ( %h <= %mh )
  set %act %h , _of_ , %mh
  gosub t_chk hits_between_0_and_maxhits %act 0..maxhits %ok
  set %h #stamina
  set %mh #maxstam
  set %ok ( %h >= 0 ) && ( %h <= %mh )
  set %act %h , _of_ , %mh
  gosub t_chk stamina_between_0_and_maxstam %act 0..maxstam %ok
  set %h #mana
  set %mh #maxmana
  set %ok ( %h >= 0 ) && ( %h <= %mh )
  set %act %h , _of_ , %mh
  gosub t_chk mana_between_0_and_maxmana %act 0..maxmana %ok
  gosub c_nonneg weight_is_>=_0 #weight
  gosub c_nonneg maxweight_is_>=_0 #maxweight
  gosub c_nonneg maxstats_is_>=_0 #maxstats
  gosub c_num luck_is_a_number #luck
  set %a #mindmg
  set %b #maxdmg
  set %ok ( %a >= 0 ) && ( %a <= %b )
  set %act %a , _.._ , %b
  gosub t_chk mindmg_<=_maxdmg %act 0<=mindmg<=maxdmg %ok
  gosub c_nonneg gold_is_>=_0 #gold
  gosub c_nonneg followers_is_>=_0 #followers
  gosub c_nonneg maxfol_is_>=_0 #maxfol
  gosub c_num armor_rating_is_a_number #ar
  gosub c_num fire_resist_is_a_number #fr
  gosub c_num cold_resist_is_a_number #cr
  gosub c_num poison_resist_is_a_number #pr
  gosub c_num energy_resist_is_a_number #er
  gosub c_nonneg tithing_points_>=_0 #tp

  ; ---- client info ------------------------------------------------------------------------
  gosub c_has cliver_is_not_empty #cliver
  gosub t_info clilang_[Reforged] #clilang
  gosub t_eq cliLogged_is_1 #clilogged 1
  gosub t_info shard_name #shard
  gosub c_range curskind_is_a_facet_0..5 #curskind 0 5
  gosub c_nonneg clixres_>=_0 #clixres
  gosub c_nonneg cliyres_>=_0 #cliyres
  gosub c_num clileft_is_a_number #clileft
  gosub c_num clitop_is_a_number #clitop

  ; ---- container / gump (the backpack was opened last) ------------------------------------------
  ; what the "top gump" is depends on what the client is doing: soft checks
  set %c_soft 1
  gosub t_soft contname_of_the_top_gump_is_container_gump #contname container_gump
  gosub c_has contid_is_not_empty #contid
  gosub c_has contkind_is_not_empty #contkind
  gosub c_has conttype_is_not_empty #conttype
  gosub c_num contposx_is_a_number #contposx
  gosub c_num contposy_is_a_number #contposy
  gosub c_nonneg contsizex_>=_0_[Reforged] #contsizex
  gosub c_nonneg contsizey_>=_0_[Reforged] #contsizey
  set %cs #contsizex , _ , #contsizey
  gosub t_soft contsize_is_contsizex_underscore_contsizey #contsize %cs
  gosub c_num conthp_is_a_number_[Reforged] #conthp
  gosub t_info contname_after_opening_the_backpack #contname
  set %c_soft 0

  ; ---- combat ---------------------------------------------------------------------------------------
  gosub t_info enemyid_(N/A_when_nobody_attacks_you) #enemyid
  gosub t_info enemyhits #enemyhits
  gosub t_info lhandid #lhandid
  gosub t_info rhandid #rhandid

  gosub sec_skills
  gosub sec_finditem
  gosub sec_journal
  gosub sec_client_events
  gosub sec_client_misc
return

; ---------------------------------------------------------------------------
;  findItem helper: #findcnt must be >= 1 (soft: depends on what is in the world)
sub fi_atleast1
  set %_fn %1
  set %_fc #findcnt
  set %_fk %_fc >= 1
  gosub t_softchk %_fn %_fc at_least_1 %_fk
return

; ---------------------------------------------------------------------------
sub sec_skills
  gosub t_head 14a_chooseskill
  chooseSkill mage
  gosub c_nonneg skill_mage_is_>=_0 #skill
  set %sk #skill
  set %sc #skillcap
  set %ok ( %sk >= 0 ) && ( %sc >= %sk )
  set %act skill_ , %sk , _cap_ , %sc
  gosub t_chk skillcap_is_not_below_skill %act skill<=skillcap %ok
  set %sl #skilllock
  set %ok ( %sl = up ) || ( %sl = down ) || ( %sl = locked )
  gosub t_chk skilllock_is_up_down_or_locked %sl up_down_or_locked %ok
  chooseSkill mage real
  gosub c_nonneg skill_mage_real_is_>=_0 #skill
  chooseSkill anil
  gosub c_nonneg skill_animal_lore_(anil)_is_>=_0 #skill
  chooseSkill stlt
  gosub c_nonneg skill_stealth_(stlt)_is_>=_0 #skill
  chooseSkill swor
  gosub c_nonneg skill_swordsmanship_is_>=_0 #skill
return

; ---------------------------------------------------------------------------
sub sec_finditem
  gosub t_head 14b_finditem_and_ignoreitem
  set %bp #backpackid
  findItem * C_ , %bp
  set %cnt_bp #findcnt
  gosub c_nonneg finditem_C_backpack_count_is_>=_0 %cnt_bp
  gosub t_info finditem_items_in_the_open_backpack %cnt_bp
  if %cnt_bp > 0
  {
    set %id1 #findid
    set %ty1 #findtype
    gosub c_has finditem_first_item_id %id1
    gosub c_has finditem_first_item_type %ty1
    gosub t_eq finditem_C_item_kind_is_0_(in_a_container) #findkind 0
    gosub t_soft finditem_C_item_is_inside_the_backpack #findbagid %bp
    gosub c_nonneg finditem_stack_>=_0 #findstack
    gosub c_num finditem_x_is_a_number #findx
    gosub c_num finditem_y_is_a_number #findy
    gosub c_num finditem_color_is_a_number #findcol
    findItem * 1 C_ , %bp
    gosub t_soft finditem_index_1_is_the_default_item #findid %id1
    gosub t_eq finditem_index_sets_findindex #findindex 1
    set %seen 0
    findItem * C_ , %bp
    for #findindex 1 #findcnt
    {
      set %seen %seen + 1
    }
    gosub t_eq finditem_for_findindex_visits_every_item %seen %cnt_bp
    if %cnt_bp > 1
    {
      findItem * 2 C_ , %bp
      set %id2 #findid
      set %ok %id2 <> %id1
      set %act %id1 , _vs_ , %id2
      gosub t_chk finditem_index_2_is_a_different_item %act different_ids %ok
    }
    else
    {
      gosub t_skip finditem_index_2 only_one_item_in_the_backpack
    }
    findItem * C_ , %bp
    set %x0 #findx
    set %y0 #findy
    set #findMod 10_20
    set %x1 #findx
    set %y1 #findy
    set %ex %x0 + 10
    set %ey %y0 + 20
    gosub t_eq findmod_adds_the_x_displacement %x1 %ex
    gosub t_eq findmod_adds_the_y_displacement %y1 %ey
    gosub t_eq findmod_reads_back_x_underscore_y #findmod 10_20
    set #findMod 0_0
    findItem %id1
    gosub t_soft finditem_by_id_finds_exactly_that_item #findid %id1
    findItem %ty1
    gosub fi_atleast1 finditem_by_type_finds_at_least_one

    ; ---- ignoreItem (wiki: ignoring hides from findItem used with a matching parameter) ----
    ignoreItem %id1 1
    findItem %id1
    gosub t_soft ignoreitem_id_in_list_1_hides_it_from_finditem_by_id #findcnt 0
    ignoreItem reset 1
    findItem %id1
    gosub fi_atleast1 ignoreitem_reset_1_makes_it_findable_again
    ignoreItem %id1
    ignoreItem %id1
    findItem %id1
    gosub fi_atleast1 ignoreitem_twice_toggles_the_item_off_again
    ignoreItem %ty1 2
    findItem %ty1
    gosub t_soft ignoreitem_type_hides_that_type_from_finditem_by_type #findcnt 0
    findItem %id1
    gosub fi_atleast1 wiki_ignored_type_is_still_found_when_searching_by_id
    ignoreItem reset 2
    ignoreItem %id1 , _ , %ty1 3
    findItem %id1
    gosub t_soft ignoreitem_id_underscore_type_list_hides_the_id #findcnt 0
    ignoreItem reset
    findItem %id1
    gosub fi_atleast1 ignoreitem_reset_without_list_clears_everything
  }
  else
  {
    gosub t_skip finditem_item_checks_and_ignoreitem open_backpack_is_empty_or_not_open
  }

  findItem BBBBBBB
  gosub t_eq finditem_of_a_missing_id_finds_nothing #findcnt 0
  gosub t_eq finditem_of_a_missing_id_sets_findkind_minus_1 #findkind -1
  findItem * G_30
  set %cnt_g #findcnt
  gosub c_nonneg finditem_G_30_ground_count_is_>=_0 %cnt_g
  if %cnt_g > 0
  {
    gosub t_soft finditem_G_item_kind_is_1_(on_the_ground) #findkind 1
    set %fd #finddist
    set %c_soft 1
    gosub c_range finditem_G_30_distance_is_within_30 %fd 0 30
    set %c_soft 0
    gosub c_num finditem_G_world_x_is_a_number #findx
  }
  findItem #charid
  gosub fi_atleast1 finditem_can_find_the_own_character
  findItem * CA_ , %bp
  gosub t_info finditem_CA_hidden_items_in_the_backpack #findcnt
  findItem * A
  gosub t_info finditem_A_all_items_including_hidden #findcnt
  ignoreItem reset
return

; ---------------------------------------------------------------------------
sub sec_journal
  gosub t_head 14c_journal_and_system_messages
  set %j0 #jindex
  gosub c_nonneg jindex_is_a_number %j0
  event sysmessage EUO_SELFTEST_MARKER_1
  wait 3
  scanJournal 1
  set %jl #journal
  set %ok EUO_SELFTEST_MARKER_1 in %jl
  gosub t_softchk scanjournal_1_sees_the_sysmessage_marker %jl contains_EUO_SELFTEST_MARKER_1 %ok
  gosub c_num jcolor_is_a_number #jcolor
  set %j1 #jindex
  set %ok %j1 > %j0
  set %act %j0 , _then_ , %j1
  gosub t_softchk jindex_grows_after_a_new_message %act second>first %ok
  scanJournal %j1
  set %jl #journal
  set %ok EUO_SELFTEST_MARKER_1 in %jl
  gosub t_softchk scanjournal_with_a_jindex_value_(>=1000)_finds_the_same_line %jl contains_EUO_SELFTEST_MARKER_1 %ok
  scanJournal 1
  deleteJournal
  scanJournal 1
  gosub t_soft deletejournal_hides_the_already_read_lines #journal N/A
  event sysmessage EUO_SELFTEST_MARKER_2
  wait 3
  set %sm #sysmsg
  set %ok EUO_SELFTEST_MARKER_2 in %sm
  gosub t_softchk sysmsg_holds_the_latest_system_message %sm contains_EUO_SELFTEST_MARKER_2 %ok
  scanJournal 1
  set %jl #journal
  set %ok EUO_SELFTEST_MARKER_2 in %jl
  gosub t_softchk new_lines_after_deletejournal_are_visible_again %jl contains_EUO_SELFTEST_MARKER_2 %ok
return

; ---------------------------------------------------------------------------
sub sec_client_events
  gosub t_head 14d_events_that_only_read_or_display
  event exmsg #charid 3 0 EUO_selftest_overhead_text
  wait 3
  event exmsg #charid 1 33 Second_font_and_colour
  set %r event_exmsg_ok
  gosub t_eq event_exmsg_ran_without_stopping_the_script %r event_exmsg_ok
  event property #backpackid
  wait 3
  gosub t_info event_property_of_the_backpack_(lines_are_joined_by_dollar_signs) #property
  set %t0 #systime
  event sleep 100
  set %dt #systime - %t0
  set %ok %dt >= 80
  gosub t_softchk event_sleep_100_keeps_the_client_busy_about_100_ms %dt >=_80 %ok
  ; gump macros: close / maximize / minimize / open the paperdoll
  event macro 9 1
  wait 3
  gosub t_info contname_after_closing_the_paperdoll #contname
  event macro 8 1
  wait 3
  gosub t_info contname_after_opening_the_paperdoll #contname
  event macro 10 1
  wait 3
  event macro 11 1
  wait 3
  gosub t_info contname_after_minimize_and_maximize #contname
  event macro 12
  set %r event_macro_ok
  gosub t_eq event_macro_with_only_one_parameter_is_accepted %r event_macro_ok
  event conttop 0
  event statbar #charid
  wait 3
  set %r reforged_events_ok
  gosub t_eq event_conttop_and_statbar_[Reforged]_ran_without_stopping_the_script %r reforged_events_ok
  event skilllock
  event sysmessage
  set %r bad_arguments_ok
  gosub t_eq event_with_missing_arguments_is_a_noop %r bad_arguments_ok
return

; ---------------------------------------------------------------------------
sub sec_client_misc
  gosub t_head 14e_target_pixels_title_clients
  ; ---- target ----
  set %t0 #systime
  target 1s
  set %dt #systime - %t0
  set %ok ( %dt >= 900 ) && ( %dt <= 3000 )
  gosub t_softchk target_1s_without_a_cursor_waits_about_1000_ms %dt 900..3000 %ok
  gosub t_soft targcurs_is_0_when_no_target_cursor_is_up #targcurs 0

  ; ---- savePix / cmpPix ----
  savePix 5 5 1 $123456
  set %hit no
  cmpPix 1 f
    set %hit yes
  gosub t_soft cmppix_f_runs_the_next_line_when_the_pixel_differs %hit yes
  set %hit no
  cmpPix 1 t
    set %hit yes
  gosub t_soft cmppix_t_skips_the_next_line_when_the_pixel_differs %hit no
  set %hit no
  cmpPix 1 false
    set %hit yes
  gosub t_dd wiki_cmppix_false_option_runs_the_next_line_when_different %hit yes no
  set %hit no
  cmpPix 1
  {
    set %hit yes
    set %hit yes_in_block
  }
  gosub t_soft cmppix_without_option_is_the_same_as_t %hit no
  savePix 5 5 2
  gosub c_num pixcol_after_savepix_is_a_number #pixcol

  ; ---- getUOTitle ----
  getUOTitle
  gosub c_has getuotitle_returns_the_client_window_title #strres
  set %title #strres
  set %clt #clititle
  gosub t_soft clititle_variable_equals_getuotitle %clt %title
  gosub t_info client_window_title %title

  ; ---- uoXL swap ----
  ; (with NO client attached "uoXL swap" divides by zero - Nr mod Cnt with
  ; Cnt = 0 - and stops the script, so it is only tried when a client exists)
  set %cnt0 #clicnt
  set %nr0 #clinr
  if %cnt0 >= 1
  {
    uoXL swap
    set %nr1 #clinr
    set %exp %nr0 % %cnt0 + 1
    gosub t_eq uoxl_swap_selects_the_next_client %nr1 %exp
    set %k 1
    while %k < %cnt0
    {
      uoXL swap
      set %k %k + 1
    }
    gosub t_eq uoxl_swapping_through_all_clients_returns_to_the_start #clinr %nr0
  }
  else
  {
    gosub t_skip uoxl_swap no_client_is_registered_in_clicnt
  }
return

; ---------------------------------------------------------------------------
sub sec_ignorecont
  gosub t_head 21_ignorecont_[Reforged]
  ignoreCont dumb_gump
  ignoreCont 12345
  ignoreCont reset
  set %r ignorecont_ok
  gosub t_eq ignorecont_add_and_reset_ran_without_stopping_the_script %r ignorecont_ok
return

; ###########################################################################
;  OPT-IN GROUPS
; ###########################################################################

; ---------------------------------------------------------------------------
;  %DO_CLIENT_WRITES - write every read/write client variable, then restore
; ---------------------------------------------------------------------------
sub sec_client_writes
  gosub t_head 15_client_variable_writes_(restored_afterwards)
  event macro 8 1
  wait 5
  gosub w_num lShard strict
  gosub w_num contPosX soft
  gosub w_num contPosY soft
  gosub w_num nextCPosX strict
  gosub w_num nextCPosY strict
  gosub w_num targCurs soft
  gosub w_num cliXRes soft
  gosub w_num cliYRes soft
  gosub w_num cliLeft soft
  gosub w_num cliTop soft
  gosub w_num lSpell strict
  gosub w_num lSkill strict
  gosub w_num lTargetKind strict
  gosub w_num lTargetTile strict
  gosub w_num lTargetX strict
  gosub w_num lTargetY strict
  gosub w_num lTargetZ strict
  gosub w_num sysMsgCol strict
  gosub w_id lTargetID
  gosub w_id lHandID
  gosub w_id rHandID
  gosub w_id lObjectID

  ; findIndex / findMod
  set %o_fi #findindex
  set #findIndex 1
  gosub t_eq write_findindex_1 #findindex 1
  set #findIndex %o_fi
  set #findMod 5_6
  gosub t_eq write_findmod_5_6 #findmod 5_6
  set #findMod 0_0

  ; cliTitle (Reforged) and setUOTitle / getUOTitle
  set %o_ct #clititle
  set #cliTitle EUO_selftest_title_A
  gosub t_eq write_clititle #clititle EUO_selftest_title_A
  set #cliTitle %o_ct
  getUOTitle
  set %title0 #strres
  setUOTitle EUO_selftest_title_B
  getUOTitle
  gosub t_eq setuotitle_then_getuotitle #strres EUO_selftest_title_B
  setUOTitle %title0
  getUOTitle
  gosub t_eq setuotitle_restores_the_original_title #strres %title0

  ; jColor is documented read/write but is read-only in the engine
  set %o_jc #jcolor
  set #jColor 5
  gosub t_dd wiki_jcolor_is_writable #jcolor 5 %o_jc

  ; contPos / nextCPos commands
  contPos 120 80
  wait 2
  gosub t_soft contpos_command_moves_the_top_gump_x #contposx 120
  gosub t_soft contpos_command_moves_the_top_gump_y #contposy 80
  nextCPos 55 66
  gosub t_eq nextcpos_command_sets_nextcposx #nextcposx 55
  gosub t_eq nextcpos_command_sets_nextcposy #nextcposy 66
return

; read/write round trip of one numeric client variable, then restore it
sub w_num
  set %_wn %1
  set %_wm %2
  set %_wo # . %_wn
  set %_wv 7
  set %_wk ( %_wo >= 0 ) || ( %_wo < 0 )
  if %_wk
  {
    set %_wv %_wo + 1
  }
  set # . %_wn %_wv
  set %_wr # . %_wn
  if %_wm = soft
  {
    gosub t_soft write_ , %_wn %_wr %_wv
  }
  else
  {
    gosub t_eq write_ , %_wn %_wr %_wv
  }
  set # . %_wn %_wo
  set %_wb # . %_wn
  gosub t_soft restore_ , %_wn %_wb %_wo
return

; same for an id variable: write the character id, read it back, restore
sub w_id
  set %_wn %1
  set %_wo # . %_wn
  set # . %_wn #charid
  set %_wr # . %_wn
  gosub t_eq write_ , %_wn %_wr #charid
  set # . %_wn %_wo
  set %_wb # . %_wn
  gosub t_soft restore_ , %_wn %_wb %_wo
return

; ---------------------------------------------------------------------------
;  %DO_INPUT - click (cursor only), key, msg, move, pathfind, event macro say
; ---------------------------------------------------------------------------
sub sec_input
  gosub t_head 16_input_synthesis
  ; "click x y n" only moves the cursor - nothing is pressed
  click 15 25 n
  wait 2
  gosub t_soft click_n_moves_the_cursor_x #cursorx 15
  gosub t_soft click_n_moves_the_cursor_y #cursory 25
  click 40 50 n dmc
  click 41 51 n mc
  click 42 52 n f
  click 43 53 n x 2
  wait 2
  gosub t_soft click_with_modifiers_still_ends_at_the_last_position_x #cursorx 43
  set %r click_ok
  gosub t_eq click_modifier_variants_ran_without_stopping_the_script %r click_ok
  key esc
  key esc shift
  set %r key_ok
  gosub t_eq key_esc_with_and_without_modifier_ran %r key_ok
  ; msg types into the chat line and presses Enter ($): this SPEAKS in the game
  msg EUO selftest msg$
  wait 3
  scanJournal 1
  set %jl #journal
  set %ok EUO in %jl
  gosub t_softchk msg_text_shows_up_in_the_journal %jl contains_EUO %ok
  ; walking to the position you already stand on
  set %px #charposx
  set %py #charposy
  move %px %py 2 2s
  gosub t_soft move_to_the_current_position_keeps_x #charposx %px
  gosub t_soft move_to_the_current_position_keeps_y #charposy %py
  event pathfind %px %py
  wait 5
  gosub t_soft pathfind_to_the_current_position_keeps_x #charposx %px
  event macro 1 0 EUO selftest macro say
  wait 3
  set %r input_ok
  gosub t_eq event_macro_say_ran %r input_ok
  gosub t_skip event_macro_20_(quit_game) NEVER_run_by_this_script
return

; ---------------------------------------------------------------------------
;  %DO_ITEMS - move ONE backpack item out and back, context menu, equip, hide
; ---------------------------------------------------------------------------
sub sec_items
  gosub t_head 17_item_drag_drop_popup_hide
  event macro 8 7
  wait 5
  findItem * C_ , #backpackid
  if #findcnt < 1
  {
    gosub t_skip exevent_drag_dropc open_backpack_is_empty_or_not_open
  }
  else
  {
    set %bp #backpackid
    set %id1 #findid
    exevent drag %id1 1
    wait 5
    gosub t_soft exevent_drag_lifts_the_item #lliftedid %id1
    gosub t_soft exevent_drag_puts_an_object_on_the_cursor #lliftedkind 1
    exevent dropc %bp
    wait 10
    gosub t_soft exevent_dropc_puts_it_back_nothing_left_on_the_cursor #lliftedkind 0
    findItem %id1
    gosub t_soft the_item_is_in_the_backpack_again #findbagid %bp
    exevent drag %id1 1
    wait 5
    exevent dropc %bp 80 80
    wait 10
    gosub t_soft exevent_dropc_with_x_y_also_returns_it #lliftedkind 0
  }
  gosub t_skip event_drag NOT_run_wiki:_mixing_it_with_exevent_dropc_leaves_a_ghost_item
  gosub t_skip exevent_dropg NOT_run_it_would_put_an_item_on_the_ground
  exevent popup #charid
  wait 5
  key esc
  set %r popup_ok
  gosub t_eq exevent_popup_on_the_own_character_ran %r popup_ok
  str len %CFG_PET_ID
  if #strres > 0
  {
    exevent renamePet %CFG_PET_ID EUOTest
    wait 5
    set %r rename_ok
    gosub t_eq exevent_renamepet_ran_(check_the_pets_name_in_game) %r rename_ok
  }
  else
  {
    gosub t_skip exevent_renamepet set_%CFG_PET_ID_(it_renames_the_pet_to_EUOTest)
  }
  str len %CFG_EQUIP_ID
  if #strres > 0
  {
    exevent equip %CFG_EQUIP_ID
    wait 10
    exevent drag %CFG_EQUIP_ID 1
    wait 5
    exevent droppd
    wait 10
    set %r equip_ok
    gosub t_eq exevent_equip_and_droppd_ran_(check_the_paperdoll) %r equip_ok
  }
  else
  {
    gosub t_skip exevent_equip_and_droppd set_%CFG_EQUIP_ID_to_a_wearable_item_id
  }
  findItem * G_12
  if #findcnt > 0
  {
    hideItem #findid
    wait 3
    set %r hide_ok
    gosub t_eq hideitem_on_a_ground_item_ran_(it_disappears_until_redraw) %r hide_ok
  }
  else
  {
    gosub t_skip hideitem no_item_on_the_ground_within_12_tiles
  }
return

; ---------------------------------------------------------------------------
;  %DO_LOCKS
; ---------------------------------------------------------------------------
sub sec_locks
  gosub t_head 17b_skill_and_stat_locks
  chooseSkill mage
  set %lock0 #skilllock
  gosub t_info mage_lock_before_the_test %lock0
  exevent skillLock mage locked
  wait 20
  chooseSkill mage
  gosub t_soft exevent_skilllock_mage_locked #skilllock locked
  exevent skillLock mage down
  wait 20
  chooseSkill mage
  gosub t_soft exevent_skilllock_mage_down #skilllock down
  event skillLock mage up
  wait 20
  chooseSkill mage
  gosub t_soft event_skilllock_(rerouted_to_exevent)_mage_up #skilllock up
  exevent skillLock mage %lock0
  wait 20
  chooseSkill mage
  gosub t_soft mage_lock_restored #skilllock %lock0
  ; stat locks cannot be read back: Str is left UP (the usual default)
  exevent statLock str up
  wait 10
  set %r statlock_ok
  gosub t_eq exevent_statlock_str_up_ran_(str_lock_is_now_UP) %r statlock_ok
return

; ---------------------------------------------------------------------------
;  %DO_SHOP - open a vendor buy gump first
; ---------------------------------------------------------------------------
sub sec_shop
  gosub t_head 17c_shop_commands
  getShopInfo
  gosub t_info shopcurpos #shopcurpos
  gosub t_info shopcnt #shopcnt
  gosub t_info shopitemtype #shopitemtype
  gosub t_info shopitemid #shopitemid
  gosub t_info shopitemname #shopitemname
  gosub t_info shopitemprice #shopitemprice
  gosub t_info shopitemmax #shopitemmax
  setShopItem #shopitemid 1
  set %r shop_ok
  gosub t_eq setshopitem_ran_without_stopping_the_script %r shop_ok
return

; ---------------------------------------------------------------------------
;  %DO_EXECUTE / %DO_SEND / %DO_UOXL_NEW / %DO_TERMINATE_UO
; ---------------------------------------------------------------------------
sub sec_execute
  gosub t_head 18_execute
  set %t0 #systime
  execute cmd.exe /c exit
  set %dt #systime - %t0
  set %ok %dt >= 1800
  gosub t_softchk execute_includes_the_built_in_2_second_wait %dt >=_1800_ms %ok
return

sub sec_send
  gosub t_head 19_send_http_post
  set #sendHeader X-Test:_1$
  set %t0 #systime
  send HTTPPost euo-selftest.invalid /euo-selftest a=1
  set %dt #systime - %t0
  set %ok %dt <= 15000
  gosub t_chk send_to_an_unresolvable_host_returns_and_runs_nothing %dt 0..15000_ms %ok
  set #sendHeader N/A
return

sub sec_uoxl_new
  gosub t_head 20_uoxl_new
  set %c0 #clicnt
  uoXL new
  wait 10s
  set %c1 #clicnt
  set %ok %c1 > %c0
  set %act %c0 , _to_ , %c1
  gosub t_softchk uoxl_new_starts_another_client %act clicnt_grows %ok
return

sub sec_terminate_uo
  gosub t_head 22_terminate_uo
  set %c0 #clicnt
  terminate uo
  wait 5
  set %c1 #clicnt
  set %ok %c1 < %c0
  set %act %c0 , _to_ , %c1
  gosub t_softchk terminate_uo_closes_the_client %act clicnt_shrinks %ok
return

; ###########################################################################
;  TILE  (runs last: a missing map file makes Tile Init stop the script)
; ###########################################################################
sub sec_tile
  gosub t_head 23_tile
  set %c_soft 1
  tile init
  tile cnt #charposx #charposy #curskind
  set %tc #tilecnt
  gosub c_nonneg tile_cnt_at_the_characters_position_is_>=_0 %tc
  if %tc > 0
  {
    tile get #charposx #charposy 1 #curskind
    gosub c_num tile_type_is_a_number #tiletype
    gosub c_num tile_z_is_a_number #tilez
    gosub c_has tile_name_is_not_empty #tilename
    gosub t_info tile_flags #tileflags
    for %ti 1 %tc
    {
      tile get #charposx #charposy %ti #curskind
      set %tl #tiletype , _z= , #tilez , _name= , #tilename
      gosub t_info tile_layer_ , %ti %tl
    }
  }
  else
  {
    gosub t_skip tile_get no_tiles_reported_at_the_characters_position
  }
  tile init noOverrides
  tile cnt #charposx #charposy #curskind
  gosub t_soft tile_init_noOverrides_gives_the_same_tile_count #tilecnt %tc
  set %c_soft 0
return

; ---------------------------------------------------------------------------
;  %DO_INTERACTIVE - message boxes, beep, pause, hotkey, menu clicks
;  (you have to act: every step tells you what to click)
; ---------------------------------------------------------------------------
sub sec_interactive
  gosub t_head 24_interactive_(you_click_things)

  ; ---- display ---------------------------------------------------------------
  display ok Interactive 1 of 10:$Click OK.
  gosub t_eq display_ok_gives_Ok #dispres Ok
  display okcancel Interactive 2 of 10:$Click CANCEL.
  gosub t_eq display_okcancel_cancel_gives_Cancel #dispres Cancel
  display yesno Interactive 3 of 10:$Click YES.
  gosub t_eq display_yesno_yes_gives_Yes #dispres Yes
  display yesno Interactive 4 of 10:$Click NO.
  gosub t_eq display_yesno_no_gives_No #dispres No
  display yesnocancel Interactive 5 of 10:$Click CANCEL.
  gosub t_eq display_yesnocancel_cancel_gives_Cancel #dispres Cancel
  display Interactive 6 of 10: a display line without a type keyword.$Click OK.
  gosub t_eq display_without_a_type_is_a_plain_ok_box #dispres Ok

  ; ---- sound -------------------------------------------------------------------------
  sound
  display yesno Interactive 7 of 10:$Did you just hear a beep?
  gosub t_soft sound_without_a_file_plays_the_default_beep #dispres Yes

  ; ---- pause ---------------------------------------------------------------------------
  display ok Interactive 8 of 10:$After you click OK the script PAUSES.$Press the PLAY button of EasyUO Reforged to continue.
  set %resumed no
  pause
  set %resumed yes
  gosub t_eq pause_waits_until_play_is_pressed %resumed yes

  ; ---- onHotKey ----------------------------------------------------------------------------
  display ok Interactive 9 of 10:$After you click OK press and HOLD the F9 key (you have 10 seconds).
  set %hk 0
  set %lim #scnt + 10
  repeat
  {
    onhotkey F9
      set %hk 1
    wait 1
  }
  until %hk = 1 || #scnt > %lim
  gosub t_eq onhotkey_fires_while_the_key_is_down %hk 1

  ; ---- menu: buttons, check box, close button ----------------------------------------------------
  display ok Interactive 10 of 10:$A small window opens.$Click the button TWO, tick the check box, then CLOSE the window.
  menu Clear
  menu Window Title EUO selftest - click TWO, tick, close
  menu Window Size 330 130
  menu Text t1 10 10 Click TWO, tick the box, close the window.
  menu Button b1 10 40 80 30 One
  menu Button b2 100 40 80 30 Two
  menu Check c1 10 80 140 20 #false Tick me
  set #menuButton none
  menu Show 200 200
  set %lim #scnt + 60
  repeat
  {
    wait 1
  }
  until #menubutton = b2 || #menubutton = CLOSED || #scnt > %lim
  gosub t_eq menu_button_click_sets_menubutton #menubutton b2
  menu Get c1
  gosub t_info menu_check_box_state_when_you_clicked_TWO_(-1=ticked) #menures
  set %lim #scnt + 60
  repeat
  {
    wait 1
  }
  until #menubutton = CLOSED || #scnt > %lim
  gosub t_eq closing_the_menu_window_sets_menubutton_to_CLOSED #menubutton CLOSED

  ; ---- menu hide / show ----------------------------------------------------------------------------
  menu Clear
  menu Window Size 260 60
  menu Text t1 10 10 Hide / show test window
  menu Show 200 200
  menu Hide
  display yesno Interactive:$The small test window should be HIDDEN now.$Is it?
  gosub t_soft menu_hide_hides_the_window #dispres Yes
  menu Show 200 200
  display yesno Interactive:$The small test window should be VISIBLE again.$Is it?
  gosub t_soft menu_show_shows_the_window_again #dispres Yes

  ; ---- gallery: shapes and images (visual check) -----------------------------------------------------------
  menu Clear
  menu Window Title EUO selftest - gallery
  menu Window Size 340 210
  menu Window Color white
  for %st 1 6
  {
    set %gx %st * 50 - 40
    menu Shape gs , %st %gx 10 40 40 %st 7 1 red 7 yellow
  }
  menu Image Create gi 10 70 150 100
  menu Image Rectangle gi 0 0 149 99 blue #true
  menu Image Ellipse gi 40 20 100 80 red #true
  menu Image Line gi 0 0 149 99 green 3
  menu Image PixLine gi 0 90 AAAPPP666999AAP
  menu Text gt 180 80 Text with a $ line break
  menu Show 200 200
  display yesno Interactive:$Do you see 6 yellow shapes (circle, ellipse, rectangle, rounded rectangle, rounded square, square) with red outlines,$and below them a blue rectangle with a red circle and a green diagonal line?
  gosub t_soft menu_shape_and_image_commands_draw_what_they_should #dispres Yes
  menu Hide

  ; ---- menu HideEUO -------------------------------------------------------------------------------------------
  menu Clear
  menu Window Size 300 60
  menu Text t1 10 10 Close this window to bring the main window back
  menu Show 200 200
  menu HideEUO
  display yesno Interactive:$The MAIN EasyUO Reforged window should be minimised now.$Is it?   (afterwards close the small window to restore it)
  gosub t_soft menu_hideeuo_minimises_the_main_window #dispres Yes
  menu Hide
return
; ###########################################################################
;  HELPER SUBS  (everything below the final "halt" - never fall through)
; ###########################################################################
;  %1..%n are overwritten by every gosub, so each helper copies its
;  parameters to _h* variables before it does anything else.

; ---- section header --------------------------------------------------------
sub t_head
  set %log %log , $=== , %1 , ===$
return

; ---- t_eq name actual expected ---------------------------------------------
;  numeric compare when both sides are numbers, else case-insensitive text
sub t_eq
  set %n_run %n_run + 1
  set %_hn %1
  set %_ha %2
  set %_he %3
  if %_ha = %_he
  {
    set %n_pass %n_pass + 1
    set %_hl [PASS] , #spc , %_hn , #spc , | , #spc , expected[ , %_he , ] , #spc , actual[ , %_ha , ]$
  }
  else
  {
    set %n_fail %n_fail + 1
    set %_hl [FAIL] , #spc , %_hn , #spc , | , #spc , expected[ , %_he , ] , #spc , actual[ , %_ha , ]$
    set %fails %fails , %_hl
  }
  set %log %log , %_hl
return

; ---- t_str name actual expected ---------------------------------------------
;  same, but both sides are wrapped in [ ] first so a value such as  -  (  in
;  abs  cannot be mistaken for an operator by the "if" evaluator
sub t_str
  set %n_run %n_run + 1
  set %_hn %1
  set %_ha %2
  set %_he %3
  set %_hwa [ , %_ha , ]
  set %_hwe [ , %_he , ]
  if %_hwa = %_hwe
  {
    set %n_pass %n_pass + 1
    set %_hl [PASS] , #spc , %_hn , #spc , | , #spc , expected[ , %_he , ] , #spc , actual[ , %_ha , ]$
  }
  else
  {
    set %n_fail %n_fail + 1
    set %_hl [FAIL] , #spc , %_hn , #spc , | , #spc , expected[ , %_he , ] , #spc , actual[ , %_ha , ]$
    set %fails %fails , %_hl
  }
  set %log %log , %_hl
return

; ---- t_chk name actual criterion bool ----------------------------------------
;  for values that cannot be known in advance: the caller computes the boolean
;  (#true/#false) and passes a readable criterion that is printed as "expected"
sub t_chk
  set %n_run %n_run + 1
  set %_hn %1
  set %_ha %2
  set %_he %3
  set %_hb %4
  if %_hb = -1
  {
    set %n_pass %n_pass + 1
    set %_hl [PASS] , #spc , %_hn , #spc , | , #spc , expected[ , %_he , ] , #spc , actual[ , %_ha , ]$
  }
  else
  {
    set %n_fail %n_fail + 1
    set %_hl [FAIL] , #spc , %_hn , #spc , | , #spc , expected[ , %_he , ] , #spc , actual[ , %_ha , ]$
    set %fails %fails , %_hl
  }
  set %log %log , %_hl
return

; ---- t_soft name actual expected -----------------------------------------------
;  like t_eq, but a mismatch is only a [NOTE] (depends on live client data)
sub t_soft
  set %n_run %n_run + 1
  set %_hn %1
  set %_ha %2
  set %_he %3
  if %_ha = %_he
  {
    set %n_pass %n_pass + 1
    set %_hl [PASS] , #spc , %_hn , #spc , | , #spc , expected[ , %_he , ] , #spc , actual[ , %_ha , ]$
  }
  else
  {
    set %n_note %n_note + 1
    set %_hl [NOTE] , #spc , %_hn , #spc , | , #spc , soft_check_expected[ , %_he , ] , #spc , actual[ , %_ha , ]$
  }
  set %log %log , %_hl
return

; ---- t_softchk name actual criterion bool ---------------------------------------
sub t_softchk
  set %n_run %n_run + 1
  set %_hn %1
  set %_ha %2
  set %_he %3
  set %_hb %4
  if %_hb = -1
  {
    set %n_pass %n_pass + 1
    set %_hl [PASS] , #spc , %_hn , #spc , | , #spc , expected[ , %_he , ] , #spc , actual[ , %_ha , ]$
  }
  else
  {
    set %n_note %n_note + 1
    set %_hl [NOTE] , #spc , %_hn , #spc , | , #spc , soft_check_expected[ , %_he , ] , #spc , actual[ , %_ha , ]$
  }
  set %log %log , %_hl
return

; ---- t_dd name actual wiki_says code_does ---------------------------------------
;  a place where the old wiki text and the engine disagree.  Matching the
;  engine = [NOTE] (the port is a faithful copy of the original, so the wiki is
;  presumably wrong); matching the wiki = [PASS]; neither = [FAIL].
sub t_dd
  set %n_run %n_run + 1
  set %_hn %1
  set %_ha %2
  set %_hd %3
  set %_hc %4
  if %_ha = %_hc
  {
    set %n_note %n_note + 1
    set %_hl [NOTE] , #spc , %_hn , #spc , | , #spc , engine_does[ , %_hc , ] , #spc , wiki_says[ , %_hd , ] , #spc , actual[ , %_ha , ]$
  }
  else
  {
    if %_ha = %_hd
    {
      set %n_pass %n_pass + 1
      set %_hl [PASS] , #spc , %_hn , #spc , | , #spc , matches_the_wiki[ , %_hd , ] , #spc , actual[ , %_ha , ]$
    }
    else
    {
      set %n_fail %n_fail + 1
      set %_hl [FAIL] , #spc , %_hn , #spc , | , #spc , engine_does[ , %_hc , ] , #spc , wiki_says[ , %_hd , ] , #spc , actual[ , %_ha , ]$
      set %fails %fails , %_hl
    }
  }
  set %log %log , %_hl
return

; ---- t_info name value ----------------------------------------------------------
sub t_info
  set %n_info %n_info + 1
  set %_hn %1
  set %_ha %2
  set %log %log , [INFO] , #spc , %_hn , #spc , = , #spc , [ , %_ha , ]$
return

; ---- t_skip name reason ---------------------------------------------------------
sub t_skip
  set %n_skip %n_skip + 1
  set %_hn %1
  set %_hr %2
  set %log %log , [SKIP] , #spc , %_hn , #spc , | , #spc , %_hr , $
return

; ---- v_cli varname ----------------------------------------------------------------
;  reads  #varname  dynamically (the "# . name" array idiom).  Client variable:
;  without a client it must be N/A, with a client the value is just listed.
sub v_cli
  set %_vn %1
  set %_vv # . %_vn
  if %HAVE_CLIENT = 1
  {
    gosub t_info # , %_vn %_vv
  }
  else
  {
    gosub t_eq no_client_na_# , %_vn %_vv N/A
  }
return

; ---- v_any varname ----------------------------------------------------------------
;  variable that works with or without a client: value is only listed
sub v_any
  set %_vn %1
  set %_vv # . %_vn
  gosub t_info # , %_vn %_vv
return

; ---- c_num name value --------------------------------------------------------------
;  value must be a number (the "( v > 0 || v < 1 )" trick from the wiki)
sub c_num
  set %_cn %1
  set %_cv %2
  set %_ck ( %_cv >= 0 ) || ( %_cv < 0 )
  if %c_soft = 1
  {
    gosub t_softchk %_cn %_cv a_number %_ck
  }
  else
  {
    gosub t_chk %_cn %_cv a_number %_ck
  }
return

; ---- c_nonneg name value -------------------------------------------------------------
sub c_nonneg
  set %_cn %1
  set %_cv %2
  set %_ck %_cv >= 0
  if %c_soft = 1
  {
    gosub t_softchk %_cn %_cv number_>=_0 %_ck
  }
  else
  {
    gosub t_chk %_cn %_cv number_>=_0 %_ck
  }
return

; ---- c_range name value lo hi ----------------------------------------------------------
sub c_range
  set %_cn %1
  set %_cv %2
  set %_cl %3
  set %_ch %4
  set %_ck ( %_cv >= %_cl ) && ( %_cv <= %_ch )
  if %c_soft = 1
  {
    gosub t_softchk %_cn %_cv number_ , %_cl , .. , %_ch %_ck
  }
  else
  {
    gosub t_chk %_cn %_cv number_ , %_cl , .. , %_ch %_ck
  }
return

; ---- c_has name value ---------------------------------------------------------------------
;  value must not be empty and not N/A
sub c_has
  set %_cn %1
  set %_cv %2
  str len %_cv
  set %_ck ( #strres > 0 ) && ( %_cv <> N/A )
  if %c_soft = 1
  {
    gosub t_softchk %_cn %_cv not_empty_and_not_N/A %_ck
  }
  else
  {
    gosub t_chk %_cn %_cv not_empty_and_not_N/A %_ck
  }
return

; ---- c_digits name value length ---------------------------------------------------------------
sub c_digits
  set %_cn %1
  set %_cv %2
  set %_cl %3
  str len %_cv
  set %_ck ( #strres = %_cl ) && ( %_cv >= 0 )
  if %c_soft = 1
  {
    gosub t_softchk %_cn %_cv numeric_ , %_cl , _characters %_ck
  }
  else
  {
    gosub t_chk %_cn %_cv numeric_ , %_cl , _characters %_ck
  }
return

; ###########################################################################
;  REPORT
; ###########################################################################
sub sec_report
  gosub build_report
  if %CFG_QUIET = 0
  {
    menu Clear
    menu Window Title EasyUO Reforged self-test report
    menu Window Size 960 660
    menu Font Name Courier New
    menu Font Size 9
    menu Memo rpt 8 8 940 610 %report
    menu Show 30 30
    menu Activate rpt
  }
return

sub sec_report_refresh
  gosub build_report
  if %CFG_QUIET = 0
  {
    menu Set rpt %report
  }
return

sub build_report
  if %n_fail = 0
  {
    set %verdict ALL_CHECKS_PASSED
  }
  else
  {
    set %verdict SOME_CHECKS_FAILED
  }
  set %summary RESULT: , #spc , %verdict , $ , checks , #spc , = , #spc , %n_run , $ , pass , #spc , = , #spc , %n_pass , $ , fail , #spc , = , #spc , %n_fail , $ , note , #spc , = , #spc , %n_note , #spc , (soft_checks_and_wiki_differences) , $ , skip , #spc , = , #spc , %n_skip , $ , info , #spc , = , #spc , %n_info
  if %HAVE_CLIENT = 1
  {
    if %LOGGED = 1
    {
      set %modetxt client_attached_and_logged_in
    }
    else
    {
      set %modetxt client_attached_but_not_logged_in
    }
  }
  else
  {
    set %modetxt NO_client_attached
  }
  set %report EasyUO , #spc , Reforged , #spc , self-test , #spc , - , #spc , ReforgedVer , #spc , #reforgedver , #spc , - , #spc , EUOVer , #spc , #euover , #spc , - , #spc , %modetxt , $ , %summary , $
  set %report %report , Legend: , #spc , [PASS]_ok , #spc , [FAIL]_expected<>actual , #spc , [NOTE]_soft/wiki_difference , #spc , [INFO]_live_value , #spc , [SKIP]_not_run , $
  set %report %report , $ , FAILURES: , $
  str len %fails
  if #strres > 0
  {
    set %report %report , %fails
  }
  else
  {
    set %report %report , (none) , $
  }
  str len %tile_note
  if #strres > 0
  {
    set %report %report , $ , %tile_note , $
  }
  set %report %report , $ , FULL_LOG: , %log
return

; ---- used by call-helper.euo to prove a callee cannot gosub the caller's subs ----
sub t_leak_probe
  set %call_leak BAD_the_callee_reached_a_sub_of_the_caller
return
